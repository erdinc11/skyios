--- /dev/null
+++ b/osfmk/arm64/sweet_rs.c
@@ -0,0 +1,27 @@
+/*
+ * C hooks for the Rust part of the SWEET kernel (kernel-rs/ in the repo,
+ * linked as libsweet_kernel.a through LD_KERNEL_ARCHIVES). Rust calls
+ * these instead of printf/panic directly: LLVM turns printf("%s", s)
+ * into puts, which the kernel does not have.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <kern/misc_protos.h>
+#include <kern/debug.h>
+
+void sweet_rs_log(const char *msg);
+void sweet_rs_panic(const char *msg) __abortlike;
+
+void
+sweet_rs_log(const char *msg)
+{
+	printf("%s", msg);
+}
+
+void
+sweet_rs_panic(const char *msg)
+{
+	panic("%s", msg);
+}
+#endif /* SWEET */
