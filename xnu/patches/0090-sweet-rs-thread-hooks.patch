@@ -6,14 +6,19 @@
 #include <kern/clock.h>
 #include <machine/machine_routines.h>
 #include <pexpert/pexpert.h>
+#include <kern/thread.h>
+#include <kern/kalloc.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
 
 void sweet_rs_log(const char *msg);
 void sweet_rs_panic(const char *msg) __abortlike;
 uintptr_t sweet_rs_io_map(uint64_t pa, uint64_t size);
 bool sweet_rs_boot_arg_u32(const char *name, uint32_t *out);
 void sweet_rs_delay_us(uint32_t us);
+void sweet_rs_sleep_ms(uint32_t ms);
+bool sweet_rs_spawn(void (*fn)(uintptr_t), uintptr_t arg);
 
 void
 sweet_rs_log(const char *msg)
@@ -44,4 +49,43 @@
 {
 	delay(us);
 }
+
+void
+sweet_rs_sleep_ms(uint32_t ms)
+{
+	delay_for_interval(ms, NSEC_PER_MSEC);
+}
+
+struct sweet_rs_job {
+	void (*fn)(uintptr_t);
+	uintptr_t arg;
+};
+
+static void
+sweet_rs_thread(void *p, __unused wait_result_t wr)
+{
+	struct sweet_rs_job job = *(struct sweet_rs_job *)p;
+	kfree_data(p, sizeof(job));
+	job.fn(job.arg);
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+bool
+sweet_rs_spawn(void (*fn)(uintptr_t), uintptr_t arg)
+{
+	struct sweet_rs_job *job = kalloc_data(sizeof(*job), Z_WAITOK);
+	thread_t thread;
+	if (job == NULL) {
+		return false;
+	}
+	job->fn = fn;
+	job->arg = arg;
+	if (kernel_thread_start(sweet_rs_thread, job, &thread) != KERN_SUCCESS) {
+		kfree_data(job, sizeof(*job));
+		return false;
+	}
+	thread_deallocate(thread);
+	return true;
+}
 #endif
