diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 94a1f74..151c13e 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -123,14 +123,55 @@ sweet_early_draw_checkpoint(unsigned int stage)
 }
 
 static unsigned int checkpoint_active;
+static unsigned int diag_active;
+static unsigned int diag_stage_last;
+
+static void
+sweet_early_draw_diag(unsigned int id)
+{
+	unsigned int x = SWEET_DIAG_X + 8u;
+	for (unsigned int y = 0; y < SWEET_DIAG_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (SWEET_DIAG_Y + y) * EARLY_STRIDE + SWEET_DIAG_X;
+		for (unsigned int i = 0; i < SWEET_DIAG_W; i++) {
+			line[i] = CHECKPOINT_BLACK;
+		}
+	}
+	for (unsigned int d = 0; d < 3u; d++) {
+		unsigned int digit = (id / (d == 0 ? 100u : (d == 1 ? 10u : 1u))) % 10u;
+		const unsigned char *glyph = iso_font + ('0' + digit) * 16u;
+		for (unsigned int gy = 0; gy < 16; gy++) {
+			for (unsigned int sy = 0; sy < 4u; sy++) {
+				volatile uint32_t *line = EARLY_FB +
+				    (SWEET_DIAG_Y + 6u + gy * 4u + sy) * EARLY_STRIDE + x + d * 36u;
+				for (unsigned int gx = 0; gx < 8; gx++) {
+					uint32_t px = (glyph[gy] & (1u << gx)) ? CHECKPOINT_RED : CHECKPOINT_BLACK;
+					for (unsigned int sx = 0; sx < 4u; sx++) {
+						line[gx * 4u + sx] = px;
+					}
+				}
+			}
+		}
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+void
+sweet_early_diag(unsigned int id)
+{
+	diag_stage_last = id;
+	diag_active = 1;
+	sweet_early_draw_diag(id);
+}
 
 void
 sweet_early_checkpoint_repaint(void)
 {
-	if (!checkpoint_active) {
-		return;
+	if (checkpoint_active) {
+		sweet_early_draw_checkpoint(checkpoint_stage_last);
+	}
+	if (diag_active) {
+		sweet_early_draw_diag(diag_stage_last);
 	}
-	sweet_early_draw_checkpoint(checkpoint_stage_last);
 }
 
 static void
