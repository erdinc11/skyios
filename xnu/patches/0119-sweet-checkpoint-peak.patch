 }
 
+static unsigned int checkpoint_stage_last;
+static unsigned int checkpoint_stage_max;
+
+/* Two two-digit numbers: left = highest checkpoint reached so far (dim red),
+ * right = most recent checkpoint (bright red). The peak survives later
+ * checkpoints so short-lived diagnostic markers remain observable. */
 static void
 sweet_early_draw_checkpoint(unsigned int stage)
 {
+	unsigned int peak = checkpoint_stage_max > stage ? checkpoint_stage_max : stage;
 	unsigned int x = CHECKPOINT_X + 8u;
 	for (unsigned int y = 0; y < CHECKPOINT_BOX_H; y++) {
 		volatile uint32_t *line = EARLY_FB + (CHECKPOINT_Y + y) * EARLY_STRIDE + CHECKPOINT_X;
@@ -106,12 +115,13 @@ sweet_early_draw_checkpoint(unsigned int stage)
 			line[i] = CHECKPOINT_BLACK;
 		}
 	}
-	sweet_early_draw_checkpoint_digit(stage / 10u, x);
-	sweet_early_draw_checkpoint_digit(stage % 10u, x + 56u);
+	sweet_early_draw_checkpoint_digit(peak / 10u, x, CHECKPOINT_RED_DIM);
+	sweet_early_draw_checkpoint_digit(peak % 10u, x + CHECKPOINT_DIGIT_W + 4u, CHECKPOINT_RED_DIM);
+	sweet_early_draw_checkpoint_digit(stage / 10u, x + 2u * CHECKPOINT_DIGIT_W + 26u, CHECKPOINT_RED);
+	sweet_early_draw_checkpoint_digit(stage % 10u, x + 3u * CHECKPOINT_DIGIT_W + 30u, CHECKPOINT_RED);
 	__asm__ volatile("dsb sy" ::: "memory");
 }
 
-static unsigned int checkpoint_stage_last;
 static unsigned int checkpoint_active;
 
 void
@@ -138,6 +148,9 @@ sweet_early_mark(unsigned int stage, const char *label)
 		return;
 	}
 	checkpoint_stage_last = stage;
+	if (stage > checkpoint_stage_max) {
+		checkpoint_stage_max = stage;
+	}
 	checkpoint_active = 1;
 	sweet_early_draw_checkpoint(stage);
 	if (stage <= 20u) {
