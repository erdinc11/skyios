 	return true;
+}
+
+extern "C" volatile int sweet_touch_dbg[3];
+
+static void
+sweet_fb_touch_dot(uintptr_t pixels, uint32_t width, uint32_t height, uint32_t row_bytes)
+{
+	static int enabled = -1;
+	if (enabled < 0) {
+		enabled = 0;
+		PE_parse_boot_argn("sweettouchdot", &enabled, sizeof(enabled));
+	}
+	if (!enabled || !sweet_touch_dbg[0]) {
+		return;
+	}
+	int cx = sweet_touch_dbg[1], cy = sweet_touch_dbg[2];
+	for (int d = -40; d <= 40; d++) {
+		for (int t = -2; t <= 2; t++) {
+			int pts[2][2] = { { cx + d, cy + t }, { cx + t, cy + d } };
+			for (int k = 0; k < 2; k++) {
+				int px = pts[k][0], py = pts[k][1];
+				if (px >= 0 && py >= 0 && (uint32_t)px < width && (uint32_t)py < height) {
+					((volatile uint32_t *)(pixels + (uint64_t)py * row_bytes))[px] = 0xffff0000;
+				}
+			}
+		}
+	}
 }
 
