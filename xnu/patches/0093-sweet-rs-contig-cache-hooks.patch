 void
 sweet_rs_log(const char *msg)
@@ -88,4 +94,29 @@
 	thread_deallocate(thread);
 	return true;
 }
+
+uintptr_t
+sweet_rs_alloc_contig(uint64_t size, uint64_t *pa)
+{
+	vm_offset_t va = 0;
+	if (kmem_alloc_contig(kernel_map, &va, (vm_size_t)round_page(size), PAGE_MASK, 0, 0,
+	    KMA_KOBJECT | KMA_ZERO | KMA_NOPAGEWAIT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	*pa = kvtophys(va);
+	CleanPoC_DcacheRegion(va, (size_t)round_page(size));
+	return (uintptr_t)va;
+}
+
+void
+sweet_rs_cache_clean(uintptr_t va, uint64_t size)
+{
+	CleanPoC_DcacheRegion((vm_offset_t)va, (size_t)size);
+}
+
+void
+sweet_rs_cache_flush(uintptr_t va, uint64_t size)
+{
+	FlushPoC_DcacheRegion((vm_offset_t)va, (size_t)size);
+}
 #endif
