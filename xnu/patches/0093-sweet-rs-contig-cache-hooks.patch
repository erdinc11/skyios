+#include <arm/pmap/pmap.h>
 
 extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
 extern kern_return_t thread_terminate(thread_t);
@@ -19,6 +22,9 @@
 void sweet_rs_delay_us(uint32_t us);
 void sweet_rs_sleep_ms(uint32_t ms);
 bool sweet_rs_spawn(void (*fn)(uintptr_t), uintptr_t arg);
+uintptr_t sweet_rs_alloc_contig(uint64_t size, uint64_t *pa);
+void sweet_rs_cache_clean(uintptr_t va, uint64_t size);
