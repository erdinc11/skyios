diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 9ed849b..6dad100 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -70,6 +70,47 @@ sweet_early_putc(char c)
 	early_col++;
 }
 
+#define CHECKPOINT_X (EARLY_WIDTH - 80u - 120u)
+#define CHECKPOINT_Y 96u
+#define CHECKPOINT_BOX_W 120u
+#define CHECKPOINT_BOX_H 112u
+#define CHECKPOINT_SCALE 6u
+#define CHECKPOINT_RED 0xffff2020u
+#define CHECKPOINT_BLACK 0xff000000u
+
+static void
+sweet_early_draw_checkpoint_digit(unsigned int digit, unsigned int x)
+{
+	const unsigned char *glyph = iso_font + (digit % 10u) * 16u;
+	for (unsigned int gy = 0; gy < 16; gy++) {
+		for (unsigned int sy = 0; sy < CHECKPOINT_SCALE; sy++) {
+			volatile uint32_t *line = EARLY_FB +
+			    (CHECKPOINT_Y + gy * CHECKPOINT_SCALE + sy) * EARLY_STRIDE + x;
+			for (unsigned int gx = 0; gx < 8; gx++) {
+				uint32_t color = (glyph[gy] & (1u << gx)) ? CHECKPOINT_RED : CHECKPOINT_BLACK;
+				for (unsigned int sx = 0; sx < CHECKPOINT_SCALE; sx++) {
+					line[gx * CHECKPOINT_SCALE + sx] = color;
+				}
+			}
+		}
+	}
+}
+
+static void
+sweet_early_draw_checkpoint(unsigned int stage)
+{
+	unsigned int x = CHECKPOINT_X + 8u;
+	for (unsigned int y = 0; y < CHECKPOINT_BOX_H; y++) {
+		volatile uint32_t *line = EARLY_FB + (CHECKPOINT_Y + y) * EARLY_STRIDE + CHECKPOINT_X;
+		for (unsigned int i = 0; i < CHECKPOINT_BOX_W; i++) {
+			line[i] = CHECKPOINT_BLACK;
+		}
+	}
+	sweet_early_draw_checkpoint_digit(stage / 10u, x);
+	sweet_early_draw_checkpoint_digit(stage % 10u, x + 56u);
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
 static void
 sweet_early_string(const char *s)
 {
@@ -81,21 +122,29 @@ sweet_early_string(const char *s)
 void
 sweet_early_mark(unsigned int stage, const char *label)
 {
-	if (early_disabled || stage > 20) {
+	if (stage > 99u) {
 		return;
 	}
-	uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
-	for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
-		for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
-			EARLY_FB[y * EARLY_STRIDE + x] = color;
+	sweet_early_draw_checkpoint(stage);
+	if (stage <= 20u) {
+		uint32_t color = 0xff00ff00u | ((stage & 7u) * 32u << 16);
+		for (unsigned int y = EARLY_HEIGHT - 32; y < EARLY_HEIGHT; y++) {
+			for (unsigned int x = stage * 48; x < (stage + 1) * 48; x++) {
+				EARLY_FB[y * EARLY_STRIDE + x] = color;
+			}
 		}
 	}
 	__asm__ volatile("dsb sy" ::: "memory");
+	if (early_disabled) {
+		return;
+	}
 	sweet_early_string("SWEET EARLY ");
-	if (stage >= 10) {
-		sweet_early_putc((char)('0' + stage / 10));
+	if (stage >= 10u) {
+		sweet_early_putc((char)('0' + stage / 10u));
+	} else {
+		sweet_early_putc('0');
 	}
-	sweet_early_putc((char)('0' + stage % 10));
+	sweet_early_putc((char)('0' + stage % 10u));
 	sweet_early_string(": ");
 	sweet_early_string(label);
 	sweet_early_putc('\n');
