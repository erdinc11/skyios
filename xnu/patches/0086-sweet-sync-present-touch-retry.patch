+
+/*
+ * With sweetfb_sync (default) SwapEnd copies the frame before returning:
+ * the client may redraw a surface as soon as the next swap replaces it, so
+ * a late copy from the vsync timer could show a half-drawn frame, and
+ * frames swapped between two ticks were dropped. At full CPU clock (0084)
+ * the copy takes about 3 ms. The timer path stays for sweetfb_sync=0 and
+ * for the redraw after display on.
+ */
+void
+AppleCLCD::presentTimed(const uint8_t *rec)
+{
+	IOLockLock(fPresentLock);
+	uint64_t t0 = mach_absolute_time();
+	present(rec);
+	uint64_t dt = mach_absolute_time() - t0;
+	fStatPresents++;
+	fStatPresentAbs += dt;
+	if (dt > fStatPresentMaxAbs) {
+		fStatPresentMaxAbs = dt;
 	}
+	IOLockUnlock(fPresentLock);
 }
 
