--- a/bsd/dev/sweet_sample.c
+++ b/bsd/dev/sweet_sample.c
@@ -5,6 +5,8 @@
 #include <kern/task.h>
 #include <kern/thread.h>
 #include <pexpert/pexpert.h>
+#include <sys/bsdtask_info.h>
+#include <kern/clock.h>
 
 extern task_t proc_task(proc_t);
 extern int hz;
@@ -64,11 +66,96 @@
 	}
 }
 
+#define TOP_SLOTS 768
+#define TOP_SHOW 10
+
+struct sweet_top_ent {
+	int      pid;
+	uint64_t cpu;
+	uint64_t delta;
+	char     name[20];
+};
+
+static struct sweet_top_ent sweet_top_prev[TOP_SLOTS], sweet_top_cur[TOP_SLOTS];
+static unsigned sweet_top_nprev, sweet_top_ncur;
+
+static int
+sweet_top_proc(proc_t p, __unused void *arg)
+{
+	if (sweet_top_ncur >= TOP_SLOTS) {
+		return PROC_RETURNED;
+	}
+	task_t task = proc_task(p);
+	if (task == TASK_NULL) {
+		return PROC_RETURNED;
+	}
+	struct proc_taskinfo_internal ti;
+	fill_taskprocinfo(task, &ti);
+	struct sweet_top_ent *e = &sweet_top_cur[sweet_top_ncur++];
+	e->pid = proc_pid(p);
+	e->cpu = ti.pti_total_user + ti.pti_total_system;
+	e->delta = e->cpu;
+	proc_name(e->pid, e->name, sizeof(e->name));
+	for (unsigned i = 0; i < sweet_top_nprev; i++) {
+		if (sweet_top_prev[i].pid == e->pid) {
+			e->delta = e->cpu >= sweet_top_prev[i].cpu ? e->cpu - sweet_top_prev[i].cpu : 0;
+			break;
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+sweet_top_thread(void *arg, __unused wait_result_t wr)
+{
+	unsigned secs = (unsigned)(uintptr_t)arg;
+	int chan;
+	uint64_t last = mach_absolute_time();
+	for (;;) {
+		(void)tsleep(&chan, PZERO, "sweettop", (int)secs * hz);
+		sweet_top_ncur = 0;
+		proc_iterate(PROC_ALLPROCLIST, sweet_top_proc, NULL, NULL, NULL);
+		uint64_t now = mach_absolute_time(), span = now - last, all = 0;
+		last = now;
+		char line[512];
+		int len = snprintf(line, sizeof(line), "SWEET TOP %us:", secs);
+		for (unsigned i = 0; i < sweet_top_ncur; i++) {
+			all += sweet_top_cur[i].delta;
+		}
+		for (unsigned k = 0; k < TOP_SHOW; k++) {
+			unsigned best = TOP_SLOTS;
+			for (unsigned i = 0; i < sweet_top_ncur; i++) {
+				if (sweet_top_cur[i].delta != 0 &&
+				    (best == TOP_SLOTS || sweet_top_cur[i].delta > sweet_top_cur[best].delta)) {
+					best = i;
+				}
+			}
+			if (best == TOP_SLOTS) {
+				break;
+			}
+			struct sweet_top_ent *e = &sweet_top_cur[best];
+			if (len < (int)sizeof(line)) {
+				len += snprintf(line + len, sizeof(line) - (size_t)len, " %s[%d] %llu%%",
+				    e->name, e->pid, span ? e->delta * 100 / span : 0);
+			}
+			e->delta = 0;
+		}
+		printf("%s | all %llu%% of 800%%\n", line, span ? all * 100 / span : 0);
+		memcpy(sweet_top_prev, sweet_top_cur, sizeof(sweet_top_cur[0]) * sweet_top_ncur);
+		sweet_top_nprev = sweet_top_ncur;
+	}
+}
+
 void
 sweet_sample_start(void)
 {
 	thread_t thread;
+	unsigned top = 5;
 	if (kernel_thread_start(sweet_sample_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	(void)PE_parse_boot_argn("sweettop", &top, sizeof(top));
+	if (top != 0 && kernel_thread_start(sweet_top_thread, (void *)(uintptr_t)top, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
