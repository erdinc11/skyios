+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * sweetrun=NAME: the first exec of a binary whose last path component is NAME
+ * runs the tool bsd_init installed (sweet_tool_path) instead. Only once per
+ * boot, so the tool can exec the original.
+ */
+extern char sweet_tool_path[112];
 
+static const char *
+sweet_run_redirect(const char *path)
+{
+	static char name[64];
+	static int state;       /* 0 unparsed, 1 armed, 2 done or off */
+	if (state == 0) {
+		state = PE_parse_boot_argn("sweetrun", name, sizeof(name)) && name[0] ? 1 : 2;
+	}
+	if (state != 1 || sweet_tool_path[0] == '\0') {
+		return path;
+	}
+	const char *base = strrchr(path, '/');
+	base = base ? base + 1 : path;
+	if (strcmp(base, name) != 0 || !OSCompareAndSwap(1, 2, (volatile UInt32 *)&state)) {
+		return path;
+	}
+	printf("SWEET TOOL: exec %s -> %s\n", path, sweet_tool_path);
+	return sweet_tool_path;
+}
+#endif
 
