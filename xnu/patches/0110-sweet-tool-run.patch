+/*
+ * Test tool delivery without touching the root image by hand: skyios
+ * mkpayload --ramdisk puts a "SKYTOOL1" file (128-byte header: size, mode,
+ * destination path, then the bytes) in /chosen/memory-map RAMDisk; it is
+ * written to its path here, root:wheel. kern_exec.c (sweetrun=NAME) then
+ * runs it once in place of the first exec of a binary called NAME; the tool
+ * execs the original when it is done.
+ */
+struct sweet_tool_hdr {
+	char magic[8];
+	uint32_t size;
+	uint32_t mode;
+	char path[112];
+};
+
+char sweet_tool_path[112];
+
+static void
+sweet_tool_install(void)
+{
+	DTEntry entry;
+	void const *prop = NULL;
+	unsigned int len = 0;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &entry) != kSuccess ||
+	    SecureDTGetProperty(entry, "RAMDisk", &prop, &len) != kSuccess || len < 16) {
+		return;
+	}
+	const uint64_t *rd = (const uint64_t *)prop;
+	if (rd[1] < sizeof(struct sweet_tool_hdr)) {
+		return;
+	}
+	const struct sweet_tool_hdr *h = (const struct sweet_tool_hdr *)ml_static_ptovirt((vm_offset_t)rd[0]);
+	if (memcmp(h->magic, "SKYTOOL1", 8) != 0 || h->size == 0 ||
+	    h->size > rd[1] - sizeof(*h) || h->path[0] != '/' || strnlen(h->path, sizeof(h->path)) == sizeof(h->path)) {
+		printf("SWEET TOOL: RAMDisk is not a tool\n");
+		return;
+	}
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(h->path, O_CREAT | O_TRUNC | FWRITE, h->mode & 0755, 0, &vp, ctx);
+	if (err) {
+		printf("SWEET TOOL: open %s: %d\n", h->path, err);
+		return;
+	}
+	int resid = 0;
+	err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)(h + 1), (int)h->size, 0, UIO_SYSSPACE, IO_SYNC,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_uid, 0);
+	VATTR_SET(&va, va_gid, 0);
+	VATTR_SET(&va, va_mode, h->mode & 0755);
+	int aerr = vnode_setattr(vp, &va, ctx);
+	(void)vnode_close(vp, FWRITE, ctx);
+	if (err == 0 && resid == 0) {
+		strlcpy(sweet_tool_path, h->path, sizeof(sweet_tool_path));
+	}
+	printf("SWEET TOOL: %s, %u bytes written (err %d resid %d attr %d)\n", h->path, h->size, err, resid, aerr);
+	sweet_note("tool %u err %d; ", h->size, err);
 }
 #endif
 
