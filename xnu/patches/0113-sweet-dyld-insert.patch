@@ -2,6 +2,7 @@
 #include <kern/debug.h>
 #include <kern/startup.h>
 #include <libkern/amfi/amfi.h>
+#include <pexpert/pexpert.h>
 #include <mach/kern_return.h>
 #include <sys/codesign.h>
 #include <sys/mount.h>
@@ -267,6 +268,31 @@
 	case 0x60: {
 		uint64_t state = 0;
 		error = copyout(&state, arg, sizeof(state));
+		break;
+	}
+	case 0x5a: {
+		/*
+		 * AMFI_SYSCALL_CHECK_DYLD_POLICY (amfi_check_dyld_policy_self):
+		 * args { uint64_t input flags; user pointer to uint64_t output
+		 * flags }. With boot-arg sweetdyldvars=1 answer "everything
+		 * allowed" (DYLD_INSERT_LIBRARIES etc.), else ENOTSUP as before
+		 * (dyld then treats the process as restricted).
+		 */
+		static int allow = -1;
+		if (allow < 0) {
+			allow = 0;
+			(void)PE_parse_boot_argn("sweetdyldvars", &allow, sizeof(allow));
+		}
+		if (!allow) {
+			error = ENOTSUP;
+			break;
+		}
+		uint64_t args[2];
+		error = copyin(arg, args, sizeof(args));
+		if (!error) {
+			uint64_t out = 0xff;
+			error = copyout(&out, (user_addr_t)args[1], sizeof(out));
+		}
 		break;
 	}
 	default:
