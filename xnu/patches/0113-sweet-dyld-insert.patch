+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	/*
+	 * sweetinsert=NAME:PATH adds DYLD_INSERT_LIBRARIES=PATH to the
+	 * environment of every exec of a binary called NAME (launchd strips
+	 * DYLD_* from job environments, 0113o/s). Used to load
+	 * skyios-ios/pbfix into SpringBoard; dyld honours it only when the
