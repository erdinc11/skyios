+		base = base ? base + 1 : path;
+		if (colon && base && (size_t)(colon - spec) == strlen(base) &&
+		    strncmp(base, spec, (size_t)(colon - spec)) == 0) {
+			static char var[200];
+			snprintf(var, sizeof(var), "DYLD_INSERT_LIBRARIES=%s", colon + 1);
+			error = exec_add_user_string(imgp, CAST_USER_ADDR_T(var), UIO_SYSSPACE, TRUE);
+			if (error) {
+				goto bad;
+			}
+			if (imgp->ip_argspace < new_ptr_size) {
+				error = E2BIG;
+				goto bad;
+			}
+			imgp->ip_argspace -= new_ptr_size;
+			imgp->ip_envc++;
+			printf("SWEET INSERT: %s gets %s\n", base, var);
+		}
+	}
+#endif
 
