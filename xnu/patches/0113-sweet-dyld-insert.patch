+		if (!parsed) {
+			parsed = 1;
+			if (!PE_parse_boot_argn("sweetinsert", spec, sizeof(spec))) {
+				spec[0] = '\0';
+			}
+		}
+		char *colon = spec[0] ? strchr(spec, ':') : NULL;
+		const char *path = imgp->ip_strings;
