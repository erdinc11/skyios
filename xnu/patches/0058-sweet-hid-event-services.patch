+#ifndef _DEV_EV_KEYMAP_H
+#define _DEV_EV_KEYMAP_H
+
+#define	NX_NUMKEYCODES	256
+#define NX_NUMSEQUENCES	128
+#define	NX_NUMMODIFIERS	16
+#define	NX_BYTE_CODES	0
+
+#define	NX_WHICHMODMASK	0x0f
+#define	NX_MODMASK	0x10
+#define	NX_CHARGENMASK	0x20
+#define	NX_SPECIALKEYMASK 0x40
