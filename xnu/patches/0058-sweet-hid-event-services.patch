+                                           UInt32               type,
+                                           UInt32               refCon);
+    
+    virtual IOReturn clientMemoryForType(
+                                UInt32                          type,
+                                IOOptionBits *                  options,
+                                IOMemoryDescriptor **           memory ) APPLE_KEXT_OVERRIDE;
+
+    IOReturn clientMemoryForTypeGated(
+                                IOOptionBits *                  options,
+                                IOMemoryDescriptor **           memory );
