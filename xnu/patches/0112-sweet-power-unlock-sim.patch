+
+/*
+ * sweetpowersim=S (sweetpowersim_every=T, up to 8 times): S seconds after the
+ * touch service starts, press the power key once if the display is off, so
+ * unattended boots (sweetshot screenshots) show a lit screen.
+ */
+extern "C" volatile int sweet_fb_power_off;
+
+static void
+sweet_powersim_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	uint32_t every = 0;
+	PE_parse_boot_argn("sweetpowersim_every", &every, sizeof(every));
+	IOSleep((uint32_t)(uintptr_t)arg * 1000);
+	for (int n = 0; n < 8; n++) {
+		bool off = sweet_fb_power_off != 0;
+		if (off) {
+			sweet_hid_key(0, 1);
+			IOSleep(120);
+			sweet_hid_key(0, 0);
+		}
+		IOLog("SWEET POWERSIM: display %s\n", off ? "off, power key pressed" : "on, nothing to do");
+		if (every == 0) {
+			return;
+		}
+		IOSleep(every * 1000);
+	}
+}
+
+/*
+ * sweetunlocksim=S: S seconds after the touch service starts, wake the
+ * display if it is off and swipe up from the bottom edge (the home gesture),
+ * which opens the home screen when there is no passcode.
+ */
+static void
+sweet_unlocksim_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	IOSleep((uint32_t)(uintptr_t)arg * 1000);
+	if (sweet_fb_power_off) {
+		sweet_hid_key(0, 1);
+		IOSleep(120);
+		sweet_hid_key(0, 0);
+		IOSleep(1500);
+	}
+	const int steps = 20;
+	for (int i = 0; i <= steps; i++) {
+		sweet_hid_touch(9, 1, 540, 2395 - (2395 - 900) * i / steps);
+		IOSleep(16);
+	}
+	sweet_hid_touch(9, 0, 540, 900);
+	IOLog("SWEET UNLOCKSIM: home gesture done (display was %s)\n", sweet_fb_power_off ? "off" : "on");
 }
 
