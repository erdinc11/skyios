+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static bool
+sweet_noexec(const char *name)
+{
+	static char list[128] = "bluetoothd,fairplayd.H2,vmd";
+	static int parsed;
+	if (!parsed) {
+		(void)PE_parse_boot_argn("sweetnoexec", list, sizeof(list));
+		parsed = 1;
+	}
+	size_t n = strlen(name);
+	for (const char *s = list; *s;) {
+		const char *e = s;
+		while (*e && *e != ',') {
+			e++;
+		}
+		if ((size_t)(e - s) == n && strncmp(s, name, n) == 0) {
+			return true;
+		}
+		s = *e ? e + 1 : e;
+	}
+	return false;
+}
+#endif
