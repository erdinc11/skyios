+/* SPDX-License-Identifier: MIT */
+#ifndef SWEET_ADRENO_CP_H
+#define SWEET_ADRENO_CP_H
+#include "sweet_adreno_dma.h"
+#define A618_CP_DMA_BYTES 0x18000u
+#define A618_CP_SQE_OFFSET 0x4000u
+#define A618_CP_RING_OFFSET 0xc000u
+#define A618_CP_FENCE_OFFSET 0x14000u
+#define A618_CP_SHADOW_OFFSET (A618_CP_FENCE_OFFSET + 0x100u)
+#define A618_CP_IOVA 0x70000000u
+#define A618_CP_RING_IOVA (A618_CP_IOVA + 0x8000u)
+#define A618_CP_FENCE_IOVA (A618_CP_IOVA + 0x10000u)
+#define A618_CP_SHADOW_IOVA (A618_CP_FENCE_IOVA + 0x100u)
+#define A618_CP_SNAPSHOT_COUNT 16
+struct a618_cp_snapshot {
+ const char *tag;
+ uint32_t irq, sqectl, instr_lo, instr_hi, rb_cntl, cp2gmu;
+};
+#ifdef __cplusplus
+extern "C" {
+#endif
+int sweet_adreno_cp_allocate(struct a618_dma_region *);
+int sweet_adreno_pas_allocate(struct a618_dma_region *);
+int a618_smmu_prepare_cp(const struct a618_smmu_io *,
+ const struct a618_dma_region *, struct a618_smmu_result *);
+struct a618_cp_result {
+ unsigned phase, submitted, completed;
+ uint32_t rptr, wptr, status, interrupt, hw_fault, fence, value;
+ uint32_t cp_interrupt;
+ uint32_t irq_after_power, irq_before_auth, irq_after_auth;
+ unsigned bootstrap_wait_us;
+ uint32_t initial_sqectl, initial_instr_lo, initial_instr_hi, initial_rb_cntl;
+ struct a618_cp_snapshot snapshot[A618_CP_SNAPSHOT_COUNT];
+ unsigned snapshots;
+ const char *first_fault;
+ unsigned sqe_started, secure_prepare_attempted;
+ int secure_prepare_error;
+ uint64_t initial_tsb_base;
+ uint32_t initial_tsb_size, initial_tsb_control;
+ unsigned aperture_phase;
+ int aperture_error;
+ int64_t aperture_status;
+ uint64_t aperture_response;
+ int poisoned;
+};
+/* Trusted kernel commands only. The caller verified SQE blob CRC, GPU stream
+ * mappings, GMU/HFI completion and live clocks/rails. Failure retains OOB and
+ * wired memory; no speculative reset/powerdown or retry. No userspace PM4. */
+int a618_cp_stage(const struct a618_dma_region *, const unsigned char *,
+ unsigned, void (*)(void *), void *);
+int a618_cp_start(const struct a618_io *, const struct a618_io *,
+ const struct a618_dma_region *, const unsigned char *, unsigned,
+ void (*)(void *), void *, int (*)(void *), void *, struct a618_cp_result *);
+struct a618_pas_result { unsigned phase; int64_t status; uint64_t response; };
+/* Optional SCM MP/CP aperture setup, fixed to the driver-owned CB0. */
+int a618_cp_configure_aperture(struct a618_pas_result *);
+/* Signed device ZAP only, live reserved range must match the device DT.
+ * Metadata lives in its own permanently retained, cache-inhibited host page.
+ * No security-register fallback if firmware authorization fails. */
+int a618_zap_authenticate(volatile uint32_t *, uint64_t,
+ const struct a618_dma_region *, const unsigned char *, unsigned,
+ const unsigned char *, unsigned, struct a618_pas_result *);
+int a618_gmu_dcvs(const struct a618_io *, unsigned index);
+int a618_cp_leave_secure(const struct a618_io *, const struct a618_io *,
+ const struct a618_dma_region *, void (*)(void *), void *, struct a618_cp_result *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_adreno_cp_smmu.c b/bsd/dev/sweet_adreno_cp_smmu.c
new file mode 100644
index 000000000..d4fc12121
--- /dev/null
+++ b/bsd/dev/sweet_adreno_cp_smmu.c
@@ -0,0 +1,156 @@
+/* SPDX-License-Identifier: MIT
+ * Original bounded SMMUv2 backend using the ARM architecture and public
+ * Linux/Qualcomm register protocols. See docs/adreno-port.md for source pins.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_cp.h"
+#define CP_CB 0x8000u
+#define ASID 0x62u
+/* FSR.Format[10:9] is read-only metadata, not a W1C fault. */
+#define FSR_FAULT 0xc00001feu
+static int
+put(const struct a618_io *io, uint32_t offset, uint32_t value,
+ uint32_t mask, struct a618_smmu_result *r)
+{
+ io->write(io->cookie, offset, value);
+ r->offset = offset; r->value = io->read(io->cookie, offset);
+ return r->value != 0xffffffffu && (r->value & mask) == (value & mask) ? 0 : EIO;
+}
+static int
+wait_clear(const struct a618_io *io, uint32_t offset, unsigned mask,
+ struct a618_smmu_result *r)
+{
+ for (unsigned i = 0; i < 500; ++i) {
+  r->offset = offset; r->value = io->read(io->cookie, offset);
+  if (r->value == 0xffffffffu) return EIO;
+  if (!(r->value & mask)) return 0;
+  io->delay_us(io->cookie, 1);
+ }
+ return ETIMEDOUT;
+}
+int
+a618_smmu_prepare_cp(const struct a618_smmu_io *ops,
+ const struct a618_dma_region *memory, struct a618_smmu_result *r)
+{
+ if (!ops || !memory || !r || !ops->registers.read ||
+     !ops->registers.write || !ops->registers.delay_us ||
+     !ops->read64 || !ops->write64 || !ops->barrier || !memory->cpu ||
+     !memory->uncached || memory->bytes != A618_CP_DMA_BYTES ||
+     (memory->physical & 0x3fff) || !memory->physical ||
+     memory->physical > (1ull << 36) - A618_CP_DMA_BYTES ||
+     ((uintptr_t)memory->cpu & 7)) return EINVAL;
+ const struct a618_io *io = &ops->registers;
+ *r = (struct a618_smmu_result){ .context = 0, .slot = 0xffffffffu };
+ /* Measured 0091 profile: 4 KiB register pages, 0x8000 CB base, five
+  * stream match slots and context banks, 36-bit PA. 16K PT granules are
+  * intentionally not used (Qualcomm advertises broken 16K support).
+  */
+ const uint32_t identity[] = {0x48016605, 0x20008005, 0x7511};
+ for (unsigned i = 0; i < 3; ++i) {
+  r->offset = 0x20 + 4 * i; r->value = io->read(io->cookie, r->offset);
+  if (r->value != identity[i]) return ENOTSUP;
+ }
+ /* Do not steal an active bank or matching stream, even if its firmware
+  * owner appears idle. CB1 and protected banks are left alone.
+  */
+ r->offset = CP_CB; r->value = io->read(io->cookie, CP_CB);
+ if (r->value == 0xffffffffu) return EIO;
+ if (r->value & 1) return EBUSY; /* M=0 is disabled; other reset bits may be UNKNOWN. */
+ for (unsigned i = 0; i < 5; ++i) {
+  r->offset = 0x800 + 4 * i;
+  uint32_t smr = r->value = io->read(io->cookie, r->offset);
+  if (smr == 0xffffffffu) return EIO;
+  if (!(smr & 0x80000000u)) {
+   if (r->slot == 0xffffffffu) r->slot = i;
+  } else if (((smr ^ 0u) & ~((smr >> 16) & 0x7fffu) & 0xffffu) == 0) {
+   r->slot = i; return EBUSY;
+  }
+ }
+ if (r->slot == 0xffffffffu) return ENOSPC;
+ r->control = io->read(io->cookie, 0);
+ if (r->control == 0xffffffffu) return EIO;
+ /* Three 4K tables inside one host page: L1[1] -> L2[384] ->
+  * L3[0..19] at 0x70000000. SQE pages are RO/executable; ring/fence
+  * pages RW/NX. Tables are inaccessible to the GPU. Normal NC/OSH.
+  */
+ volatile uint64_t *l1 = (volatile uint64_t *)memory->cpu;
+ volatile uint64_t *l2 = (volatile uint64_t *)(memory->cpu + 0x1000);
+ volatile uint64_t *l3 = (volatile uint64_t *)(memory->cpu + 0x2000);
+ for (unsigned i = 0; i < 512; ++i) l1[i] = l2[i] = l3[i] = 0;
+ l1[1] = (memory->physical + 0x1000) | 3;
+ l2[384] = (memory->physical + 0x2000) | 3;
+ for (unsigned i = 0; i < 20; ++i)
+  l3[i] = (memory->physical + A618_TABLE_BYTES + 0x1000 * i) |
+      (i < 8 ? 0 : (3ull << 53)) | (1u << 11) | (1u << 10) |
+      (2u << 8) | ((i < 8 ? 3u : 1u) << 6) | 3;
+ ops->barrier(io->cookie);
+ int error;
+ #define SET(o,v,m) do { error = put(io, (o), (v), (m), r); if (error) return error; } while (0)
+ SET(0x1800, 1, 1); /* GR1 CBA2R(1): AArch64. */
+ SET(0x1000, 0x1f300, 0x3f3ff); /* Stage1, stage2 bypass, weak upstream attributes. */
+ SET(CP_CB + 0x10, 0x38011, 0x38077); /* TCR2: SEP upstream, 36-bit output, AArch64 ASID. */
+ SET(CP_CB + 0x30, 0x00802020u, 0x00c0ffbfu); /* EPD1, OSH, NC walks, T0SZ=32; AArch64, no EAE. */
+ uint64_t ttbr = memory->physical | ((uint64_t)ASID << 48);
+ ops->write64(io->cookie, CP_CB + 0x20, ttbr);
+ r->offset = CP_CB + 0x20;
+ r->par = ops->read64(io->cookie, r->offset);
+ if ((r->par & 0xffff000ffffff000ull) != ttbr) return EIO;
+ ops->write64(io->cookie, CP_CB + 0x28, 0);
+ SET(CP_CB + 0x38, 0x44, 0xff); /* MAIR[0]: Normal NC. */
+ /* MAIR1 is unused: every data PTE references MAIR0[0]. */
+ /* Fault reporting enabled, IRQ/stalling disabled until an IRQ handler
+  * exists; HUPCF continues other transactions after an abort.
+  */
+ /* AFE/TRE are UNK/SBOP for long descriptors: write ones, do not
+  * compare their readback. Check M, E, fault controls, WXN and ASIDPNE.
+  */
+ SET(CP_CB, 0x1127, 0x17f1);
+ /* Block unmatched streams and enable this device. Preserve other controls;
+  * do not enable interrupt sources without handlers. No reset-all/TLBI-all.
+  */
+ SET(0, (r->control | 0x1c12u) & ~0xe025u, 0xfc37);
+ io->write(io->cookie, CP_CB + 0x610, ASID);
+ io->write(io->cookie, CP_CB + 0x7f0, 0);
+ error = wait_clear(io, CP_CB + 0x7f4, 1, r);
+ if (error) return error;
+ /* Hardware translation probes, not a software table walk: all twenty pages
+  * plus a guard fault must match before the stream is published.
+  */
+ for (unsigned i = 0; i <= 20; ++i) {
+  uint64_t va = (uint64_t)A618_CP_IOVA + i * 0x1000u;
+  ops->write64(io->cookie, CP_CB + 0x800, va);
+  error = wait_clear(io, CP_CB + 0x8f0, 1, r);
+  if (error) return error;
+  r->par = ops->read64(io->cookie, CP_CB + 0x50);
+  if (r->par == 0xffffffffffffffffull) return EIO;
+  if (i == 20) {
+   if (!(r->par & 1)) return EFAULT;
+  } else {
+   uint64_t expected = memory->physical + A618_TABLE_BYTES + i * 0x1000u;
+   if ((r->par & 1) || (r->par & 0x0000000ffffff000ull) != expected)
+    return EFAULT;
+   ++r->translated;
+  }
+ }
+ r->fault = io->read(io->cookie, CP_CB + 0x58);
+ if (r->fault == 0xffffffffu) return EIO;
+ if (r->fault & (1u << 30)) return EBUSY; /* Never resume an unknown stall. */
+ if (r->fault & FSR_FAULT) {
+  io->write(io->cookie, CP_CB + 0x58, r->fault & (FSR_FAULT & ~(1u << 30)));
+  uint32_t after = io->read(io->cookie, CP_CB + 0x58);
+  if (after == 0xffffffffu || (after & FSR_FAULT)) return EIO;
+ }
+ /* Only exact GPU stream 0, route first and VALID last. CP_CB/stream5
+  * remain owned by the running GMU. No user stream or bypass entry. */
+ SET(0xc00 + 4 * r->slot, 0, 0x030300ff);
+ SET(0x800 + 4 * r->slot, 0x80000000u, 0xffffffffu);
+ r->fault = io->read(io->cookie, CP_CB + 0x58);
+ #undef SET
+ return r->fault == 0xffffffffu || (r->fault & FSR_FAULT) ? EIO : 0;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_dma.h b/bsd/dev/sweet_adreno_dma.h
new file mode 100644
index 000000000..414871d1b
--- /dev/null
+++ b/bsd/dev/sweet_adreno_dma.h
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef SWEET_ADRENO_DMA_H
+#define SWEET_ADRENO_DMA_H
+#include "sweet_adreno.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+#define A618_DMA_BYTES 0x14000u
+#define A618_TABLE_BYTES 0x4000u
+#define A618_SHARED_IOVA 0x60000000u
+#define A618_HFI_IOVA 0x60004000u
+#define A618_DEBUG_IOVA 0x60008000u
+#define A618_LOG_IOVA 0x6000c000u
+struct a618_dma_region {
+ unsigned char *cpu;
+ uint64_t physical;
+ unsigned bytes;
+ unsigned uncached;
+};
+struct a618_smmu_io {
+ struct a618_io registers;
+ uint64_t (*read64)(void *, uint32_t);
+ void (*write64)(void *, uint32_t, uint64_t);
+ void (*barrier)(void *);
+};
+struct a618_smmu_result {
+ unsigned context, slot, translated;
+ uint32_t control, fault, offset, value;
+ uint64_t par;
+};
+/* Permanent wired allocation: retain on failure once hardware can reference it. */
+int sweet_adreno_dma_allocate(struct a618_dma_region *);
+/* Caller holds GMU reset, GX off, clocks/rails on. CB0 is never touched.
+ * Only the measured SMMU profile is accepted. No reset-all or bypass domain.
+ * Full DMA readiness requires all 16 translation checks and the guard fault.
+ */
+int a618_smmu_prepare(const struct a618_smmu_io *,
+ const struct a618_dma_region *, struct a618_smmu_result *);
+/* Legacy HFI v1, single host producer/consumer, uncached shared storage.
+ * barrier orders device-visible RAM. All caller messages are trusted kernel
+ * data, <=255 DWORDs. These APIs do not start firmware or touch MMIO.
+ */
+struct a618_hfi {
+ volatile uint32_t *table;
+ void (*barrier)(void *);
+ void *cookie;
+ unsigned sequence, poisoned, responses;
+ uint32_t last_request, last_response, firmware_error;
+};
+int a618_hfi_init(struct a618_hfi *, const struct a618_dma_region *,
+ void (*)(void *), void *);
+int a618_hfi_write(struct a618_hfi *, const uint32_t *, unsigned);
+int a618_hfi_read(struct a618_hfi *, unsigned, uint32_t *, unsigned, unsigned *);
+/* Single caller, polled legacy v1 RPC. A timeout/fault poisons the session:
+ * never reuse it or release DMA memory while firmware ownership is uncertain.
+ * payload_words is a required response length, not an unchecked copy size.
+ */
+int a618_hfi_call(struct a618_hfi *, const struct a618_io *, unsigned,
+ const uint32_t *, unsigned, uint32_t *, unsigned);
+int a618_hfi_bootstrap(struct a618_hfi *, const struct a618_io *,
+ uint32_t gpu_vote, uint32_t gmu_vote, uint32_t *firmware_version);
+/* Optional active GPU levels after the mandatory off entry, ascending. When
+ * empty the legacy single level (derived from gpu_vote) is sent. Index i in
+ * this table is HFI performance index i+1 for the legacy DCVS request. */
+#define A618_GPU_LEVELS_MAX 8u
+struct a618_gpu_level { uint32_t vote, khz; };
+extern struct a618_gpu_level a618_gpu_levels[A618_GPU_LEVELS_MAX];
+extern unsigned a618_gpu_level_count;
+struct a618_gmu_boot_result {
+ unsigned phase;
+ uint32_t offset, value, firmware_version;
+};
+/* SM7150/A618 cold boot only. Firmware must be staged, the shared SMMU
+ * mappings verified and all clocks/parent rails held before calling.
+ * PDC/PDC-sequence apertures are the SM7150 DT regions. No warm resume,
+ * CP/SQE init, GPU stream mapping, graphics service or rendering here.
+ */
+int a618_gmu_boot_legacy(const struct a618_io *, const struct a618_io *,
+ const struct a618_io *, struct a618_hfi *, uint32_t, uint32_t,
+ struct a618_gmu_boot_result *);
+/* Read command DB only; constructs raw ARC votes for the documented MIN_SVS
+ * 180 MHz GPU / 200 MHz GMU operating points. No ACTIVE rail write.
+ */
+int sweet_rpmh_adreno_votes(uint32_t *, uint32_t *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/bsd/dev/sweet_adreno_gmu.c b/bsd/dev/sweet_adreno_gmu.c
new file mode 100644
index 000000000..7951dc076
--- /dev/null
+++ b/bsd/dev/sweet_adreno_gmu.c
@@ -0,0 +1,186 @@
+/* SPDX-License-Identifier: MIT
+ * A618 cold-start implementation using the pinned SM7150 Linux register and
+ * firmware protocols. See docs/adreno-port.md for scope and source hashes.
+ * Single caller. No dynamic clock scaling, warm boot, IRQs or CP submission.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_dma.h"
+#define GMU_CM3_DTCM_START 0x7000u
+#define GMU_GENERAL_7 0x14730u
+#define GMU_CM3_BOOT_CONFIG 0x14004u
+#define GMU_HFI_QTBL_ADDR 0x14614u
+#define GMU_HFI_QTBL_INFO 0x14610u
+#define GMU_AHB_FENCE_RANGE_0 0x24c44u
+#define GMU_CM3_CFG 0x140b4u
+#define GMU_HFI_SFR_ADDR 0x14608u
+#define GPU_GMU_CX_GMU_PWR_COL_CP_MSG 0x14400u
+#define GPU_GMU_CX_GMU_PWR_COL_CP_RESP 0x14404u
+#define GMU_SYS_BUS_CONFIG 0x1303cu
+#define GMU_ICACHE_CONFIG 0x13000u
+#define GMU_DCACHE_CONFIG 0x13004u
+#define GMU_PWR_COL_INTER_FRAME_CTRL 0x14300u
+#define GMU_RPMH_CTRL 0x143a0u
+#define GMU_BOOT_SLUMBER_OPTION 0x8fe0u
+#define GMU_GX_VOTE_IDX 0x8fe4u
+#define GMU_MX_VOTE_IDX 0x8fe8u
+#define GMU_HOST2GMU_INTR_SET 0x14650u
+#define GMU_GMU2HOST_INTR_INFO 0x14648u
+#define GMU_GMU2HOST_INTR_CLR 0x14644u
+#define GMU_GMU2HOST_INTR_MASK 0x1464cu
+#define GMU_AO_HOST_INTERRUPT_MASK 0x24c18u
+#define GMU_GX_SPTPRAC_POWER_CONTROL 0x204u
+#define GMU_SPTPRAC_PWR_CLK_STATUS 0x14340u
+#define GMU_HFI_CTRL_INIT 0x14618u
+#define GMU_HFI_CTRL_STATUS 0x14600u
+
+static int
+valid_io(const struct a618_io *io)
+{
+ return io && io->read && io->write && io->delay_us;
+}
+static int
+poll(const struct a618_io *io, uint32_t offset, uint32_t mask,
+ uint32_t expected, unsigned timeout, struct a618_gmu_boot_result *result)
+{
+ result->offset = offset;
+ for (unsigned us = 0; us <= timeout; us += 10) {
+  result->value = io->read(io->cookie, offset);
+  if (result->value == 0xffffffffu) return EIO;
+  uint32_t faults = io->read(io->cookie, 0x24c14); /* AO status */
+  uint32_t interrupts = io->read(io->cookie, GMU_GMU2HOST_INTR_INFO);
+  if (faults == 0xffffffffu || interrupts == 0xffffffffu ||
+      (faults & 0x29) || (interrupts & (1u << 23))) return EIO;
+  if ((result->value & mask) == expected) return 0;
+  if (us != timeout) io->delay_us(io->cookie, 10);
+ }
+ return ETIMEDOUT;
+}
+static void
+rscc_write(const struct a618_io *gmu, unsigned reg, uint32_t value)
+{
+ gmu->write(gmu->cookie, 0x23000 + reg * 4, value);
+}
+static void
+pdc_program(const struct a618_io *gmu, const struct a618_io *pdc,
+ const struct a618_io *seq)
+{
+ /* SM7150 A618 constants, not the newer A650/A7xx sequence. */
+ static const uint32_t rsc[] = {
+  0xa7a506a0, 0xa1e6a6e7, 0xa2e081e1, 0xe9a982e2, 0x0020e8a8 };
+ static const uint32_t program[] = {
+  0xfebea1e1, 0xa5a4a3a2, 0x8382a6e0, 0xbce3e284, 0x002081fc };
+ rscc_write(gmu, 4, 1u << 24);
+ rscc_write(gmu, 0xb, 1);
+ for (unsigned i = 0; i < 3; ++i) {
+  rscc_write(gmu, 0xe + i * 2, i == 2 ? 0x80000000 : 0);
+  rscc_write(gmu, 0xd + i * 2, 0);
+ }
+ rscc_write(gmu, 0x100, 0);
+ rscc_write(gmu, 8, 0x4520);
+ rscc_write(gmu, 9, 0x4510);
+ rscc_write(gmu, 0xa, 0x4514);
+ for (unsigned i = 0; i < 5; ++i) {
+  rscc_write(gmu, 0x180 + i, rsc[i]);
+  seq->write(seq->cookie, i * 4, program[i]);
+ }
+ /* Third address is the target-specific A618 PDC resource from Linux.
+  * Do not label it xo.lvl without command-DB identity evidence. */
+ static const uint32_t address[] = {0x30010, 0x30000, 0x30090};
+ static const uint32_t sleep[] = {1, 0, 0}, wake[] = {2, 2, 3};
+ for (unsigned bank = 0; bank < 2; ++bank) {
+  unsigned base = bank ? 0x15d6 : 0x1572; /* TCS3 / TCS1 DWORD offsets */
+  pdc->write(pdc->cookie, (base + 1) * 4, 7);
+  pdc->write(pdc->cookie, (base + 2) * 4, 0);
+  pdc->write(pdc->cookie, base * 4, 0);
+  for (unsigned i = 0; i < 3; ++i) {
+   unsigned command = base + 3 + 4 * i;
+   pdc->write(pdc->cookie, command * 4, 0x10108);
+   pdc->write(pdc->cookie, (command + 1) * 4, address[i]);
+   pdc->write(pdc->cookie, (command + 2) * 4, bank ? wake[i] : sleep[i]);
+  }
+ }
+ pdc->write(pdc->cookie, 0x1148 * 4, 0);
+ pdc->write(pdc->cookie, 0x1140 * 4, 0x80000001);
+}
+int
+a618_gmu_boot_legacy(const struct a618_io *gmu, const struct a618_io *pdc,
+ const struct a618_io *seq, struct a618_hfi *hfi, uint32_t gpu_vote,
+ uint32_t gmu_vote, struct a618_gmu_boot_result *result)
+{
+ if (!valid_io(gmu) || !valid_io(pdc) || !valid_io(seq) || !hfi ||
+     !hfi->table || !hfi->barrier || hfi->poisoned || !result ||
+     !(gpu_vote >> 16) || !(gmu_vote >> 16)) return EINVAL;
+ result->phase = result->offset = result->value = result->firmware_version = 0;
+ /* Never reload a running M3 or pretend a warm boot is cold. The caller
+  * has already validated every SMMU page and the unmapped guard. */
+ if (gmu->read(gmu->cookie, A618_GMU_SYSRESET) != 1) return EBUSY;
+ uint32_t version = gmu->read(gmu->cookie, GMU_CM3_DTCM_START + 0xff8 * 4);
+ if (version == 0xffffffffu) return EIO;
+ /* Polled faults only; no unhandled GMU interrupts reach the host GIC. */
+ gmu->write(gmu->cookie, GMU_GMU2HOST_INTR_MASK, 0xffffffffu);
+ gmu->write(gmu->cookie, GMU_AO_HOST_INTERRUPT_MASK, 0xffffffffu);
+ gmu->write(gmu->cookie, GMU_GMU2HOST_INTR_CLR, 0xffffffffu);
+ gmu->write(gmu->cookie, 0x24c10, 0xffffffffu); /* AO status W1C */
+ /* A reset M3 does not prove the independent RSC sequencer is idle. */
+ if (gmu->read(gmu->cookie, 0x23000 + 0x101 * 4) != 0) return EBUSY;
+ pdc_program(gmu, pdc, seq);
+ gmu->write(gmu->cookie, GMU_GENERAL_7, 1);
+ gmu->write(gmu->cookie, A618_GMU_FW_INIT_RESULT, 0);
+ gmu->write(gmu->cookie, GMU_CM3_BOOT_CONFIG, 2);
+ gmu->write(gmu->cookie, GMU_HFI_QTBL_ADDR, A618_HFI_IOVA);
+ gmu->write(gmu->cookie, GMU_HFI_QTBL_INFO, 1);
+ gmu->write(gmu->cookie, GMU_AHB_FENCE_RANGE_0, (1u << 31) | (0xau << 18) | 0xa0);
+ gmu->write(gmu->cookie, GMU_CM3_CFG, 0x4052);
+ /* 0x06010800 chipid in the GMU's packed minor/patch layout. */
+ gmu->write(gmu->cookie, GMU_HFI_SFR_ADDR, 0x06018000);
+ gmu->write(gmu->cookie, GPU_GMU_CX_GMU_PWR_COL_CP_MSG, A618_LOG_IOVA | 3);
+ gmu->write(gmu->cookie, GMU_SYS_BUS_CONFIG, 1);
+ gmu->write(gmu->cookie, GMU_ICACHE_CONFIG, 1);
+ gmu->write(gmu->cookie, GMU_DCACHE_CONFIG, 1);
+ /* ACTIVE idle policy: no automatic GX collapse until recovery exists. */
+ gmu->write(gmu->cookie, GMU_PWR_COL_INTER_FRAME_CTRL, 0x09c40400);
+ uint32_t rpmh = gmu->read(gmu->cookie, GMU_RPMH_CTRL);
+ if (rpmh == 0xffffffffu) return EIO;
+ gmu->write(gmu->cookie, GMU_RPMH_CTRL, rpmh | 0xf11);
+ gmu->write(gmu->cookie, GPU_GMU_CX_GMU_PWR_COL_CP_RESP, 0);
+ hfi->barrier(hfi->cookie);
+ result->phase = 1;
+ gmu->write(gmu->cookie, A618_GMU_SYSRESET, 0);
+ int error = poll(gmu, A618_GMU_FW_INIT_RESULT,
+     version <= 0x20010004 ? 0xffffffffu : 0x1ff,
+     version <= 0x20010004 ? 0xbabeface : 0x100, 10000, result);
+ if (error) goto failed;
+ result->phase = 2;
+ gmu->write(gmu->cookie, GMU_BOOT_SLUMBER_OPTION, 0);
+ gmu->write(gmu->cookie, GMU_GX_VOTE_IDX, gpu_vote & 255);
+ gmu->write(gmu->cookie, GMU_MX_VOTE_IDX, (gpu_vote >> 8) & 255);
+ gmu->write(gmu->cookie, GMU_HOST2GMU_INTR_SET, 1u << 22);
+ error = poll(gmu, GMU_GMU2HOST_INTR_INFO, 1u << 30, 1u << 30, 10000, result);
+ gmu->write(gmu->cookie, GMU_GMU2HOST_INTR_CLR, 1u << 30);
+ if (error) goto failed;
+ result->phase = 3;
+ gmu->write(gmu->cookie, GMU_GX_SPTPRAC_POWER_CONTROL, 0x778000);
+ error = poll(gmu, GMU_SPTPRAC_PWR_CLK_STATUS, 0x38, 0x28, 100, result);
+ if (error) goto failed;
+ result->phase = 4;
+ gmu->write(gmu->cookie, GMU_HFI_CTRL_INIT, 1);
+ error = poll(gmu, GMU_HFI_CTRL_STATUS, 1, 1, 10000, result);
+ if (error) goto failed;
+ result->phase = 5;
+ error = a618_hfi_bootstrap(hfi, gmu, gpu_vote, gmu_vote, &result->firmware_version);
+ if (error) goto failed;
+ result->phase = 6; /* GMU/HFI ready; this does not imply a working GPU CP. */
+ return 0;
+failed:
+ /* Do not reset/power down behind an in-flight RPMh transaction or free
+  * its DMA storage. Preserve the failure registers and poison the session.
+  * Controlled shutdown/recovery is still required before any retry. */
+ hfi->poisoned = 1;
+ return error;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_hfi.c b/bsd/dev/sweet_adreno_hfi.c
new file mode 100644
index 000000000..ad2032019
--- /dev/null
+++ b/bsd/dev/sweet_adreno_hfi.c
@@ -0,0 +1,234 @@
+/* SPDX-License-Identifier: MIT
+ * Legacy GMU HFI v1 wire format, original bounded host transport.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#include <sys/systm.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_dma.h"
+#define QUEUE_WORDS 1024u
+#define HEADER_WORDS 12u
+static volatile uint32_t *
+queue_header(struct a618_hfi *hfi, unsigned queue)
+{
+ return hfi->table + 6 + queue * HEADER_WORDS;
+}
+static int
+indices(struct a618_hfi *hfi, unsigned queue, unsigned *read, unsigned *write)
+{
+ volatile uint32_t *header = queue_header(hfi, queue);
+ hfi->barrier(hfi->cookie);
+ if (header[0] != 1 || header[3] != QUEUE_WORDS) return EIO;
+ *read = header[10]; *write = header[11];
+ if (*read >= QUEUE_WORDS || *write >= QUEUE_WORDS) return EIO;
+ hfi->barrier(hfi->cookie);
+ return 0;
+}
+int
+a618_hfi_init(struct a618_hfi *hfi, const struct a618_dma_region *memory,
+ void (*barrier)(void *), void *cookie)
+{
+ if (!hfi || !memory || !memory->cpu || !memory->uncached || !barrier ||
+     memory->bytes != A618_DMA_BYTES || ((uintptr_t)memory->cpu & 3))
+  return EINVAL;
+ hfi->table = (volatile uint32_t *)(memory->cpu + A618_TABLE_BYTES +
+     (A618_HFI_IOVA - A618_SHARED_IOVA));
+ hfi->barrier = barrier; hfi->cookie = cookie;
+ hfi->sequence = hfi->poisoned = hfi->responses = 0;
+ hfi->last_request = hfi->last_response = hfi->firmware_error = 0;
+ for (unsigned i = 0; i < 4096; ++i) hfi->table[i] = 0;
+ hfi->table[0] = 0;
+ hfi->table[1] = 24 + 3 * 48; /* size in bytes; offsets below in DWORDs */
+ hfi->table[2] = 6; hfi->table[3] = 12;
+ hfi->table[4] = hfi->table[5] = 3;
+ const unsigned id[] = {0, 4, 5};
+ for (unsigned q = 0; q < 3; ++q) {
+  volatile uint32_t *header = queue_header(hfi, q);
+  header[0] = 1;
+  header[1] = A618_HFI_IOVA + (q + 1) * 4096;
+  header[2] = (10u << 8) | id[q];
+  header[3] = QUEUE_WORDS;
+  header[6] = header[7] = header[8] = 1;
+ }
+ barrier(cookie);
+ return 0;
+}
+int
+a618_hfi_write(struct a618_hfi *hfi, const uint32_t *words, unsigned count)
+{
+ if (!hfi || !hfi->table || !hfi->barrier || !words || !count || count > 255 ||
+     ((words[0] >> 8) & 255) != count || (words[0] & 0xf0000u)) return EINVAL;
+ unsigned read, write;
+ int error = indices(hfi, 0, &read, &write);
+ if (error) return error;
+ unsigned free_words = (read + QUEUE_WORDS - write - 1) % QUEUE_WORDS;
+ if (count > free_words) return ENOSPC;
+ volatile uint32_t *data = hfi->table + QUEUE_WORDS;
+ for (unsigned i = 0; i < count; ++i) data[(write + i) % QUEUE_WORDS] = words[i];
+ hfi->barrier(hfi->cookie);
+ queue_header(hfi, 0)[11] = (write + count) % QUEUE_WORDS;
+ hfi->barrier(hfi->cookie);
+ return 0;
+}
+int
+a618_hfi_read(struct a618_hfi *hfi, unsigned queue, uint32_t *words,
+ unsigned capacity, unsigned *count)
+{
+ if (!count) return EINVAL;
+ *count = 0;
+ if (!hfi || !hfi->table || !hfi->barrier || !words || !capacity ||
+     queue < 1 || queue > 2) return EINVAL;
+ unsigned read, write;
+ int error = indices(hfi, queue, &read, &write);
+ if (error) return error;
+ unsigned available = (write + QUEUE_WORDS - read) % QUEUE_WORDS;
+ if (!available) {
+  queue_header(hfi, queue)[8] = 1;
+  hfi->barrier(hfi->cookie);
+  return EAGAIN;
+ }
+ volatile uint32_t *data = hfi->table + (queue + 1) * QUEUE_WORDS;
+ unsigned size = (data[read] >> 8) & 255;
+ if (!size) return EIO;
+ if (size > available) return EAGAIN;
+ if (size > capacity) return EMSGSIZE;
+ for (unsigned i = 0; i < size; ++i) words[i] = data[(read + i) % QUEUE_WORDS];
+ hfi->barrier(hfi->cookie);
+ queue_header(hfi, queue)[10] = (read + size) % QUEUE_WORDS;
+ hfi->barrier(hfi->cookie);
+ *count = size;
+ return 0;
+}
+
+/* GMU-relative byte offsets from the A6xx register XML. Keep host IRQs
+ * masked: this backend polls, and no XNU interrupt handler is installed. */
+#define HFI_INTR_INFO 0x14648u
+#define HFI_INTR_CLEAR 0x14644u
+#define HFI_DOORBELL 0x14650u
+#define HFI_CM3_FAULT (1u << 23)
+int
+a618_hfi_call(struct a618_hfi *hfi, const struct a618_io *io, unsigned id,
+ const uint32_t *body, unsigned body_words, uint32_t *payload,
+ unsigned payload_words)
+{
+ if (!hfi || !hfi->table || !hfi->barrier || !io || !io->read ||
+     !io->write || !io->delay_us || id > 255 || body_words > 254 ||
+     (body_words && !body) || payload_words > 252 ||
+     (payload_words && !payload)) return EINVAL;
+ if (hfi->poisoned) return EIO;
+ uint32_t message[255];
+ hfi->sequence = (hfi->sequence + 1) % 0xfffu;
+ uint32_t sent = (hfi->sequence << 20) | ((body_words + 1) << 8) | id;
+ message[0] = sent;
+ hfi->last_request = sent;
+ for (unsigned i = 0; i < body_words; ++i) message[i + 1] = body[i];
+ int error = a618_hfi_write(hfi, message, body_words + 1);
+ if (error) return error; /* Nothing published on a rejected append. */
+ io->write(io->cookie, HFI_DOORBELL, 1);
+ for (unsigned elapsed = 0; elapsed < 1000000; elapsed += 100) {
+  uint32_t interrupt = io->read(io->cookie, HFI_INTR_INFO);
+  if (interrupt == 0xffffffffu || (interrupt & HFI_CM3_FAULT)) {
+   error = EIO; goto failed;
+  }
+  /* W1C before reading: a concurrent firmware append remains visible via
+   * the queue indices, including when no fresh interrupt edge is seen. */
+  if (interrupt & 1) io->write(io->cookie, HFI_INTR_CLEAR, 1);
+  unsigned words = 0;
+  error = a618_hfi_read(hfi, 1, message, 255, &words);
+  if (error != EAGAIN && error) goto failed;
+  if (!error) {
+   ++hfi->responses;
+   unsigned received_id = message[0] & 255;
+   unsigned type = (message[0] >> 16) & 15;
+   if (received_id == 100) { error = EIO; goto failed; }
+   if (received_id != 126 || type != 2 || words < 3) {
+    error = EPROTO; goto failed;
+   }
+   /* Match command ID and transaction sequence as in the Linux transport;
+    * request length bits are not used to size the ACK payload. The actual
+    * response length/type were validated above. Stale ACKs cannot extend
+    * the fixed one-second deadline. */
+   hfi->last_response = message[1];
+   if ((message[1] & 0xfff000ffu) == (sent & 0xfff000ffu)) {
+    hfi->firmware_error = message[2];
+    if (message[2]) { error = EIO; goto failed; }
+    if (words < 3 + payload_words) { error = EPROTO; goto failed; }
+    for (unsigned i = 0; i < payload_words; ++i) payload[i] = message[3 + i];
+    return 0;
+   }
+  }
+  /* Drain a single debug packet per iteration so logs cannot deadlock FW.
+   * All queue indices and packet sizes pass the same validation. */
+  error = a618_hfi_read(hfi, 2, message, 255, &words);
+  if (error != EAGAIN && error) goto failed;
+  if (!error && (message[0] & 255) == 100) { error = EIO; goto failed; }
+  io->delay_us(io->cookie, 100);
+ }
+ error = ETIMEDOUT;
+failed:
+ hfi->poisoned = 1;
+ return error;
+}
+
+struct a618_gpu_level a618_gpu_levels[A618_GPU_LEVELS_MAX];
+unsigned a618_gpu_level_count;
+
+int
+a618_hfi_bootstrap(struct a618_hfi *hfi, const struct a618_io *io,
+ uint32_t gpu_vote, uint32_t gmu_vote, uint32_t *firmware_version)
+{
+ if (!firmware_version || !(gpu_vote >> 16) || !(gmu_vote >> 16)) return EINVAL;
+ *firmware_version = 0;
+ uint32_t init[] = {0, A618_DEBUG_IOVA, 0x4000, 1}; /* cold boot = 1 */
+ int error = a618_hfi_call(hfi, io, 0, init, 4, 0, 0);
+ if (error) return error;
+ uint32_t supported = (1u << 28) | (1u << 19) | (1u << 17); /* HFI 1.10 */
+ error = a618_hfi_call(hfi, io, 1, &supported, 1, firmware_version, 1);
+ if (error) return error;
+ /* The pinned SM7150 DT permits 267MHz at raw LOW_SVS=64 for all
+  * speed bins (opp-supported-hw=0x1f). The live command DB already rounds
+  * our MIN_SVS=48 request up to raw64; use that existing voltage corner.
+  * Keep 180MHz if a different command DB supplies a lower corner. Never
+  * infer a measured clock from firmware accepting this table. Higher
+  * frequency/voltage corners and dynamic scaling remain absent. */
+ const uint32_t gpu_khz = (gpu_vote >> 16) >= 64u ? 267000u : 180000u;
+#if defined(KERNEL)
+ printf("SWEET ADRENO: HFI active OPP configured=%u kHz raw_corner=%u; clock not measured\n",
+     gpu_khz, gpu_vote >> 16);
+#endif
+ uint32_t perf[42] = {0}; /* body of the fixed 43-DWORD v1 message */
+ /* Linux a6xx_hfi_msg_perf_table_v1: counts, 16 gx {vote,kHz}, 4 cx. */
+ perf[0] = perf[1] = 2;
+ perf[4] = gpu_vote; perf[5] = gpu_khz;
+ if (a618_gpu_level_count && a618_gpu_level_count <= A618_GPU_LEVELS_MAX) {
+  perf[0] = 1 + a618_gpu_level_count;
+  for (unsigned i = 0; i < a618_gpu_level_count; ++i) {
+   perf[4 + 2 * i] = a618_gpu_levels[i].vote;
+   perf[5 + 2 * i] = a618_gpu_levels[i].khz;
+#if defined(KERNEL)
+   printf("SWEET ADRENO: HFI perf index %u vote=%#x %u kHz\n", i + 1,
+       a618_gpu_levels[i].vote, a618_gpu_levels[i].khz);
+#endif
+  }
+ }
+ perf[36] = gmu_vote; perf[37] = 200000;
+ error = a618_hfi_call(hfi, io, 4, perf, 42, 0, 0);
+ if (error) return error;
+ /* A618 uses a single DDR off entry: GMU does not scale its bus. Exact
+  * target-specific wire constants from Linux a618_build_bw_table().
+  * Host interconnect bandwidth remains a separate prerequisite. */
+ uint32_t bw[159] = {0}; /* body of the fixed 160-DWORD message */
+ bw[0] = 1; bw[1] = 1; bw[2] = 3; bw[3] = bw[4] = 1;
+ bw[5] = 0x5007c;
+ bw[11] = 0x40000000; bw[17] = 0x60000001;
+ bw[23] = 0x50000; bw[24] = 0x5003c; bw[25] = 0x5000c;
+ bw[31] = bw[32] = bw[33] = 0x40000000;
+ error = a618_hfi_call(hfi, io, 3, bw, 159, 0, 0);
+ if (error) return error;
+ /* Wire message 5 ends legacy initialization (named TEST in Linux). */
+ return a618_hfi_call(hfi, io, 5, 0, 0, 0, 0);
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_pas.c b/bsd/dev/sweet_adreno_pas.c
new file mode 100644
index 000000000..27d080f34
--- /dev/null
+++ b/bsd/dev/sweet_adreno_pas.c
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: MIT
+ * Restricted SM7150 signed-ZAP PAS transport (public Qualcomm SCM protocol).
+ * No generic SCM entry point, memory-assignment or security-register bypass.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include "sweet_adreno_cp.h"
+static uint32_t
+le32(const unsigned char *p)
+{
+ return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+     ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+static int
+scm(unsigned service, unsigned command, uint64_t arguments,
+ uint64_t arg0, uint64_t arg1, uint64_t arg2, uint64_t arg3,
+ struct a618_pas_result *result)
+{
+ uint64_t function = 0x42000000u | (service << 8) | command;
+ for (unsigned busy = 0; busy < 5; ++busy) {
+  uint64_t resume = function, quirk_a6 = 0;
+  for (unsigned interrupted = 0; interrupted < 32; ++interrupted) {
+   register uint64_t x0 __asm__("x0") = resume;
+   register uint64_t x1 __asm__("x1") = arguments;
+   register uint64_t x2 __asm__("x2") = arg0;
+   register uint64_t x3 __asm__("x3") = arg1;
+   register uint64_t x4 __asm__("x4") = arg2;
+   register uint64_t x5 __asm__("x5") = arg3;
+   register uint64_t x6 __asm__("x6") = quirk_a6;
+   register uint64_t x7 __asm__("x7") = 0;
+   __asm__ volatile("dsb sy\n\tsmc #0\n\tdsb sy" :
+       "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3),
+       "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7) : :
+       "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+       "x16", "x17", "memory", "cc");
+   result->status = (int64_t)x0;
+   result->response = x1;
+   if (x0 == 1) { resume = 1; quirk_a6 = x6; continue; }
+   if ((int64_t)x0 == -12) break; /* bounded busy retry */
+   if (x0) return x0 == (uint64_t)-1 ? ENOTSUP : EIO;
+   return 0;
+  }
+  if (result->status != -12) return ETIMEDOUT;
+  if (busy != 4) delay(30000);
+ }
+ return EBUSY;
+}
+/* Public SCM aperture protocol used by the pinned Linux Adreno driver.
+ * Availability is optional; an advertised call that fails is fatal. The four
+ * arguments fit x2..x5 directly, so no shared extended-argument buffer exists.
+ * This entry cannot select another context or issue arbitrary SCM commands. */
+int
+a618_cp_configure_aperture(struct a618_pas_result *result)
+{
+ if (!result) return EINVAL;
+ *result = (struct a618_pas_result){ .phase = 1 };
+ int error = scm(6, 1, 1, 0x02000c1b, 0, 0, 0, result);
+ /* Linux treats a failed availability query as unavailable. It has no
+  * configuration side effects; retain raw status for the boot log. */
+ if (error) return 0;
+ if (!result->response) return 0; /* optional MP command unavailable */
+ result->phase = 2;
+ error = scm(0x0c, 0x1b, 4, 0xffff0000, 0xffffffffu,
+     0xffffffffu, 0xffffffffu, result);
+ if (error) return error;
+ result->phase = 3;
+ return 0;
+}
+int
+a618_zap_authenticate(volatile uint32_t *reserved, uint64_t physical,
+ const struct a618_dma_region *metadata, const unsigned char *mdt,
+ unsigned mdt_bytes, const unsigned char *code, unsigned code_bytes,
+ struct a618_pas_result *result)
+{
+ if (!result) return EINVAL;
+ *result = (struct a618_pas_result){0};
+ if (!reserved || physical != 0x97f15000ull || !metadata || !metadata->cpu ||
+     metadata->bytes != 0x4000 || !metadata->uncached ||
+     !metadata->physical || (metadata->physical & 0x3fff) ||
+     metadata->physical >= (1ull << 36) || !mdt || !code ||
+     mdt_bytes != 0x1acc || code_bytes != 0x7c0 ||
+     le32(mdt) != 0x464c457f || mdt[4] != 1 || mdt[5] != 1 ||
+     le32(mdt + 28) != 52 || (le32(mdt + 44) & 0xffff) != 3 || le32(mdt + 40) != 0x00200034 ||
+     le32(mdt + 52 + 2 * 32) != 1 ||
+     le32(mdt + 52 + 2 * 32 + 12) != 0x5000 ||
+     le32(mdt + 52 + 2 * 32 + 16) != code_bytes ||
+     le32(mdt + 52 + 2 * 32 + 20) != code_bytes ||
+     le32(mdt + 52 + 2 * 32 + 24) != 0x08000007) return EINVAL;
+ result->phase = 1;
+ const unsigned commands[] = {1, 2, 5};
+ for (unsigned i = 0; i < 3; ++i) {
+  int error = scm(6, 1, 1, 0x02000200u | commands[i], 0, 0, 0, result);
+  if (error) return error;
+  if (!result->response) return ENOTSUP;
+ }
+ volatile uint32_t *words = (volatile uint32_t *)metadata->cpu;
+ for (unsigned i = 0; i < mdt_bytes / 4; ++i) words[i] = le32(mdt + i * 4);
+ __asm__ volatile("dsb sy" ::: "memory");
+ result->phase = 2;
+ int error = scm(2, 1, 0x82, 13, metadata->physical, 0, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ /* TZ may now protect metadata. Retain its separate page and do not read,
+  * modify, free or reuse it, including on errors below. */
+ result->phase = 3;
+ error = scm(2, 2, 3, 13, physical, 0x1000, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ for (unsigned i = 0; i < 0x1000 / 4; ++i) reserved[i] = 0;
+ for (unsigned i = 0; i < code_bytes / 4; ++i) reserved[i] = le32(code + i * 4);
+ __asm__ volatile("dsb sy" ::: "memory");
+ result->phase = 4;
+ error = scm(2, 5, 1, 13, 0, 0, 0, result);
+ if (error || result->response) return error ? error : EACCES;
+ result->phase = 5;
+ return 0;
+}
+#endif
diff --git a/bsd/dev/sweet_adreno_smmu.c b/bsd/dev/sweet_adreno_smmu.c
new file mode 100644
index 000000000..e27c05c9d
--- /dev/null
+++ b/bsd/dev/sweet_adreno_smmu.c
@@ -0,0 +1,157 @@
+/* SPDX-License-Identifier: MIT
+ * Original bounded SMMUv2 backend using the ARM architecture and public
+ * Linux/Qualcomm register protocols. See docs/adreno-port.md for source pins.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#if defined(KERNEL)
+#include <sys/errno.h>
+#else
+#include <errno.h>
+#endif
+#include "sweet_adreno_dma.h"
+#define CB1 0x9000u
+#define ASID 0x61u
+/* FSR.Format[10:9] is read-only metadata, not a W1C fault. */
+#define FSR_FAULT 0xc00001feu
+static int
+put(const struct a618_io *io, uint32_t offset, uint32_t value,
+ uint32_t mask, struct a618_smmu_result *r)
+{
+ io->write(io->cookie, offset, value);
+ r->offset = offset; r->value = io->read(io->cookie, offset);
+ return r->value != 0xffffffffu && (r->value & mask) == (value & mask) ? 0 : EIO;
+}
+static int
+wait_clear(const struct a618_io *io, uint32_t offset, unsigned mask,
+ struct a618_smmu_result *r)
+{
+ for (unsigned i = 0; i < 500; ++i) {
+  r->offset = offset; r->value = io->read(io->cookie, offset);
+  if (r->value == 0xffffffffu) return EIO;
+  if (!(r->value & mask)) return 0;
+  io->delay_us(io->cookie, 1);
+ }
+ return ETIMEDOUT;
+}
+int
+a618_smmu_prepare(const struct a618_smmu_io *ops,
+ const struct a618_dma_region *memory, struct a618_smmu_result *r)
+{
+ if (!ops || !memory || !r || !ops->registers.read ||
+     !ops->registers.write || !ops->registers.delay_us ||
+     !ops->read64 || !ops->write64 || !ops->barrier || !memory->cpu ||
+     !memory->uncached || memory->bytes != A618_DMA_BYTES ||
+     (memory->physical & 0x3fff) || !memory->physical ||
+     memory->physical > (1ull << 36) - A618_DMA_BYTES ||
+     ((uintptr_t)memory->cpu & 7)) return EINVAL;
+ const struct a618_io *io = &ops->registers;
+ *r = (struct a618_smmu_result){ .context = 1, .slot = 0xffffffffu };
+ /* Measured 0091 profile: 4 KiB register pages, 0x8000 CB base, five
+  * stream match slots and context banks, 36-bit PA. 16K PT granules are
+  * intentionally not used (Qualcomm advertises broken 16K support).
+  */
+ const uint32_t identity[] = {0x48016605, 0x20008005, 0x7511};
+ for (unsigned i = 0; i < 3; ++i) {
+  r->offset = 0x20 + 4 * i; r->value = io->read(io->cookie, r->offset);
+  if (r->value != identity[i]) return ENOTSUP;
+ }
+ /* Do not steal an active bank or matching stream, even if its firmware
+  * owner appears idle. CB0 and all protected banks are left alone.
+  */
+ r->offset = CB1; r->value = io->read(io->cookie, CB1);
+ if (r->value == 0xffffffffu) return EIO;
+ if (r->value & 1) return EBUSY; /* M=0 is disabled; other reset bits may be UNKNOWN. */
+ for (unsigned i = 0; i < 5; ++i) {
+  r->offset = 0x800 + 4 * i;
+  uint32_t smr = r->value = io->read(io->cookie, r->offset);
+  if (smr == 0xffffffffu) return EIO;
+  if (!(smr & 0x80000000u)) {
+   if (r->slot == 0xffffffffu) r->slot = i;
+  } else if (((smr ^ 5u) & ~((smr >> 16) & 0x7fffu) & 0xffffu) == 0) {
+   r->slot = i; return EBUSY;
+  }
+ }
+ if (r->slot == 0xffffffffu) return ENOSPC;
+ r->control = io->read(io->cookie, 0);
+ if (r->control == 0xffffffffu) return EIO;
+ /* Three 4K tables inside a 16K host page; no mapping of the table arena.
+  * L1[1] -> L2[256] -> L3[0..15]: shared 64K at 0x60000000.
+  * All other entries fault. Both privileged/unprivileged data R/W, NX,
+  * Normal NC and outer shareable match the uncached CPU mapping.
+  */
+ volatile uint64_t *l1 = (volatile uint64_t *)memory->cpu;
+ volatile uint64_t *l2 = (volatile uint64_t *)(memory->cpu + 0x1000);
+ volatile uint64_t *l3 = (volatile uint64_t *)(memory->cpu + 0x2000);
+ for (unsigned i = 0; i < 512; ++i) l1[i] = l2[i] = l3[i] = 0;
+ l1[1] = (memory->physical + 0x1000) | 3;
+ l2[256] = (memory->physical + 0x2000) | 3;
+ for (unsigned i = 0; i < 16; ++i)
+  l3[i] = (memory->physical + A618_TABLE_BYTES + 0x1000 * i) |
+      (3ull << 53) | (1u << 11) | (1u << 10) | (2u << 8) | (1u << 6) | 3;
+ ops->barrier(io->cookie);
+ int error;
+ #define SET(o,v,m) do { error = put(io, (o), (v), (m), r); if (error) return error; } while (0)
+ SET(0x1804, 1, 1); /* GR1 CBA2R(1): AArch64. */
+ SET(0x1004, 0x1f300, 0x3f3ff); /* Stage1, stage2 bypass, weak upstream attributes. */
+ SET(CB1 + 0x10, 0x38011, 0x38077); /* TCR2: SEP upstream, 36-bit output, AArch64 ASID. */
+ SET(CB1 + 0x30, 0x00802020u, 0x00c0ffbfu); /* EPD1, OSH, NC walks, T0SZ=32; AArch64, no EAE. */
+ uint64_t ttbr = memory->physical | ((uint64_t)ASID << 48);
+ ops->write64(io->cookie, CB1 + 0x20, ttbr);
+ r->offset = CB1 + 0x20;
+ r->par = ops->read64(io->cookie, r->offset);
+ if ((r->par & 0xffff000ffffff000ull) != ttbr) return EIO;
+ ops->write64(io->cookie, CB1 + 0x28, 0);
+ SET(CB1 + 0x38, 0x44, 0xff); /* MAIR[0]: Normal NC. */
+ /* MAIR1 is unused: every data PTE references MAIR0[0]. */
+ /* Fault reporting enabled, IRQ/stalling disabled until an IRQ handler
+  * exists; HUPCF continues other transactions after an abort.
+  */
+ /* AFE/TRE are UNK/SBOP for long descriptors: write ones, do not
+  * compare their readback. Check M, E, fault controls, WXN and ASIDPNE.
+  */
+ SET(CB1, 0x1127, 0x17f1);
+ /* Block unmatched streams and enable this device. Preserve other controls;
+  * do not enable interrupt sources without handlers. No reset-all/TLBI-all.
+  */
+ SET(0, (r->control | 0x1c12u) & ~0xe025u, 0xfc37);
+ io->write(io->cookie, CB1 + 0x610, ASID);
+ io->write(io->cookie, CB1 + 0x7f0, 0);
+ error = wait_clear(io, CB1 + 0x7f4, 1, r);
+ if (error) return error;
+ /* Hardware translation probes, not a software table walk: every shared
+  * page plus a guard fault must match before the stream is published.
+  */
+ for (unsigned i = 0; i <= 16; ++i) {
+  uint64_t va = (uint64_t)A618_SHARED_IOVA + i * 0x1000u;
+  ops->write64(io->cookie, CB1 + 0x800, va);
+  error = wait_clear(io, CB1 + 0x8f0, 1, r);
+  if (error) return error;
+  r->par = ops->read64(io->cookie, CB1 + 0x50);
+  if (r->par == 0xffffffffffffffffull) return EIO;
+  if (i == 16) {
+   if (!(r->par & 1)) return EFAULT;
+  } else {
+   uint64_t expected = memory->physical + A618_TABLE_BYTES + i * 0x1000u;
+   if ((r->par & 1) || (r->par & 0x0000000ffffff000ull) != expected)
+    return EFAULT;
+   ++r->translated;
+  }
+ }
+ r->fault = io->read(io->cookie, CB1 + 0x58);
+ if (r->fault == 0xffffffffu) return EIO;
+ if (r->fault & (1u << 30)) return EBUSY; /* Never resume an unknown stall. */
+ if (r->fault & FSR_FAULT) {
+  io->write(io->cookie, CB1 + 0x58, r->fault & (FSR_FAULT & ~(1u << 30)));
+  uint32_t after = io->read(io->cookie, CB1 + 0x58);
+  if (after == 0xffffffffu || (after & FSR_FAULT)) return EIO;
+ }
+ /* Only GMU kernel stream 5: route first, VALID last. Never program
+  * GMU user stream 4, GPU stream 0, broad masks or a bypass entry.
+  */
+ SET(0xc00 + 4 * r->slot, 1, 0x030300ff);
+ SET(0x800 + 4 * r->slot, 0x80000005u, 0xffffffffu);
+ r->fault = io->read(io->cookie, CB1 + 0x58);
+ #undef SET
+ return r->fault == 0xffffffffu || (r->fault & FSR_FAULT) ? EIO : 0;
+}
+#endif
diff --git a/bsd/dev/sweet_files.c b/bsd/dev/sweet_files.c
new file mode 100644
index 000000000..53f6a8d98
--- /dev/null
+++ b/bsd/dev/sweet_files.c
@@ -0,0 +1,355 @@
+/*
+ * File server for the running iOS root, over USB Ethernet: TCP
+ * 192.168.7.2:2223 (on the Mac: 127.0.0.1:2223 through FlameBridge,
+ * tools/flame-files.py). One request per connection, a header line then
+ * data:
+ *
+ *   PUT <path> <mode-octal> <size>\n<size bytes>  -> "OK <size>\n"  (root:wheel)
+ *   GET <path>\n                                  -> "OK <size>\n<bytes>"
+ *   MKDIR <path> <mode-octal>\n                   -> "OK\n"
+ *   LINK <target> <path>\n                        -> "OK\n"  (symlink)
+ *   RM <path>\n                                   -> "OK\n"
+ *   CHMOD <path> <mode-octal>\n                   -> "OK\n"
+ *   SYNC\n                                        -> "OK\n"  (0168)
+ *
+ * Errors: "ERR <errno>\n". Paths have no spaces. Started with the USB
+ * gadget (sweet_usb.c) when the interface comes up.
+ *
+ * ios-sweet 0168 (from ios-flame/sunfish 0091, tools/flame-files.py): root file access to the running
+ * system over the USB cable only. Boot-arg sweetfiles=1 enables it; it binds 192.168.7.2 (ue0) instead
+ * of every address, so it is not reachable over Wi-Fi, and closes connections from outside
+ * 192.168.7.0/24.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/vnode_internal.h>
+#include <sys/kernel.h>
+#include <sys/kauth.h>
+#include <sys/proc_internal.h>
+#include <sys/kpi_socket.h>
+#include <sys/socket.h>
+#include <sys/uio.h>
+#include <netinet/in.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <pexpert/pexpert.h>
+
+extern int sweet_vfs_mkdir(const char *path, int mode);
+extern int sweet_vfs_symlink(const char *target, const char *link);
+extern int sweet_vfs_unlink(const char *path);
+extern kern_return_t thread_terminate(thread_t);
+struct sync_args;
+extern int sync(proc_t p, struct sync_args *uap, int32_t *retval);
+void sweet_files_start(void);
+
+#define SF_BUF  (64 * 1024)
+
+static char *sf_buf;
+static int sf_chan;
+
+static void
+sf_sleep_ms(int ms)
+{
+	(void)tsleep(&sf_chan, PZERO, "sweetfiles", MAX(1, ms * hz / 1000));
+}
+
+static unsigned long long
+sf_dec(const char *p)
+{
+	unsigned long long v = 0;
+	while (*p == ' ') {
+		p++;
+	}
+	while (*p >= '0' && *p <= '9') {
+		v = v * 10 + (unsigned)(*p++ - '0');
+	}
+	return v;
+}
+
+static int
+sf_recv(socket_t so, void *buf, size_t len, size_t *got, int flags)
+{
+	struct iovec iov = { .iov_base = buf, .iov_len = len };
+	struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+	return sock_receive(so, &msg, flags, got);
+}
+
+static int
+sf_recv_all(socket_t so, void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		size_t got = 0;
+		int err = sf_recv(so, (char *)buf + off, len - off, &got, MSG_WAITALL);
+		if (err) {
+			return err;
+		}
+		if (got == 0) {
+			return ECONNRESET;
+		}
+		off += got;
+	}
+	return 0;
+}
+
+static int
+sf_send(socket_t so, const void *buf, size_t len)
+{
+	size_t off = 0;
+	while (off < len) {
+		struct iovec iov = { .iov_base = (char *)buf + off, .iov_len = len - off };
+		struct msghdr msg = { .msg_iov = &iov, .msg_iovlen = 1 };
+		size_t sent = 0;
+		int err = sock_send(so, &msg, 0, &sent);
+		if (err) {
+			return err;
+		}
+		off += sent;
+	}
+	return 0;
+}
+
+static void
+sf_reply(socket_t so, int err, uint64_t n, bool with_n)
+{
+	char line[48];
+	int len = err ? snprintf(line, sizeof(line), "ERR %d\n", err) :
+	    with_n ? snprintf(line, sizeof(line), "OK %llu\n", n) : snprintf(line, sizeof(line), "OK\n");
+	(void)sf_send(so, line, (size_t)len);
+}
+
+/* Header line: up to '\n', read byte by byte so data after it stays queued. */
+static int
+sf_line(socket_t so, char *line, size_t max)
+{
+	size_t n = 0;
+	while (n + 1 < max) {
+		size_t got = 0;
+		int err = sf_recv(so, line + n, 1, &got, MSG_WAITALL);
+		if (err || got == 0) {
+			return err ? err : ECONNRESET;
+		}
+		if (line[n] == '\n') {
+			break;
+		}
+		n++;
+	}
+	line[n] = 0;
+	return 0;
+}
+
+static int
+sf_setattr(const char *path, int mode, bool owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_lookup(path, 0, &vp, ctx);
+	if (err) {
+		return err;
+	}
+	struct vnode_attr va;
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_mode, mode & 07777);
+	if (owner) {
+		VATTR_SET(&va, va_uid, 0);
+		VATTR_SET(&va, va_gid, 0);
+	}
+	err = vnode_setattr(vp, &va, ctx);
+	vnode_put(vp);
+	return err;
+}
+
+static int
+sf_put(socket_t so, const char *path, int mode, uint64_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, O_CREAT | O_TRUNC | FWRITE, mode & 07777, 0, &vp, ctx);
+	uint64_t off = 0;
+	while (off < size) {
+		size_t chunk = (size_t)MIN((uint64_t)SF_BUF, size - off);
+		int rerr = sf_recv_all(so, sf_buf, chunk);
+		if (rerr) {
+			err = err ? err : rerr;
+			break;
+		}
+		if (!err) {
+			int resid = 0;
+			err = vn_rdwr(UIO_WRITE, vp, sf_buf, (int)chunk, (off_t)off, UIO_SYSSPACE, IO_UNIT,
+			    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+			if (!err && resid) {
+				err = EIO;
+			}
+		}
+		off += chunk;
+	}
+	if (vp != NULLVP) {
+		vnode_close(vp, FWRITE, ctx);
+	}
+	if (!err) {
+		err = sf_setattr(path, mode, true);
+	}
+	return err;
+}
+
+static int
+sf_get(socket_t so, const char *path)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	off_t size = 0;
+	int err = vnode_open(path, FREAD, 0, 0, &vp, ctx);
+	if (!err) {
+		err = vnode_size(vp, &size, ctx);
+	}
+	if (err) {
+		if (vp != NULLVP) {
+			vnode_close(vp, FREAD, ctx);
+		}
+		sf_reply(so, err, 0, false);
+		return err;
+	}
+	sf_reply(so, 0, (uint64_t)size, true);
+	for (off_t off = 0; off < size && !err;) {
+		int chunk = (int)MIN((off_t)SF_BUF, size - off), resid = 0;
+		err = vn_rdwr(UIO_READ, vp, sf_buf, chunk, off, UIO_SYSSPACE, IO_UNIT,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (!err) {
+			err = sf_send(so, sf_buf, (size_t)(chunk - resid));
+		}
+		off += chunk;
+	}
+	vnode_close(vp, FREAD, ctx);
+	return err;
+}
+
+static void
+sf_handle(socket_t so)
+{
+	static char line[1100];
+	char a[512], b[512];
+	unsigned long long n = 0;
+	int err = sf_line(so, line, sizeof(line));
+	if (err) {
+		return;
+	}
+	a[0] = b[0] = 0;
+	if (!strncmp(line, "PUT ", 4)) {
+		unsigned mode = 0644;
+		char *p = line + 4, *sp = strchr(p, ' ');
+		if (!sp || (size_t)(sp - p) >= sizeof(a)) {
+			sf_reply(so, EINVAL, 0, false);
+			return;
+		}
+		memcpy(a, p, (size_t)(sp - p));
+		a[sp - p] = 0;
+		mode = (unsigned)strtoul(sp + 1, &p, 8);
+		n = sf_dec(p);
+		err = sf_put(so, a, (int)mode, n);
+		printf("SWEET FILES: PUT %s %o %llu -> %d\n", a, mode, n, err);
+		sf_reply(so, err, n, true);
+		return;
+	}
+	if (!strncmp(line, "GET ", 4)) {
+		err = sf_get(so, line + 4);
+		printf("SWEET FILES: GET %s -> %d\n", line + 4, err);
+		return;
+	}
+	if (!strcmp(line, "SYNC")) {
+		/* flush written files before a forced reboot (0168) */
+		int32_t rv = 0;
+		err = sync(kernproc, NULL, &rv);
+		printf("SWEET FILES: SYNC -> %d\n", err);
+		sf_reply(so, err, 0, false);
+		return;
+	}
+	char *sp = strchr(line, ' ');
+	if (!sp) {
+		sf_reply(so, EINVAL, 0, false);
+		return;
+	}
+	*sp = 0;
+	char *arg1 = sp + 1, *arg2 = strchr(arg1, ' ');
+	if (arg2) {
+		*arg2++ = 0;
+	}
+	if (!strcmp(line, "MKDIR")) {
+		err = sweet_vfs_mkdir(arg1, arg2 ? (int)strtoul(arg2, NULL, 8) : 0755);
+		if (err == EEXIST) {
+			err = 0;
+		}
+	} else if (!strcmp(line, "LINK") && arg2) {
+		err = sweet_vfs_symlink(arg1, arg2);
+	} else if (!strcmp(line, "RM")) {
+		err = sweet_vfs_unlink(arg1);
+	} else if (!strcmp(line, "CHMOD") && arg2) {
+		err = sf_setattr(arg1, (int)strtoul(arg2, NULL, 8), false);
+	} else {
+		err = EINVAL;
+	}
+	printf("SWEET FILES: %s %s %s -> %d\n", line, arg1, arg2 ? arg2 : "", err);
+	sf_reply(so, err, 0, false);
+}
+
+static void
+sf_thread(void *arg __unused, wait_result_t wr __unused)
+{
+	socket_t ls = NULL;
+	struct sockaddr_in me;
+	int one = 1;
+
+	sf_buf = kalloc_data(SF_BUF, Z_WAITOK);
+	for (;;) {
+		if (sock_socket(PF_INET, SOCK_STREAM, IPPROTO_TCP, NULL, NULL, &ls) == 0) {
+			(void)sock_setsockopt(ls, SOL_SOCKET, SO_REUSEADDR, &one, sizeof(one));
+			bzero(&me, sizeof(me));
+			me.sin_len = sizeof(me);
+			me.sin_family = AF_INET;
+			me.sin_port = htons(2223);
+			me.sin_addr.s_addr = htonl(0xc0a80702);   /* 192.168.7.2: ue0 only */
+			if (sock_bind(ls, (struct sockaddr *)&me) == 0 && sock_listen(ls, 4) == 0) {
+				break;
+			}
+			sock_close(ls);
+		}
+		ls = NULL;
+		sf_sleep_ms(1000);
+	}
+	printf("SWEET FILES: listening on tcp 2223\n");
+	for (;;) {
+		socket_t c = NULL;
+		struct sockaddr_in peer;
+		bzero(&peer, sizeof(peer));
+		if (sock_accept(ls, (struct sockaddr *)&peer, sizeof(peer), 0, NULL, NULL, &c) != 0 || c == NULL) {
+			sf_sleep_ms(100);
+			continue;
+		}
+		if (peer.sin_family != AF_INET || (ntohl(peer.sin_addr.s_addr) & 0xffffff00u) != 0xc0a80700u) {
+			printf("SWEET FILES: refused a connection from outside 192.168.7.0/24\n");
+			sock_close(c);
+			continue;
+		}
+		sf_handle(c);
+		sock_close(c);
+	}
+}
+
+void
+sweet_files_start(void)
+{
+	int on = 0;
+	PE_parse_boot_argn("sweetfiles", &on, sizeof(on));
+	if (!on) {
+		return;
+	}
+	thread_t thread;
+	if (kernel_thread_start(sf_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
new file mode 100644
index 000000000..08d382274
--- /dev/null
+++ b/bsd/dev/sweet_gpu.c
@@ -0,0 +1,808 @@
+/*
+ * SWEET Adreno 618 bring-up. sweetgpu=1 reads GPUCC and command DB only.
+ * sweetgpu=2 adds deferred RPMh ARC READ transactions after touch power.
+ * sweetgpu=3 additionally raises only gfx.lvl and verifies the readback.
+ * sweetgpu=4 uses the new A618 core to power CX after fresh rail checks.
+ * sweetgpu=5 enables GMU/bus clocks and reads CX-side GMU/SMMU status.
+ * sweetgpu=6 additionally stages firmware while the M3 remains in reset.
+ * sweetgpu=7 additionally validates SMMU mappings and prepares HFI RAM.
+ * sweetgpu=8 cold-starts legacy GMU and exchanges real HFI messages.
+ * GX is firmware controlled. No CP/SQE or graphics submission yet.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/errno.h>
+#include "sweet_adreno.h"
+#include "sweet_adreno_cp.h"
+#include "sweet_adreno_dma.h"
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern int sweet_rpmh_arc_probe(const char *res);
+extern int sweet_rpmh_arc_read(const char *res);
+extern int sweet_rpmh_arc_require(const char *res, unsigned minimum);
+extern int sweet_rpmh_arc_raise(const char *res, unsigned target_vlvl);
+extern kern_return_t thread_terminate(thread_t);
+extern int sweet_rpmh_adreno_level_vote(unsigned level, uint32_t *vote, unsigned *mx_level);
+void sweet_gpu_probe(void);
+
+
+/* LOW_SVS is the first safe GPU corner; the write only raises gfx.lvl. */
+#define SWEET_GPU_GFX_TARGET 65u
+
+#define SWEET_GPUCC_PA       0x05090000u
+#define SWEET_GPUCC_SIZE     0x00009000u
+#define SWEET_GCC_PA         0x00100000u
+#define SWEET_GCC_SIZE       0x00072000u
+#define SWEET_GMU_PA         0x0506a000u
+#define SWEET_GMU_SIZE       0x00031000u
+#define SWEET_SMMU_PA        0x05040000u
+#define SWEET_SMMU_SIZE      0x00010000u
+#define GPU_CC_GX_BCR        0x1008u
+#define GPU_CC_GX_GDSCR      0x100cu
+#define GPU_CC_CX_GDSCR      0x106cu
+#define GPU_CC_CBCR_AHB      0x1078u
+#define GPU_CC_GX_DOMAIN     0x1508u
+#define GPU_CC_CX_HW_CTRL    0x1540u
+#define GDSC_PWR_ON          (1u << 31)
+#define GDSC_SW_COLLAPSE     (1u << 0)
+#define GDSC_HW_CONTROL      (1u << 1)
+#define GX_DOMAIN_CLAMP      (1u << 0)
+#define GX_BCR_BLK_ARES      (1u << 0)
+#define BRANCH_CLK_OFF       (1u << 31)
+#define BRANCH_CLK_ENABLE    (1u << 0)
+
+static vm_offset_t sweet_gpucc;
+static int sweet_gpu_probe_attempted;
+static int sweet_gpu_stage;
+
+/* All registers below are in GPUCC; none is in the Adreno/GMU aperture. */
+static const struct {
+	const char *name;
+	uint32_t offset;
+} sweet_gpu_branches[] = {
+	{ "AHB",          0x1078u },
+	{ "CX_APB",       0x1088u },
+	{ "CX_SNOC_DVM",  0x108cu },
+	{ "CX_GMU",       0x1098u },
+	{ "CXO",          0x109cu },
+	{ "CX_GFX3D",     0x10a4u },
+	{ "CX_GFX3D_SLV", 0x10a8u },
+	{ "GX_GFX3D",     0x1054u },
+	{ "GX_CXO",       0x1060u },
+	{ "GX_GMU",       0x1064u },
+};
+
+static uint32_t
+sweet_gpucc_read(uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)(sweet_gpucc + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+/* XNU adapter: cookie is the mapped aperture base. */
+static uint32_t
+sweet_adreno_read(void *cookie, uint32_t offset)
+{
+	uint32_t value = *(volatile uint32_t *)((vm_offset_t)cookie + offset);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static void
+sweet_adreno_write(void *cookie, uint32_t offset, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)((vm_offset_t)cookie + offset) = value;
+	__asm__ volatile("dsb oshst" ::: "memory");
+	(void)sweet_adreno_read(cookie, offset);
+}
+
+static uint64_t
+sweet_adreno_read64(void *cookie, uint32_t offset)
+{
+ uint64_t value = *(volatile uint64_t *)((vm_offset_t)cookie + offset);
+ __asm__ volatile("dmb oshld" ::: "memory");
+ return value;
+}
+static void
+sweet_adreno_write64(void *cookie, uint32_t offset, uint64_t value)
+{
+ __asm__ volatile("dmb oshst" ::: "memory");
+ *(volatile uint64_t *)((vm_offset_t)cookie + offset) = value;
+ __asm__ volatile("dsb oshst" ::: "memory");
+}
+static void
+sweet_adreno_barrier(void *cookie)
+{
+ (void)cookie;
+ __asm__ volatile("dsb sy" ::: "memory");
+}
+
+static void
+sweet_adreno_delay(void *cookie, unsigned usec)
+{
+	(void)cookie;
+	delay(usec);
+}
+
+/*
+ * Pure metadata inspection; valid tables do not establish current votes.
+ */
+static int
+sweet_gpu_arc_tables(void)
+{
+	static const char *const names[] = { "mx.lvl", "cx.lvl", "gfx.lvl" };
+	for (unsigned i = 0; i < 3; ++i) {
+		int error = sweet_rpmh_arc_probe(names[i]);
+		if (error) {
+			printf("SWEET GPU: ARC probe %s failed %d\n", names[i], error);
+			return error;
+		}
+	}
+	printf("SWEET GPU: ARC tables read-only complete\n");
+	return 0;
+}
+
+/* Fresh resource checks belong to this boot, not to a previous stage.
+ * ARC table selectors are the current board interpretation, not a voltage
+ * measurement. Shared rails are never lowered or written by this driver.
+ */
+static int
+sweet_gpu_power_cx(void)
+{
+	struct a618_power_result result;
+	const struct a618_io io = {
+		.cookie = (void *)sweet_gpucc,
+		.read = sweet_adreno_read,
+		.write = sweet_adreno_write,
+		.delay_us = sweet_adreno_delay,
+	};
+	int error = sweet_rpmh_arc_require("mx.lvl", 65);
+	if (!error)
+		error = sweet_rpmh_arc_require("cx.lvl", 65);
+	if (error) {
+		printf("SWEET ADRENO: CX preconditions failed errno=%d; no GPUCC write\n", error);
+		return error;
+	}
+	error = a618_enable_cx(&io, &result);
+	printf("SWEET ADRENO: CX result errno=%d control=%#x status=%#x waited_us=%u\n",
+	    error, result.control, result.status, result.waited_us);
+	return error;
+}
+
+static uint32_t
+sweet_gpu_crc(const unsigned char *bytes, unsigned length)
+{
+ uint32_t crc = 0xffffffffu;
+ for (unsigned i = 0; i < length; ++i) {
+  crc ^= bytes[i];
+  for (unsigned b = 0; b < 8; ++b) crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1)));
+ }
+ return ~crc;
+}
+static int
+sweet_gpu_blob(DTEntry node, const char *name, const char *crc_name,
+ const unsigned char **bytes, unsigned *length)
+{
+ const uint32_t *crc;
+ unsigned size = 0;
+ if (SecureDTGetProperty(node, name, (const void **)bytes, length) != kSuccess ||
+     SecureDTGetProperty(node, crc_name, (const void **)&crc, &size) != kSuccess ||
+     size != 4 || *length > 0x8000 || !*length) return ENOENT;
+ return sweet_gpu_crc(*bytes, *length) == *crc ? 0 : EIO;
+}
+struct sweet_gpu_zap_request {
+ volatile uint32_t *reserved;
+ uint64_t physical;
+ const struct a618_dma_region *metadata;
+ const unsigned char *mdt, *code;
+ unsigned mdt_bytes, code_bytes;
+ struct a618_pas_result result;
+};
+static int
+sweet_gpu_zap_prepare(void *cookie)
+{
+ struct sweet_gpu_zap_request *request = cookie;
+ if (!request) return EINVAL;
+ return a618_zap_authenticate(request->reserved, request->physical,
+     request->metadata, request->mdt, request->mdt_bytes, request->code,
+     request->code_bytes, &request->result);
+}
+/*
+ * GPU performance levels from the pinned sm7150.dtsi gpu_opp_table, every
+ * one opp-supported-hw 0x1f (all speed bins): kHz and raw RPMh opp-level.
+ * Bring-up still runs at index 1 (267MHz, the proven corner). After the CP
+ * fence succeeds the APPS gfx/mx floors are raised for the chosen level, the
+ * GX clock is measured, DCVS selects it, and the clock is measured again.
+ * sweetgpukhz=267000 keeps the previous single-level behaviour.
+ */
+static const struct { uint32_t khz, level; } sweet_gpu_opps[] = {
+	{ 267000u, 64u },       /* LOW_SVS */
+	{ 355000u, 128u },      /* SVS */
+	{ 430000u, 192u },      /* SVS_L1 */
+	{ 565000u, 256u },      /* NOM */
+	/* 0132 telemetry: blur-heavy CoreAnimation commits are GPU-bound (13-14
+	 * passes, up to 15.5Mpx, 51-182ms at ~557MHz). OrangeFox KGSL on this
+	 * phone lists 650 and 800MHz; the pinned table pairs them with NOM_L1 and
+	 * TURBO (opp-supported-hw 0x1d / 0x19). */
+	{ 650000u, 320u },      /* NOM_L1 */
+	{ 800000u, 384u },      /* TURBO */
+};
+static unsigned sweet_gpu_opp_mx[6];
+
+static void
+sweet_gpu_levels_prepare(void)
+{
+	uint32_t target = 800000u;
+	PE_parse_boot_argn("sweetgpukhz", &target, sizeof(target));
+	a618_gpu_level_count = 0;
+	unsigned count = 0;
+	for (unsigned i = 0; i < sizeof(sweet_gpu_opps) / sizeof(sweet_gpu_opps[0]); ++i) {
+		if (sweet_gpu_opps[i].khz > target) {
+			break;
+		}
+		uint32_t vote = 0;
+		unsigned mx = 0;
+		int error = sweet_rpmh_adreno_level_vote(sweet_gpu_opps[i].level, &vote, &mx);
+		if (error) {
+			printf("SWEET ADRENO: OPP %u kHz vote errno=%d; single legacy level\n",
+			    sweet_gpu_opps[i].khz, error);
+			return;
+		}
+		a618_gpu_levels[count].vote = vote;
+		a618_gpu_levels[count].khz = sweet_gpu_opps[i].khz;
+		sweet_gpu_opp_mx[count] = mx;
+		++count;
+	}
+	/* Only a table that begins with the proven 267MHz/raw64 corner. */
+	if (count < 2 || (a618_gpu_levels[0].vote >> 16) != 64u) {
+		printf("SWEET ADRENO: OPP table count=%u first=%#x; single legacy level\n",
+		    count, count ? a618_gpu_levels[0].vote : 0);
+		return;
+	}
+	a618_gpu_level_count = count;
+	printf("SWEET ADRENO: OPP table %u levels up to %u kHz (target %u)\n",
+	    count, a618_gpu_levels[count - 1].khz, target);
+}
+
+/* RBBM_PERFCTR_RBBM_0 with countable PERF_RBBM_ALWAYS_COUNT (GX core clock
+ * cycles) against the architected 19.2MHz timer. 0 means not measurable. */
+static uint64_t
+sweet_gpu_counter(vm_offset_t core)
+{
+	uint32_t hi, lo, again;
+	do {
+		hi = sweet_adreno_read((void *)core, 0x41d * 4);
+		lo = sweet_adreno_read((void *)core, 0x41c * 4);
+		again = sweet_adreno_read((void *)core, 0x41d * 4);
+	} while (hi != again);
+	return ((uint64_t)hi << 32) | lo;
+}
+
+static uint32_t
+sweet_gpu_measure_khz(vm_offset_t core)
+{
+	sweet_adreno_write((void *)core, 0x500 * 4, 1);         /* RBBM_PERFCTR_CNTL */
+	sweet_adreno_write((void *)core, 0x507 * 4, 0);         /* RBBM_SEL_0: ALWAYS_COUNT */
+	sweet_adreno_barrier(NULL);
+	delay(100);
+	const uint64_t c0 = sweet_gpu_counter(core), t0 = mach_absolute_time();
+	delay(20000);
+	const uint64_t c1 = sweet_gpu_counter(core), t1 = mach_absolute_time();
+	uint64_t ns = 0;
+	absolutetime_to_nanoseconds(t1 - t0, &ns);
+	if (!ns || c1 <= c0 || (c1 >> 63) || c0 == 0xffffffffffffffffULL) {
+		return 0;
+	}
+	return (uint32_t)(((c1 - c0) * 1000000ULL) / ns);
+}
+
+/* Read-only GPUCC view of the real GX clock (Lineage gpucc-sm6150.c): alpha
+ * PLLs at +0x0/+0x100 (L +4, ALPHA +8, ALPHA_U +0xc, USER_CTL +0x10) feed
+ * gpu_cc_gx_gfx3d_clk_src (CMD_RCGR 0x101c, CFG 0x1020: SRC_SEL [10:8],
+ * SRC_DIV [4:0]) through a CRC divider. Logged raw with the VCO estimate. */
+static void
+sweet_gpu_clock_regs(const char *tag)
+{
+	if (!sweet_gpucc) {
+		return;
+	}
+	for (unsigned pll = 0; pll < 2; ++pll) {
+		const uint32_t base = pll * 0x100u;
+		const uint32_t l = sweet_gpucc_read(base + 0x4) & 0xffffu;
+		const uint32_t alpha = sweet_gpucc_read(base + 0x8), alpha_u = sweet_gpucc_read(base + 0xc) & 0xffu;
+		const uint64_t frac = ((uint64_t)alpha_u << 32) | alpha;
+		const uint64_t khz = 19200ULL * l + ((19200ULL * frac) >> 40);
+		printf("SWEET ADRENO: %s GPU PLL%u mode=%#x L=%u alpha=%#llx user_ctl=%#x vco~%llu kHz\n", tag, pll,
+		    sweet_gpucc_read(base), l, (unsigned long long)frac, sweet_gpucc_read(base + 0x10), (unsigned long long)khz);
+	}
+	const uint32_t cmd = sweet_gpucc_read(0x101c), cfg = sweet_gpucc_read(0x1020);
+	printf("SWEET ADRENO: %s gfx3d RCG cmd=%#x cfg=%#x src_sel=%u src_div=%u crc_fsm=%#x crc_mnd=%#x\n", tag, cmd, cfg,
+	    (cfg >> 8) & 7, cfg & 0x1f, sweet_gpucc_read(0x1024), sweet_gpucc_read(0x1028));
+}
+
+static void
+sweet_gpu_raise_clock(vm_offset_t core, vm_offset_t gmu)
+{
+	sweet_gpu_clock_regs("before DCVS");
+	const uint32_t before = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: GX clock measured=%u kHz at perf index 1 (configured %u kHz)\n",
+	    before, a618_gpu_level_count ? a618_gpu_levels[0].khz : 267000u);
+	if (a618_gpu_level_count < 2) {
+		return;
+	}
+	const unsigned top = a618_gpu_level_count - 1;
+	const unsigned gfx_vlvl = (a618_gpu_levels[top].vote >> 16) + 1;   /* ARC consumer level */
+	const unsigned mx_vlvl = sweet_gpu_opp_mx[top] + 1;
+	int error = sweet_rpmh_arc_raise("mx.lvl", mx_vlvl);
+	if (!error) {
+		error = sweet_rpmh_arc_raise("gfx.lvl", gfx_vlvl);
+	}
+	if (error) {
+		printf("SWEET ADRENO: APPS rail floor errno=%d; GX stays at perf index 1\n", error);
+		return;
+	}
+	const struct a618_io gmu_io = {(void *)gmu,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+	error = a618_gmu_dcvs(&gmu_io, top + 1);
+	const uint32_t after = sweet_gpu_measure_khz(core);
+	printf("SWEET ADRENO: DCVS perf index %u (%u kHz, gfx vlvl %u, mx vlvl %u) errno=%d; GX clock measured=%u kHz\n",
+	    top + 1, a618_gpu_levels[top].khz, gfx_vlvl, mx_vlvl, error, after);
+	sweet_gpu_clock_regs("after DCVS");
+	if (error && error != ETIMEDOUT) {
+		/* Firmware refused: request the proven bring-up index again. */
+		int back = a618_gmu_dcvs(&gmu_io, 1);
+		printf("SWEET ADRENO: DCVS restore index 1 errno=%d measured=%u kHz\n",
+		    back, sweet_gpu_measure_khz(core));
+	}
+}
+
+static int
+sweet_gpu_cp_start(vm_offset_t gmu, vm_offset_t smmu)
+{
+ DTEntry node;
+ if (SecureDTLookupEntry(NULL, "/sweet-adreno", &node) != kSuccess) return ENOENT;
+ const unsigned char *sqe = NULL, *mdt = NULL, *code = NULL;
+ unsigned sqe_size = 0, mdt_size = 0, code_size = 0;
+ int error = sweet_gpu_blob(node, "sqe-firmware", "sqe-firmware-crc32", &sqe, &sqe_size);
+ if (!error) error = sweet_gpu_blob(node, "zap-metadata", "zap-metadata-crc32", &mdt, &mdt_size);
+ if (!error) error = sweet_gpu_blob(node, "zap-code", "zap-code-crc32", &code, &code_size);
+ const uint64_t *reserved_base = NULL;
+ const uint32_t *reserved_size = NULL;
+ unsigned length = 0;
+ if (!error && (SecureDTGetProperty(node, "zap-reserved-base", (const void **)&reserved_base,
+     &length) != kSuccess || length != 8 || *reserved_base != 0x97f15000ull)) error = EINVAL;
+ if (!error && (SecureDTGetProperty(node, "zap-reserved-size", (const void **)&reserved_size,
+     &length) != kSuccess || length != 4 || *reserved_size != 0x2000)) error = EINVAL;
+ printf("SWEET ADRENO: CP firmware properties errno=%d SQE=%u MDT=%u ZAP=%u\n",
+     error, sqe_size, mdt_size, code_size);
+ if (error) return error;
+ static struct a618_dma_region memory, metadata;
+ error = sweet_adreno_cp_allocate(&memory);
+ printf("SWEET ADRENO: CP DMA errno=%d PA=%#llx bytes=%u\n", error,
+     memory.physical, memory.bytes);
+ if (error) return error;
+ error = a618_cp_stage(&memory, sqe, sqe_size, sweet_adreno_barrier, NULL);
+ if (error) {
+  printf("SWEET ADRENO: SQE CPU staging/readback errno=%d\n", error);
+  return error;
+ }
+ /* Read the wired allocation through an independent physical IO mapping.
+  * Retain it with the wired storage for the boot lifetime. */
+ vm_offset_t physical_image = ml_io_map(memory.physical + A618_CP_SQE_OFFSET, 0x8000);
+ if (!physical_image) return ENOMEM;
+ volatile uint32_t *staged = (volatile uint32_t *)(memory.cpu + A618_CP_SQE_OFFSET);
+ unsigned verified = 0;
+ for (; verified < (sqe_size - 4) / 4; ++verified) {
+  if (sweet_adreno_read((void *)physical_image, verified * 4) != staged[verified]) {
+   error = EIO; break;
+  }
+ }
+ printf("SWEET ADRENO: SQE physical readback errno=%d words=%u first=%#x,%#x,%#x,%#x\n",
+     error, verified, sweet_adreno_read((void *)physical_image, 0),
+     sweet_adreno_read((void *)physical_image, 4), sweet_adreno_read((void *)physical_image, 8),
+     sweet_adreno_read((void *)physical_image, 12));
+ if (error) return error;
+ const struct a618_smmu_io smmu_io = {
+  {(void *)smmu, sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay},
+  sweet_adreno_read64, sweet_adreno_write64, sweet_adreno_barrier};
+ struct a618_smmu_result map;
+ bzero(&map, sizeof(map));
+ extern int sweet_native_adreno_prepare_vm(const struct a618_smmu_io *,
+     const struct a618_dma_region *, struct a618_smmu_result *);
+ error = sweet_native_adreno_prepare_vm(&smmu_io, &memory, &map);
+ printf("SWEET ADRENO: CP SMMU errno=%d CB=%u slot=%u pages=%u offset=%#x value=%#x PAR=%#llx FSR=%#x\n",
+     error, map.context, map.slot, map.translated, map.offset, map.value, map.par, map.fault);
+ if (error) return error;
+ vm_offset_t core = ml_io_map(0x05000000, 0x40000);
+ if (!core) return ENOMEM;
+ const struct a618_io gpu_io = {(void *)core,
+     sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+ const struct a618_io gmu_io = {(void *)gmu,
+     sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+ error = sweet_adreno_pas_allocate(&metadata);
+ if (error) return error;
+ vm_offset_t zap = ml_io_map(*reserved_base, *reserved_size);
+ if (!zap) return ENOMEM;
+ struct sweet_gpu_zap_request request = {
+  .reserved = (volatile uint32_t *)zap, .physical = *reserved_base,
+  .metadata = &metadata, .mdt = mdt, .code = code,
+  .mdt_bytes = mdt_size, .code_bytes = code_size,
+ };
+ struct a618_cp_result cp;
+ bzero(&cp, sizeof(cp));
+ error = a618_cp_start(&gpu_io, &gmu_io, &memory, sqe, sqe_size,
+     sweet_adreno_barrier, NULL, sweet_gpu_zap_prepare, &request, &cp);
+ printf("SWEET ADRENO: pre-SQE ZAP attempted=%u errno=%d phase=%u status=%lld response=%#llx\n",
+     cp.secure_prepare_attempted, cp.secure_prepare_error, request.result.phase,
+     request.result.status, request.result.response);
+ printf("SWEET ADRENO: CP initial TSB control=%#x base=%#llx size=%#x\n",
+     cp.initial_tsb_control, cp.initial_tsb_base, cp.initial_tsb_size);
+ printf("SWEET ADRENO: CP aperture errno=%d phase=%u status=%lld response=%#llx\n",
+     cp.aperture_error, cp.aperture_phase, cp.aperture_status, cp.aperture_response);
+ printf("SWEET ADRENO: SQE ME_INIT errno=%d phase=%u submitted=%u completed=%u RPTR=%#x WPTR=%#x status=%#x IRQ=%#x fault=%#x\n",
+     error, cp.phase, cp.submitted, cp.completed, cp.rptr, cp.wptr, cp.status,
+     cp.interrupt, cp.hw_fault);
+ printf("SWEET ADRENO: CP startup IRQ power=%#x before_auth=%#x after_auth=%#x bootstrap_us=%u CP2GMU=%#x ACTLR=%#x\n",
+     cp.irq_after_power, cp.irq_before_auth, cp.irq_after_auth, cp.bootstrap_wait_us,
+     sweet_adreno_read((void *)core, 0x2048), sweet_adreno_read((void *)smmu, 0x8004));
+ printf("SWEET ADRENO: CP startup initial SQECTL=%#x INSTR=%#x%08x RB_CNTL=%#x snapshots=%u first_fault=%s\n",
+     cp.initial_sqectl, cp.initial_instr_hi, cp.initial_instr_lo,
+     cp.initial_rb_cntl, cp.snapshots, cp.first_fault ? cp.first_fault : "none");
+ for (unsigned i = 0; i < cp.snapshots; ++i)
+  printf("SWEET ADRENO: CP SNAP[%s] IRQ=%#x SQECTL=%#x INSTR=%#x%08x CNTL=%#x CP2GMU=%#x\n",
+      cp.snapshot[i].tag, cp.snapshot[i].irq, cp.snapshot[i].sqectl,
+      cp.snapshot[i].instr_hi, cp.snapshot[i].instr_lo,
+      cp.snapshot[i].rb_cntl, cp.snapshot[i].cp2gmu);
+ printf("SWEET ADRENO: CP execution status local_irq=%#x sqe_started=%u\n", cp.cp_interrupt, cp.sqe_started);
+ printf("SWEET ADRENO: CP MMU CB0FSR=%#x CB1FSR=%#x\n",
+     sweet_adreno_read((void *)smmu, 0x8058), sweet_adreno_read((void *)smmu, 0x9058));
+ /* Snapshot the first hardware fault before any new translation probe or
+  * W1C operation. ATOS success does not prove the CP used the same VA. */
+ printf("SWEET ADRENO: CP fault FAR=%#llx FSYNR0=%#x FSYNR1=%#x SID=%#x TTBR0=%#llx TCR=%#x SCTLR=%#x\n",
+     sweet_adreno_read64((void *)smmu, 0x8060),
+     sweet_adreno_read((void *)smmu, 0x8068), sweet_adreno_read((void *)smmu, 0x806c),
+     sweet_adreno_read((void *)smmu, 0x1400),
+     sweet_adreno_read64((void *)smmu, 0x8020),
+     sweet_adreno_read((void *)smmu, 0x8030), sweet_adreno_read((void *)smmu, 0x8000));
+ printf("SWEET ADRENO: CP addresses SQE=%#llx RING=%#llx SHADOW=%#llx CNTL=%#x SQECTL=%#x\n",
+     ((uint64_t)sweet_adreno_read((void *)core, 0x20c4) << 32) | sweet_adreno_read((void *)core, 0x20c0),
+     ((uint64_t)sweet_adreno_read((void *)core, 0x2004) << 32) | sweet_adreno_read((void *)core, 0x2000),
+     ((uint64_t)sweet_adreno_read((void *)core, 0x2014) << 32) | sweet_adreno_read((void *)core, 0x2010),
+     sweet_adreno_read((void *)core, 0x2008), sweet_adreno_read((void *)core, 0x2020));
+ if (error && (cp.sqe_started || cp.first_fault)) {
+  /* Bounded failure-only indexed SQE state, same 0x33-word bank as A6xx
+   * Linux devcoredump. Each DATA read auto-increments the index. No resume
+   * follows a poisoned CP, so changing this diagnostic selector is harmless. */
+  uint32_t state[51];
+  sweet_adreno_write((void *)core, 0x2420, 0);
+  for (unsigned i = 0; i < 51; ++i)
+   state[i] = sweet_adreno_read((void *)core, 0x2424);
+  for (unsigned i = 0; i < 51; i += 3)
+   printf("SWEET ADRENO: SQE_STAT[%u]=%#x,%#x,%#x\n", i, state[i], state[i + 1], state[i + 2]);
+  printf("SWEET ADRENO: CP hardware RPTR=%#x STATUS1=%#x INTERRUPT=%#x\n",
+      sweet_adreno_read((void *)core, 0x2018), sweet_adreno_read((void *)core, 0x2094),
+      sweet_adreno_read((void *)core, 0x208c));
+  /* Halt the poisoned engine before the bounded instruction-cache capture.
+   * This does not reset it or attempt another submission. Never write a halt
+   * to an engine that did not start: 0106 tests whether that write itself
+   * launches a fetch from the current instruction base. */
+  if (cp.sqe_started) {
+   sweet_adreno_write((void *)core, 0x2020, 3);
+   uint32_t halt = sweet_adreno_read((void *)core, 0x2020);
+   printf("SWEET ADRENO: SQE failure halt=%#x ACTLR=%#x HOST_AP=%#x SQE_AP=%#x\n",
+       halt, sweet_adreno_read((void *)smmu, 0x8004),
+       sweet_adreno_read((void *)core, 0x2800), sweet_adreno_read((void *)core, 0x2804));
+   if (halt != 0xffffffffu && (halt & 3) == 3) {
+    static uint32_t cache[1024];
+    sweet_adreno_write((void *)core, 0x2440, 0);
+    for (unsigned i = 0; i < 1024; ++i)
+     cache[i] = sweet_adreno_read((void *)core, 0x2444);
+    for (unsigned i = 0; i < 1024; i += 8)
+     printf("SWEET ADRENO: SQE_CACHE[%u]=%#x,%#x,%#x,%#x,%#x,%#x,%#x,%#x\n",
+         i, cache[i], cache[i + 1], cache[i + 2], cache[i + 3],
+         cache[i + 4], cache[i + 5], cache[i + 6], cache[i + 7]);
+   }
+  } else {
+   printf("SWEET ADRENO: SQE halted=%#x; no pre-start halt write or cache capture\n",
+       sweet_adreno_read((void *)core, 0x2020));
+  }
+ }
+ if (error) return error;
+ error = a618_cp_leave_secure(&gpu_io, &gmu_io, &memory,
+     sweet_adreno_barrier, NULL, &cp);
+ printf("SWEET ADRENO: CP fence errno=%d phase=%u submitted=%u completed=%u RPTR=%#x WPTR=%#x IRQ=%#x fault=%#x fence=%#x value=%#x\n",
+     error, cp.phase, cp.submitted, cp.completed, cp.rptr, cp.wptr, cp.interrupt,
+     cp.hw_fault, cp.fence, cp.value);
+ printf("SWEET ADRENO: CP bootstrap complete errno=%d; iOS rendering ABI unavailable\n", error);
+ if (!error) {
+  sweet_gpu_raise_clock(core, gmu);
+  extern int sweet_native_adreno_adopt(const struct a618_dma_region *, uintptr_t, uintptr_t, uintptr_t, unsigned);
+  error = sweet_native_adreno_adopt(&memory, core, gmu, smmu, cp.fence);
+  printf("SWEET ADRENO: NativeAdreno A618 handoff errno=%d; no userspace rendering\n", error);
+ }
+ return error;
+}
+
+/* Matches postmarketOS SM7150: GMU firmware owns GX power-up. */
+static int
+sweet_gpu_gmu_prepare(int stage)
+{
+	vm_offset_t gcc = ml_io_map(SWEET_GCC_PA, SWEET_GCC_SIZE);
+	if (!gcc)
+		return ENOMEM;
+	const struct a618_io gpucc_io = { (void *)sweet_gpucc,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay };
+	const struct a618_io gcc_io = { (void *)gcc,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay };
+	struct a618_clock_result result;
+	printf("SWEET ADRENO: postmarketOS SM7150 GMU clocks v1 starting\n");
+	int error = a618_enable_gmu_clocks(&gpucc_io, &gcc_io, &result);
+	printf("SWEET ADRENO: GMU clocks errno=%d block=%u offset=%#x value=%#x completed=%u\n",
+	    error, result.block, result.offset, result.value, result.completed);
+	if (error)
+		return error;
+	vm_offset_t gmu = ml_io_map(SWEET_GMU_PA, SWEET_GMU_SIZE);
+	vm_offset_t smmu = ml_io_map(SWEET_SMMU_PA, SWEET_SMMU_SIZE);
+	if (!gmu || !smmu)
+		return ENOMEM;
+	const struct a618_io gmu_io = { (void *)gmu,
+	    sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay };
+	uint32_t reset = sweet_adreno_read((void *)gmu, A618_GMU_SYSRESET);
+	uint32_t power = sweet_adreno_read((void *)gmu, A618_GMU_POWER_STATUS);
+	uint32_t fence = sweet_adreno_read((void *)gmu, A618_GMU_AHB_FENCE_STATUS);
+	printf("SWEET ADRENO: GMU SYSRESET=%#x POWER_STATUS=%#x AHB_FENCE_STATUS=%#x\n",
+	    reset, power, fence);
+	if (reset == 0xffffffffu || power == 0xffffffffu || fence == 0xffffffffu)
+		return EIO;
+	/* ID registers only: do not alter SMMU contexts or stream routing. */
+	uint32_t id0 = sweet_adreno_read((void *)smmu, 0x20);
+	uint32_t id1 = sweet_adreno_read((void *)smmu, 0x24);
+	uint32_t id2 = sweet_adreno_read((void *)smmu, 0x28);
+	printf("SWEET ADRENO: SMMU IDR0=%#x IDR1=%#x IDR2=%#x\n", id0, id1, id2);
+	if (id0 == 0xffffffffu || id1 == 0xffffffffu || id2 == 0xffffffffu || !id0)
+		return EIO;
+	if (stage >= 6) {
+		DTEntry node;
+		const unsigned char *firmware = NULL;
+		const uint32_t *crc = NULL;
+		unsigned int size = 0, crc_size = 0;
+		if (SecureDTLookupEntry(NULL, "/sweet-adreno", &node) != kSuccess ||
+		    SecureDTGetProperty(node, "gmu-firmware", (const void **)&firmware,
+		    &size) != kSuccess ||
+		    SecureDTGetProperty(node, "gmu-crc32", (const void **)&crc,
+		    &crc_size) != kSuccess || crc_size != sizeof(*crc)) {
+			printf("SWEET ADRENO: missing GMU firmware properties; no TCM write\n");
+			return ENOENT;
+		}
+		unsigned verified = 0;
+		error = a618_gmu_stage_legacy(&gmu_io, firmware, size, *crc, &verified);
+		printf("SWEET ADRENO: GMU TCM staging errno=%d verified_bytes=%u; M3 not released\n",
+		    error, verified);
+		if (error)
+			return error;
+	}
+	if (stage >= 7) {
+  (void)sweet_rpmh_arc_probe("xo.lvl");
+  /* Still no M3 release: verify the actual hardware translations first. */
+  if (sweet_adreno_read((void *)gmu, A618_GMU_SYSRESET) != 1 ||
+      !(sweet_gpucc_read(GPU_CC_GX_GDSCR) & GDSC_SW_COLLAPSE) ||
+      !(sweet_gpucc_read(GPU_CC_GX_DOMAIN) & GX_DOMAIN_CLAMP)) {
+   printf("SWEET ADRENO: DMA precondition failed: require M3 reset, GX collapse/clamp\n");
+   return EBUSY;
+  }
+  static struct a618_dma_region memory;
+  static struct a618_hfi hfi;
+  error = sweet_adreno_dma_allocate(&memory);
+  printf("SWEET ADRENO: DMA allocate errno=%d bytes=%u PA=%#llx uncached=%u\n",
+      error, memory.bytes, memory.physical, memory.uncached);
+  if (error) return error;
+  error = a618_hfi_init(&hfi, &memory, sweet_adreno_barrier, NULL);
+  printf("SWEET ADRENO: legacy HFI table errno=%d IOVA=%#x queues=3; firmware not executing\n",
+      error, A618_HFI_IOVA);
+  if (error) return error;
+  const struct a618_smmu_io ops = {
+   { (void *)smmu, sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay },
+   sweet_adreno_read64, sweet_adreno_write64, sweet_adreno_barrier };
+  struct a618_smmu_result result;
+  bzero(&result, sizeof(result));
+  error = a618_smmu_prepare(&ops, &memory, &result);
+  printf("SWEET ADRENO: SMMU map errno=%d CB=%u slot=%u translated=%u offset=%#x value=%#x PAR=%#llx FSR=%#x\n",
+      error, result.context, result.slot, result.translated, result.offset,
+      result.value, result.par, result.fault);
+  printf("SWEET ADRENO: SMMU mapping check complete; SYSRESET=%#x; no firmware execution\n",
+      sweet_adreno_read((void *)gmu, A618_GMU_SYSRESET));
+  if (error) return error;
+  if (stage >= 8) {
+   printf("SWEET ADRENO: GPU context baseline SCTLR0=%#x\n",
+       sweet_adreno_read((void *)smmu, 0x8000));
+   for (unsigned slot = 0; slot < 5; ++slot)
+    printf("SWEET ADRENO: stream slot=%u SMR=%#x S2CR=%#x\n", slot,
+        sweet_adreno_read((void *)smmu, 0x800 + slot * 4),
+        sweet_adreno_read((void *)smmu, 0xc00 + slot * 4));
+   uint32_t gpu_vote = 0, gmu_vote = 0;
+   sweet_gpu_levels_prepare();
+   error = sweet_rpmh_adreno_votes(&gpu_vote, &gmu_vote);
+   printf("SWEET ADRENO: MIN_SVS votes errno=%d GPU=%#x GMU=%#x\n",
+       error, gpu_vote, gmu_vote);
+   if (error) return error;
+   /* PDC apertures from the pinned SM7150 DT, shared by the live A618. */
+   vm_offset_t pdc = ml_io_map(0x0b290000, 0x10000);
+   vm_offset_t seq = ml_io_map(0x0b490000, 0x10000);
+   if (!pdc || !seq) return ENOMEM;
+   const struct a618_io pdc_io = {(void *)pdc,
+       sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+   const struct a618_io seq_io = {(void *)seq,
+       sweet_adreno_read, sweet_adreno_write, sweet_adreno_delay};
+   struct a618_gmu_boot_result boot;
+   bzero(&boot, sizeof(boot));
+   error = a618_gmu_boot_legacy(&gmu_io, &pdc_io, &seq_io, &hfi,
+       gpu_vote, gmu_vote, &boot);
+   printf("SWEET ADRENO: legacy GMU boot errno=%d phase=%u offset=%#x value=%#x FW=%#x; CP unavailable\n",
+       error, boot.phase, boot.offset, boot.value, boot.firmware_version);
+   printf("SWEET ADRENO: HFI request=%#x response=%#x fw_error=%#x packets=%u INFO=%#x HOST_RAW=%#x CB1FSR=%#x\n",
+       hfi.last_request, hfi.last_response, hfi.firmware_error, hfi.responses,
+       sweet_adreno_read((void *)gmu, 0x14648),
+       sweet_adreno_read((void *)gmu, 0x14658),
+       sweet_adreno_read((void *)smmu, 0x9058));
+   sweet_adreno_barrier(NULL);
+   for (unsigned q = 0; q < 3; ++q) {
+    volatile uint32_t *qh = hfi.table + 6 + q * 12;
+    printf("SWEET ADRENO: HFI queue=%u status=%#x dropped=%u RX=%u TX=%u RPTR=%u WPTR=%u\n",
+        q, qh[0], qh[5], qh[8], qh[9], qh[10], qh[11]);
+   }
+   if (!error && stage >= 9) return sweet_gpu_cp_start(gmu, smmu);
+   return error;
+  }
+ }
+	printf("SWEET ADRENO: GMU preparation complete; GX remains firmware controlled, no submission\n");
+	return 0;
+}
+
+static void
+sweet_gpu_arc_thread(void *arg, wait_result_t result)
+{
+	(void)arg;
+	(void)result;
+	static int sleep_chan;
+	uint64_t deadline;
+	int stage = sweet_gpu_stage;
+	static const char *const names[] = { "mx.lvl", "cx.lvl", "gfx.lvl" };
+
+	/* Touch normally votes L11C at 45 s. The RPMh API also checks completion. */
+	clock_interval_to_deadline(60, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	if (stage >= 4) {
+		printf("SWEET ADRENO: CX controller v2 starting; no GPU core access\n");
+		int error = sweet_gpu_power_cx();
+		printf("SWEET ADRENO: CX controller finished errno=%d; rendering unavailable\n", error);
+		if (!error && stage >= 5) {
+			error = sweet_gpu_gmu_prepare(stage);
+			printf("SWEET ADRENO: GMU stage=%d finished errno=%d; rendering unavailable\n",
+			    stage, error);
+		}
+		goto out;
+	}
+	if (stage == 3) {
+		printf("SWEET GPU: ARC gfx raise v1 starting; mx/cx read-only\n");
+		/* Snapshot the shared rails without writing them. */
+		for (unsigned i = 0; i < 2; ++i) {
+			int error = sweet_rpmh_arc_read(names[i]);
+			if (error) {
+				printf("SWEET GPU: ARC gfx raise stopped at %s errno=%d; no retry\n",
+				    names[i], error);
+				goto out;
+			}
+		}
+		int error = sweet_rpmh_arc_raise("gfx.lvl", SWEET_GPU_GFX_TARGET);
+		if (error) {
+			printf("SWEET GPU: ARC gfx raise v1 stopped errno=%d; no retry\n",
+			    error);
+			goto out;
+		}
+		printf("SWEET GPU: ARC gfx raise v1 complete; GPUCC power/clock writes remain disabled\n");
+		goto out;
+	}
+	printf("SWEET GPU: ARC readback v1 starting; no resource votes\n");
+	for (unsigned i = 0; i < 3; ++i) {
+		int error = sweet_rpmh_arc_read(names[i]);
+		if (error) {
+			printf("SWEET GPU: ARC readback stopped at %s errno=%d; no retry\n",
+			    names[i], error);
+			goto out;
+		}
+	}
+	printf("SWEET GPU: ARC readback v1 complete; power/clock writes remain disabled\n");
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_gpu_probe(void)
+{
+	int enabled = 0;
+	uint32_t cx, cx_hw, gx, domain, reset;
+	unsigned int i;
+
+	if (sweet_gpu_probe_attempted) {
+		return;
+	}
+	sweet_gpu_probe_attempted = 1;
+	(void)PE_parse_boot_argn("sweetadrenostage", &enabled, sizeof(enabled));
+	if (enabled < 1 || enabled > 9) {
+		printf("SWEET GPU: audit disabled; sweetgpu=1 read-only, 2 reads ARC resources, 3 raises gfx.lvl, 4 powers CX, 5 GMU clocks/status, 6 firmware staging, 7 DMA/SMMU/HFI mappings, 8 legacy GMU/HFI startup, 9 SQE/CP commands\n");
+		return;
+	}
+
+	printf("SWEET GPU: GPUCC audit v2 at %#x; stage=%d; GMU access requires clock checks\n",
+	    SWEET_GPUCC_PA, enabled);
+	sweet_gpucc = ml_io_map(SWEET_GPUCC_PA, SWEET_GPUCC_SIZE);
+	if (sweet_gpucc == 0) {
+		printf("SWEET GPU: GPUCC mapping failed\n");
+		return;
+	}
+
+	/*
+	 * CX uses the separate HW-control status register in the live DT.
+	 * Preserve raw GX status: the DT also has qcom,poll-cfg-gdscr, whose
+	 * semantics differ across downstream kernels. These snapshots are not
+	 * permission to touch the core, even if a power/clock bit is set.
+	 */
+	cx = sweet_gpucc_read(GPU_CC_CX_GDSCR);
+	cx_hw = sweet_gpucc_read(GPU_CC_CX_HW_CTRL);
+	gx = sweet_gpucc_read(GPU_CC_GX_GDSCR);
+	domain = sweet_gpucc_read(GPU_CC_GX_DOMAIN);
+	reset = sweet_gpucc_read(GPU_CC_GX_BCR);
+	printf("SWEET GPU: CX_GDSCR=%#x CX_HW_CTRL=%#x GX_GDSCR=%#x GX_DOMAIN=%#x GX_BCR=%#x\n",
+	    cx, cx_hw, gx, domain, reset);
+	printf("SWEET GPU: CX pwr_on=%u collapse=%u hw_control=%u; GX bit31=%u collapse=%u hw_control=%u clamp=%u gmem_reset=%u block_reset=%u\n",
+	    !!(cx_hw & GDSC_PWR_ON), !!(cx & GDSC_SW_COLLAPSE),
+	    !!(cx & GDSC_HW_CONTROL), !!(gx & GDSC_PWR_ON),
+	    !!(gx & GDSC_SW_COLLAPSE), !!(gx & GDSC_HW_CONTROL),
+	    !!(domain & 1u), !!(domain & (1u << 4)), !!(reset & 1u));
+
+	for (i = 0; i < sizeof(sweet_gpu_branches) / sizeof(sweet_gpu_branches[0]); i++) {
+		uint32_t value = sweet_gpucc_read(sweet_gpu_branches[i].offset);
+		printf("SWEET GPU: CBCR %s @%#x=%#x enable=%u clk_off=%u fsm=%u\n",
+		    sweet_gpu_branches[i].name, sweet_gpu_branches[i].offset,
+		    value, !!(value & BRANCH_CLK_ENABLE),
+		    !!(value & BRANCH_CLK_OFF), (value >> 28) & 7u);
+	}
+	if (sweet_gpu_arc_tables()) {
+		printf("SWEET GPU: ARC stage stopped; no GPUCC power/clock/reset writes\n");
+		return;
+	}
+	if (enabled == 1) {
+		printf("SWEET GPU: read-only audit complete; sweetgpu=2 reads ARC resources, 3 raises gfx.lvl, 4 powers CX, 5 GMU clocks/status, 6 firmware staging, 7 DMA/SMMU/HFI mappings, 8 legacy GMU/HFI startup, 9 SQE/CP commands\n");
+		return;
+	}
+	sweet_gpu_stage = enabled;
+	thread_t thread;
+	kern_return_t kr = kernel_thread_start(sweet_gpu_arc_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		if (enabled >= 5) {
+			printf("SWEET ADRENO: GMU stage=%d scheduled in 60 s; CX and clock gates first\n", enabled);
+		} else if (enabled == 4) {
+			printf("SWEET ADRENO: CX controller v2 scheduled in 60 s; fresh rail checks required\n");
+		} else if (enabled == 3) {
+			printf("SWEET GPU: ARC gfx raise v1 scheduled in 60 s; gfx only\n");
+		} else {
+			printf("SWEET GPU: ARC readback v1 scheduled in 60 s; no resource votes\n");
+		}
+	} else {
+		printf("SWEET GPU: ARC worker thread failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
