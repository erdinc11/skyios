+{
+	if (!rh_arc_name(res) || minimum <= 1)
+		return EINVAL;
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE))
+		return EBUSY;
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t levels[RH_ARC_MAX_LEVELS] = {0}, reply = 0xffffffffu;
+	unsigned count = 0;
+	if (rh_poisoned)
+		goto out;
+	if (!rh_touch_ready) {
+		error = EAGAIN;
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, levels, &count, &reply);
+	if (error)
+		goto out;
+	if (reply >= count) {
+		error = EIO;
+		goto out;
+	}
+	printf("SWEET RPMH: ARC require %s selector=%u interpreted-level=%u minimum=%u\n",
+	    res, reply, levels[reply], minimum);
+	if (levels[reply] < minimum)
+		error = EAGAIN;
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * Userland RPMh votes for wland (/dev/pmem PMEM_RPMH, root, sweetpmem=1),
+ * limited to what Sweet's WCN3990 and modem bring-up need, with the ranges
+ * from the live FDT: icnss rails L9A (cx-mx 624-760mV), L1C (1.8-xo
+ * 1616-1984), L2C (1.3-rfa 1200-1352), L10C (3.3-ch0 3200-3312) as
+ * {voltage@0, mode@8 (HPM 7), enable@4}; rfclka2 enable@4; and the modem
+ * proxy votes on cx.lvl/mss.lvl (one table index at offset 0). Everything
+ * else, including Sweet's touch supply L11C, is refused.
+ */
+int sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values);
+int
+sweet_rpmh_write(const char *res, unsigned n, const uint32_t *offsets, const uint32_t *values)
+{
+	static const struct { const char *name; unsigned min_mv, max_mv; } rails[] = {
+		{ "ldoa9", 624, 760 }, { "ldoc1", 1616, 1984 }, { "ldoc2", 1200, 1352 }, { "ldoc10", 3200, 3312 },
+	};
+	if (!res || !offsets || !values || n == 0 || n > 4) {
+		return EINVAL;
+	}
+	int rail = -1;
+	for (unsigned i = 0; i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		if (!strcmp(res, rails[i].name)) {
+			rail = (int)i;
+		}
+	}
+	const bool clock = !strcmp(res, "rfclka2");
+	/* 0195: lcx.lvl/lmx.lvl, the ADSP's proxy votes (stock DT qcom,lpass vdd_lpi_cx/mx), for wland's `adsp` boot */
+	const bool arc = !strcmp(res, "cx.lvl") || !strcmp(res, "mss.lvl") || !strcmp(res, "lcx.lvl") || !strcmp(res, "lmx.lvl");
+	if (rail < 0 && !clock && !arc) {
+		printf("SWEET RPMH: userland vote for %s refused (not a Wi-Fi/modem resource)\n", res);
+		return EPERM;
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint32_t o = offsets[i], v = values[i];
+		const bool ok = arc ? (o == 0 && v < RH_ARC_MAX_LEVELS) :
+		    clock ? (o == 4 && v <= 1) :
+		    ((o == 0 && v >= rails[rail].min_mv && v <= rails[rail].max_mv) || (o == 4 && v <= 1) || (o == 8 && v == 7));
+		if (!ok) {
+			printf("SWEET RPMH: userland vote %s offset %#x value %u refused\n", res, o, v);
+			return EPERM;
+		}
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t level[RH_ARC_MAX_LEVELS] = {0};
+	unsigned count = 0;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing userland vote\n");
+		goto out;
+	}
+	error = rh_map();
+	if (!error) {
+		error = rh_lookup(res, arc ? RH_ARC : RH_VRM, &found);
+	}
+	if (!error && arc) {
+		error = rh_arc_levels(&found, level, &count);
+		if (!error && values[0] >= count) {
+			error = ERANGE;
+		}
+	}
+	if (!error) {
+		error = rh_send_cmds(res, found.addr, arc ? 3u : 15u, offsets, values, n,
+		    arc ? RH_ARC_TIMEOUT_US : RH_TIMEOUT_US, NULL);
+	}
+out:
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * 0149: a bus (BCM) vote from the kernel. The apps SMMU (0x15000000) sits
+ * behind the path its downstream node votes (msm-bus 161 -> 627 = BCMs SN15
+ * and CN0, active-only, 1000 KBps); 0131's wland stalled a CPU on its first
+ * apps-SMMU read with no such vote. Command: commit|valid|x<<14|y, as
+ * Linux's BCM_TCS_CMD. Only those two BCMs, only small nonzero levels.
+ */
+int sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y);
+int
+sweet_rpmh_bcm_vote(const char *res, uint32_t x, uint32_t y)
+{
+	/* SN15/CN0: the apps SMMU's path (0149, tiny votes); MC0/SH0/ACV: the memory (0169); SN11/SN0: the IPA's path to DDR (0192) */
+	const bool memory = res && (!strcmp(res, "MC0") || !strcmp(res, "SH0") || !strcmp(res, "ACV"));
+	if (!res || (strcmp(res, "SN15") && strcmp(res, "CN0") && strcmp(res, "SN11") && strcmp(res, "SN0") && !memory) ||
+	    x > (memory ? 0x3fffu : 16u) || y > (memory ? 0x3fffu : 16u) || (!x && !y)) {
+		return EPERM;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, RH_BCM, &found);
+		}
+		if (!error) {
+			const uint32_t offset = 0, value = 1u << 30 | 1u << 29 | x << 14 | y;
+			error = rh_send_cmds(res, found.addr, 3u, &offset, &value, 1, RH_TIMEOUT_US, NULL);
+			static unsigned bcm_logged;
+			if (error || ++bcm_logged <= 4) {
+				printf("SWEET RPMH: BCM %s addr=%#x vote %#x -> %d\n", res, found.addr, value, error);
+			}
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * 0192: a BCM clock vote as Linux's clk-rpmh casts it (clk_rpmh_bcm_set_rate/_send_cmd): level = rate / (cmd-db unit * 1000),
+ * BCM_TCS_CMD(commit, valid, 0, level). Only the IPA core clock (IP0, 100 MHz in ipa_data-v4.2.c).
+ */
+int sweet_rpmh_bcm_clock(const char *res, uint64_t hz);
+int
+sweet_rpmh_bcm_clock(const char *res, uint64_t hz)
+{
+	if (!res || strcmp(res, "IP0") || !hz || hz > 400000000ull) {
+		return EPERM;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	if (!rh_poisoned) {
+		error = rh_map();
+		if (!error) {
+			error = rh_lookup(res, RH_BCM, &found);
+		}
+		if (!error && found.aux_len < 4) {
+			printf("SWEET RPMH: BCM %s has no unit (aux %u bytes)\n", res, found.aux_len);
+			error = EINVAL;
+		}
+		if (!error) {
+			const uint32_t unit = (uint32_t)rh_db16(found.aux) | (uint32_t)rh_db16(found.aux + 2) << 16;
+			const uint64_t level64 = unit ? hz / ((uint64_t)unit * 1000ull) : 0;
+			const uint32_t level = level64 < 1 ? 1u : level64 > 0x3fffu ? 0x3fffu : (uint32_t)level64;
+			const uint32_t offset = 0, value = 1u << 30 | 1u << 29 | level;
+			error = unit ? rh_send_cmds(res, found.addr, 3u, &offset, &value, 1, RH_TIMEOUT_US, NULL) : EINVAL;
+			printf("SWEET RPMH: BCM %s addr=%#x unit %u width %u: %llu Hz -> level %u vote %#x -> %d\n", res, found.addr, unit,
+			    found.aux_len >= 6 ? rh_db16(found.aux + 4) : 0, hz, level, value, error);
+		}
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+
+/*
+ * Raise-only ARC vote. This is deliberately narrower than 0083's fixed
+ * votes: it reads the resource first, refuses a non-index reply, and never
+ * writes a selector below the current level. gfx.lvl and mx.lvl only: a
+ * GPU clock above the bootloader corner first raises both APPS floors so the
+ * rails cannot depend solely on the GMU's own votes. cx.lvl stays untouched.
+ */
+int
+sweet_rpmh_arc_raise(const char *res, unsigned target_vlvl)
+{
+	if (!res || (strcmp(res, "gfx.lvl") && strcmp(res, "mx.lvl")) || target_vlvl == 0) {
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	struct rh_res found = {0};
+	uint32_t level[RH_ARC_MAX_LEVELS] = {0};
+	unsigned count = 0;
+	uint32_t before = 0xffffffffu, after = 0xffffffffu;
+	unsigned selector = 0;
+
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing ARC raise\n");
+		goto out;
+	}
+	if (!rh_touch_ready) {
+		error = EAGAIN;
+		printf("SWEET RPMH: ARC raise deferred: L11C has not completed\n");
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, level, &count, &before);
+	if (error) {
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise before=%#x table-count=%u target-vlvl=%u\n",
+	    res, before, count, target_vlvl);
+	if (before >= count) {
+		printf("SWEET RPMH: ARC %s reply is not a table index; refusing write\n", res);
+		error = EINVAL;
+		goto out;
+	}
+	if (level[before] >= target_vlvl) {
+		printf("SWEET RPMH: ARC %s already at/above vlvl=%u; no write\n",
+		    res, level[before]);
+		error = 0;
+		goto out;
+	}
+	for (selector = 0; selector < count; ++selector) {
+		if (level[selector] >= target_vlvl) {
+			break;
+		}
+	}
+	if (selector == 0 || selector >= count) {
+		printf("SWEET RPMH: ARC %s no safe selector >= target; refusing write\n", res);
+		error = ERANGE;
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise selector=%u vlvl=%u from=%#x vlvl=%u\n",
+	    res, selector, level[selector], before, level[before]);
+	{
+		const uint32_t offset = 0;
+		const uint32_t value = selector;
+		error = rh_send_cmds(res, found.addr, 3u, &offset, &value, 1,
+		    RH_ARC_TIMEOUT_US, NULL);
+	}
+	if (error) {
+		goto out;
+	}
+	error = rh_arc_read_locked(res, &found, level, &count, &after);
+	if (error) {
+		goto out;
+	}
+	printf("SWEET RPMH: ARC %s raise after=%#x expected=%u\n",
+	    res, after, selector);
+	if (after != selector) {
+		printf("SWEET RPMH: ARC %s raise readback mismatch; no retry, no GPUCC access\n", res);
+		error = EIO;
+	} else if (after >= count) {
+		printf("SWEET RPMH: ARC %s raise readback index outside table; no retry\n", res);
+		error = EIO;
+	} else {
+		printf("SWEET RPMH: ARC %s raise verified selector=%u vlvl=%u\n",
+		    res, selector, level[after]);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: ARC raise %s failed errno=%d\n", res, error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/*
+ * 0149 opt-in (sweetsmmuprobe=1): vote SN15+CN0, then read the apps SMMU's
+ * ID registers from a thread of its own, logging before each read so a stall
+ * is visible as the last line. Votes stay in place for wland's SMMU step.
+ */
+/*
+ * 0153 (sweetsmmuwlan=1): wland's smmu_wlan_identity() done here at boot,
+ * where the apps-SMMU reads work, so wland (told by the boot-arg) never
+ * touches the SMMU. Same policy: WLAN SID 0x240 mask 1 -> the lowest free SMR
+ * and a free context bank with translation off (CBAR 0x1f000 = S1 translate,
+ * S2 bypass as ABL's banks; CBA2R AArch64; SCTLR 0xe0 = fault reporting, M=0).
+ */
+#define SMMU_WLAN_SID   0x240u
+#define SMMU_WLAN_MASK  0x1u
+static bool
+smmu_sid_match(uint32_t smr, uint32_t sid, uint32_t mask)
+{
+	uint32_t id = smr & 0x7fff, m = (smr >> 16) & 0x7fff;
+	return ((id ^ sid) & ~(m | mask) & 0x7fff) == 0;
+}
+static void
+sweet_smmu_wlan_stream(volatile uint32_t *gr0, uint32_t id0, uint32_t id1)
+{
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET SMMU: WLAN stream: unexpected geometry smr=%u cb=%u page=%#llx x %llu\n", nsmr, ncb, psize, npage);
+		return;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(0x15000000 + psize, psize);
+	if (!gr1) {
+		return;
+	}
+	uint64_t used[2] = {0, 0};
+	int slot = -1;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			if (slot < 0) {
+				slot = (int)i;
+			}
+			continue;
+		}
+		if (((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 64] |= 1ull << ((s2cr & 0xff) % 64);
+		}
+		if (smmu_sid_match(smr, SMMU_WLAN_SID, SMMU_WLAN_MASK)) {
+			printf("SWEET SMMU: WLAN stream: SMR%u %#x already matches (S2CR %#x)\n", i, smr, s2cr);
+			return;
+		}
+	}
+	int cb = -1;
+	volatile uint32_t *cbp = NULL;
+	for (uint32_t c = 0; c < ncb && cb < 0; c++) {
+		if (used[c / 64] & (1ull << (c % 64)) || gr1[c] != 0) {
+			continue;
+		}
+		volatile uint32_t *page = (volatile uint32_t *)ml_io_map(0x15000000 + (npage + c) * psize, psize);
+		if (page && !(page[0] & 1)) {
+			cb = (int)c;
+			cbp = page;
+		}
+	}
+	if (slot < 0 || cb < 0) {
+		printf("SWEET SMMU: WLAN stream: no free SMR/bank (SMR %d, bank %d)\n", slot, cb);
+		return;
+	}
+	cbp[0x58 / 4] = 0xffffffff;     /* FSR clear */
+	cbp[0x20 / 4] = 0;              /* TTBR0 */
+	cbp[0x24 / 4] = 0;
+	cbp[0x30 / 4] = 0;              /* TCR */
+	cbp[0x10 / 4] = 0;              /* TCR2 */
+	cbp[0x38 / 4] = 0;              /* MAIR */
+	cbp[0x3c / 4] = 0;
+	gr1[(0x800 + 4 * cb) / 4] = 0x00000001;          /* CBA2R: AArch64 */
+	gr1[cb] = 0x0001f000;                             /* CBAR */
+	cbp[0] = 0x000000e0;                              /* SCTLR last */
+	gr0[(0xc00 + 4 * slot) / 4] = (uint32_t)cb;       /* S2CR: translate via the bank */
+	gr0[(0x800 + 4 * slot) / 4] = (1u << 31) | (SMMU_WLAN_MASK << 16) | SMMU_WLAN_SID;
+	gr0[0x70 / 4] = 0;                                /* sTLBGSYNC */
+	for (int i = 0; i < 1000 && (gr0[0x74 / 4] & 1); i++) {
+		delay(1000);
+	}
+	const uint32_t smr = gr0[(0x800 + 4 * slot) / 4], s2cr = gr0[(0xc00 + 4 * slot) / 4];
+	const bool ok = (smr >> 31) && smmu_sid_match(smr, SMMU_WLAN_SID, SMMU_WLAN_MASK) &&
+	    ((s2cr >> 16) & 3) == 0 && (s2cr & 0xff) == (uint32_t)cb;
+	printf("SWEET SMMU: WLAN %#x/%#x -> CB%d via SMR%d: SMR %#x S2CR %#x SCTLR %#x CBAR %#x -> %s\n",
+	    SMMU_WLAN_SID, SMMU_WLAN_MASK, cb, slot, smr, s2cr, cbp[0], gr1[cb], ok ? "ok" : "NOT as written");
+}
+
+/*
+ * 0192/0193: the IPA's apps-SMMU streams (stock DT ipa_smmu_ap <0x520 0>, ipa_smmu_uc <0x522 0>; both banks S1 bypass there),
+ * each in its own SMR with the DT's exact mask, both to one free bank with translation off (as sweet_smmu_wlan_stream).
+ * 0192 boot: an SMR that reads back invalid can still refuse writes (SMR7 read 0 after the write, S2CR took it): owned
+ * elsewhere. So each candidate SMR is written and read back; one that does not keep the value is cleared and skipped.
+ * 0 when both streams match; the IPA is not touched otherwise (bsd/dev/sweet_ipa.c).
+ */
+#define SMMU_IPA_SID   0x520u
+#define SMMU_IPA_UC    0x522u
+int sweet_smmu_ipa_stream(void);
+int
+sweet_smmu_ipa_stream(void)
+{
+	static const uint32_t sids[2] = { SMMU_IPA_SID, SMMU_IPA_UC };
+	volatile uint32_t *gr0 = (volatile uint32_t *)ml_io_map(0x15000000, 0x1000);
+	if (!gr0) {
+		printf("SWEET SMMU: IPA stream: map failed\n");
+		return ENOMEM;
+	}
+	const uint32_t scr0 = gr0[0], id0 = gr0[0x20 / 4], id1 = gr0[0x24 / 4];
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET SMMU: IPA stream: unexpected geometry smr=%u cb=%u\n", nsmr, ncb);
+		return ENODEV;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(0x15000000 + psize, psize);
+	if (!gr1) {
+		return ENOMEM;
+	}
+	uint64_t used[2] = {0, 0};
+	int have[2] = { -1, -1 }, cb = -1;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			continue;
+		}
+		if (((s2cr >> 16) & 3) == 0) {
+			used[(s2cr & 0xff) / 64] |= 1ull << ((s2cr & 0xff) % 64);
+		}
+		for (int k = 0; k < 2; k++) {
+			if (smmu_sid_match(smr, sids[k], 0)) {
+				have[k] = (int)i;
+				if (((s2cr >> 16) & 3) == 0) {
+					cb = (int)(s2cr & 0xff);
+				}
+				printf("SWEET SMMU: IPA stream %#x already in SMR%u %#x (S2CR %#x)\n", sids[k], i, smr, s2cr);
+			}
+		}
+	}
+	volatile uint32_t *cbp = NULL;
+	if (cb < 0) {
+		for (uint32_t c = 0; c < ncb && cb < 0; c++) {
+			if (used[c / 64] & (1ull << (c % 64)) || gr1[c] != 0) {
+				continue;
+			}
+			volatile uint32_t *page = (volatile uint32_t *)ml_io_map(0x15000000 + (npage + c) * psize, psize);
+			if (page && !(page[0] & 1)) {
+				cb = (int)c;
+				cbp = page;
+			}
+		}
+		if (cb < 0) {
+			printf("SWEET SMMU: IPA stream: no free context bank, sCR0 %#x\n", scr0);
+			return ENOSPC;
+		}
+		cbp[0x58 / 4] = 0xffffffff;     /* FSR clear */
+		cbp[0x20 / 4] = 0;              /* TTBR0 */
+		cbp[0x24 / 4] = 0;
+		cbp[0x30 / 4] = 0;              /* TCR */
+		cbp[0x10 / 4] = 0;              /* TCR2 */
+		cbp[0x38 / 4] = 0;              /* MAIR */
+		cbp[0x3c / 4] = 0;
+		gr1[(0x800 + 4 * cb) / 4] = 0x00000001;          /* CBA2R: AArch64 */
+		gr1[cb] = 0x0001f000;                             /* CBAR */
+		cbp[0] = 0x000000e0;                              /* SCTLR last: M=0, faults reported */
+	}
+	unsigned refused = 0;
+	for (int k = 0; k < 2; k++) {
+		for (uint32_t i = 0; i < nsmr && have[k] < 0; i++) {
+			if (gr0[(0x800 + 4 * i) / 4] >> 31) {
+				continue;
+			}
+			const uint32_t s2cr_before = gr0[(0xc00 + 4 * i) / 4];
+			const uint32_t want = (1u << 31) | sids[k];
+			gr0[(0xc00 + 4 * i) / 4] = (uint32_t)cb;  /* S2CR: translate via the bank */
+			gr0[(0x800 + 4 * i) / 4] = want;
+			__asm__ volatile ("dsb sy" ::: "memory");
+			if (gr0[(0x800 + 4 * i) / 4] == want) {
+				have[k] = (int)i;
+				printf("SWEET SMMU: IPA stream %#x -> CB%d via SMR%u (S2CR %#x)\n", sids[k], cb, i, gr0[(0xc00 + 4 * i) / 4]);
+			} else {
+				gr0[(0x800 + 4 * i) / 4] = 0;
+				gr0[(0xc00 + 4 * i) / 4] = s2cr_before;
+				if (refused++ < 8) {
+					printf("SWEET SMMU: IPA stream: SMR%u refused the write (reads %#x), S2CR restored\n", i, gr0[(0x800 + 4 * i) / 4]);
+				}
+			}
+		}
+	}
+	gr0[0x70 / 4] = 0;                                /* sTLBGSYNC */
+	for (int i = 0; i < 1000 && (gr0[0x74 / 4] & 1); i++) {
+		delay(1000);
+	}
+	const bool ok = have[0] >= 0 && have[1] >= 0;
+	printf("SWEET SMMU: IPA streams %#x SMR%d %#x SMR%d, CB%d, %u SMR(s) refused, sCR0 %#x sGFSR %#x -> %s\n", SMMU_IPA_SID, have[0],
+	    SMMU_IPA_UC, have[1], cb, refused, scr0, gr0[0x48 / 4], ok ? "ok" : "NOT set up");
+	return ok ? 0 : EIO;
+}
+
+/*
+ * 0180: read-only. Which SMRs route the display controller (MDSS, DT iommus
+ * SID 0x800 mask 0x440) and how its context bank translates, so a page-flip
+ * present knows whether scanout addresses are physical (bypass or SCTLR.M=0)
+ * or go through an ABL page table (TTBR0).
+ */
+#define SMMU_MDSS_SID   0x800u
+#define SMMU_MDSS_MASK  0x440u
+static void
+sweet_smmu_dump_mdss(volatile uint32_t *gr0, uint32_t id0, uint32_t id1)
+{
+	const uint32_t nsmr = id0 & 0xff, ncb = id1 & 0xff;
+	const uint64_t psize = (id1 >> 31) ? 0x10000 : 0x1000, npage = 1ull << (((id1 >> 28) & 7) + 1);
+	if (psize != 0x1000 || nsmr > 128 || ncb > 128 || (npage + ncb) * psize > 0x100000) {
+		printf("SWEET SMMU: MDSS: unexpected geometry\n");
+		return;
+	}
+	volatile uint32_t *gr1 = (volatile uint32_t *)ml_io_map(0x15000000 + psize, psize);
+	unsigned found = 0;
+	for (uint32_t i = 0; i < nsmr; i++) {
+		const uint32_t smr = gr0[(0x800 + 4 * i) / 4], s2cr = gr0[(0xc00 + 4 * i) / 4];
+		if (!(smr >> 31)) {
+			continue;
+		}
+		const uint32_t id = smr & 0x7fff, m = (smr >> 16) & 0x7fff;
+		/* Overlaps the MDSS stream group: some SID matches both. */
+		if (((id ^ SMMU_MDSS_SID) & ~(m | SMMU_MDSS_MASK) & 0x7fff) != 0) {
+			continue;
+		}
+		found++;
+		const uint32_t type = (s2cr >> 16) & 3, cb = s2cr & 0xff;
+		if (type != 0 || cb >= ncb || gr1 == NULL) {
+			printf("SWEET SMMU: MDSS SMR%u %#x S2CR %#x (type %u: %s)\n", i, smr, s2cr, type,
+			    type == 1 ? "bypass" : type == 2 ? "fault" : "translate");
+			continue;
+		}
+		volatile uint32_t *cbp = (volatile uint32_t *)ml_io_map(0x15000000 + (npage + cb) * psize, psize);
+		if (cbp == NULL) {
+			continue;
+		}
+		printf("SWEET SMMU: MDSS SMR%u %#x S2CR %#x -> CB%u CBAR %#x CBA2R %#x SCTLR %#x TTBR0 %#x%08x TCR %#x TCR2 %#x MAIR %#x,%#x FSR %#x FAR %#x%08x\n",
+		    i, smr, s2cr, cb, gr1[cb], gr1[(0x800 + 4 * cb) / 4], cbp[0], cbp[0x24 / 4], cbp[0x20 / 4],
+		    cbp[0x30 / 4], cbp[0x10 / 4], cbp[0x38 / 4], cbp[0x3c / 4], cbp[0x58 / 4], cbp[0x64 / 4], cbp[0x60 / 4]);
+	}
+	printf("SWEET SMMU: MDSS %#x/%#x: %u matching SMRs\n", SMMU_MDSS_SID, SMMU_MDSS_MASK, found);
+}
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * 0169: memory bandwidth. Nothing here voted for DRAM; the frames stayed at ~300 Mpx/s of GPU fill
+ * whatever the GPU clock, tiling or shaders (0154-0158 hardware). HackiOS (oosexgang/hackios-xnu-kernel,
+ * bsd/dev/hakios.cpufreq.c ddr_raise(), Poco X5 Pro) casts what Linux's interconnect driver casts for a
+ * busy GPU: the memory controller's BCM (MC0) and the shared hub with the system cache (SH0) at the
+ * most there is (commit, valid, average and peak 14 bits each), and ACV with the apps bit (8): their
+ * Control Center 46 -> 59 frames/s, Settings opening 29 -> 37. sweetddr=0: no vote; sweetddrvote=N:
+ * N instead of 0x3fff.
+ */
+void sweet_rpmh_ddr_raise(void);
+void
+sweet_rpmh_ddr_raise(void)
+{
+	uint32_t on = 1, vote = 0x3fff;
+	PE_parse_boot_argn("sweetddr", &on, sizeof(on));
+	PE_parse_boot_argn("sweetddrvote", &vote, sizeof(vote));
+	if (!on || vote == 0 || vote > 0x3fff) {
+		printf("SWEET DDR: no memory bandwidth vote (sweetddr=%u, vote %u)\n", on, vote);
+		return;
+	}
+	const int mc0 = sweet_rpmh_bcm_vote("MC0", vote, vote);
+	const int sh0 = sweet_rpmh_bcm_vote("SH0", vote, vote);
+	const int acv = sweet_rpmh_bcm_vote("ACV", 0, 8);
+	printf("SWEET DDR: memory bandwidth vote %u: MC0 %d, SH0 %d, ACV %d\n", vote, mc0, sh0, acv);
+}
+#endif
