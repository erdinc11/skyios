+bool AGXDeviceUserClient::mount(task_t task,void *securityID,UInt32 type,OSDictionary *properties,unsigned slot)
+{
+ if(!IOUserClient::initWithTask(task,securityID,type,properties))return false;
+ task_=task;slot_=slot;info_=backend.info;
+ if(slot) {
+  info_.va_start=ExtraWindowStart+(uint64_t)(slot-1)*ExtraWindowBytes;
+  info_.va_size=ExtraWindowBytes;
+  if(info_.va_start<backend.info.va_start+backend.info.va_size)return false;
+ }
+ core_=new NativeAdrenoUserClient;
+ if(!core_)return false;
+ IOReturn error=core_->open(NativeAdrenoAbiVersion,backend.vm,backend.submit,backend.ring,32,36);
+ if(!error)error=core_->setScope(slot*NativeAdrenoAbiMaxQueues,info_.va_start,info_.va_size);
+ if(!error)error=core_->attachTimer(&backend.timer);
+ if(!error)error=core_->attachStatus(&backend.status);
+ if(!error)error=core_->attachDeviceInfo(&info_);
+ if(error) {if(core_->close()!=kIOReturnSuccess)backend.lost=true;return false;}
+ mounted_=true;return true;
+}
+IOReturn AGXAccelerator::newUserClient(task_t task,void *securityID,UInt32 type,
+    OSDictionary *properties,IOUserClient **handler)
+{
+ if(!handler)return kIOReturnBadArgument;
+ *handler=nullptr;
+ if(type!=0x4147 || task!=current_task())return kIOReturnUnsupported;
+ char name[32]={};proc_selfname(name,sizeof name);
+ const bool compositor=!strcmp(name,"backboardd");
+ if(!compositor && !(backend.extra_slots && extra_client(name)))return kIOReturnNotPrivileged;
+ IOLockLock(backend.lock);
+ static unsigned open_traces=0;
+ if(open_traces<16) {++open_traces;IOLog("SWEET RENDER: %s open type=%#x\n",name,type); }
+ unsigned slot=0;
+ if(compositor) {
+  if(backend.opened || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnBusy;}
+ } else {
+  for(slot=1;slot<=backend.extra_slots && backend.slot_open[slot];++slot) {}
+  if(slot>backend.extra_slots || !healthy()) {
+   IOLog("SWEET RENDER: %s refused: no free extra Metal slot\n",name);
+   IOLockUnlock(backend.lock);return kIOReturnBusy;
+  }
+ }
+ auto client=new AGXDeviceUserClient;
+ if(!client || !client->mount(task,securityID,type,properties,slot) || !client->attach(this) || !client->start(this)) {
+  if(client)client->release();
+  IOLockUnlock(backend.lock);return kIOReturnNoResources;
+ }
+ if(compositor)backend.opened=true;
+ backend.slot_open[slot]=true;*handler=client;
+ IOLog("SWEET RENDER: %s client connected ABI=%u slot=%u window=%#llx+%#llx\n",name,NativeAdrenoAbiVersion,
+   slot,slot?ExtraWindowStart+(uint64_t)(slot-1)*ExtraWindowBytes:backend.info.va_start,
+   slot?(uint64_t)ExtraWindowBytes:backend.info.va_size);
+ IOLockUnlock(backend.lock);return kIOReturnSuccess;
+}
+IOReturn AGXDeviceUserClient::clientMemoryForType(UInt32 type,IOOptionBits *options,IOMemoryDescriptor **memory)
+{
+ if(!options || !memory)return kIOReturnBadArgument;
+ *memory=nullptr;
+ IOLockLock(backend.lock);
+ NativeAdrenoMemory *buffer=mounted_ && !closed_?core_->memoryForToken(type):nullptr;
+ auto descriptor=buffer?buffer->userDescriptor():nullptr;
+ if(!descriptor || buffer->quarantined()) {IOLockUnlock(backend.lock);return kIOReturnBadArgument;}
+ /* Return this same original descriptor on every map/unmap query. Its maps
+  * retain the BO allocation until the last user mapping really disappears. */
+ descriptor->retain();*memory=descriptor;*options=kIOMapDefaultCache;
+ IOLockUnlock(backend.lock);return kIOReturnSuccess;
+}
+/* 0176: the ADT gives XNU one homogeneous cluster: cpu0-5 are Cortex-A55
+ * (1.8 GHz), cpu6-7 Cortex-A76 (2.3 GHz, far higher IPC). With no AMP
+ * scheduler, CoreAnimation's render thread lands on an A55 whenever app
+ * launches keep other cores busy, and first app opens stutter. Bind the
+ * threads that submit GPU work to cpu7 and the framebuffer present thread to
+ * cpu6. Only when all eight processors are available; sweetbigbind=0 off. */
+extern "C" processor_t thread_bind(processor_t);
+extern "C" processor_t cpu_to_processor(int);
+extern "C" uint32_t processor_avail_count;
+extern "C" bool sweet_bind_current_thread(int cpu)
+{
+ static int enabled=-1;
+ if(enabled<0) {
+  int value=1;
+  PE_parse_boot_argn("sweetbigbind",&value,sizeof value);
+  enabled=value!=0;
+  IOLog("SWEET CPU: big-core binding %s (GPU submitters -> cpu7, present -> cpu6)\n",enabled?"on":"off (sweetbigbind=0)");
+ }
+ if(!enabled)return true;   /* nothing to retry */
+ if(processor_avail_count<8 || cpu<0 || cpu>=8)return false;
+ processor_t target=cpu_to_processor(cpu);
+ if(!target)return false;
+ if(thread_bind(target)!=target || cpu_number()!=cpu)thread_block(THREAD_CONTINUE_NULL);
+ return true;
+}
+IOReturn AGXDeviceUserClient::externalMethod(uint32_t selector,IOExternalMethodArguments *args,
+    IOExternalMethodDispatch *,OSObject *,void *)
+{
+ if(selector==NativeAdrenoMethodSubmitResources)sweet_bind_current_thread(7);
+ if(!args || args->scalarInputCount || args->scalarOutputCount || args->structureOutputDescriptor)return kIOReturnBadArgument;
+ // Large residency lists arrive via IOKit's out-of-line descriptor. Snapshot
+ // once before validation; never dispatch directly from mutable task memory.
+ struct InputCopy {
+  void *data=nullptr;size_t bytes=0;
+  ~InputCopy(){if(data)IOFree(data,bytes);}
+ } copy;
+ IOExternalMethodArguments forwarded=*args;
+ if(args->structureInputDescriptor) {
+  if(selector!=NativeAdrenoMethodSubmitResources ||
+     args->structureInputDescriptor->getLength()!=sizeof(NativeAdrenoAbiSubmitResources))return kIOReturnBadArgument;
+  copy.bytes=sizeof(NativeAdrenoAbiSubmitResources);copy.data=IOMalloc(copy.bytes);
+  if(!copy.data)return kIOReturnNoMemory;
+  IOReturn prepare=args->structureInputDescriptor->prepare(kIODirectionOut);
+  if(prepare)return prepare;
+  const bool copied=args->structureInputDescriptor->readBytes(0,copy.data,copy.bytes)==copy.bytes;
+  IOReturn completed=args->structureInputDescriptor->complete(kIODirectionOut);
+  if(!copied)return kIOReturnVMError;
+  if(completed)return completed;
+  forwarded.structureInput=copy.data;forwarded.structureInputSize=copy.bytes;
+  forwarded.structureInputDescriptor=nullptr;args=&forwarded;
+ }
+ if(args->structureInput && args->structureInputSize>=8) {
+  uint32_t tunnel[2];memcpy(tunnel,args->structureInput,sizeof tunnel);
+  if(tunnel[0]==0x4e544e4c) {
+   if(tunnel[1]==UINT32_MAX) {
+    if(args->structureInputSize!=8 || args->structureOutputSize)return kIOReturnBadArgument;
+    IOLockLock(backend.lock);
+    const bool accepted=mounted_ && !closed_ && healthy();
+    IOLockUnlock(backend.lock);return accepted?kIOReturnSuccess:kIOReturnNotReady;
+   }
+   selector=tunnel[1];
+   forwarded.structureInput=static_cast<const unsigned char *>(args->structureInput)+8;
+   forwarded.structureInputSize-=8;args=&forwarded;
+  }
+ }
+ if(selector<1 || selector>NativeAdrenoMethodSubmitResources)return kIOReturnUnsupported;
+ const size_t input=NativeAdrenoUserClient::inputSize(selector),output=NativeAdrenoUserClient::outputSize(selector);
+ if(args->structureInputSize!=input || args->structureOutputSize!=output ||
+    (input && !args->structureInput) || (output && !args->structureOutput))return kIOReturnBadArgument;
+ /* Turnip waits in 1 ms WaitFence slices. Spinning one under the global lock
+  * stalled every Submit/BoMap/import of the next frame behind the GPU (and
+  * burned a core). Poll the same single check (timeout 0) with the lock
+  * taken only for that check, and block between polls. */
+ if(selector==NativeAdrenoMethodWaitFence && backend.wait_unlocked) {
+  NativeAdrenoAbiWaitFence request{};memcpy(&request,args->structureInput,sizeof request);
+  if(request.timeout_ns) {
+   NativeAdrenoAbiWaitFence poll=request;poll.timeout_ns=0;
+   const uint64_t limit_us=request.timeout_ns/1000?request.timeout_ns/1000:1;
+   const uint64_t began=backend.clock.now_us(backend.clock.cookie);
+   for(;;) {
+    lock_timed();
+    if(!mounted_ || closed_ || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnNotReady;}
+    const IOReturn result=core_->dispatch(selector,&poll,sizeof poll,args->structureOutput,output,&backend.clock);
+    ++wait_polls;
+    const uint64_t now=backend.clock.now_us(backend.clock.cookie);
+    if(result!=kIOReturnTimeout || now-began>=limit_us) {
+     ++method_stats[selector].calls;method_stats[selector].us+=now-began;
+     method_window();
+     if(result && result!=kIOReturnTimeout && trace_errors_++<16)
+      IOLog("SWEET RENDER: method=%u result=%#x\n",selector,result);
+     IOLockUnlock(backend.lock);return result;
+    }
+    IOLockUnlock(backend.lock);
+    IODelay(20);
+   }
+  }
+ }
+ lock_timed();
+ if(!mounted_ || closed_ || !healthy()) {IOLockUnlock(backend.lock);return kIOReturnNotReady;}
+ const uint64_t began=backend.clock.now_us(backend.clock.cookie);
+ uint64_t quiesce_us=0;
+ IOReturn result=kIOReturnSuccess;
+ // BoFree must not unmap while legacy jobs (which hold only their IBs) may
+ // still reference the buffer, so it waits for the actual CP fences. Submit
+ // and BoMap only append: a new mapping uses previously unmapped IOVAs, the
+ // TLB invalidate and the full clean are safe beside running work, and every
+ // job keeps its own fence and references. Pipelining is what lets the CPU
+ // encode frame N+1 while the A618 executes frame N.
+ const bool drains=selector==NativeAdrenoMethodBoFree ||
+     (!backend.pipeline && (selector==NativeAdrenoMethodBoMap || selector==NativeAdrenoMethodSubmit ||
+      selector==NativeAdrenoMethodSubmitResources));
+ if(drains)
+ {
+  result=quiesce();
+  quiesce_us=backend.clock.now_us(backend.clock.cookie)-began;
+ }
+ if(!result && selector==NativeAdrenoMethodBoImport) {
+  NativeAdrenoAbiBoImport request{};NativeAdrenoAbiBoAllocReply reply{};
+  memcpy(&request,args->structureInput,sizeof request);
+  result=core_->importBo(&request,task_,&reply);
+  if(!result)memcpy(args->structureOutput,&reply,sizeof reply);
+ } else if(!result)result=core_->dispatch(selector,args->structureInput,input,args->structureOutput,output,&backend.clock);
+ if(!result)args->structureOutputSize=output;
+ if(selector==NativeAdrenoMethodBoMap) {
+  static unsigned maps=0;
+  if(++maps<=4 || maps%256==0 || result)
+   IOLog("SWEET RENDER: map %u objects=%lu/4128 spans=%lu/%lu total_us=%llu result=%#x\n",maps,
+    (unsigned long)backend.vm->objectCount(),(unsigned long)backend.vm->spanCount(),
+    (unsigned long)backend.vm->spanCapacity(),backend.clock.now_us(backend.clock.cookie)-began,result);
+ }
+ if((selector==NativeAdrenoMethodSubmit || selector==NativeAdrenoMethodSubmitResources) && !result)
+  proc_selfname(last_submitter,sizeof last_submitter);
+ if(selector==NativeAdrenoMethodSubmit) {
+  // Window of 120 legacy submits: kernel time per call and jobs still in
+  // flight after it, i.e. whether the CPU actually ran ahead of the GPU.
+  static unsigned submits=0,busy=0;static uint64_t window_us=0,max_us=0,in_flight=0;
+  const uint64_t spent=backend.clock.now_us(backend.clock.cookie)-began;
+  window_us+=spent;if(spent>max_us)max_us=spent;
+  in_flight+=result?0:backend.submit->outstanding();if(result==kIOReturnBusy)++busy;
+  if(++submits%120==0) {
+   // Full-VM cache publication inside those submits (NativeAdrenoSubmit).
+   const uint64_t ticks=__atomic_exchange_n(&native_adreno_publish_stats[0],0,__ATOMIC_RELAXED);
+   const uint64_t bytes=__atomic_exchange_n(&native_adreno_publish_stats[1],0,__ATOMIC_RELAXED);
+   const uint64_t objects=__atomic_exchange_n(&native_adreno_publish_stats[2],0,__ATOMIC_RELAXED);
+   uint64_t publish_ns=0;absolutetime_to_nanoseconds(ticks,&publish_ns);
+   IOLog("SWEET RENDER: legacy submits %u avg_us=%llu max_us=%llu avg_in_flight_x100=%llu busy=%u drain=%d publish_avg_us=%llu publish_avg_kib=%llu publish_avg_objects=%llu wc_audits=%u dirty=%u stale=%u fail=%#x reasserted=%u distrusted_at=%u\n",submits,
+     window_us/120,max_us,in_flight*100/120,busy,drains,publish_ns/1000/120,bytes/1024/120,objects/120,
+     native_adreno_wc_audit[0],native_adreno_wc_audit[2],native_adreno_wc_audit[3],native_adreno_wc_audit[4],
+     native_adreno_wc_audit[5],native_adreno_wc_distrusted);
+   window_us=max_us=in_flight=0;busy=0;
+  }
+ }
+ if(selector==NativeAdrenoMethodSubmitResources) {
+  static unsigned submissions=0;
+  if(++submissions<=8 || submissions%120==0) {
+   const auto *request=static_cast<const NativeAdrenoAbiSubmitResources *>(args->structureInput);
+   IOLog("SWEET RENDER: scoped submit %u IBs=%u BOs=%u total_us=%llu quiesce_us=%llu result=%#x\n",submissions,
+     request->commands.buffer_count,request->resource_count,
+     backend.clock.now_us(backend.clock.cookie)-began,quiesce_us,result);
+  }
+ }
+
+ bool pending_poll=false;
+ if(selector==NativeAdrenoMethodWaitFence && result==kIOReturnTimeout) {
+  NativeAdrenoAbiWaitFence request{};memcpy(&request,args->structureInput,sizeof request);
+  pending_poll=request.timeout_ns==0;
+ }
+ if(!pending_poll && (trace_calls_++<64 || (result && trace_errors_++<16)))
+  IOLog("SWEET RENDER: method=%u result=%#x\n",selector,result);
+ ++method_stats[selector].calls;method_stats[selector].us+=backend.clock.now_us(backend.clock.cookie)-began;
+ method_window();
+ IOLockUnlock(backend.lock);return result;
+}
+IOReturn AGXDeviceUserClient::clientClose()
+{
+ IOLockLock(backend.lock);
+ if(closed_) {IOLockUnlock(backend.lock);return kIOReturnSuccess;}
+ closed_=true;
+ IOReturn error=mounted_?quiesce():kIOReturnSuccess;
+ if(!error && mounted_)error=core_->releaseAll(&backend.clock,1000000);
+ if(error) {
+  backend.lost=true;
+  char why[64];snprintf(why,sizeof why,"client close %#x slot=%u",error,slot_);
+  sweet_native_adreno_fault_report(why);
+  // Keep uncertain GPU resources and their bookkeeping alive for this boot.
+  retain();
+ } else {
+  mounted_=false;backend.slot_open[slot_]=false;
+  if(!slot_)backend.opened=false;
+  if(slot_)IOLog("SWEET RENDER: extra Metal slot %u closed\n",slot_);
+ }
+ IOLockUnlock(backend.lock);
+ terminate();return error;
+}
+void AGXDeviceUserClient::free()
+{
+ if(core_) {
+  if(mounted_) {
+   // Partial open/start failure: no GPU job was submitted, but do not discard
+   // an object that still owns resources on a failed close.
+   if(core_->close()!=kIOReturnSuccess) {backend.lost=true;core_=nullptr;}
+  }
+  if(core_) {delete core_;core_=nullptr;}
+ }
+ IOUserClient::free();
+}
+/* The owned-BO pool (0146/0147): one physically contiguous block, taken from
+ * bsd init (sweet_ufs_init) while memory is still unfragmented. sweetbopool=MiB
+ * (default 384, 0 = off); halves until a block is found. Returns 1 if held. */
+extern "C" int sweet_native_adreno_reserve_pool(void)
+{
+ if(NativeAdrenoMemory::poolBytes())return 1;
+ uint32_t pool_mib=384;PE_parse_boot_argn("sweetbopool",&pool_mib,sizeof(pool_mib));
+ if(pool_mib>1024)pool_mib=1024;
+ /* Blocks of up to 64 MiB (0137: 48 MiB was the largest contiguous run), halving on refusal. */
+ uint32_t got=0,blocks=0,mib=64;IOReturn last=kIOReturnSuccess;
+ while(got<pool_mib && mib>=16) {
+  uint32_t want=pool_mib-got<mib?pool_mib-got:mib;
+  if(want<16)want=16;
+  last=NativeAdrenoMemory::reservePool(36,(size_t)want<<20);
+  if(last==kIOReturnNoResources)break;   /* every block slot used */
+  if(last) {mib/=2;continue;}
+  got+=want;++blocks;
+ }
+ if(pool_mib)IOLog("SWEET RENDER: owned BO pool reserved %u of %u MiB in %u blocks (%#x)\n",got,pool_mib,blocks,last);
+ return got!=0;
+}
+extern "C" int sweet_native_adreno_publish(NativeAdrenoVm *vm,NativeAdrenoSubmit *submit,
+    NativeAdrenoRing *ring,IOLock *gate,const NativeAdrenoRingClock *clock,
+    int (*health)(void *),int (*read)(void *,uint32_t,uint32_t *),const NativeAdrenoAbiDeviceInfo *info)
+{
+ if(backend.published || !vm || !submit || !ring || !gate || !clock || !clock->now_us || !health || !read || !info)return 1;
+ backend.vm=vm;backend.submit=submit;backend.ring=ring;backend.lock=gate;
+ backend.clock=*clock;backend.health=health;backend.info=*info;
+ const NativeAdrenoTimeIo timerIo={nullptr,read};
+ if(backend.timer.attach(&timerIo,NativeAdrenoTimeCp)!=kIOReturnSuccess || !healthy())return 1;
+ /* Turnip maps every owned BO kIOMapWriteCombineCache, so CPU writes never sit
+  * dirty in a cache; the owned pages are made write-combined to match (the
+  * UniXNU/Sunfish contract). The per-submit IB audit stays armed and on any
+  * dirty line distrusts WC for the rest of the boot (full maintenance again).
+  * 0130 hardware: with WC off the full-VM publish of owned BOs alone grew to
+  * 5.6ms/80MiB per submit. sweetwc=0 restores cacheable owned BOs. */
+ int wc=1;PE_parse_boot_argn("sweetwc",&wc,sizeof(wc));
+ native_adreno_wc_enabled=wc!=0;
+ IOLog("SWEET RENDER: owned BOs %s (sweetwc=%d)\n",wc?"write-combined, IB audit armed":"cacheable with full maintenance",wc);
+ /* 0135 hardware: BoAlloc averaged 22ms (a failing 2MiB contiguous scan of
+  * 255k pages, then one cache-attribute change per page) under the GPU lock.
+  * The UniXNU pool (one contiguous block, write-combined once) was never
+  * reserved here. Owned BOs come from it first; larger or overflow ones keep
+  * the old path. sweetbopool=MiB (0 = off). */
+ /* 0136 hardware: reserved here, only 48 of 192 MiB were still contiguous and
+  * the pool filled within seconds; sweet_native_adreno_reserve_pool() now
+  * takes it early in bsd init, and this only write-combines it. */
+ if(NativeAdrenoMemory::poolBytes() || sweet_native_adreno_reserve_pool()) {
+  const uint64_t began=clock->now_us(clock->cookie);
+  const IOReturn combined=wc?NativeAdrenoMemory::writeCombinePool():kIOReturnSuccess;
+  IOLog("SWEET RENDER: owned BO pool %lu MiB write-combine=%#x in %llu us\n",
+    (unsigned long)(NativeAdrenoMemory::poolBytes()>>20),combined,clock->now_us(clock->cookie)-began);
+ }
+ auto provider=new AGXAccelerator;
+ if(!provider || !provider->init() || !provider->attach(IOService::getPlatform())) {
+  if(provider)provider->release();return 1;
+ }
+ provider->setName("NativeAdrenoGpu");
+ int gles=0,mtl=0;
+ PE_parse_boot_argn("sweetgles",&gles,sizeof(gles));PE_parse_boot_argn("sweetmtl",&mtl,sizeof(mtl));
+ int native=0;PE_parse_boot_argn("sweetnative",&native,sizeof native);
+ if(gles!=1) {
+  // sweetnative=1 opts into the direct AIR/freedreno frontend.
+  // Existing sweetmtl values retain their previous plugin and row-layout behavior.
+  const char *plugin=native==1?"SweetNativeMetal":mtl==1?"NativeAdrenoMetal":"SweetMetal2";
+  provider->setProperty("MetalPluginName",plugin);
+  provider->setProperty("MetalPluginClassName",native==1?"SweetNativeMetalDevice":mtl==1?"SweetAdrenoMetalDevice":"SweetMTL2Device");
+  IOLog("SWEET RENDER: Metal plugin %s selected (sweetmtl=%d sweetnative=%d)\n",plugin,mtl,native);
+ } else IOLog("SWEET GLES: native A618 transport published; Metal discovery disabled for GLES boot\n");
+ provider->setProperty("model","Adreno 618");
+ provider->setProperty("NativeAdrenoABI",NativeAdrenoAbiVersion,32);
+ int extra=3;PE_parse_boot_argn("sweetm2extra",&extra,sizeof(extra));
+ backend.extra_slots=extra<0?0u:(extra>3?3u:(unsigned)extra);
+ int import_sync=0;PE_parse_boot_argn("sweetimportsync",&import_sync,sizeof(import_sync));
+ native_adreno_import_sync=import_sync!=0;
+ uint32_t below_kib=2048;PE_parse_boot_argn("sweetimportmin",&below_kib,sizeof(below_kib));
+ native_adreno_import_sync_below=(uint64_t)below_kib<<10;
+ IOLog("SWEET RENDER: imported BO cache sync by %s (sweetimportsync=%d), kernel still maintains imports below %u KiB\n",
+   import_sync?"kernel at every submit/completion":"client per command",import_sync,below_kib);
+ int swap_fence=0;PE_parse_boot_argn("sweetpresentfence",&swap_fence,sizeof(swap_fence));
+ backend.present_swap_fence=swap_fence!=0;
+ int present_locked=0;PE_parse_boot_argn("sweetpresentlock",&present_locked,sizeof(present_locked));
+ backend.present_locked=present_locked!=0;
+ int pipeline=1;PE_parse_boot_argn("sweetpipeline",&pipeline,sizeof(pipeline));
+ backend.pipeline=pipeline!=0;
+ int wait_locked=0;PE_parse_boot_argn("sweetwaitlock",&wait_locked,sizeof(wait_locked));
+ backend.wait_unlocked=wait_locked==0;
+ IOLog("SWEET RENDER: fence waits %s (sweetwaitlock=%d)\n",
+   backend.wait_unlocked?"poll with the lock dropped between checks":"spin under the lock",wait_locked);
+ IOLog("SWEET RENDER: submission pipelining %s (BoFree/close still drain); extra Metal slots=%u\n",
+   backend.pipeline?"enabled":"disabled",backend.extra_slots);
+ int present_wait=0;PE_parse_boot_argn("sweetpresentwait",&present_wait,sizeof(present_wait));
+ backend.cpu_present=mtl==2 && gles!=1 && present_wait==1;
+ __atomic_store_n(&presentation_ready,true,__ATOMIC_RELEASE);
+ if(backend.cpu_present)IOLog("SWEET RENDER: CPU presentation fence gate enabled\n");
+ backend.published=true;provider->registerService();
+ IOLog("SWEET RENDER: NativeAdreno ABI + Metal discovery published on live A618 context\n");
+ /* Metal.framework probes IOAcceleratorES once, when backboardd initializes
+    CoreAnimation, long before this asynchronous bring-up publishes the
+    service. Restart it once here (Sunfish's install script does the same by
+    hand) so the fresh process finds MetalPluginName. */
+ int restart=1;PE_parse_boot_argn("sweetm2restart",&restart,sizeof(restart));
+ if(gles!=1 && restart==1) {
+  for(int pid=1;pid<99999;pid++) {
+   proc_t p=proc_find(pid);
+   if(!p)continue;
+   const bool match=!strcmp(proc_best_name(p),"backboardd");
+   if(match)proc_signal(pid,SIGKILL);
+   proc_rele(p);
+   if(match) {
+    IOLog("SWEET RENDER: restarted backboardd for Metal discovery\n");
+    break;
+   }
+  }
+ }
+ return 0;
+}
diff --git a/iokit/Kernel/arm/SweetNativeAdrenoRender.cpp b/iokit/Kernel/arm/SweetNativeAdrenoRender.cpp
new file mode 100644
index 000000000..35cfdde3a
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdrenoRender.cpp
@@ -0,0 +1,53 @@
+/* SPDX-License-Identifier: MIT
+ * A618 render-engine setup from pinned SM7150 a6xx_gpu/catalog/XML and
+ * qcom_ubwc_cfg_data sm7150_data. Does not reset the working CP or GMU.
+ */
+#include <IOKit/IOLib.h>
+#include "unixnu/NativeAdrenoABI.h"
+extern "C" int sweet_native_adreno_render_profile(uintptr_t mapping,NativeAdrenoAbiDeviceInfo *info)
+{
+ if(!mapping || !info)return 1;
+ auto core=reinterpret_cast<volatile uint32_t *>(mapping);
+ /* Call only after the boot timestamp fence: no render IB is published yet.
+  * CP_PROTECT, SQE, trusted range and UCHE trap already have the proven boot
+  * values. Complete the previously missing 3D blocks and GMEM/UBWC layout. */
+ static const struct {unsigned reg,value,mask;} setup[]={
+  {0x0c01,1,1}, {0x8601,1,1}, {0x8e05,1,1}, {0x9e01,1,1},
+  {0xbe05,1,1}, {0xa601,1,1}, {0x9601,1,1}, {0xae01,1,1}, {0xb601,1,1},
+  {0x050b,0xffffffff,0}, {0x0500,1,1},
+  {0x0e0b,0x100000,0xffffffff}, {0x0e0c,0,0xffffffff},
+  /* A618 log0111: MAX reads 0x17f000 after Linux's 0x17ffff write.
+   * The inclusive limit's low 12 bits are RAZ; validate the page address.
+   * Keep Linux's inclusive-end programming and check all upper bits. */
+  {0x0e0d,0x17ffff,0xfffff000}, {0x0e0e,0,0xffffffff},
+  {0x9e00,0x00180000,0x00180000},
+  /* UBWC2: bank14 (hbb_lo1), min32B, four channels, levels2+3 swizzle. */
+  {0x8e08,2,0xffffffff}, {0xb604,2,0xffffffff}, {0xae02,2,0xffffffff},
+  {0x0e01,1u<<21,(1u<<23)|(3u<<21)},
+  /* Downstream A618 a6xx_start programs UCHE_CLIENT_PF=1. The XML calls
+   * this field PERFSEL, not a render-enable bit. On sweet0114 bit7 read
+   * zero after the generic mainline0x81 write. Use the vendor selector
+   * and validate its entire8-bit field instead of gating on that bit. */
+  {0x0e19,1,0xff},
+  /* A618 has no eight-channel macrotiling override. Downstream a6xx_start
+   * accesses RBBM_NC_MODE_CNTL only for channel==8. Preserve its reset
+   * setting here; 0112 hardware reads 0xdeafbead from 0x534. */
+ };
+ for(const auto &entry:setup) {
+  core[entry.reg]=entry.value;
+  __asm__ volatile("dsb sy":::"memory");
+  const uint32_t value=core[entry.reg];
+  if(value==0xdeafbead || (value==UINT32_MAX && entry.value!=UINT32_MAX)) {
+   IOLog("SWEET RENDER: invalid readback reg=%#x value=%#x\n",entry.reg,value);return 1;
+  }
+  if((value&entry.mask)!=(entry.value&entry.mask)) {
+   IOLog("SWEET RENDER: reg=%#x expected=%#x read=%#x\n",entry.reg,entry.value,value);return 1;
+  }
+ }
+ if(core[0x084f]!=0xb || core[0x0e09]!=0xfffff000 || core[0x0e0a]!=0x1ffff)return 1;
+ *info={0x06010800,512u*1024u,0x100000,UINT64_C(0x1fffffffff000),
+     UINT64_C(0x40000000),UINT64_C(0x30000000),14,6,0,2,NativeAdrenoDeviceClientIova,0};
+ IOLog("SWEET RENDER: A618 PERFSEL legacy selector=1 accepted\n");
+ IOLog("SWEET RENDER: A618 address modes/GMEM512K/UBWC2 programmed and read back\n");
+ return 0;
+}
diff --git a/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp b/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp
new file mode 100644
index 000000000..064cf159d
--- /dev/null
+++ b/iokit/Kernel/arm/SweetNativeAdrenoVM.cpp
@@ -0,0 +1,259 @@
+/* SPDX-License-Identifier: MIT
+ * sweet/A618 live BO arena. Called before SQE release, under the boot GPU
+ * owner's lease. Never replaces an enabled CB0 or touches GMU CB1.
+ */
+#include <IOKit/IOLib.h>
+#include <sys/errno.h>
+#include "../../../bsd/dev/sweet_adreno_cp.h"
+#include "unixnu/NativeAdrenoVm.h"
+#include "unixnu/NativeAdrenoSubmit.h"
+#include "unixnu/NativeAdrenoABI.h"
+extern "C" int sweet_native_adreno_render_profile(uintptr_t,NativeAdrenoAbiDeviceInfo *);
+extern "C" volatile uint32_t native_adreno_force_wb;
+extern "C" int sweet_native_adreno_publish(NativeAdrenoVm *,NativeAdrenoSubmit *,NativeAdrenoRing *,IOLock *,
+    const NativeAdrenoRingClock *,int (*)(void *),int (*)(void *,uint32_t,uint32_t *),const NativeAdrenoAbiDeviceInfo *);
+
+namespace {
+constexpr unsigned PollBudget=100000, TableBytes=0x404000;
+constexpr uint64_t ArenaStart=0x40000000, ArenaBytes=0x80000000;
+struct BootVm {
+ NativeAdrenoMemory tables,firmware,ring,fence;
+ NativeAdrenoVm vm;
+ NativeAdrenoSubmit submit;
+ ArmSmmu4KLiveArena arena{};
+ ArmSmmu4KLiveState live{};
+ ArmSmmu4KLiveVisibility visibility{};
+ ArmSmmu4KContextConfig config{};
+ ArmSmmu4KStreamState streams{};
+ ArmSmmu4KIo io{};
+ a618_smmu_io hardware{};
+ uint64_t handles[3]{};
+ bool attempted=false,ready=false,connected=false,faultWriteQuirk=false;
+} state;
+int read32(void *,size_t offset,uint32_t *value)
+{
+ if(!value || (offset&3) || offset>0xfffc)return 1;
+ *value=state.hardware.registers.read(state.hardware.registers.cookie,(uint32_t)offset);
+ return *value==UINT32_MAX;
+}
+int read64(void *,size_t offset,uint64_t *value)
+{
+ if(!value || (offset&7) || offset>0xfff8)return 1;
+ *value=state.hardware.read64(state.hardware.registers.cookie,(uint32_t)offset);
+ return *value==UINT64_MAX;
+}
+int write32(void *,size_t offset,uint32_t value)
+{
+ /* Restrict the helper to its leased CB0 and one stream slot. The SMMU
+  * core does no global writes, and never accesses the GMU context bank. */
+ const unsigned slot=state.streams.streams[0].slot;
+ if((offset&3) || !((offset>=0x8000 && offset<=0x8ffc) || offset==0x1000 ||
+     offset==0x1800 || offset==0x800+4*slot || offset==0xc00+4*slot))return 1;
+ /* Qualcomm firmware can ignore FAULT writes and rewrite BYPASS to FAULT.
+  * This flag is probed ONLY while our exact leased SMR is still invalid.
+  * Never request a real bypass stream or change the GMU route. */
+ if(offset==0xc00+4*slot && value==(2u<<16) && state.faultWriteQuirk)value=(1u<<16)|0xffu;
+ state.hardware.registers.write(state.hardware.registers.cookie,(uint32_t)offset,value);
+ return 0;
+}
+int write64(void *,size_t offset,uint64_t value)
+{
+ if((offset&7) || offset<0x8000 || offset>0x8ff8)return 1;
+ state.hardware.write64(state.hardware.registers.cookie,(uint32_t)offset,value);
+ return 0;
+}
+int barrier(void *)
+{state.hardware.barrier(state.hardware.registers.cookie);return 0;}
+int failed(const char *where,IOReturn error)
+{
+ /* All descriptor and VM storage is retained on an uncertain failure. There
+  * is no fallback that clears active tables or restarts an already-run SQE. */
+ IOLog("SWEET NATIVE VM: %s failed=%#x; all resources retained\n",where,error);
+ state.ready=false;return EIO;
+}
+int translate(uint64_t iova,uint64_t *physical)
+{
+ if(write64(nullptr,0x8800,iova) || barrier(nullptr))return EIO;
+ for(unsigned i=0;i<1000;++i) {
+  uint32_t status=0;
+  if(read32(nullptr,0x88f0,&status))return EIO;
+  if(!(status&1))return read64(nullptr,0x8050,physical)?EIO:0;
+  state.hardware.registers.delay_us(state.hardware.registers.cookie,1);
+ }
+ return ETIMEDOUT;
+}
+}
+extern "C" int sweet_native_adreno_prepare_vm(const a618_smmu_io *hardware,
+    const a618_dma_region *memory,a618_smmu_result *result)
+{
+ if(!hardware || !memory || !result || !hardware->registers.read || !hardware->registers.write ||
+    !hardware->registers.delay_us || !hardware->read64 || !hardware->write64 || !hardware->barrier ||
+    !memory->cpu || !memory->uncached || memory->bytes!=A618_CP_DMA_BYTES ||
+    (memory->physical&0x3fff) || memory->physical>=(UINT64_C(1)<<36) ||
+    memory->bytes>(UINT64_C(1)<<36)-memory->physical)return EINVAL;
+ if(state.attempted)return EBUSY;
+ state.attempted=true;state.hardware=*hardware;*result={};result->slot=UINT32_MAX;
+ state.io={nullptr,0x10000,read32,read64,write32,write64,barrier,1};
+ uint32_t id0=0,id1=0,id2=0,control=0,sctlr=0,fsr=0;
+ if(read32(nullptr,0x20,&id0) || read32(nullptr,0x24,&id1) || read32(nullptr,0x28,&id2) ||
+    read32(nullptr,0,&control) || read32(nullptr,0x8000,&sctlr) || read32(nullptr,0x8058,&fsr))return EIO;
+ if(fsr&(1u<<30))return EBUSY;
+ if(id0!=0x48016605 || id1!=0x20008005 || id2!=0x7511 || (sctlr&1))return ENOTSUP;
+ /* Claim only an invalid slot. An active SID0 or any live CB0 route is a
+  * foreign owner, regardless of its apparent idle state. */
+ unsigned slot=UINT32_MAX;
+ for(unsigned i=0;i<5;++i) {
+  uint32_t smr=0,s2cr=0;
+  if(read32(nullptr,0x800+4*i,&smr) || read32(nullptr,0xc00+4*i,&s2cr))return EIO;
+  if(smr&(1u<<31)) {
+   const uint32_t mask=(smr>>16)&0x7fff;
+   if(((smr&0xffff)&~mask)==0 || (!(s2cr&(3u<<16)) && !(s2cr&255)))return EBUSY;
+  } else if(slot==UINT32_MAX)slot=i;
+ }
+ if(slot==UINT32_MAX)return ENOSPC;
+ result->slot=slot;result->context=0;result->control=control;
+ /* The boot GMU owner has already established enable/fault-on-unmatched,
+  * with global IRQ disabled. Preserve that policy and every other route. */
+ if((control&0x407)!=0x402)return ENOTSUP;
+ state.streams.streams[0]={slot,0};
+ /* Pinned Linux qcom_smmu_cfg_probe/qcom_smmu_write_s2cr quirk.
+  * Probe the claimed INVALID slot: global USFCFG faults unmatched traffic,
+  * and no valid SID or enabled CB0 exists here. Do not probe any live route. */
+ uint32_t invalidSmr=0,probe=0,faulted=0;
+ if(read32(nullptr,0x800+4*slot,&invalidSmr) || (invalidSmr&(1u<<31)))return EBUSY;
+ if(write32(nullptr,0xc00+4*slot,(1u<<16)|0xffu) || barrier(nullptr) ||
+    read32(nullptr,0xc00+4*slot,&probe))return EIO;
+ if((probe&~0xffu)==(2u<<16))state.faultWriteQuirk=true;
+ else if(probe!=((1u<<16)|0xffu))return failed("S2CR quirk probe",kIOReturnIOError);
+ if(write32(nullptr,0xc00+4*slot,2u<<16) || barrier(nullptr) ||
+    read32(nullptr,0xc00+4*slot,&faulted) || (faulted&~0xffu)!=(2u<<16))
+  return failed("S2CR fault readback",kIOReturnIOError);
+ IOLog("SWEET NATIVE VM: leased slot=%u S2CR probe=%#x fault=%#x qcom_quirk=%u\n",
+     slot,probe,faulted,(unsigned)state.faultWriteQuirk);
+ const ArmSmmu4KStream stream={slot,0};ArmSmmu4KStreamResult routes{};
+ ArmSmmu4KStatus status=ArmSmmu4KCheckFaultedStreams(&state.io,&stream,1,0,&routes);
+ if(status) {
+  IOLog("SWEET NATIVE VM: route detail ID0=%#x sCR0=%#x GFSR=%#x verified=%u SMR=%#x S2CR=%#x\n",
+      routes.id0,routes.scr0,routes.global_fault,routes.streams_verified,invalidSmr,faulted);
+  return failed("route preflight",(IOReturn)status);
+ }
+ IOReturn error=state.tables.allocate(TableBytes,36,true,8u*1024u*1024u);
+ if(error)return failed("table allocation",error);
+ error=NativeAdrenoPrepareSmmuMemory(&state.tables,32,36,ArenaStart,ArenaBytes,0,
+     ArenaBytes/4096,&state.arena,&state.live,&state.visibility);
+ if(error)return failed("table preparation",error);
+ uint32_t wb=0;
+ PE_parse_boot_argn("sweetgpuwb",&wb,sizeof(wb));
+ native_adreno_force_wb=wb?1:0;
+ printf("SWEET ADRENO: GPU mappings %s (sweetgpuwb=%u)\n",wb?"forced write-back":"as the client asks",wb);
+ uint32_t walk=0;
+ PE_parse_boot_argn("sweetsmmuwalk",&walk,sizeof(walk));
+ printf("SWEET ADRENO: GPU SMMU table walks %s (sweetsmmuwalk=%u)\n",walk?"cacheable (inner WBWA)":"outer non-cacheable",walk);
+ state.config={&state.arena.config,nullptr,&state.live.tables,nullptr,id0,id2,0x62,walk?1u:0u,0,1,1};
+ ArmSmmu4KProgramResult programmed{};
+ status=ArmSmmu4KProgramDisabledContext(&state.io,0,&state.config,PollBudget,&programmed);
+ if(status)return failed("context programming",(IOReturn)status);
+ status=ArmSmmu4KAttachStreams(&state.io,&state.streams,&stream,1,0,&state.config,&routes);
+ if(status)return failed("stream attachment",(IOReturn)status);
+ NativeAdrenoVmRegion region={&state.tables,&state.arena,&state.live};
+ error=state.vm.attach(&state.io,&state.config,&state.streams,&region,nullptr,65536,PollBudget);
+ if(error)return failed("VM attachment",error);
+ NativeAdrenoMemory *objects[]={&state.firmware,&state.ring,&state.fence};
+ const unsigned offsets[]={A618_CP_SQE_OFFSET,A618_CP_RING_OFFSET,A618_CP_FENCE_OFFSET};
+ const unsigned sizes[]={0x8000,0x8000,0x4000};
+ const uint64_t addresses[]={A618_CP_IOVA,A618_CP_RING_IOVA,A618_CP_FENCE_IOVA};
+ for(unsigned i=0;i<3;++i) {
+  error=objects[i]->borrowBootStorage(memory->cpu+offsets[i],memory->physical+offsets[i],sizes[i],36);
+  if(!error)error=state.vm.map(objects[i],0,addresses[i],ArmSmmu4KRead|
+      (i?ArmSmmu4KWrite:ArmSmmu4KExecute),0,2,&state.handles[i]);
+  if(error)return failed("bootstrap mapping",error);
+ }
+ /* Prove real translations for the unchanged firmware/ring/fence IOVAs,
+  * including the immediately following unmapped guard, before SQE starts. */
+ for(unsigned i=0;i<=20;++i) {
+  uint64_t translated=0;
+  const int failure=translate(A618_CP_IOVA+4096ull*i,&translated);
+  result->par=translated;
+  if(failure)return failure;
+  if(i==20) {if(!(translated&1))return EFAULT;}
+  else {
+   const uint64_t expected=memory->physical+A618_CP_SQE_OFFSET+4096ull*i;
+   if((translated&1) || (translated&UINT64_C(0xffffff000))!=expected)return EFAULT;
+   ++result->translated;
+  }
+ }
+ if(read32(nullptr,0x8058,&result->fault) || (result->fault&0xc00001feu))return EIO;
+ result->offset=0x800+4*slot;
+ if(read32(nullptr,result->offset,&result->value))return EIO;
+ state.ready=true;
+ IOLog("SWEET NATIVE VM: CB0 active ASID62 4K GPU /16K host, aperture=%#llx+%#llx tablePA=%#llx pages=%lu bootstrap=%u\n",
+     ArenaStart,ArenaBytes,state.tables.spans()[0].physical,state.live.tables.table_pages,result->translated);
+ return 0;
+}
+/*
+ * 0246: kernel-owned GPU mappings for the framebuffer's GPU present copy (SweetFramebuffer.cpp), in
+ * 0xb0000000..0xc0000000 of the arena: above backboardd's window, the CP firmware/ring/fence at 0x70000000 and
+ * the three 256 MiB extra client windows from 0x80000000, so no client IOVA can collide with them. Taken under
+ * the same gate as the userclient's BO maps and submissions. task != NULL: pin address..+bytes of that task
+ * (kernel_task for an IOSurface's kernel mapping); task == NULL: a physically contiguous range with its own CPU
+ * mapping (the scanout buffers in ABL's splash region). The caller unmaps only after its GPU work completed.
+ */
+static IOLock *sweet_kernel_gate;
+namespace {
+constexpr uint64_t KernelWindowStart=0xb0000000,KernelWindowEnd=0xc0000000;
+struct SweetKernelMap {NativeAdrenoMemory memory;uint64_t handle=0;};
+}
+extern "C" void *sweet_native_adreno_kmap(void *task,uint64_t address,uint64_t physical,size_t bytes,uint64_t iova,int writable)
+{
+ if(!state.ready || !state.connected || !sweet_kernel_gate || !address || !bytes || (bytes&4095) || (iova&4095) ||
+    iova<KernelWindowStart || bytes>KernelWindowEnd-KernelWindowStart || iova>KernelWindowEnd-bytes)return nullptr;
+ SweetKernelMap *m=new SweetKernelMap;
+ if(!m)return nullptr;
+ IOLockLock(sweet_kernel_gate);
+ IOReturn error=task?m->memory.importTask(task,address,bytes,36,bytes):
+     m->memory.borrowBootStorage(reinterpret_cast<void *>(address),physical,bytes,36);
+ const IOReturn backing=error;
+ if(!error)error=state.vm.map(&m->memory,0,iova,ArmSmmu4KRead|(writable?ArmSmmu4KWrite:0u),0,2,&m->handle);
+ const bool mapped=!error;
+ if(!error)error=state.vm.invalidateTlb();
+ IOLockUnlock(sweet_kernel_gate);
+ if(error) {
+  IOLog("SWEET NATIVE VM: kernel map %#llx+%#lx (%s) failed=%#x backing=%#x\n",iova,(unsigned long)bytes,
+      task?"task":"physical",error,backing);
+  if(!mapped) {
+   IOLockLock(sweet_kernel_gate);
+   const IOReturn released=backing?kIOReturnSuccess:m->memory.release();
+   IOLockUnlock(sweet_kernel_gate);
+   if(!released)delete m;   /* else retained: ownership uncertain */
+  }
+  return nullptr;
+ }
+ return m;
+}
+extern "C" int sweet_native_adreno_kunmap(void *cookie)
+{
+ SweetKernelMap *m=static_cast<SweetKernelMap *>(cookie);
+ if(!m || !sweet_kernel_gate)return EINVAL;
+ IOLockLock(sweet_kernel_gate);
+ IOReturn error=state.vm.unmap(m->handle);
+ if(!error)error=m->memory.release();
+ IOLockUnlock(sweet_kernel_gate);
+ if(error) {IOLog("SWEET NATIVE VM: kernel unmap failed=%#x; mapping retained\n",error);return EIO;}
+ delete m;
+ return 0;
+}
+extern "C" int sweet_native_adreno_connect_vm(NativeAdrenoRing *ring,IOLock *gate,const NativeAdrenoRingClock *clock,
+    uintptr_t core,int (*health)(void *),int (*read)(void *,uint32_t,uint32_t *))
+{
+ if(!state.ready || state.connected || !ring)return ENXIO;
+ const IOReturn error=state.submit.attach(&state.vm,ring);
+ if(error)return failed("submit attachment",error);
+ NativeAdrenoAbiDeviceInfo info{};
+ if(sweet_native_adreno_render_profile(core,&info))return failed("render profile",kIOReturnIOError);
+ if(sweet_native_adreno_publish(&state.vm,&state.submit,ring,gate,clock,health,read,&info))
+  return failed("userclient publication",kIOReturnIOError);
+ state.connected=true;
+ sweet_kernel_gate=gate;
+ IOLog("SWEET NATIVE VM: live BO/IB manager connected to compositor userclient\n");
+ return 0;
+}
diff --git a/iokit/Kernel/arm/unixnu/AdrenoPM4.cpp b/iokit/Kernel/arm/unixnu/AdrenoPM4.cpp
new file mode 100644
index 000000000..12b293640
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/AdrenoPM4.cpp
@@ -0,0 +1,87 @@
+/* SPDX-License-Identifier: MIT */
+#include "AdrenoPM4.h"
+
+/* Add one bit to make the field's total population odd. */
+static uint32_t odd_bit(uint32_t field)
+{
+    uint32_t parity = 1;
+    while (field) {
+        parity ^= 1;
+        field &= field - 1;
+    }
+    return parity;
+}
+
+AdrenoPM4Status AdrenoPM4Type4(uint32_t reg, uint32_t count, uint32_t *header)
+{
+    if (!header || reg > 0x3ffff || !count || count > 127 ||
+        count - 1 > 0x3ffff - reg)
+        return AdrenoPM4InvalidArgument;
+    *header = 0x40000000u | count | (odd_bit(count) << 7) |
+        (reg << 8) | (odd_bit(reg) << 27);
+    return AdrenoPM4Success;
+}
+
+AdrenoPM4Status AdrenoPM4Type7(uint32_t opcode, uint32_t count, uint32_t *header)
+{
+    if (!header || opcode > 127 || count > 0x3fff)
+        return AdrenoPM4InvalidArgument;
+    *header = 0x70000000u | count | (odd_bit(count) << 15) |
+        (opcode << 16) | (odd_bit(opcode) << 23);
+    return AdrenoPM4Success;
+}
+
+static AdrenoPM4Status decode(uint32_t word, AdrenoPM4Packet *packet)
+{
+    uint32_t rebuilt;
+    AdrenoPM4Status status;
+    packet->type = word >> 28;
+    if (packet->type == 4) {
+        packet->identifier = (word >> 8) & 0x3ffff;
+        packet->payload_words = word & 127;
+        status = AdrenoPM4Type4(packet->identifier, packet->payload_words, &rebuilt);
+    } else if (packet->type == 7) {
+        packet->identifier = (word >> 16) & 127;
+        packet->payload_words = word & 0x3fff;
+        status = AdrenoPM4Type7(packet->identifier, packet->payload_words, &rebuilt);
+    } else {
+        return AdrenoPM4InvalidHeader;
+    }
+    if (status != AdrenoPM4Success || rebuilt != word)
+        return AdrenoPM4InvalidHeader;
+    return AdrenoPM4Success;
+}
+
+AdrenoPM4Status AdrenoPM4Plan(const uint32_t *words, size_t word_count,
+    AdrenoPM4Packet *output, size_t capacity, size_t *count)
+{
+    size_t at = 0, packets = 0;
+    AdrenoPM4Packet packet;
+    if (!count)
+        return AdrenoPM4InvalidArgument;
+    *count = 0;
+    if ((word_count && !words) || (capacity && !output) ||
+        word_count > SIZE_MAX / sizeof(*words) || capacity > SIZE_MAX / sizeof(*output))
+        return AdrenoPM4InvalidArgument;
+    while (at < word_count) {
+        AdrenoPM4Status status = decode(words[at], &packet);
+        if (status != AdrenoPM4Success)
+            return status;
+        /* Subtraction keeps both bounds checking and the next offset safe. */
+        if (packet.payload_words > word_count - at - 1)
+            return AdrenoPM4Truncated;
+        at += 1 + packet.payload_words;
+        ++packets;
+    }
+    if (packets > capacity)
+        return AdrenoPM4Capacity;
+    at = packets = 0;
+    while (at < word_count) {
+        (void)decode(words[at], &packet); /* Immutable input, already checked. */
+        packet.header_word = at;
+        output[packets++] = packet;
+        at += 1 + packet.payload_words;
+    }
+    *count = packets;
+    return AdrenoPM4Success;
+}
diff --git a/iokit/Kernel/arm/unixnu/AdrenoPM4.h b/iokit/Kernel/arm/unixnu/AdrenoPM4.h
new file mode 100644
index 000000000..ceaefa233
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/AdrenoPM4.h
@@ -0,0 +1,43 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ADRENO_PM4_H
+#define ADRENO_PM4_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    AdrenoPM4Success = 0,
+    AdrenoPM4InvalidArgument,
+    AdrenoPM4InvalidHeader,
+    AdrenoPM4Truncated,
+    AdrenoPM4Capacity
+} AdrenoPM4Status;
+
+typedef struct {
+    size_t header_word;
+    uint32_t type;          /* 4 (register sequence) or 7 (opcode). */
+    uint32_t identifier;    /* Register index or opcode; NOT authorization. */
+    uint32_t payload_words;
+} AdrenoPM4Packet;
+
+/* Supported emission profile: 18-bit registers, 1..127 values; 7-bit
+ * opcodes, 0..16383 values. No silent masking. Failure preserves *header. */
+AdrenoPM4Status AdrenoPM4Type4(uint32_t reg, uint32_t count, uint32_t *header);
+AdrenoPM4Status AdrenoPM4Type7(uint32_t opcode, uint32_t count, uint32_t *header);
+
+/* Structural decoding only. A successful plan DOES NOT authorize register
+ * writes, addresses, opcodes, indirect buffers or hardware submission.
+ * Input is an immutable array of logical 32-bit words (little-endian on
+ * the target). All extents must be real caller-owned accessible storage.
+ * Input, output and count must not alias; input must remain immutable.
+ * Validate the whole input and capacity before writing any packet record.
+ * On failure, *count=0 and output is untouched. Empty input succeeds.
+ * No allocation, recursion, payload interpretation, MMIO or completion. */
+AdrenoPM4Status AdrenoPM4Plan(const uint32_t *words, size_t word_count,
+    AdrenoPM4Packet *output, size_t capacity, size_t *count);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4K.c b/iokit/Kernel/arm/unixnu/ArmSmmu4K.c
new file mode 100644
index 000000000..be5f30249
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4K.c
@@ -0,0 +1,111 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4K.h"
+#define PAGE_BYTES UINT64_C(4096)
+#define ADDRESS_MASK UINT64_C(0x0000fffffffff000)
+
+static ArmSmmu4KStatus build_region(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result, unsigned upper)
+{
+    if (!result) return ArmSmmu4KArgument;
+    result->root_physical = result->mair = 0;
+    result->table_pages = result->leaf_pages = result->start_level = 0;
+    result->upper_region = 0;
+    if (!config || !ranges || !range_count || !tables || !capacity ||
+        capacity > SIZE_MAX / PAGE_BYTES || range_count > SIZE_MAX / sizeof(*ranges) ||
+        config->input_bits < 32 || config->input_bits > 48 ||
+        !(config->output_bits == 32 || config->output_bits == 36 || config->output_bits == 40 ||
+          config->output_bits == 42 || config->output_bits == 44 || config->output_bits == 48) ||
+        !config->leaf_budget || config->leaf_budget > (SIZE_MAX - 1) / 3 ||
+        ((uintptr_t)tables & 7)) return ArmSmmu4KArgument;
+    if (range_count > config->leaf_budget) return ArmSmmu4KBudget;
+    uint64_t input_limit = UINT64_C(1) << config->input_bits;
+    uint64_t output_limit = UINT64_C(1) << config->output_bits;
+    uint64_t pool_bytes = (uint64_t)capacity * PAGE_BYTES;
+    uint64_t pool = config->table_physical;
+    if ((pool & 4095) || pool >= output_limit || pool_bytes > output_limit - pool)
+        return ArmSmmu4KBadRange;
+    size_t leaves = 0;
+    uint64_t previous_end = 0;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        if (!r->bytes || ((r->iova | r->physical | r->bytes) & 4095) ||
+            (!(r->permissions & ArmSmmu4KRead) || (r->permissions & ~15u)) || r->writeback > 1 || (r->shareability != 2 && r->shareability != 3) ||
+            r->physical >= output_limit || r->bytes > output_limit - r->physical)
+            return ArmSmmu4KBadRange;
+        if (upper ? (r->iova < UINT64_MAX-input_limit+1 || r->bytes-1 > UINT64_MAX-r->iova) :
+                    (r->iova >= input_limit || r->bytes > input_limit-r->iova))
+            return ArmSmmu4KBadRange;
+        if (i && r->iova <= previous_end) return ArmSmmu4KOverlap;
+        previous_end = r->iova + (r->bytes-1);
+        if (r->physical < pool + pool_bytes && pool < r->physical + r->bytes)
+            return ArmSmmu4KOverlap;
+        for (size_t j = 0; j < i; ++j) {
+            if ((r->writeback != ranges[j].writeback || r->shareability != ranges[j].shareability || ((r->permissions ^ ranges[j].permissions) & ArmSmmu4KPrivileged)) && r->physical < ranges[j].physical + ranges[j].bytes &&
+                ranges[j].physical < r->physical + r->bytes) return ArmSmmu4KOverlap;
+        }
+        uint64_t pages = r->bytes / PAGE_BYTES;
+        if (pages > config->leaf_budget - leaves) return ArmSmmu4KBudget;
+        leaves += (size_t)pages;
+    }
+    /* Each range has at least one leaf, so the validated leaf budget also
+     * bounds the range/alias loops. Sorted IOVAs make prefix counting exact. */
+    unsigned levels = (config->input_bits - 12 + 8) / 9;
+    unsigned start = 4 - levels;
+    size_t required = 1;
+    uint64_t last[3] = {UINT64_MAX, UINT64_MAX, UINT64_MAX};
+    for (size_t i = 0; i < range_count; ++i) {
+        for (uint64_t offset = 0; offset < ranges[i].bytes; offset += PAGE_BYTES) {
+            uint64_t va = ranges[i].iova + offset;
+            for (unsigned level = start; level < 3; ++level) {
+                uint64_t prefix = va >> (39 - 9 * level);
+                if (prefix != last[level]) { ++required; last[level] = prefix; }
+            }
+        }
+    }
+    if (required > capacity) return ArmSmmu4KCapacity;
+    for (size_t i = 0; i < required * 512; ++i) tables[i] = 0;
+    size_t next = 1;
+    for (size_t i = 0; i < range_count; ++i) {
+        const ArmSmmu4KRange *r = &ranges[i];
+        uint64_t attributes = (1u << 11) | (1u << 10) | 3;
+        if (!(r->permissions & ArmSmmu4KExecute)) attributes |= UINT64_C(3) << 53;
+        if (!(r->permissions & ArmSmmu4KPrivileged)) attributes |= 1u << 6;
+        if (!(r->permissions & ArmSmmu4KWrite)) attributes |= 1u << 7;
+        attributes |= (uint64_t)r->shareability << 8;
+        if (r->writeback) attributes |= 1u << 2;
+        for (uint64_t offset = 0; offset < r->bytes; offset += PAGE_BYTES) {
+            uint64_t va = r->iova + offset;
+            size_t table = 0;
+            for (unsigned level = start; level < 3; ++level) {
+                unsigned shift = 39-9*level;
+                unsigned width = level==start ? config->input_bits-shift : 9;
+                size_t slot = table * 512 + ((va >> shift) & ((1u<<width)-1));
+                if (!tables[slot]) tables[slot] = (pool + PAGE_BYTES * next++) | 3;
+                table = (size_t)(((tables[slot] & ADDRESS_MASK) - pool) / PAGE_BYTES);
+            }
+            tables[table * 512 + ((va >> 12) & 511)] = (r->physical + offset) | attributes;
+        }
+    }
+    result->root_physical = pool;
+    result->mair = 0xff44;
+    result->table_pages = required;
+    result->leaf_pages = leaves;
+    result->start_level = start;
+    result->upper_region = upper;
+    return ArmSmmu4KSuccess;
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,0);
+}
+
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t capacity, ArmSmmu4KResult *result)
+{
+    return build_region(config,ranges,range_count,tables,capacity,result,1);
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4K.h b/iokit/Kernel/arm/unixnu/ArmSmmu4K.h
new file mode 100644
index 000000000..1b09a295a
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4K.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_H
+#define ARM_SMMU_4K_H
+#include <stddef.h>
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum {
+    ArmSmmu4KSuccess = 0, ArmSmmu4KArgument, ArmSmmu4KBadRange,
+    ArmSmmu4KOverlap, ArmSmmu4KCapacity, ArmSmmu4KBudget,
+    ArmSmmu4KUnsupported, ArmSmmu4KStateMismatch,
+    ArmSmmu4KIoError, ArmSmmu4KTimeout, ArmSmmu4KBusy, ArmSmmu4KFault
+} ArmSmmu4KStatus;
+typedef struct {
+    unsigned input_bits;           /* 32..48, low-address TTBR0 profile. */
+    unsigned output_bits;          /* 32,36,40,42,44,48. */
+    uint64_t table_physical;        /* Caller-owned contiguous pool, aligned 4K. */
+    size_t leaf_budget;            /* Explicit upper bound on mapping work. */
+} ArmSmmu4KConfig;
+enum {ArmSmmu4KRead=1,ArmSmmu4KWrite=2,ArmSmmu4KExecute=4,ArmSmmu4KPrivileged=8};
+typedef struct {
+    uint64_t iova, physical, bytes;
+    unsigned permissions;          /* Read required; optional Write/Execute/Privileged. */
+    unsigned writeback;            /* 0=normal NC, 1=normal WB/WA. */
+    unsigned shareability;         /* 2=outer, 3=inner; explicit, no default. */
+} ArmSmmu4KRange;
+typedef struct {
+    uint64_t root_physical;
+    uint64_t mair;                 /* NC at index 0, WB/WA at index 1. */
+    size_t table_pages, leaf_pages;
+    unsigned start_level;
+    unsigned upper_region;        /* 0=Build TTBR0, 1=BuildUpper TTBR1. */
+} ArmSmmu4KResult;
+
+/* Build inactive ARM LPAE stage-1 tables with ONLY 4K level-3 leaves.
+ * Sorted disjoint low IOVA ranges; no sign extension or input conversion.
+ * No resource may map the table pool. Conflicting cache/shareability/privilege
+ * aliases refuse. Default 1/3 retains unprivileged PXN/UXN behavior. Execute
+ * and Privileged explicitly describe DEVICE-stage1 accesses (e.g. firmware),
+ * never CPU permissions or authorization to execute unauthenticated images.
+ * All validation/capacity checks precede table writes. Failure zeros result
+ * and leaves tables untouched. Success writes only result.table_pages pages.
+ * Caller guarantees real accessible, disjoint storage, immutable inputs,
+ * native-endian uint64_t table storage aligned to at least 8 bytes, actual
+ * physical ownership and matching CPU attributes/cache maintenance.
+ * NO MMIO, allocation, barriers, TLB operations or activation. This does NOT
+ * prove hardware support, coherent walks or a live isolated GPU context. */
+ArmSmmu4KStatus ArmSmmu4KBuild(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+/* Same native 4K format for TTBR1's upper, sign-extended address region.
+ * IOVAs must already be in [2^64-2^input_bits,2^64); truncated low addresses
+ * refuse. Uses the architectural partial-root index width. No lower-region
+ * remapping, page-size conversion, MMIO or translation activation occurs. */
+ArmSmmu4KStatus ArmSmmu4KBuildUpper(const ArmSmmu4KConfig *config,
+    const ArmSmmu4KRange *ranges, size_t range_count, uint64_t *tables,
+    size_t table_capacity_pages, ArmSmmu4KResult *result);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.c
new file mode 100644
index 000000000..9e4e9a5a7
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.c
@@ -0,0 +1,172 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KAudit.h"
+#define PAGE UINT64_C(4096)
+#define ADDRESS UINT64_C(0x0000fffffffff000)
+typedef struct {
+    const ArmSmmu4KTableIo *io;
+    const ArmSmmu4KConfig *c;
+    const ArmSmmu4KResult *built;
+    const ArmSmmu4KAuditRegion *a;
+    ArmSmmu4KTableAuditResult *r;
+    size_t range;
+    uint64_t offset;
+} Walk;
+static int intersects(uint64_t a,uint64_t an,uint64_t b,uint64_t bn)
+{return a<b+bn && b<a+an;}
+static int incompatible(const ArmSmmu4KRange *a,const ArmSmmu4KRange *b)
+{return a->writeback!=b->writeback || a->shareability!=b->shareability || ((a->permissions^b->permissions)&ArmSmmu4KPrivileged);}
+static ArmSmmu4KStatus validate(const ArmSmmu4KConfig *c,const ArmSmmu4KResult *b,
+    const ArmSmmu4KAuditRegion *a,uint64_t root)
+{
+    if(!c || !b || !a || !a->ranges || !a->range_count || !a->visited ||
+        !a->capacity_pages || a->capacity_pages>SIZE_MAX/4096 ||
+        a->visited_bytes<a->capacity_pages || !a->read_budget ||
+        c->input_bits<32 || c->input_bits>48 ||
+        !(c->output_bits==32 || c->output_bits==36 || c->output_bits==40 ||
+          c->output_bits==42 || c->output_bits==44 || c->output_bits==48) ||
+        !c->leaf_budget || c->leaf_budget>(SIZE_MAX-1)/3 ||
+        a->range_count>SIZE_MAX/sizeof(*a->ranges))return ArmSmmu4KArgument;
+    if(a->range_count>c->leaf_budget)return ArmSmmu4KBudget;
+    uint64_t limit=UINT64_C(1)<<c->output_bits,span=UINT64_C(1)<<c->input_bits;
+    uint64_t pool_bytes=(uint64_t)a->capacity_pages*PAGE;
+    if((c->table_physical&4095) || c->table_physical>=limit || pool_bytes>limit-c->table_physical)
+        return ArmSmmu4KBadRange;
+    if(root!=c->table_physical || b->root_physical!=root || b->mair!=0xff44 ||
+        !b->table_pages || b->table_pages>a->capacity_pages || !b->leaf_pages ||
+        b->start_level!=4-(c->input_bits-12+8)/9 || b->upper_region>1)
+        return ArmSmmu4KStateMismatch;
+    if(b->table_pages>a->read_budget/512)return ArmSmmu4KBudget;
+    size_t leaves=0;uint64_t end=0;
+    for(size_t i=0;i<a->range_count;++i) {
+        const ArmSmmu4KRange *r=&a->ranges[i];
+        if(!r->bytes || ((r->iova|r->physical|r->bytes)&4095) ||
+            !(r->permissions&ArmSmmu4KRead) || (r->permissions&~15u) ||
+            r->writeback>1 || (r->shareability!=2 && r->shareability!=3) ||
+            r->physical>=limit || r->bytes>limit-r->physical ||
+            (b->upper_region?(r->iova<UINT64_MAX-span+1 || r->bytes-1>UINT64_MAX-r->iova):
+             (r->iova>=span || r->bytes>span-r->iova)))return ArmSmmu4KBadRange;
+        if(i && r->iova<=end)return ArmSmmu4KOverlap;
+        end=r->iova+r->bytes-1;
+        if(intersects(r->physical,r->bytes,c->table_physical,pool_bytes))return ArmSmmu4KOverlap;
+        for(size_t j=0;j<i;++j)if(incompatible(r,&a->ranges[j]) &&
+            intersects(r->physical,r->bytes,a->ranges[j].physical,a->ranges[j].bytes))return ArmSmmu4KOverlap;
+        uint64_t pages=r->bytes/PAGE;
+        if(pages>c->leaf_budget-leaves)return ArmSmmu4KBudget;
+        leaves+=(size_t)pages;
+    }
+    return leaves==b->leaf_pages?ArmSmmu4KSuccess:ArmSmmu4KStateMismatch;
+}
+static ArmSmmu4KStatus walk(Walk *w,uint64_t table,unsigned level,uint64_t base)
+{
+    if((table&4095) || table<w->c->table_physical ||
+        (table-w->c->table_physical)/PAGE>=w->a->capacity_pages)return ArmSmmu4KBadRange;
+    size_t page=(size_t)((table-w->c->table_physical)/PAGE);
+    if(w->a->visited[page])return ArmSmmu4KOverlap;
+    if(w->r->table_pages>=w->built->table_pages)return ArmSmmu4KStateMismatch;
+    w->a->visited[page]=1;++w->r->table_pages;
+    size_t initial_leaves=w->r->leaf_pages;
+    unsigned shift=39-9*level;
+    unsigned width=level==w->built->start_level?w->c->input_bits-shift:9;
+    for(unsigned i=0;i<512;++i) {
+        w->r->descriptor_physical=table+8*i;w->r->descriptor=0;
+        w->r->level=level;w->r->iova=base|((uint64_t)i<<shift);w->r->expected_descriptor=0;
+        if(w->r->descriptor_reads==w->a->read_budget)return ArmSmmu4KBudget;
+        ++w->r->descriptor_reads;
+        uint64_t d;
+        if(w->io->read_descriptor(w->io->cookie,table+8*i,&d))return ArmSmmu4KIoError;
+        w->r->descriptor=d;
+        if(!d)continue;
+        if(i>=(1u<<width) || (d&3)!=3)return ArmSmmu4KStateMismatch;
+        if(level<3) {
+            if(d!=((d&ADDRESS)|3))return ArmSmmu4KStateMismatch;
+            ArmSmmu4KStatus status=walk(w,d&ADDRESS,level+1,base|((uint64_t)i<<shift));
+            if(status)return status;
+        } else {
+            if(w->range==w->a->range_count)return ArmSmmu4KStateMismatch;
+            const ArmSmmu4KRange *r=&w->a->ranges[w->range];
+            uint64_t expected=(r->physical+w->offset)|3|(1u<<11)|(1u<<10)|((uint64_t)r->shareability<<8);
+            if(!(r->permissions&ArmSmmu4KExecute))expected|=UINT64_C(3)<<53;
+            if(!(r->permissions&ArmSmmu4KPrivileged))expected|=1u<<6;
+            if(!(r->permissions&ArmSmmu4KWrite))expected|=1u<<7;
+            if(r->writeback)expected|=1u<<2;
+            w->r->expected_descriptor=expected;
+            if(w->r->iova!=r->iova+w->offset || d!=expected)return ArmSmmu4KStateMismatch;
+            ++w->r->leaf_pages;w->offset+=PAGE;
+            if(w->offset==r->bytes){++w->range;w->offset=0;}
+        }
+    }
+    /* Empty intermediate tables are not part of the declared resource graph. */
+    return w->r->leaf_pages>initial_leaves?ArmSmmu4KSuccess:ArmSmmu4KStateMismatch;
+}
+ArmSmmu4KStatus ArmSmmu4KAuditTables(const ArmSmmu4KTableIo *io,
+    const ArmSmmu4KConfig *c,const ArmSmmu4KResult *b,const ArmSmmu4KAuditRegion *a,
+    uint64_t root,ArmSmmu4KTableAuditResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;*r=(ArmSmmu4KTableAuditResult){0};
+    if(!io || !io->read_descriptor)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=validate(c,b,a,root);if(status)return status;
+    for(size_t i=0;i<a->capacity_pages;++i)a->visited[i]=0;
+    Walk w={io,c,b,a,r,0,0};
+    uint64_t base=b->upper_region?UINT64_MAX-(UINT64_C(1)<<c->input_bits)+1:0;
+    status=walk(&w,root,b->start_level,base);if(status)return status;
+    if(r->table_pages!=b->table_pages || r->leaf_pages!=b->leaf_pages || w.range!=a->range_count)
+        return ArmSmmu4KStateMismatch;
+    r->complete=1;return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus pair_validate(const ArmSmmu4KContextConfig *c,const ArmSmmu4KAuditConfig *a)
+{
+    if(!c || !a || !a->io.read_descriptor || (!c->lower && !c->upper) ||
+        !!c->lower!=!!c->lower_tables || !!c->upper!=!!c->upper_tables ||
+        !!c->lower!=!!a->lower || !!c->upper!=!!a->upper)return ArmSmmu4KArgument;
+    const ArmSmmu4KConfig *cs[2]={c->lower,c->upper};
+    const ArmSmmu4KResult *bs[2]={c->lower_tables,c->upper_tables};
+    const ArmSmmu4KAuditRegion *as[2]={a->lower,a->upper};
+    for(unsigned i=0;i<2;++i)if(cs[i]) {
+        ArmSmmu4KStatus status=validate(cs[i],bs[i],as[i],bs[i]->root_physical);if(status)return status;
+        if(bs[i]->upper_region!=i)return ArmSmmu4KStateMismatch;
+    }
+    if(c->lower && c->upper) {
+        if(c->lower->output_bits!=c->upper->output_bits)return ArmSmmu4KStateMismatch;
+        if(intersects(c->lower->table_physical,a->lower->capacity_pages*PAGE,
+                      c->upper->table_physical,a->upper->capacity_pages*PAGE))return ArmSmmu4KOverlap;
+        for(unsigned side=0;side<2;++side)for(size_t i=0;i<as[side]->range_count;++i) {
+            const ArmSmmu4KRange *r=&as[side]->ranges[i];
+            if(intersects(r->physical,r->bytes,cs[!side]->table_physical,as[!side]->capacity_pages*PAGE))return ArmSmmu4KOverlap;
+        }
+        for(size_t i=0;i<a->lower->range_count;++i)for(size_t j=0;j<a->upper->range_count;++j) {
+            const ArmSmmu4KRange *x=&a->lower->ranges[i],*y=&a->upper->ranges[j];
+            if(incompatible(x,y) && intersects(x->physical,x->bytes,y->physical,y->bytes))return ArmSmmu4KOverlap;
+        }
+    }
+    return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus regions(const ArmSmmu4KContextConfig *c,const ArmSmmu4KAuditConfig *a,
+    uint64_t lower,uint64_t upper,ArmSmmu4KAuditResult *r)
+{
+    ArmSmmu4KStatus status;
+    if(c->lower){r->phase=2;status=ArmSmmu4KAuditTables(&a->io,c->lower,c->lower_tables,a->lower,lower,&r->lower);if(status)return status;}
+    if(c->upper){r->phase=3;status=ArmSmmu4KAuditTables(&a->io,c->upper,c->upper_tables,a->upper,upper,&r->upper);if(status)return status;}
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KAuditDeclaredContext(const ArmSmmu4KContextConfig *c,
+    const ArmSmmu4KAuditConfig *a,ArmSmmu4KAuditResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;*r=(ArmSmmu4KAuditResult){0};
+    ArmSmmu4KStatus status=pair_validate(c,a);if(status)return status;
+    status=regions(c,a,c->lower?c->lower_tables->root_physical:0,c->upper?c->upper_tables->root_physical:0,r);
+    if(!status){r->phase=4;r->complete=1;}return status;
+}
+ArmSmmu4KStatus ArmSmmu4KObserveAuditedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *c,const ArmSmmu4KAuditConfig *a,ArmSmmu4KAuditResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;*r=(ArmSmmu4KAuditResult){0};
+    ArmSmmu4KStatus status=pair_validate(c,a);if(status)return status;
+    r->phase=1;status=ArmSmmu4KObserveOwnedContext(io,bank,c,&r->before);if(status)return status;
+    status=regions(c,a,r->before.readback.ttbr0&ADDRESS,r->before.readback.ttbr1&ADDRESS,r);if(status)return status;
+    r->phase=5;status=ArmSmmu4KObserveOwnedContext(io,bank,c,&r->after);if(status)return status;
+    /* Each complete image independently matched the same immutable expected
+     * context, including capabilities, ASID, roots, MAIR and granules. */
+    if(r->before.id0!=r->after.id0 || r->before.id1!=r->after.id1 || r->before.id2!=r->after.id2)
+        return ArmSmmu4KStateMismatch;
+    r->phase=6;r->complete=1;return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.h
new file mode 100644
index 000000000..147ad654d
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KAudit.h
@@ -0,0 +1,64 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_AUDIT_H
+#define ARM_SMMU_4K_AUDIT_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    void *cookie;
+    /* Read the actual descriptor at an owned physical address. No generated,
+     * cached reference-table or translated/shadow-table substitute. Return 0
+     * on success. Platform supplies a real coherent CPU mapping and ownership. */
+    int (*read_descriptor)(void *,uint64_t physical,uint64_t *);
+} ArmSmmu4KTableIo;
+typedef struct {
+    const ArmSmmu4KRange *ranges;
+    size_t range_count,capacity_pages,read_budget;
+    /* Scratch: one byte per pool page, reset by each audit. Disjoint from all
+     * inputs, outputs, mapped resources, physical tables and other scratch. */
+    unsigned char *visited;
+    size_t visited_bytes;
+} ArmSmmu4KAuditRegion;
+typedef struct {
+    ArmSmmu4KTableIo io;
+    const ArmSmmu4KAuditRegion *lower,*upper; /* exactly the enabled regions */
+} ArmSmmu4KAuditConfig;
+typedef struct {
+    size_t descriptor_reads,table_pages,leaf_pages;
+    uint64_t descriptor_physical,descriptor,iova,expected_descriptor;
+    unsigned level,complete;
+} ArmSmmu4KTableAuditResult;
+typedef struct {
+    ArmSmmu4KTableAuditResult lower,upper;
+    ArmSmmu4KProgramResult before,after;
+    unsigned phase,complete;
+} ArmSmmu4KAuditResult;
+/* Walk the physical graph, including every unused slot, with a strict read
+ * budget and bounded depth (four levels). Reject blocks, cycles, aliases of
+ * table pages, extra/missing mappings, permissions/attributes differing from
+ * declared resources, foreign PAs and nonzero reserved descriptor bits.
+ * No allocation, descriptor writes, rebuilding, conversion or MMIO. Each
+ * expected resource must appear exactly once, in ascending native IOVA order.
+ * Caller holds immutable tables/ranges/results and exclusive leases throughout;
+ * all masters are quiesced. Scratch and physical callback are trusted kernel
+ * boundaries. Declared bounds do NOT establish physical ownership/provenance. */
+ArmSmmu4KStatus ArmSmmu4KAuditTables(const ArmSmmu4KTableIo *,
+    const ArmSmmu4KConfig *,const ArmSmmu4KResult *,const ArmSmmu4KAuditRegion *,
+    uint64_t root_physical,ArmSmmu4KTableAuditResult *);
+/* Pre-activation audit of BOTH declared physical regions; also rejects pool
+ * overlap and resource access to either entire pool, including spare pages.
+ * This is not an observation of an active context. */
+ArmSmmu4KStatus ArmSmmu4KAuditDeclaredContext(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KAuditConfig *,ArmSmmu4KAuditResult *);
+/* Read actual context before AND after the physical walks; use its observed
+ * TTBR addresses as traversal roots. Require exact enabled 4K state and no
+ * faults at both observations. No writes, activation or hardware timing proof.
+ * Exclusive ownership/quiescence and coherent immutable tables are mandatory;
+ * two observations cannot detect an unowned writer changing and restoring state. */
+ArmSmmu4KStatus ArmSmmu4KObserveAuditedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,const ArmSmmu4KAuditConfig *,ArmSmmu4KAuditResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c
new file mode 100644
index 000000000..30a4a3276
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.c
@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KContext.h"
+static int width_code(unsigned bits)
+{
+    switch(bits) {case 32:return 0;case 36:return 1;case 40:return 2;
+        case 42:return 3;case 44:return 4;case 48:return 5;default:return -1;}
+}
+static unsigned width_bits(unsigned code)
+{
+    switch(code) {case 0:return 32;case 1:return 36;case 2:return 40;
+        case 3:return 42;case 4:return 44;case 5:return 48;default:return 0;}
+}
+static int region_valid(const ArmSmmu4KConfig *c,const ArmSmmu4KResult *r,unsigned upper)
+{
+    if(!c || !r)return !c && !r;
+    if(c->input_bits<32 || c->input_bits>48 || width_code(c->output_bits)<0 ||
+        (c->table_physical&4095) || r->root_physical!=c->table_physical ||
+        r->mair!=0xff44 || r->upper_region!=upper || !r->table_pages ||
+        r->leaf_pages>c->leaf_budget || r->table_pages>UINT64_MAX/4096 ||
+        r->start_level!=4-(c->input_bits-12+8)/9)return 0;
+    uint64_t limit=UINT64_C(1)<<c->output_bits;
+    return r->root_physical<limit && (uint64_t)r->table_pages*4096<=limit-r->root_physical;
+}
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *c,
+    ArmSmmu4KContextImage *out)
+{
+    if(!out)return ArmSmmu4KArgument;
+    out->cbar=out->cba2r=out->tcr=out->tcr2=out->mair0=out->mair1=out->sctlr=0;
+    out->reserved_zero=0;
+    out->ttbr0=out->ttbr1=0;
+    if(!c || c->profile>1 || (!c->lower && !c->upper) || c->asid>65535 || c->coherent_walk>1 ||
+        c->stall_on_fault>1 || c->continue_after_fault>1 ||
+        !region_valid(c->lower,c->lower_tables,0) || !region_valid(c->upper,c->upper_tables,1))return ArmSmmu4KArgument;
+    unsigned va=width_bits((c->id2>>8)&15),pa=width_bits((c->id2>>4)&15);
+    if(!(c->id0&(UINT32_C(1)<<30)) || !(c->id2&(1u<<12)) || !va || !pa)return ArmSmmu4KUnsupported;
+    const ArmSmmu4KConfig *basis=c->lower?c->lower:c->upper;
+    if(basis->output_bits>pa || (c->lower && c->lower->input_bits>va) ||
+        (c->upper && (c->upper->input_bits>va || c->upper->output_bits!=basis->output_bits)))return ArmSmmu4KUnsupported;
+    if(c->lower && c->upper) {
+        const ArmSmmu4KResult *a=c->lower_tables,*b=c->upper_tables;
+        if(a->root_physical<b->root_physical+(uint64_t)b->table_pages*4096 &&
+           b->root_physical<a->root_physical+(uint64_t)a->table_pages*4096)return ArmSmmu4KOverlap;
+    }
+    ArmSmmu4KContextImage v;
+    v.cbar=0x1f300; /* Stage1 translation, stage2 bypass; weakest bypass attrs. */
+    v.cba2r=1;      /* AArch64. No stage2 VMID or guest translation. */
+    v.tcr=UINT32_C(2)<<30; /* TG1=4K, TG0=4K. */
+    unsigned walk=c->coherent_walk?0x3500:0x2000;
+    if(c->lower)v.tcr|=walk|(64-c->lower->input_bits);
+    else v.tcr|=1u<<7; /* EPD0 */
+    if(c->upper)v.tcr|=(walk|(64-c->upper->input_bits))<<16;
+    else v.tcr|=1u<<23; /* EPD1 */
+    v.tcr2=(7u<<15)|(1u<<4)|(unsigned)width_code(basis->output_bits);
+    v.ttbr0=(uint64_t)c->asid<<48;v.ttbr1=v.ttbr0;
+    if(c->lower)v.ttbr0|=c->lower_tables->root_physical;
+    if(c->upper)v.ttbr1|=c->upper_tables->root_physical;
+    v.mair0=0xff44;v.mair1=0;
+    v.sctlr=0x1067|(c->stall_on_fault<<7)|(c->continue_after_fault<<8);
+    if(c->profile==1) {
+        if(c->id0!=0x48016605 || c->id2!=0x7511 || !c->lower || c->upper ||
+            c->lower->input_bits!=32 || c->lower->output_bits!=36 || c->asid!=0x62 ||
+            c->stall_on_fault || !c->continue_after_fault)return ArmSmmu4KUnsupported;
+        /* Measured0106: EPD1 with unusedTG1 zero, TTBR1zero, CFIEdisabled.
+         * The board polls faults synchronously and never enables unhandled IRQs. */
+        /* 0170: coherent_walk=1 (boot-arg sweetsmmuwalk=1): inner-shareable write-back walks instead of outer non-cacheable ones.
+         * The tables are non-cacheable pages of ours, so the walker cannot see stale CPU lines either way. */
+        v.tcr=c->coherent_walk?0x803520:0x802020;v.ttbr1=0;v.sctlr=0x1127;
+    }
+    v.reserved_zero=0;
+    *out=v;
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *c,
+    const ArmSmmu4KContextImage *observed)
+{
+    if(!observed)return ArmSmmu4KArgument;
+    ArmSmmu4KContextImage expected;
+    ArmSmmu4KStatus status=ArmSmmu4KEncodeContext(c,&expected);
+    if(status!=ArmSmmu4KSuccess)return status;
+    /* TCR2.TBI0/TBI1 (bits 5/6, top-byte ignore) are written 0 but may read 1: the sheng Adreno MMU-500 reads
+     * 0x38071 for 0x38011 (int-008). Linux neither sets nor reads them back. With a 48-bit upstream bus the top
+     * byte of a device address is zero, so ignoring it changes no translation. Only 0 -> 1 is accepted here. */
+    const uint32_t tbi_set=observed->tcr2&~expected.tcr2&UINT32_C(0x60);
+    /* SCTLR.ASIDPNE (bit 12) is written 1 but may read 0: the same SMMU reads 0x167 for 0x1167 (int-009). Linux
+     * writes it and never reads it back. A shared ASID namespace is safe because every bank's ASID is the
+     * caller's exclusive lease. Only 1 -> 0 is accepted. */
+    const uint32_t asidpne_clear=expected.sctlr&~observed->sctlr&UINT32_C(0x1000);
+    if(expected.cbar!=observed->cbar || expected.cba2r!=observed->cba2r ||
+        expected.tcr!=observed->tcr || ((expected.tcr2^observed->tcr2)&~tbi_set) ||
+        expected.mair0!=observed->mair0 || expected.mair1!=observed->mair1 ||
+        ((expected.sctlr^observed->sctlr)&~asidpne_clear) || observed->reserved_zero || expected.ttbr0!=observed->ttbr0 ||
+        expected.ttbr1!=observed->ttbr1)return ArmSmmu4KStateMismatch;
+    return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.h
new file mode 100644
index 000000000..cec0fb2c6
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KContext.h
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_CONTEXT_H
+#define ARM_SMMU_4K_CONTEXT_H
+#include "ArmSmmu4K.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    /* A config/result pair from Build, BuildUpper or LivePrepare; NULL pair disables it.
+     * A live arena may have zero mapped leaves while retaining its table topology.
+     * Both enabled regions need distinct physical pools and equal OAS/MAIR.
+     * The trusted caller retains actual pool ownership and immutable results. */
+    const ArmSmmu4KConfig *lower, *upper;
+    const ArmSmmu4KResult *lower_tables, *upper_tables;
+    uint32_t id0, id2;       /* Raw SMMUv2 identification register values. */
+    unsigned asid;          /* 0..65535, ownership managed by the caller. */
+    unsigned coherent_walk; /* Explicit: 1=inner WBWA, 0=outer NC. */
+    unsigned stall_on_fault, continue_after_fault; /* Each 0 or 1. */
+    /* 0: upstream profile; 1: measured sweet A618 CB0 polling profile.
+     * Profile1 is restricted to its exact hardware IDs and lower-only32/36. */
+    unsigned profile;
+} ArmSmmu4KContextConfig;
+typedef struct {
+    uint32_t cbar, cba2r, tcr, tcr2, mair0, mair1, sctlr, reserved_zero;
+    uint64_t ttbr0, ttbr1;
+} ArmSmmu4KContextImage;
+
+/* Encode AArch64 stage1, stage2-bypass native4K SMMUv2 context registers.
+ * Capability/width/result/refusal checks precede publishing an image. Failure
+ * zeros it. Both TG0/TG1 select 4K even for a disabled region. No MMIO, power,
+ * stream/context assignment, cache barriers, TLB operations or activation.
+ * ID inputs are not proof that the caller read actual hardware. Inputs,
+ * their pointed-to configs/results, and output must be disjoint and immutable
+ * throughout the call; this is a trusted kernel integration boundary. */
+ArmSmmu4KStatus ArmSmmu4KEncodeContext(const ArmSmmu4KContextConfig *,
+    ArmSmmu4KContextImage *);
+/* Compare all supplied readback fields with the freshly encoded expected
+ * image. Caller must read real hardware and independently walk its actual
+ * TTBR tables, verify ownership/coherency and handle faults/TLB lifetime.
+ * Matching caller-supplied values alone never qualify an active GPU mapping. */
+ArmSmmu4KStatus ArmSmmu4KValidateContextReadback(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KContextImage *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KLive.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KLive.c
new file mode 100644
index 000000000..a400d3f5e
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KLive.c
@@ -0,0 +1,530 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KLive.h"
+#define PAGE UINT64_C(4096)
+#define PA_MASK UINT64_C(0x0000fffffffff000)
+
+static int output_width(unsigned bits)
+{return bits==32 || bits==36 || bits==40 || bits==42 || bits==44 || bits==48;}
+static ArmSmmu4KStatus layout(const ArmSmmu4KLiveArena *a,ArmSmmu4KResult *out)
+{
+    if(!a || !a->mapping || ((uintptr_t)a->mapping&4095) || a->upper_region>1 ||
+        a->config.input_bits<32 || a->config.input_bits>48 ||
+        !output_width(a->config.output_bits) || !a->config.leaf_budget ||
+        !a->capacity_pages || a->capacity_pages>SIZE_MAX/4096 ||
+        a->capacity_pages*4096>UINTPTR_MAX-(uintptr_t)a->mapping)return ArmSmmu4KArgument;
+    uint64_t limit=UINT64_C(1)<<a->config.input_bits;
+    uint64_t physical_limit=UINT64_C(1)<<a->config.output_bits;
+    if(!a->bytes || ((a->iova|a->bytes|a->config.table_physical)&4095) ||
+        (a->upper_region ? a->iova<UINT64_MAX-limit+1 : a->iova>=limit) ||
+        a->bytes>limit-(a->iova&(limit-1)) ||
+        a->config.table_physical>=physical_limit ||
+        a->capacity_pages*PAGE>physical_limit-a->config.table_physical)return ArmSmmu4KBadRange;
+    if(a->bytes/PAGE>a->config.leaf_budget)return ArmSmmu4KBudget;
+    unsigned start=4-(a->config.input_bits-12+8)/9;
+    uint64_t low=a->iova&(limit-1),high=low+a->bytes-1;
+    size_t pages=1;
+    for(unsigned level=start;level<3;++level) {
+        unsigned shift=39-9*level;
+        uint64_t extra=(high>>shift)-(low>>shift)+1;
+        if(extra>SIZE_MAX-pages)return ArmSmmu4KCapacity;
+        pages+=(size_t)extra;
+    }
+    if(pages>a->capacity_pages)return ArmSmmu4KCapacity;
+    *out=(ArmSmmu4KResult){a->config.table_physical,0xff44,pages,0,start,a->upper_region};
+    return ArmSmmu4KSuccess;
+}
+static uint64_t descriptor(const ArmSmmu4KRange *r,uint64_t iova)
+{
+    uint64_t attrs=(1u<<11)|(1u<<10)|3u|((uint64_t)r->shareability<<8);
+    if(!(r->permissions&ArmSmmu4KExecute))attrs|=UINT64_C(3)<<53;
+    if(!(r->permissions&ArmSmmu4KPrivileged))attrs|=1u<<6;
+    if(!(r->permissions&ArmSmmu4KWrite))attrs|=1u<<7;
+    if(r->writeback)attrs|=1u<<2;
+    return (r->physical+(iova-r->iova))|attrs;
+}
+static const ArmSmmu4KRange *find(const ArmSmmu4KRange *ranges,size_t count,uint64_t iova)
+{
+    size_t low=0,high=count;
+    while(low<high) {
+        size_t mid=low+(high-low)/2;
+        const ArmSmmu4KRange *r=&ranges[mid];
+        if(iova<r->iova)high=mid;
+        else if(iova-r->iova>=r->bytes)low=mid+1;
+        else return r;
+    }
+    return 0;
+}
+/* The walk visits addresses in ascending order, so one cursor per range list replaces a binary search for every leaf: lower_bound once per
+ * leaf page, then forward. A range is behind the address when the address lies past its end (written as a difference: native addresses
+ * may end at 2^64). */
+static size_t first_not_behind(const ArmSmmu4KRange *ranges,size_t count,uint64_t va)
+{
+    size_t low=0,high=count;
+    while(low<high) {
+        size_t mid=low+(high-low)/2;
+        if(va>=ranges[mid].iova && va-ranges[mid].iova>=ranges[mid].bytes)low=mid+1;
+        else high=mid;
+    }
+    return low;
+}
+static const ArmSmmu4KRange *scan(const ArmSmmu4KRange *ranges,size_t count,size_t *cursor,uint64_t va)
+{
+    while(*cursor<count && va>=ranges[*cursor].iova && va-ranges[*cursor].iova>=ranges[*cursor].bytes)++*cursor;
+    if(*cursor<count && va>=ranges[*cursor].iova && va-ranges[*cursor].iova<ranges[*cursor].bytes)return &ranges[*cursor];
+    return 0;
+}
+static uint64_t expected(const ArmSmmu4KRange *ranges,size_t count,uint64_t iova)
+{
+    const ArmSmmu4KRange *r=find(ranges,count,iova);
+    return r?descriptor(r,iova):0;
+}
+static ArmSmmu4KStatus validate_range(const ArmSmmu4KLiveArena *a,const ArmSmmu4KRange *r)
+{
+    uint64_t physical_limit=UINT64_C(1)<<a->config.output_bits;
+    uint64_t pool=a->config.table_physical,pool_bytes=a->capacity_pages*PAGE;
+    if(!r || !r->bytes || ((r->iova|r->physical|r->bytes)&4095) ||
+        !(r->permissions&ArmSmmu4KRead) || (r->permissions&~15u) ||
+        r->writeback>1 || (r->shareability!=2 && r->shareability!=3) ||
+        r->physical>=physical_limit || r->bytes>physical_limit-r->physical ||
+        r->iova<a->iova || r->iova-a->iova>=a->bytes ||
+        r->bytes>a->bytes-(r->iova-a->iova))return ArmSmmu4KBadRange;
+    if(r->physical<pool+pool_bytes && pool<r->physical+r->bytes)return ArmSmmu4KOverlap;
+    return ArmSmmu4KSuccess;
+}
+static int conflicting_alias(const ArmSmmu4KRange *a,const ArmSmmu4KRange *b)
+{
+    return (a->writeback!=b->writeback || a->shareability!=b->shareability ||
+        ((a->permissions^b->permissions)&ArmSmmu4KPrivileged)) &&
+        a->physical<b->physical+b->bytes && b->physical<a->physical+a->bytes;
+}
+/* Only ranges of different cache/shareability/privilege classes can alias in conflict, and of two conflicting ranges at most one
+ * is in the class most ranges of both sets have. So for every other class k, the members of class k in one set are compared with
+ * the members of other classes in the other set, both ways. Each such comparison sorts the smaller side by physical address in
+ * the arena's scratch and looks every range of the larger side up in it: a scattered buffer is one range per physical page, and
+ * with coherent imports (write-back) beside the GPU's own non-cacheable buffers a pairwise loop over both was some 2.4 billion
+ * comparisons per map (int-144: 368 ms per map on average, 8 s at worst). Without scratch, or a side larger than it, the
+ * comparison is the pairwise loop. */
+static unsigned alias_class(const ArmSmmu4KRange *r)
+{return (r->writeback&1u)|((r->shareability&3u)<<1)|((r->permissions&ArmSmmu4KPrivileged)?8u:0u);}
+typedef struct {
+    const ArmSmmu4KRange *ranges;size_t count;
+    unsigned cls;int same;   /* members: class == cls (same) or class != cls */
+} AliasSide;
+static int alias_member(const AliasSide *s,size_t i)
+{return (alias_class(&s->ranges[i])==s->cls)==(s->same!=0);}
+static void sift(const ArmSmmu4KRange *r,uint32_t *h,size_t root,size_t n)
+{
+    for(;;) {
+        size_t child=2*root+1;
+        if(child>=n)return;
+        if(child+1<n && r[h[child+1]].physical>r[h[child]].physical)++child;
+        if(r[h[root]].physical>=r[h[child]].physical)return;
+        uint32_t t=h[root];h[root]=h[child];h[child]=t;root=child;
+    }
+}
+static int alias_pass(const ArmSmmu4KLiveArena *arena,const AliasSide *p,const AliasSide *q)
+{
+    size_t np=0,nq=0;
+    for(size_t i=0;i<p->count;++i)np+=(size_t)alias_member(p,i);
+    for(size_t j=0;j<q->count;++j)nq+=(size_t)alias_member(q,j);
+    if(!np || !nq)return 0;
+    const AliasSide *sorted=np<=nq?p:q,*probe=np<=nq?q:p;
+    const size_t n=np<=nq?np:nq;
+    uint32_t *h=arena?arena->alias_scratch:0;
+    if(!h || n>arena->alias_scratch_entries || sorted->count>UINT32_MAX) {
+        for(size_t i=0;i<p->count;++i)if(alias_member(p,i))
+            for(size_t j=0;j<q->count;++j)if(alias_member(q,j) && conflicting_alias(&p->ranges[i],&q->ranges[j]))return 1;
+        return 0;
+    }
+    const ArmSmmu4KRange *r=sorted->ranges;
+    size_t k=0;
+    for(size_t i=0;i<sorted->count;++i)if(alias_member(sorted,i)) {
+        h[k++]=(uint32_t)i;
+    }
+    for(size_t i=n/2;i-->0;)sift(r,h,i,n);
+    for(size_t end=n;end>1;) {--end;uint32_t t=h[0];h[0]=h[end];h[end]=t;sift(r,h,0,end);}
+    /* Drop intervals contained by an earlier interval. Both starts and ends of
+     * the retained indices are now monotonic, even with nested/duplicate runs.
+     * A distant long run cannot force gap queries to scan short runs backward.
+     * Every compared pair belongs to different classes by AliasSide's filter. */
+    size_t kept=0;
+    for(size_t i=0;i<n;++i) {
+        uint32_t index=h[i];
+        if(!kept || r[index].physical+r[index].bytes>r[h[kept-1]].physical+r[h[kept-1]].bytes)h[kept++]=index;
+    }
+    for(size_t j=0;j<probe->count;++j) {
+        if(!alias_member(probe,j))continue;
+        const ArmSmmu4KRange *y=&probe->ranges[j];
+        size_t lo=0,hi=kept;   /* first interval ending after y's start */
+        while(lo<hi) {size_t mid=lo+(hi-lo)/2;if(r[h[mid]].physical+r[h[mid]].bytes<=y->physical)lo=mid+1;else hi=mid;}
+        if(lo<kept && r[h[lo]].physical<y->physical+y->bytes)return 1;
+    }
+    return 0;
+}
+static int any_conflicting_alias(const ArmSmmu4KLiveArena *arena,const ArmSmmu4KRange *a,size_t na,
+    const ArmSmmu4KRange *b,size_t nb)
+{
+    if(!na || !nb)return 0;
+    size_t members[16]={0};
+    for(size_t i=0;i<na;++i)++members[alias_class(&a[i])];
+    for(size_t j=0;j<nb;++j)++members[alias_class(&b[j])];
+    unsigned reference=0;
+    for(unsigned k=1;k<16;++k)if(members[k]>members[reference])reference=k;
+    const int self=a==b && na==nb;
+    for(unsigned k=0;k<16;++k) {
+        if(k==reference || !members[k])continue;
+        const AliasSide ak={a,na,k,1},bo={b,nb,k,0};
+        if(alias_pass(arena,&ak,&bo))return 1;
+        if(self)continue;
+        const AliasSide bk={b,nb,k,1},ao={a,na,k,0};
+        if(alias_pass(arena,&bk,&ao))return 1;
+    }
+    return 0;
+}
+static ArmSmmu4KStatus validate_ranges_checked(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KRange *ranges,size_t count,size_t *leaves,int aliases);
+static ArmSmmu4KStatus validate_ranges(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KRange *ranges,size_t count,size_t *leaves)
+{return validate_ranges_checked(a,ranges,count,leaves,1);}
+static ArmSmmu4KStatus validate_ranges_checked(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KRange *ranges,size_t count,size_t *leaves,int aliases)
+{
+    *leaves=0;
+    if((count && !ranges) || count>a->config.leaf_budget ||
+        count>SIZE_MAX/sizeof(*ranges))return ArmSmmu4KArgument;
+    for(size_t i=0;i<count;++i) {
+        ArmSmmu4KStatus status=validate_range(a,&ranges[i]);
+        if(status!=ArmSmmu4KSuccess)return status;
+        if(i && ranges[i].iova<=ranges[i-1].iova+(ranges[i-1].bytes-1))return ArmSmmu4KOverlap;
+        size_t pages=(size_t)(ranges[i].bytes/PAGE);
+        if(pages>a->config.leaf_budget-*leaves)return ArmSmmu4KBudget;
+        *leaves+=pages;
+    }
+    return aliases && any_conflicting_alias(a,ranges,count,ranges,count)?ArmSmmu4KOverlap:ArmSmmu4KSuccess;
+}
+/* Traverse the actual fixed topology, never generate/copy a reference table.
+ * A fixed owned aperture reserves empty intermediate tables; every other slot
+ * must be zero. Resource expectations are metadata, not translated page tables. */
+static ArmSmmu4KStatus walk(const ArmSmmu4KLiveArena *a,const ArmSmmu4KResult *shape,
+    unsigned level,size_t page,uint64_t prefix,size_t *next,unsigned build,
+    const ArmSmmu4KRange *ranges,size_t count,const ArmSmmu4KRange *changes,size_t changed,
+    unsigned map,ArmSmmu4KLiveResult *r)
+{
+    uint64_t limit=UINT64_C(1)<<a->config.input_bits;
+    uint64_t low=a->iova&(limit-1),high=low+a->bytes-1;
+    unsigned shift=39-9*level;
+    unsigned width=level==shape->start_level?a->config.input_bits-shift:9;
+    size_t range_cursor=0,change_cursor=0;
+    if(level==3) {
+        uint64_t first=a->upper_region ? prefix|~(limit-1) : prefix;
+        range_cursor=first_not_behind(ranges,count,first);change_cursor=first_not_behind(changes,changed,first);
+    }
+    for(unsigned slot=0;slot<512;++slot) {
+        uint64_t begin=prefix+((uint64_t)slot<<shift),value=0;
+        int reserved=slot<(1u<<width) && begin<=high && low<begin+(UINT64_C(1)<<shift);
+        size_t child=0;
+        if(level<3 && reserved) {
+            child=(*next)++;
+            if(child>=shape->table_pages)return ArmSmmu4KStateMismatch;
+            value=(a->config.table_physical+child*PAGE)|3u;
+        } else if(level==3 && reserved && !build) {
+            uint64_t va=a->upper_region ? begin|~(limit-1) : begin;
+            const ArmSmmu4KRange *c=scan(changes,changed,&change_cursor,va);
+            if(c)value=map?descriptor(c,va):0;
+            else {
+                const ArmSmmu4KRange *r0=scan(ranges,count,&range_cursor,va);
+                value=r0?descriptor(r0,va):0;
+            }
+        }
+        size_t index=page*512+slot;
+        if(build)a->mapping[index]=value;
+        else {++r->descriptor_reads;if(a->mapping[index]!=value)return ArmSmmu4KStateMismatch;}
+        if(level<3 && reserved) {
+            ArmSmmu4KStatus status=walk(a,shape,level+1,child,begin,next,build,ranges,count,changes,changed,map,r);
+            if(status!=ArmSmmu4KSuccess)return status;
+        }
+    }
+    return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus leaf_index(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KResult *shape,uint64_t va,size_t *index,ArmSmmu4KLiveResult *r);
+/* The changed leaves alone, through the table path each one's address takes: before the store (after=0) each holds what the
+ * operation replaces (nothing for a map, its range's descriptor for an unmap), after it what the operation wrote. */
+static ArmSmmu4KStatus verify_changed(const ArmSmmu4KLiveArena *a,const ArmSmmu4KResult *shape,
+    const ArmSmmu4KRange *changes,size_t changed,unsigned map,unsigned after,ArmSmmu4KLiveResult *r)
+{
+    for(size_t i=0;i<changed;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        const uint64_t va=changes[i].iova+offset;size_t index;
+        ArmSmmu4KStatus status=leaf_index(a,shape,va,&index,r);if(status!=ArmSmmu4KSuccess)return status;
+        const uint64_t want=(map==after)?descriptor(&changes[i],va):0;
+        ++r->descriptor_reads;
+        if(a->mapping[index]!=want)return ArmSmmu4KStateMismatch;
+    }
+    return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus verify(const ArmSmmu4KLiveArena *a,const ArmSmmu4KResult *shape,
+    const ArmSmmu4KRange *ranges,size_t count,const ArmSmmu4KRange *changes,size_t changed,
+    unsigned map,ArmSmmu4KLiveResult *r)
+{
+    size_t next=1;
+    ArmSmmu4KStatus status=walk(a,shape,shape->start_level,0,0,&next,0,ranges,count,changes,changed,map,r);
+    return status==ArmSmmu4KSuccess && next!=shape->table_pages?ArmSmmu4KStateMismatch:status;
+}
+ArmSmmu4KStatus ArmSmmu4KLivePrepare(const ArmSmmu4KLiveArena *a,ArmSmmu4KLiveState *state)
+{
+    if(!state || state->prepared || state->poisoned)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(a,&shape);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t next=1;
+    status=walk(a,&shape,shape.start_level,0,0,&next,1,0,0,0,0,0,0);
+    if(status!=ArmSmmu4KSuccess || next!=shape.table_pages) {state->poisoned=1;return ArmSmmu4KStateMismatch;}
+    state->tables=shape;state->generation=0;state->prepared=1;state->context_offset=0;
+    return ArmSmmu4KSuccess;
+}
+static int same_config(const ArmSmmu4KConfig *a,const ArmSmmu4KConfig *b)
+{
+    return a && b && a->input_bits==b->input_bits && a->output_bits==b->output_bits &&
+        a->table_physical==b->table_physical && a->leaf_budget==b->leaf_budget;
+}
+ArmSmmu4KStatus ArmSmmu4KLiveAudit(const ArmSmmu4KLiveArena *a,const ArmSmmu4KLiveState *state,
+    const ArmSmmu4KRange *ranges,size_t count,ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    if(!state || !state->prepared || state->poisoned)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(a,&shape);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(state->tables.root_physical!=shape.root_physical || state->tables.mair!=shape.mair ||
+        state->tables.table_pages!=shape.table_pages || state->tables.start_level!=shape.start_level ||
+        state->tables.upper_region!=shape.upper_region)return ArmSmmu4KArgument;
+    size_t leaves=0;
+    status=validate_ranges(a,ranges,count,&leaves);if(status!=ArmSmmu4KSuccess)return status;
+    if(leaves!=state->tables.leaf_pages)return ArmSmmu4KArgument;
+    status=verify(a,&shape,ranges,count,0,0,0,r);
+    r->complete=status==ArmSmmu4KSuccess;return status;
+}
+static ArmSmmu4KStatus leaf_index(const ArmSmmu4KLiveArena *a,
+    const ArmSmmu4KResult *shape,uint64_t va,size_t *index,ArmSmmu4KLiveResult *r)
+{
+    size_t page=0;
+    for(unsigned level=shape->start_level;level<3;++level) {
+        unsigned shift=39-9*level,width=level==shape->start_level?a->config.input_bits-shift:9;
+        uint64_t entry=a->mapping[page*512+((va>>shift)&((1u<<width)-1))];++r->descriptor_reads;
+        uint64_t physical=entry&PA_MASK;
+        if(entry!=(physical|3u) || physical<a->config.table_physical ||
+            physical-a->config.table_physical>=shape->table_pages*PAGE)return ArmSmmu4KStateMismatch;
+        page=(size_t)((physical-a->config.table_physical)/PAGE);
+    }
+    *index=page*512+((va>>12)&511);
+    return ArmSmmu4KSuccess;
+}
+static int overlaps(uint64_t a,uint64_t abytes,uint64_t b,uint64_t bbytes)
+{return a<b+bbytes && b<a+abytes;}
+static int touches_pool(const ArmSmmu4KRange *r,const ArmSmmu4KLiveArena *a)
+{return overlaps(r->physical,r->bytes,a->config.table_physical,a->capacity_pages*PAGE);}
+static ArmSmmu4KStatus region_metadata(const ArmSmmu4KLiveRegion *region,
+    const ArmSmmu4KConfig *config,const ArmSmmu4KResult *root,unsigned upper,int aliases)
+{
+    if(!region)return (!config && !root)?ArmSmmu4KSuccess:ArmSmmu4KArgument;
+    if(!region->arena || !region->state || region->arena->upper_region!=upper ||
+        root!=&region->state->tables || !same_config(config,&region->arena->config) ||
+        !region->state->prepared || region->state->poisoned)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(region->arena,&shape);if(status)return status;
+    const ArmSmmu4KResult *r=&region->state->tables;
+    if(r->root_physical!=shape.root_physical || r->mair!=shape.mair || r->table_pages!=shape.table_pages ||
+        r->start_level!=shape.start_level || r->upper_region!=shape.upper_region)return ArmSmmu4KArgument;
+    size_t leaves=0;
+    status=validate_ranges_checked(region->arena,region->ranges,region->count,&leaves,aliases);if(status)return status;
+    return leaves==r->leaf_pages?ArmSmmu4KSuccess:ArmSmmu4KArgument;
+}
+/* aliases=0 (an update that is not its region's whole-verification one) skips the existing ranges' alias checks against each other
+ * and across the regions: each range was checked against all of them when it was mapped, and the 64th update re-proves them. */
+static ArmSmmu4KStatus context_metadata(const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveRegion *lower,const ArmSmmu4KLiveRegion *upper,int aliases)
+{
+    if(!context || (!lower && !upper))return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=region_metadata(lower,context->lower,context->lower_tables,0,aliases);if(status)return status;
+    status=region_metadata(upper,context->upper,context->upper_tables,1,aliases);if(status)return status;
+    if(lower && upper) {
+        const ArmSmmu4KLiveArena *a=lower->arena,*b=upper->arena;
+        if(lower->state==upper->state || a->config.output_bits!=b->config.output_bits ||
+            overlaps(a->config.table_physical,a->capacity_pages*PAGE,b->config.table_physical,b->capacity_pages*PAGE) ||
+            overlaps((uintptr_t)a->mapping,a->capacity_pages*PAGE,(uintptr_t)b->mapping,b->capacity_pages*PAGE))
+            return ArmSmmu4KOverlap;
+        for(size_t i=0;i<lower->count;++i)if(touches_pool(&lower->ranges[i],b))return ArmSmmu4KOverlap;
+        for(size_t i=0;i<upper->count;++i)if(touches_pool(&upper->ranges[i],a))return ArmSmmu4KOverlap;
+        if(aliases && any_conflicting_alias(lower->arena,lower->ranges,lower->count,upper->ranges,upper->count))return ArmSmmu4KOverlap;
+    }
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KLiveAuditContext(const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveRegion *lower,const ArmSmmu4KLiveRegion *upper,ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    ArmSmmu4KStatus status=context_metadata(context,lower,upper,1);if(status)return status;
+    const ArmSmmu4KLiveRegion *regions[]={lower,upper};
+    for(unsigned i=0;i<2;++i)if(regions[i]) {
+        const ArmSmmu4KLiveRegion *v=regions[i];
+        status=verify(v->arena,&v->state->tables,v->ranges,v->count,0,0,0,r);if(status)return status;
+    }
+    r->complete=1;return ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus update(const ArmSmmu4KLiveArena *a,ArmSmmu4KLiveState *state,
+    const ArmSmmu4KIo *io,unsigned bank,const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveVisibility *visibility,const ArmSmmu4KRange *before,size_t count,
+    const ArmSmmu4KLiveRegion *peer,const ArmSmmu4KRange *changes,size_t change_count,unsigned map,unsigned budget,
+    ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    if(!state || !state->prepared || state->poisoned || !context ||
+        !visibility || !visibility->publish_table_page || map>1 || !change_count ||
+        !budget || budget>1048576 || state->generation==UINT64_MAX)return ArmSmmu4KArgument;
+    ArmSmmu4KResult shape;
+    ArmSmmu4KStatus status=layout(a,&shape);
+    if(status!=ArmSmmu4KSuccess)return status;
+    const ArmSmmu4KResult *root=a->upper_region?context->upper_tables:context->lower_tables;
+    if((!peer && (a->upper_region?(context->lower || context->lower_tables):(context->upper || context->upper_tables))) ||
+        !same_config(a->upper_region?context->upper:context->lower,&a->config) ||
+        root!=&state->tables || state->tables.root_physical!=shape.root_physical ||
+        state->tables.mair!=shape.mair || state->tables.table_pages!=shape.table_pages ||
+        state->tables.start_level!=shape.start_level || state->tables.upper_region!=shape.upper_region)
+        return ArmSmmu4KArgument;
+    /* Every 64th update of a region (its first included) re-proves the whole region: the existing ranges against each other and every
+     * table descriptor before and after. The others prove what they change: each changed leaf holds its old descriptor before the store
+     * and its new one after it, the existing ranges are still sorted, disjoint and in budget, and the changes conflict with none of
+     * them. The ranges were each checked as changes when they were added, and the tables were last proved whole at most 63 updates ago.
+     * A whole-region walk read every descriptor of a 2 GiB aperture four times per update (int-143: 10 ms per buffer map). */
+    const int whole=(state->generation&63)==0;
+    r->whole_verification=whole?1u:0u;
+    size_t leaves=0;
+    status=validate_ranges_checked(a,before,count,&leaves,whole);if(status!=ArmSmmu4KSuccess)return status;
+    if(leaves!=state->tables.leaf_pages)return ArmSmmu4KArgument;
+    /* The changes: sorted, disjoint, each valid; together within the leaf budget. */
+    size_t changed=0;
+    if(!changes)return ArmSmmu4KBadRange;
+    if(change_count>a->config.leaf_budget)return ArmSmmu4KArgument;
+    for(size_t i=0;i<change_count;++i) {
+        status=validate_range(a,&changes[i]);if(status!=ArmSmmu4KSuccess)return status;
+        if(i && changes[i].iova<=changes[i-1].iova+(changes[i-1].bytes-1))return ArmSmmu4KOverlap;
+        size_t pages=(size_t)(changes[i].bytes/PAGE);
+        if(pages>a->config.leaf_budget-changed)return ArmSmmu4KBudget;
+        changed+=pages;
+    }
+    if(peer) {
+        ArmSmmu4KLiveRegion target={a,state,before,count};
+        status=context_metadata(context,a->upper_region?peer:&target,a->upper_region?&target:peer,whole);
+        if(status)return status;
+        for(size_t i=0;i<change_count;++i)if(touches_pool(&changes[i],peer->arena))return ArmSmmu4KOverlap;
+        if(map && any_conflicting_alias(a,changes,change_count,peer->ranges,peer->count))return ArmSmmu4KOverlap;
+    }
+    if(map && changed>a->config.leaf_budget-leaves)return ArmSmmu4KBudget;
+    if(map && (any_conflicting_alias(a,changes,change_count,changes,change_count) ||
+        any_conflicting_alias(a,changes,change_count,before,count)))return ArmSmmu4KOverlap;
+    for(size_t i=0;i<change_count;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        uint64_t va=changes[i].iova+offset,old=expected(before,count,va);
+        if(map?old!=0:old!=descriptor(&changes[i],va))return ArmSmmu4KStateMismatch;
+    }
+    /* The context image and faults are observed around the stores of the whole-verification updates only (every 64th, the first
+     * included), and remembered there. Between them the bank stays the caller's exclusively owned one; each of these reads is a
+     * device register access, and an update observed it five times (int-159: 1.1 ms of a 1.7 ms buffer map). */
+    const int observed=whole || !state->context_offset;
+    if(observed) {
+        status=ArmSmmu4KObserveOwnedContext(io,bank,context,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(whole) {
+        status=verify(a,&shape,before,count,0,0,0,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(peer) {
+            status=verify(peer->arena,&peer->state->tables,peer->ranges,peer->count,0,0,0,r);
+            if(status)goto poisoned;
+        }
+    } else {
+        status=verify_changed(a,&shape,changes,change_count,map,0,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(observed) {
+        ArmSmmu4KProgramResult initial=r->synchronization;
+        status=ArmSmmu4KObserveOwnedContext(io,bank,context,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(initial.id0!=r->synchronization.id0 || initial.id1!=r->synchronization.id1 ||
+            initial.id2!=r->synchronization.id2 || initial.context_offset!=r->synchronization.context_offset)
+            {status=ArmSmmu4KStateMismatch;goto poisoned;}
+    }
+    /* All validation precedes the first store. Caller keeps every master
+     * quiesced and retains both old/new object references through this call. */
+    for(size_t i=0;i<change_count;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        uint64_t va=changes[i].iova+offset;size_t index;
+        status=leaf_index(a,&shape,va,&index,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        a->mapping[index]=map?descriptor(&changes[i],va):0;++r->descriptor_writes;
+    }
+    /* Sorted changes reach leaf pages in order, so each changed page is published once. */
+    size_t last_page=SIZE_MAX;
+    for(size_t i=0;i<change_count;++i)for(uint64_t offset=0;offset<changes[i].bytes;offset+=PAGE) {
+        size_t index;
+        status=leaf_index(a,&shape,changes[i].iova+offset,&index,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        size_t page=index/512;
+        if(page!=last_page) {
+            if(visibility->publish_table_page(visibility->cookie,a->mapping+page*512,4096)) {status=ArmSmmu4KIoError;goto poisoned;}
+            ++r->published_pages;last_page=page;
+        }
+    }
+    /* A map of leaves that were invalid needs no TLB invalidation: the TLBs hold no translation of an invalid descriptor (as Linux's
+     * io-pgtable maps without one). The unmap invalidates the ASID before it reports the translation removed. */
+    if(observed) {
+        status=ArmSmmu4KSynchronizeOwnedContext(io,bank,context,budget,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+    } else if(!map) {
+        status=ArmSmmu4KSyncContextTlb(io,state->context_offset,context->asid,0,budget,&r->synchronization);
+        if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(whole) {
+        status=verify(a,&shape,before,count,changes,change_count,map,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(peer) {
+            status=verify(peer->arena,&peer->state->tables,peer->ranges,peer->count,0,0,0,r);
+            if(status)goto poisoned;
+        }
+    } else {
+        status=verify_changed(a,&shape,changes,change_count,map,1,r);if(status!=ArmSmmu4KSuccess)goto poisoned;
+    }
+    if(observed) {
+        ArmSmmu4KProgramResult after;
+        status=ArmSmmu4KObserveOwnedContext(io,bank,context,&after);if(status!=ArmSmmu4KSuccess)goto poisoned;
+        if(after.id0!=r->synchronization.id0 || after.id1!=r->synchronization.id1 ||
+            after.id2!=r->synchronization.id2 || after.context_offset!=r->synchronization.context_offset)
+            {status=ArmSmmu4KStateMismatch;goto poisoned;}
+        state->context_offset=r->synchronization.context_offset;
+    }
+    state->tables.leaf_pages=map?leaves+changed:leaves-changed;++state->generation;
+    r->complete=1;r->translation_removed=!map;r->must_retain_resources=0;
+    return ArmSmmu4KSuccess;
+poisoned:
+    state->poisoned=1;if(peer)peer->state->poisoned=1;return status;
+}
+ArmSmmu4KStatus ArmSmmu4KLiveUpdate(const ArmSmmu4KLiveArena *a,ArmSmmu4KLiveState *state,
+    const ArmSmmu4KIo *io,unsigned bank,const ArmSmmu4KContextConfig *context,
+    const ArmSmmu4KLiveVisibility *visibility,const ArmSmmu4KRange *before,size_t count,
+    const ArmSmmu4KRange *change,unsigned map,unsigned budget,ArmSmmu4KLiveResult *r)
+{return update(a,state,io,bank,context,visibility,before,count,0,change,1,map,budget,r);}
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContextBatch(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *context,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,const ArmSmmu4KLiveVisibility *visibility,
+    const ArmSmmu4KRange *changes,size_t change_count,unsigned map,unsigned budget,ArmSmmu4KLiveResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KLiveResult){0};r->must_retain_resources=1;
+    if(change_upper>1)return ArmSmmu4KArgument;
+    const ArmSmmu4KLiveRegion *target=change_upper?upper:lower,*peer=change_upper?lower:upper;
+    if(!target || !target->state)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=context_metadata(context,lower,upper,(target->state->generation&63)==0);if(status)return status;
+    return update(target->arena,target->state,io,bank,context,visibility,target->ranges,target->count,
+        peer,changes,change_count,map,budget,r);
+}
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *context,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,const ArmSmmu4KLiveVisibility *visibility,
+    const ArmSmmu4KRange *change,unsigned map,unsigned budget,ArmSmmu4KLiveResult *r)
+{return ArmSmmu4KLiveUpdateContextBatch(io,bank,context,lower,upper,change_upper,visibility,change,1,map,budget,r);}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KLive.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KLive.h
new file mode 100644
index 000000000..d796657db
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KLive.h
@@ -0,0 +1,114 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_LIVE_H
+#define ARM_SMMU_4K_LIVE_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    ArmSmmu4KConfig config;
+    uint64_t iova,bytes;              /* Bounded native VA aperture, no conversion. */
+    unsigned upper_region;
+    volatile uint64_t *mapping;       /* Real writable CPU mapping of owned pool. */
+    size_t capacity_pages;
+    /* Optional caller-owned scratch for the physical-alias checks (one entry per range of the smaller compared side), used by one
+     * call at a time; absent or too small, those checks compare pairwise. Never read as state. */
+    uint32_t *alias_scratch;
+    size_t alias_scratch_entries;
+} ArmSmmu4KLiveArena;
+typedef struct {
+    ArmSmmu4KResult tables;
+    uint64_t generation;
+    unsigned prepared,poisoned;
+    /* The context bank's register offset the last whole-verification update observed its image at; 0 before the first. */
+    uint64_t context_offset;
+} ArmSmmu4KLiveState;
+typedef struct {
+    void *cookie;
+    /* Clean/publish the actual mapped table page for device walks. Required
+     * even for coherent walks (where the platform may use ordering alone).
+     * Return zero only after visibility is established. No fake success. */
+    int (*publish_table_page)(void *,volatile uint64_t *,size_t bytes);
+} ArmSmmu4KLiveVisibility;
+typedef struct {
+    const ArmSmmu4KLiveArena *arena;
+    ArmSmmu4KLiveState *state;
+    const ArmSmmu4KRange *ranges;
+    size_t count;
+} ArmSmmu4KLiveRegion;
+typedef struct {
+    size_t descriptor_reads,descriptor_writes,published_pages;
+    unsigned complete,translation_removed,must_retain_resources;
+    unsigned whole_verification;   /* this update re-proved the whole region (every 64th of a region) */
+    ArmSmmu4KProgramResult synchronization;
+} ArmSmmu4KLiveResult;
+/* Prepare an INACTIVE empty native4K arena. Preallocate only real intermediate
+ * table pages; all leaf slots remain invalid. No MMIO, TLB, allocator or cache
+ * operations. The explicit leaf budget bounds aperture size and traversal.
+ * state must be zero initialized and never reset while a context can access
+ * the pool. Capacity errors do not write tables. Caller must publish all used
+ * pages before enabling a context with &state->tables. This is not activation.
+ * The pool uses a fixed owned topology; no shadow/rebuilt translation exists. */
+ArmSmmu4KStatus ArmSmmu4KLivePrepare(const ArmSmmu4KLiveArena *,ArmSmmu4KLiveState *);
+/* Read-only exact graph check, including reserved empty intermediate tables.
+ * Use before context activation and while masters are quiesced. This neither
+ * observes a context/streams nor clears poison or authorizes resource release. */
+ArmSmmu4KStatus ArmSmmu4KLiveAudit(const ArmSmmu4KLiveArena *,const ArmSmmu4KLiveState *,
+    const ArmSmmu4KRange *ranges,size_t count,ArmSmmu4KLiveResult *);
+/* Incrementally map (map=1) an entirely invalid range, or unmap (map=0) an
+ * exactly matching mapped range. Replacement requires unmap then map; valid
+ * descriptors are never overwritten with different valid descriptors.
+ * before describes ALL currently mapped resources, sorted by native IOVA.
+ * Exact physical graph checks precede/follow changes to the actual pool.
+ * No copies/reference table graphs, block mappings or table retirement.
+ *
+ * Requires a SINGLE enabled region rooted in this arena, an exclusive powered
+ * bank/ASID/stream lease, installed fault handling, and ALL masters quiesced
+ * until successful completion. Caller establishes/retains actual CPU->PA
+ * ownership, attributes, object references, data-cache ordering and queue
+ * serialization. Metadata, arrays, state/results and table storage are disjoint
+ * and immutable during each call except the explicit outputs/table writes.
+ * These conditions are platform responsibilities, not caller boolean proofs.
+ * On any uncertain context/table/cache/TLB failure the state is poisoned and
+ * all old/new resources and tables must remain owned until an independently
+ * verified quiesce/fault/disable/reset. No automatic rollback/replay occurs.
+ * Successful unmap removes translation only; it does not generate a GPU fence
+ * or establish completion of previous DMA. No hardware ownership is inferred
+ * from declared addresses. The software tests are not hardware qualification. */
+ArmSmmu4KStatus ArmSmmu4KLiveUpdate(const ArmSmmu4KLiveArena *,ArmSmmu4KLiveState *,
+    const ArmSmmu4KIo *,unsigned bank,const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KLiveVisibility *,const ArmSmmu4KRange *before,size_t count,
+    const ArmSmmu4KRange *change,unsigned map,unsigned poll_budget,ArmSmmu4KLiveResult *);
+/* Full enabled-context variant: supply exactly its enabled lower/upper regions.
+ * Both actual pool graphs are audited; cross-pool resource access, pool CPU/PA
+ * aliases and inconsistent cross-region physical aliases refuse before writes.
+ * Context roots/configs must match the actual supplied arena/state pairs.
+ * AuditContext is read-only and does not observe hardware or release anything.
+ * UpdateContext edits only the selected region, publishes its changed pages,
+ * synchronizes the actual shared ASID and rechecks BOTH graphs. Any uncertainty
+ * poisons both states and retains all resources. All ownership/quiescence/cache
+ * preconditions of LiveUpdate apply to the entire context. No context switch,
+ * TTBR change, copied/converted/shadow mapping or GPU fence is implemented. */
+ArmSmmu4KStatus ArmSmmu4KLiveAuditContext(const ArmSmmu4KContextConfig *,
+    const ArmSmmu4KLiveRegion *lower,const ArmSmmu4KLiveRegion *upper,ArmSmmu4KLiveResult *);
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,
+    const ArmSmmu4KLiveVisibility *,const ArmSmmu4KRange *change,unsigned map,
+    unsigned poll_budget,ArmSmmu4KLiveResult *);
+/* UpdateContext for several ranges of one region in one transaction: changes are
+ * sorted by native IOVA and disjoint; map wants each entirely invalid, unmap
+ * each exactly mapped. Every check of UpdateContext covers all of them before
+ * the first store; their leaf pages are published once, the ASID synchronized
+ * once and both graphs rechecked once. A buffer of scattered physical pages is
+ * one change per page, so its mapping costs one transaction, not one per page.
+ * The changes may lie inside the target region's ranges (an unmap). */
+ArmSmmu4KStatus ArmSmmu4KLiveUpdateContextBatch(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,const ArmSmmu4KLiveRegion *lower,
+    const ArmSmmu4KLiveRegion *upper,unsigned change_upper,
+    const ArmSmmu4KLiveVisibility *,const ArmSmmu4KRange *changes,size_t change_count,
+    unsigned map,unsigned poll_budget,ArmSmmu4KLiveResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KMmio.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KMmio.c
new file mode 100644
index 000000000..df974ba1c
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KMmio.c
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KMmio.h"
+#if !defined(__aarch64__) || __BYTE_ORDER__ != __ORDER_LITTLE_ENDIAN__
+#error Direct SMMUv2 MMIO binding requires little-endian AArch64
+#endif
+static int fits(const ArmSmmu4KMmio *m,size_t at,size_t bytes)
+{return m && m->mapping && m->bytes && m->bytes-1<=UINTPTR_MAX-(uintptr_t)m->mapping && !((uintptr_t)m->mapping&7) && !(at&(bytes-1)) && at<=m->bytes && bytes<=m->bytes-at;}
+static int read32(void *cookie,size_t at,uint32_t *out)
+{ArmSmmu4KMmio *m=cookie;if(!out || !fits(m,at,4))return 1;*out=*(volatile uint32_t *)(m->mapping+at);return 0;}
+static int read64(void *cookie,size_t at,uint64_t *out)
+{ArmSmmu4KMmio *m=cookie;if(!out || !fits(m,at,8))return 1;*out=*(volatile uint64_t *)(m->mapping+at);return 0;}
+static int write32(void *cookie,size_t at,uint32_t value)
+{ArmSmmu4KMmio *m=cookie;if(!fits(m,at,4))return 1;*(volatile uint32_t *)(m->mapping+at)=value;return 0;}
+static int write64(void *cookie,size_t at,uint64_t value)
+{ArmSmmu4KMmio *m=cookie;if(!fits(m,at,8))return 1;*(volatile uint64_t *)(m->mapping+at)=value;return 0;}
+static int barrier(void *cookie)
+{(void)cookie;__asm__ volatile("dsb sy":::"memory");return 0;}
+ArmSmmu4KStatus ArmSmmu4KBindMmio(ArmSmmu4KMmio *mapping,ArmSmmu4KIo *out)
+{
+    if(!out)return ArmSmmu4KArgument;
+    *out=(ArmSmmu4KIo){0};
+    if(!mapping || !mapping->mapping || ((uintptr_t)mapping->mapping&7) || mapping->bytes<0x2c || mapping->bytes-1>UINTPTR_MAX-(uintptr_t)mapping->mapping)return ArmSmmu4KArgument;
+    out->cookie=mapping;out->register_bytes=mapping->bytes;out->read32=read32;out->read64=read64;
+    out->write32=write32;out->write64=write64;out->barrier=barrier;
+    return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KMmio.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KMmio.h
new file mode 100644
index 000000000..52a2d37c3
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KMmio.h
@@ -0,0 +1,19 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_MMIO_H
+#define ARM_SMMU_4K_MMIO_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {volatile unsigned char *mapping;size_t bytes;} ArmSmmu4KMmio;
+/* AArch64 little-endian direct volatile MMIO adapter, with dsb sy barriers.
+ * Caller supplies an owned live Device mapping. This allocates/maps nothing,
+ * powers nothing and cannot recover a synchronous external bus abort. All
+ * inputs/output must be disjoint and retained for the I/O object's lifetime.
+ * Never bind arbitrary physical/virtual addresses or ordinary user buffers
+ * as a hardware mapping. Software tests are explicitly separate fixtures. */
+ArmSmmu4KStatus ArmSmmu4KBindMmio(ArmSmmu4KMmio *,ArmSmmu4KIo *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KProgram.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KProgram.c
new file mode 100644
index 000000000..2cb669506
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KProgram.c
@@ -0,0 +1,195 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KProgram.h"
+#define FSR_FAULT UINT32_C(0xc00001fe)
+static int read_image(const ArmSmmu4KIo *io,size_t gr1,size_t cb,unsigned bank,
+    ArmSmmu4KContextImage *v)
+{
+    v->reserved_zero=0;
+    return io->read32(io->cookie,gr1+bank*4,&v->cbar) ||
+        io->read32(io->cookie,gr1+0x800+bank*4,&v->cba2r) ||
+        io->read32(io->cookie,cb+0x30,&v->tcr) ||
+        io->read32(io->cookie,cb+0x10,&v->tcr2) ||
+        io->read64(io->cookie,cb+0x20,&v->ttbr0) ||
+        io->read64(io->cookie,cb+0x28,&v->ttbr1) ||
+        io->read32(io->cookie,cb+0x38,&v->mair0) ||
+        io->read32(io->cookie,cb+0x3c,&v->mair1) ||
+        io->read32(io->cookie,cb,&v->sctlr);
+}
+static int write32(const ArmSmmu4KIo *io,size_t at,uint32_t value,ArmSmmu4KProgramResult *r)
+{
+    ++r->writes;return io->write32(io->cookie,at,value);
+}
+static int write64(const ArmSmmu4KIo *io,size_t at,uint64_t value,ArmSmmu4KProgramResult *r)
+{
+    ++r->writes;return io->write64(io->cookie,at,value);
+}
+/* TLBIASID (+0x610, value = ASID) or, with all set, TLBIALL (+0x618, value ignored), then TLBSYNC/TLBSTATUS. */
+static ArmSmmu4KStatus sync_tlb(const ArmSmmu4KIo *io,size_t cb,unsigned asid,unsigned all,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    r->tlb_synchronized=0;
+    if(io->barrier(io->cookie) || write32(io,cb+(all?0x618:0x610),all?0:asid,r) ||
+        write32(io,cb+0x7f0,UINT32_MAX,r) || io->barrier(io->cookie))return ArmSmmu4KIoError;
+    for(unsigned i=0;i<budget;++i) {
+        uint32_t status;++r->poll_reads;
+        if(io->read32(io->cookie,cb+0x7f4,&status))return ArmSmmu4KIoError;
+        if(!(status&1)) {
+            /* Order the completed device observation before callers recycle
+             * normal-memory tables or publish subsequent context work. */
+            if(io->barrier(io->cookie))return ArmSmmu4KIoError;
+            r->tlb_synchronized=1;return ArmSmmu4KSuccess;
+        }
+    }
+    return ArmSmmu4KTimeout;
+}
+static ArmSmmu4KStatus sync_asid(const ArmSmmu4KIo *io,size_t cb,unsigned asid,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    return sync_tlb(io,cb,asid,0,budget,r);
+}
+static ArmSmmu4KStatus disable_sync(const ArmSmmu4KIo *io,size_t cb,unsigned asid,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    r->must_retain_tables=1;r->disabled_verified=0;
+    uint32_t value;
+    if(write32(io,cb,0,r) || io->barrier(io->cookie) || io->read32(io->cookie,cb,&value))return ArmSmmu4KIoError;
+    if(value)return ArmSmmu4KStateMismatch;
+    r->disabled_verified=1;r->enabled=0;
+    ArmSmmu4KStatus status=sync_asid(io,cb,asid,budget,r);
+    if(status==ArmSmmu4KSuccess)r->must_retain_tables=0;
+    return status;
+}
+static ArmSmmu4KStatus prepare(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r,
+    ArmSmmu4KContextConfig *actual,ArmSmmu4KContextImage *image,size_t *gr1)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};
+    r->must_retain_tables=1;
+    if(!io || !config || !io->read32 || !io->read64 || !io->write32 || !io->write64 ||
+        !io->barrier || io->register_bytes<0x2c || !budget || budget>1048576 || bank>255)return ArmSmmu4KArgument;
+    r->phase=1;
+    if(io->read32(io->cookie,0x20,&r->id0) || io->read32(io->cookie,0x24,&r->id1) ||
+        io->read32(io->cookie,0x28,&r->id2))return ArmSmmu4KIoError;
+    unsigned shift=(r->id1>>31)?16:12;
+    size_t pages=(size_t)1<<(((r->id1>>28)&7)+1);
+    size_t stride=(size_t)1<<shift;
+    unsigned banks=r->id1&255,s2=(r->id1>>16)&255;
+    if(!banks || banks>pages || s2>banks || bank<s2 || bank>=banks ||
+        io->register_bytes<2*pages*stride)return ArmSmmu4KUnsupported;
+    *gr1=stride;r->context_offset=(pages+bank)*stride;
+    if(r->context_offset>io->register_bytes || io->register_bytes-r->context_offset<0x7f8 ||
+        *gr1+0x804+bank*4>io->register_bytes)return ArmSmmu4KBadRange;
+    *actual=*config;actual->id0=r->id0;actual->id2=r->id2;
+    return ArmSmmu4KEncodeContext(actual,image);
+}
+ArmSmmu4KStatus ArmSmmu4KProgramDisabledContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,budget,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t cb=(size_t)r->context_offset;uint32_t sctlr;
+    if(io->read32(io->cookie,cb,&sctlr))return ArmSmmu4KIoError;
+    if(sctlr&1){r->enabled=1;return ArmSmmu4KBusy;}
+    r->must_retain_tables=1;r->phase=2;
+    /* A disabled owned bank only. TCR2/TCR precede all TTBR accesses. */
+    if(write32(io,cb,0,r) || io->barrier(io->cookie) ||
+        write32(io,gr1+0x800+bank*4,image.cba2r,r) || write32(io,gr1+bank*4,image.cbar,r) ||
+        write32(io,cb+0x10,image.tcr2,r) || write32(io,cb+0x30,image.tcr,r) ||
+        write64(io,cb+0x20,image.ttbr0,r) || write64(io,cb+0x28,image.ttbr1,r) ||
+        write32(io,cb+0x38,image.mair0,r) || write32(io,cb+0x3c,image.mair1,r) ||
+        write32(io,cb+0x58,UINT32_MAX,r)) {status=ArmSmmu4KIoError;goto failed;}
+    status=sync_asid(io,cb,actual.asid,budget,r);if(status!=ArmSmmu4KSuccess)goto failed;
+    r->phase=3;
+    if(read_image(io,gr1,cb,bank,&r->readback)) {status=ArmSmmu4KIoError;goto failed;}
+    r->readback_valid=1;
+    /* Verify configuration while M is still zero; never enable a bad granule. */
+    sctlr=r->readback.sctlr;r->readback.sctlr=image.sctlr;
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);r->readback.sctlr=sctlr;
+    if(status!=ArmSmmu4KSuccess || sctlr) {status=ArmSmmu4KStateMismatch;goto failed;}
+    r->readback_valid=0;
+    if(io->barrier(io->cookie) || write32(io,cb,image.sctlr,r) || io->barrier(io->cookie)) {status=ArmSmmu4KIoError;goto failed;}
+    r->phase=4;
+    if(read_image(io,gr1,cb,bank,&r->readback)) {status=ArmSmmu4KIoError;goto failed;}
+    r->readback_valid=1;r->enabled=r->readback.sctlr&1;
+    if(io->read32(io->cookie,cb+0x58,&r->fault_status)) {status=ArmSmmu4KIoError;goto failed;}
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);if(status!=ArmSmmu4KSuccess)goto failed;
+    if(r->fault_status&FSR_FAULT) {status=ArmSmmu4KFault;goto failed;}
+    r->phase=5;r->enabled=1;return ArmSmmu4KSuccess;
+failed:
+    /* Even a reported failed write may have reached hardware. On uncertainty
+     * retain all tables/leases; never claim safe recycling after timeout. */
+    r->readback_valid=0;(void)disable_sync(io,cb,actual.asid,budget,r);
+    r->phase=6;return status;
+}
+ArmSmmu4KStatus ArmSmmu4KDisableOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,budget,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    size_t cb=(size_t)r->context_offset;r->must_retain_tables=1;
+    if(read_image(io,gr1,cb,bank,&r->readback))return ArmSmmu4KIoError;
+    r->readback_valid=1;uint32_t sctlr=r->readback.sctlr;
+    /* An enabled bank must match the owned image (ValidateContextReadback, with its documented read-only bits); a
+     * disabled one is compared with SCTLR substituted. */
+    if(sctlr)status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);
+    else {r->readback.sctlr=image.sctlr;status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);r->readback.sctlr=sctlr;}
+    if(status!=ArmSmmu4KSuccess)return status; /* Another context: do not touch. */
+    r->readback_valid=0;status=disable_sync(io,cb,actual.asid,budget,r);r->phase=status==ArmSmmu4KSuccess?7:6;
+    return status;
+}
+
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,ArmSmmu4KProgramResult *r)
+{
+    ArmSmmu4KContextConfig actual;ArmSmmu4KContextImage image;size_t gr1;
+    ArmSmmu4KStatus status=prepare(io,bank,config,1,r,&actual,&image,&gr1);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(read_image(io,gr1,(size_t)r->context_offset,bank,&r->readback))return ArmSmmu4KIoError;
+    r->readback_valid=1;r->enabled=r->readback.sctlr&1;
+    status=ArmSmmu4KValidateContextReadback(&actual,&r->readback);
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(io->read32(io->cookie,(size_t)r->context_offset+0x58,&r->fault_status) || io->barrier(io->cookie))return ArmSmmu4KIoError;
+    if(r->fault_status&FSR_FAULT)return ArmSmmu4KFault;
+    r->phase=8;return ArmSmmu4KSuccess;
+}
+
+static ArmSmmu4KStatus synchronize(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned all,unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};r->must_retain_tables=1;
+    if(!budget || budget>1048576)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=ArmSmmu4KObserveOwnedContext(io,bank,config,r);
+    if(status!=ArmSmmu4KSuccess)return status;
+    status=sync_tlb(io,(size_t)r->context_offset,config->asid,all,budget,r);
+    if(status!=ArmSmmu4KSuccess)return status;
+    ArmSmmu4KProgramResult after;
+    status=ArmSmmu4KObserveOwnedContext(io,bank,config,&after);
+    r->readback=after.readback;r->readback_valid=after.readback_valid;
+    r->fault_status=after.fault_status;r->enabled=after.enabled;
+    if(status!=ArmSmmu4KSuccess)return status;
+    if(r->id0!=after.id0 || r->id1!=after.id1 || r->id2!=after.id2 ||
+        r->context_offset!=after.context_offset)return ArmSmmu4KStateMismatch;
+    r->phase=9;return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KSyncContextTlb(const ArmSmmu4KIo *io,uint64_t context_offset,unsigned asid,unsigned all,
+    unsigned budget,ArmSmmu4KProgramResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KProgramResult){0};r->must_retain_tables=1;
+    if(!io || !io->write32 || !io->read32 || !io->barrier || !budget || budget>1048576 || !context_offset ||
+        context_offset>io->register_bytes || io->register_bytes-context_offset<0x7f8)return ArmSmmu4KArgument;
+    r->context_offset=context_offset;
+    ArmSmmu4KStatus status=sync_tlb(io,(size_t)context_offset,asid,all,budget,r);
+    if(status==ArmSmmu4KSuccess)r->phase=9;
+    return status;
+}
+ArmSmmu4KStatus ArmSmmu4KSynchronizeOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{return synchronize(io,bank,config,0,budget,r);}
+ArmSmmu4KStatus ArmSmmu4KInvalidateAllOwnedContext(const ArmSmmu4KIo *io,unsigned bank,
+    const ArmSmmu4KContextConfig *config,unsigned budget,ArmSmmu4KProgramResult *r)
+{return synchronize(io,bank,config,1,budget,r);}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KProgram.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KProgram.h
new file mode 100644
index 000000000..88b3aa2f9
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KProgram.h
@@ -0,0 +1,74 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_PROGRAM_H
+#define ARM_SMMU_4K_PROGRAM_H
+#include "ArmSmmu4KContext.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+/* Byte offsets are relative to one real, owned SMMUv2 MMIO mapping. All I/O
+ * callbacks return 0 on success. read/write64 must perform actual aligned
+ * 64-bit TTBR accesses; barrier orders table visibility and device writes.
+ * A barrier is NOT cache cleaning. No callback may silently fake success. */
+typedef struct {
+    void *cookie;
+    size_t register_bytes;
+    int (*read32)(void *,size_t,uint32_t *);
+    int (*read64)(void *,size_t,uint64_t *);
+    int (*write32)(void *,size_t,uint32_t);
+    int (*write64)(void *,size_t,uint64_t);
+    int (*barrier)(void *);
+    unsigned polling_faults; /*1: board owns synchronous fault polling; no GFIE requirement.*/
+} ArmSmmu4KIo;
+typedef struct {
+    uint64_t context_offset;
+    uint32_t id0,id1,id2,phase,writes,poll_reads,fault_status;
+    uint32_t readback_valid,enabled,disabled_verified,tlb_synchronized,must_retain_tables;
+    ArmSmmu4KContextImage readback;
+} ArmSmmu4KProgramResult;
+
+/* REAL register programming primitive, not a device-discovery/ownership layer.
+ * Caller MUST hold an exclusive bank/ASID/stream lease, keep the device powered
+ * and clocked, quiesce/fault its streams, install its fault interrupt handler,
+ * establish platform ACTLR/security requirements, and clean/publish real owned
+ * native4K tables before calling. Every argument/result must be disjoint.
+ * Reads actual ID0/ID1/ID2 through I/O and overrides config's supplied IDs.
+ * Refuses enabled banks before any write. Enables SCTLR only after register
+ * readback and bounded ASID invalidation/synchronization. No global reset,
+ * stream reassignment or other bank is touched. On failure attempts disable
+ * and sync; must_retain_tables stays set unless both are confirmed. Success
+ * also retains table ownership while the installed context is active.
+ * This does not walk tables or establish actual GPU execution/correctness. */
+ArmSmmu4KStatus ArmSmmu4KProgramDisabledContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* Read-only observation of actual IDs and all owned context registers. Requires
+ * exact enabled native4K image and no pending context fault. Does not walk the
+ * physical tables or establish ownership. Readback is a momentary observation;
+ * callers retain resources, quiescence/exclusive lease and fault handling. */
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KProgramResult *);
+/* Publish already cleaned descriptor changes with a real ASID invalidation
+ * and bounded context TLBSYNC. Observe the complete enabled native4K image and
+ * faults before and after. Caller exclusively owns this bank/ASID, serializes
+ * all page-table updates and keeps every master quiesced. A barrier is not a
+ * cache clean. No SCTLR/TTBR/stream writes or recovery/reset are performed.
+ * Any failure retains all mappings/resources; success is not a GPU fence. */
+ArmSmmu4KStatus ArmSmmu4KSynchronizeOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* TLBIASID (or, with all set, TLBIALL) and the bounded TLBSYNC of the context bank at context_offset alone: no image or fault
+ * observation. For a caller that observed this owned bank's image at that offset already and keeps it owned (the live updater
+ * between its whole-verification updates). */
+ArmSmmu4KStatus ArmSmmu4KSyncContextTlb(const ArmSmmu4KIo *,uint64_t context_offset,unsigned asid,unsigned all,
+    unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* As ArmSmmu4KSynchronizeOwnedContext, but with TLBIALL for the bank instead of TLBIASID: every cached translation of the bank goes,
+ * whatever ASID it was tagged with. */
+ArmSmmu4KStatus ArmSmmu4KInvalidateAllOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+/* Disable only if actual stage/format/roots/ASID/attributes still match the
+ * expected owned context. Retain bank, mappings and tables on any uncertainty.
+ * Does not release the caller's lease or power/stream/interrupt resources. */
+ArmSmmu4KStatus ArmSmmu4KDisableOwnedContext(const ArmSmmu4KIo *,unsigned bank,
+    const ArmSmmu4KContextConfig *,unsigned poll_budget,ArmSmmu4KProgramResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KStreams.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KStreams.c
new file mode 100644
index 000000000..0e9ecff69
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KStreams.c
@@ -0,0 +1,165 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KStreams.h"
+#define FAULT (UINT32_C(2)<<16)
+static int rd(const ArmSmmu4KIo *io,size_t at,uint32_t *v,ArmSmmu4KStreamResult *r)
+{++r->reads;return io->read32(io->cookie,at,v);}
+static int wr(const ArmSmmu4KIo *io,size_t at,uint32_t v,ArmSmmu4KStreamResult *r)
+{++r->writes;return io->write32(io->cookie,at,v);}
+static unsigned exids(uint32_t id){return (id>>8)&1;}
+static uint32_t valid_smr(uint32_t id){return exids(id)?0:UINT32_C(1)<<31;}
+static uint32_t valid_s2cr(uint32_t id){return exids(id)?1u<<10:0;}
+/* CBNDX has no translation meaning for TYPE=FAULT. On sweet's exact
+ * measured polling profile firmware retains0xff there after ignored FAULT
+ * writes. Keep exact readback for active translations and all other boards. */
+static int fault_equal(const ArmSmmu4KIo *io,uint32_t id,uint32_t got,uint32_t want)
+{
+    const uint32_t ignored=io->polling_faults==1 && id==0x48016605u?0xffu:0;
+    return (got&~ignored)==want;
+}
+static int valid(uint32_t id,uint32_t smr,uint32_t s2cr)
+{return exids(id)?!!(s2cr&(1u<<10)):!!(smr&(UINT32_C(1)<<31));}
+static ArmSmmu4KStatus global(const ArmSmmu4KIo *io,ArmSmmu4KStreamResult *r)
+{
+    if(!io || !io->read32 || !io->write32 || !io->barrier || io->register_bytes<0xc04)return ArmSmmu4KArgument;
+    if(rd(io,0x20,&r->id0,r) || rd(io,0,&r->scr0,r) || rd(io,0x48,&r->global_fault,r))return ArmSmmu4KIoError;
+    if(!(r->id0&(1u<<27)) || !(r->id0&255) || 0xc00u+4*(r->id0&255)>io->register_bytes)return ArmSmmu4KUnsupported;
+    /* Real global enable (CLIENTPD clear), global fault reporting (GFRE/GFIE) and unmatched-stream fault
+     * policy (USFCFG). Configuration-access fault reporting (GCFGFRE/GCFGFIE) is not required: Linux sets
+     * it only in its own global reset, and firmware that owns sCR0 may leave it clear (an Adreno SMMU read
+     * 0x002f0406). It reports bad register accesses, it does not change translation or bypass. */
+    if(io->polling_faults>1 || (r->scr0&0x407)!=(io->polling_faults?0x402u:0x406u) || !!(r->scr0&8)!=exids(r->id0))return ArmSmmu4KStateMismatch;
+    return r->global_fault?ArmSmmu4KFault:ArmSmmu4KSuccess;
+}
+static ArmSmmu4KStatus scan(const ArmSmmu4KIo *io,const ArmSmmu4KStream *s,unsigned n,
+    unsigned bank,unsigned attached,ArmSmmu4KStreamResult *r)
+{
+    unsigned slots=r->id0&255;uint32_t sidmask=exids(r->id0)?0xffffu:(1u<<((r->id0>>9)&15))-1;
+    for(unsigned i=0;i<n;++i) {
+        if(s[i].slot>=slots || (s[i].sid&~sidmask))return ArmSmmu4KArgument;
+        for(unsigned j=0;j<i;++j)if(s[i].slot==s[j].slot || s[i].sid==s[j].sid)return ArmSmmu4KOverlap;
+    }
+    r->streams_verified=0;
+    for(unsigned slot=0;slot<slots;++slot) {
+        uint32_t smr,s2cr;
+        if(rd(io,0x800+4*slot,&smr,r) || rd(io,0xc00+4*slot,&s2cr,r))return ArmSmmu4KIoError;
+        unsigned own=n;
+        for(unsigned i=0;i<n;++i)if(s[i].slot==slot){own=i;break;}
+        if(own<n) {
+            unsigned live=valid(r->id0,smr,s2cr);
+            if(attached) {
+                if(smr!=(valid_smr(r->id0)|s[own].sid) || s2cr!=(bank|valid_s2cr(r->id0)))return ArmSmmu4KStateMismatch;
+            } else if(!fault_equal(io,r->id0,s2cr&~valid_s2cr(r->id0),FAULT) ||
+                (live && smr!=(valid_smr(r->id0)|s[own].sid)))return ArmSmmu4KBusy;
+            ++r->streams_verified;
+        } else if(valid(r->id0,smr,s2cr)) {
+            if(!(s2cr&(3u<<16)) && (s2cr&255)==bank)return ArmSmmu4KBusy;
+            uint32_t mask=(smr>>16)&(exids(r->id0)?0xffffu:0x7fffu),id=smr&0xffff;
+            for(unsigned i=0;i<n;++i)if(!((s[i].sid^id)&~mask&sidmask))return ArmSmmu4KOverlap;
+        }
+    }
+    return ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KCheckFaultedStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStream *s,
+    unsigned n,unsigned bank,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !n || n>8 || bank>255)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    return scan(io,s,n,bank,0,r);
+}
+static int quarantine(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *state,unsigned count,ArmSmmu4KStreamResult *r)
+{
+    r->streams_faulted=0;int failed=0;
+    for(unsigned i=0;i<count;++i) {
+        size_t at=0xc00+4*state->streams[i].slot;uint32_t value;
+        /* First stop translation. Only after confirmed FAULT may we restore
+         * the exact owned SID and make EXIDS matching valid again. This also
+         * handles an indeterminate/failed SMR publication without activating
+         * an old or corrupted SID from an initially invalid slot. */
+        size_t smr=0x800+4*state->streams[i].slot;
+        uint32_t match=valid_smr(state->id0)|state->streams[i].sid;
+        if(wr(io,at,FAULT,r) || io->barrier(io->cookie) || rd(io,at,&value,r) || !fault_equal(io,state->id0,value,FAULT) ||
+            wr(io,smr,match,r) || io->barrier(io->cookie) || rd(io,smr,&value,r) || value!=match ||
+            wr(io,at,FAULT|valid_s2cr(state->id0),r) || io->barrier(io->cookie) ||
+            rd(io,at,&value,r) || !fault_equal(io,state->id0,value,FAULT|valid_s2cr(state->id0)))failed=1;
+        else ++r->streams_faulted;
+    }
+    return failed;
+}
+static ArmSmmu4KStatus observe(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=ArmSmmu4KObserveOwnedContext(io,s->bank,c,&r->context);if(status)return status;
+    status=scan(io,s->streams,s->count,s->bank,1,r);if(status)return status;
+    return io->barrier(io->cookie)?ArmSmmu4KIoError:ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KObserveStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    return observe(io,s,c,r);
+}
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedStreams(const ArmSmmu4KIo *io,const ArmSmmu4KStreamState *s,
+    const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=ArmSmmu4KObserveOwnedContext(io,s->bank,c,&r->context);if(status)return status;
+    for(unsigned i=0;i<s->count;++i) {
+        uint32_t smr,s2cr;
+        if(rd(io,0x800+4*s->streams[i].slot,&smr,r) || rd(io,0xc00+4*s->streams[i].slot,&s2cr,r))return ArmSmmu4KIoError;
+        if(smr!=(valid_smr(r->id0)|s->streams[i].sid) || s2cr!=(s->bank|valid_s2cr(r->id0)))return ArmSmmu4KStateMismatch;
+        ++r->streams_verified;
+    }
+    return io->barrier(io->cookie)?ArmSmmu4KIoError:ArmSmmu4KSuccess;
+}
+ArmSmmu4KStatus ArmSmmu4KAttachStreams(const ArmSmmu4KIo *io,ArmSmmu4KStreamState *state,
+    const ArmSmmu4KStream *s,unsigned n,unsigned bank,const ArmSmmu4KContextConfig *c,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!state || !s || !n || n>8 || bank>255)return ArmSmmu4KArgument;
+    if(state->attempted || state->attached || state->poisoned)return ArmSmmu4KBusy;
+    r->phase=1;ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    status=ArmSmmu4KObserveOwnedContext(io,bank,c,&r->context);if(status)return status;
+    status=scan(io,s,n,bank,0,r);if(status)return status;
+    state->attempted=1;state->id0=r->id0;state->scr0=r->scr0;state->count=n;state->bank=bank;
+    for(unsigned i=0;i<n;++i)state->streams[i]=s[i];
+    unsigned touched=0;r->phase=2;
+    for(unsigned i=0;i<n;++i) {
+        uint32_t value;size_t smr=0x800+4*s[i].slot,s2cr=0xc00+4*s[i].slot;
+        touched=i+1;
+        /* In EXIDS mode make this leased slot invalid until its new SID is
+         * installed. All masters are quiesced, and unmatched SIDs fault. */
+        if(wr(io,s2cr,bank,r) || io->barrier(io->cookie) || rd(io,s2cr,&value,r)) {status=ArmSmmu4KIoError;goto failed;}
+        if(value!=bank){status=ArmSmmu4KStateMismatch;goto failed;}
+        if(wr(io,smr,valid_smr(r->id0)|s[i].sid,r) || io->barrier(io->cookie) || rd(io,smr,&value,r)) {status=ArmSmmu4KIoError;goto failed;}
+        if(value!=(valid_smr(r->id0)|s[i].sid)){status=ArmSmmu4KStateMismatch;goto failed;}
+        if(exids(r->id0) && (wr(io,s2cr,bank|valid_s2cr(r->id0),r) || io->barrier(io->cookie))) {status=ArmSmmu4KIoError;goto failed;}
+    }
+    r->phase=3;status=observe(io,state,c,r);if(status)goto failed;
+    state->attached=1;r->phase=4;return ArmSmmu4KSuccess;
+failed:
+    state->poisoned=1;state->attached=0;r->phase=5;
+    (void)quarantine(io,state,touched,r);return status;
+}
+ArmSmmu4KStatus ArmSmmu4KFaultStreams(const ArmSmmu4KIo *io,ArmSmmu4KStreamState *s,ArmSmmu4KStreamResult *r)
+{
+    if(!r)return ArmSmmu4KArgument;
+    *r=(ArmSmmu4KStreamResult){0};r->must_retain_resources=1;
+    if(!s || !s->attached || s->poisoned || !s->count || s->count>8)return ArmSmmu4KArgument;
+    ArmSmmu4KStatus status=global(io,r);if(status)return status;
+    if(r->id0!=s->id0 || r->scr0!=s->scr0)return ArmSmmu4KStateMismatch;
+    status=scan(io,s->streams,s->count,s->bank,1,r);if(status)return status;
+    r->phase=6;
+    if(quarantine(io,s,s->count,r)){s->poisoned=1;s->attached=0;return ArmSmmu4KIoError;}
+    s->attached=0;r->phase=7;return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KStreams.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KStreams.h
new file mode 100644
index 000000000..56d3d2e26
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KStreams.h
@@ -0,0 +1,63 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_STREAMS_H
+#define ARM_SMMU_4K_STREAMS_H
+#include "ArmSmmu4KProgram.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {unsigned slot;uint16_t sid;} ArmSmmu4KStream;
+typedef struct {
+    unsigned attempted,attached,poisoned,count,bank;
+    uint32_t id0,scr0;
+    ArmSmmu4KStream streams[8];
+} ArmSmmu4KStreamState;
+typedef struct {
+    unsigned phase,reads,writes,streams_verified,streams_faulted,must_retain_resources;
+    uint32_t id0,scr0,global_fault;
+    ArmSmmu4KProgramResult context;
+} ArmSmmu4KStreamResult;
+/* Read-only preflight of global fault policy, target faulting slots and all
+ * conflicting live routes, including unrelated SIDs using the selected bank.
+ * Intended before programming a disabled context under the same global lease. */
+ArmSmmu4KStatus ArmSmmu4KCheckFaultedStreams(const ArmSmmu4KIo *,const ArmSmmu4KStream *,
+    unsigned count,unsigned bank,ArmSmmu4KStreamResult *);
+/* Native SMMUv2 exact stream matching (SMS), both legacy and EXIDS layouts.
+ * Caller owns the listed slots, bank/ASID, mappings and a global configuration
+ * lock. All client masters MUST remain quiesced until successful attachment.
+ * Requires live powered MMIO and installed context/global fault handlers,
+ * active native4K context/tables with verified physical ownership/coherence,
+ * and global fault-on-unmatched (no bypass). Global setup/quirks and context
+ * creation belong to the platform; no global reset or mask probing occurs.
+ * All target S2CRs must already fault; valid target SMRs must be exact matches.
+ * Every other active SMR is checked for overlapping requested SIDs. No masked
+ * attachment, bypass, privilege override, implicit slot selection or context
+ * reassignment is supported. Reads actual ID0 and enabled context registers.
+ * Inputs/state/result must be disjoint; state is zero-initialized and remains
+ * exclusively owned. Configuration/tables remain immutable while attached.
+ * Writes S2CR before publishing SMR; EXIDS keeps EXIDVALID clear until the
+ * exact SMR has been read back. Success rereads actual context/stream state.
+ * Any failure after a mutation attempt faults only the leased touched slots,
+ * poisons state and forbids replay. Resources are retained on EVERY outcome.
+ * Successful software I/O fixtures are not proof of active hardware tables. */
+ArmSmmu4KStatus ArmSmmu4KAttachStreams(const ArmSmmu4KIo *,ArmSmmu4KStreamState *,
+    const ArmSmmu4KStream *,unsigned count,unsigned bank,const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Read-only, checks all routes/conflicts/global fault policy and complete
+ * enabled native4K context image. No fault clear or recovery is synthesized. */
+ArmSmmu4KStatus ArmSmmu4KObserveStreams(const ArmSmmu4KIo *,const ArmSmmu4KStreamState *,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Read-only, the global fault policy, the complete enabled native4K context
+ * image and the exact owned routes, without the scan of every other slot for
+ * conflicting routes: a fixed read count however many slots the SMMU has. A
+ * route another agent added later is only seen by ArmSmmu4KObserveStreams,
+ * which a caller observing this way must still run at a bounded interval. */
+ArmSmmu4KStatus ArmSmmu4KObserveOwnedStreams(const ArmSmmu4KIo *,const ArmSmmu4KStreamState *,
+    const ArmSmmu4KContextConfig *,ArmSmmu4KStreamResult *);
+/* Require exact owned active routes before changing them to FAULT. SMRs stay
+ * valid, so those SIDs remain blocked. Does not drain transactions/TLBs, stop
+ * devices, disable context, release ownership or authorize freeing tables.
+ * Failure poisons state; external real reset/recovery is required. */
+ArmSmmu4KStatus ArmSmmu4KFaultStreams(const ArmSmmu4KIo *,ArmSmmu4KStreamState *,ArmSmmu4KStreamResult *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KTableMemory.c b/iokit/Kernel/arm/unixnu/ArmSmmu4KTableMemory.c
new file mode 100644
index 000000000..c21faa966
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KTableMemory.c
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: MIT */
+#include "ArmSmmu4KTableMemory.h"
+static int read_descriptor(void *cookie,uint64_t physical,uint64_t *value)
+{
+    const ArmSmmu4KTableMemory *memory=cookie;
+    if(!value || (physical&7))return 1;
+    for(unsigned i=0;i<memory->count;++i) {
+        const ArmSmmu4KTableMapping *p=&memory->pools[i];
+        if(physical>=p->physical && physical-p->physical<(uint64_t)p->pages*4096) {
+            *value=p->mapping[(physical-p->physical)/8];return 0;
+        }
+    }
+    return 1;
+}
+ArmSmmu4KStatus ArmSmmu4KBindTableMemory(const ArmSmmu4KTableMemory *memory,ArmSmmu4KTableIo *io)
+{
+    if(!io)return ArmSmmu4KArgument;*io=(ArmSmmu4KTableIo){0};
+    if(!memory || !memory->count || memory->count>2)return ArmSmmu4KArgument;
+    for(unsigned i=0;i<memory->count;++i) {
+        const ArmSmmu4KTableMapping *p=&memory->pools[i];uintptr_t cpu=(uintptr_t)p->mapping;
+        if(!cpu || (cpu&4095) || (p->physical&4095) || !p->pages || p->pages>SIZE_MAX/4096 ||
+            p->physical>=(UINT64_C(1)<<48) || p->pages*UINT64_C(4096)>(UINT64_C(1)<<48)-p->physical ||
+            p->pages*4096>UINTPTR_MAX-cpu)return ArmSmmu4KBadRange;
+        for(unsigned j=0;j<i;++j) {
+            const ArmSmmu4KTableMapping *q=&memory->pools[j];
+            if((p->physical<q->physical+q->pages*UINT64_C(4096) && q->physical<p->physical+p->pages*UINT64_C(4096)) ||
+                (cpu<(uintptr_t)q->mapping+q->pages*4096 && (uintptr_t)q->mapping<cpu+p->pages*4096))return ArmSmmu4KOverlap;
+        }
+    }
+    io->cookie=(void *)memory;io->read_descriptor=read_descriptor;return ArmSmmu4KSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/ArmSmmu4KTableMemory.h b/iokit/Kernel/arm/unixnu/ArmSmmu4KTableMemory.h
new file mode 100644
index 000000000..da4f92a5f
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/ArmSmmu4KTableMemory.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef ARM_SMMU_4K_TABLE_MEMORY_H
+#define ARM_SMMU_4K_TABLE_MEMORY_H
+#include "ArmSmmu4KAudit.h"
+#ifdef __cplusplus
+extern "C" {
+#endif
+typedef struct {
+    const volatile uint64_t *mapping;
+    uint64_t physical;
+    size_t pages;
+} ArmSmmu4KTableMapping;
+typedef struct {
+    unsigned count;
+    ArmSmmu4KTableMapping pools[2];
+} ArmSmmu4KTableMemory;
+/* Concrete aligned volatile 64-bit descriptor reads through already existing
+ * CPU mappings of one/two physically contiguous owned table pools. Validates
+ * CPU/physical bounds and aliasing; it cannot create or establish the claimed
+ * VA->PA relation, ownership, cache attributes or visibility. Platform must
+ * obtain and retain those mappings from its real allocator, clean tables for
+ * device visibility and order publication before activation/audit. Caller
+ * retains immutable memory metadata and tables under an exclusive lease.
+ * No fallback tables, copying/rebuilding, MMIO, cache clean, allocation or
+ * hardware probe. A matching software buffer alone is not hardware evidence.
+ * On bind failure io is cleared. Inputs/output/storage must be disjoint. */
+ArmSmmu4KStatus ArmSmmu4KBindTableMemory(const ArmSmmu4KTableMemory *,ArmSmmu4KTableIo *);
+#ifdef __cplusplus
+}
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoABI.h b/iokit/Kernel/arm/unixnu/NativeAdrenoABI.h
new file mode 100644
index 000000000..96d1349cc
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoABI.h
@@ -0,0 +1,184 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_ABI_H
+#define NATIVE_ADRENO_ABI_H
+#include <stdint.h>
+
+/* Versioned kernel/user-client wire ABI for the native Adreno driver. This is
+ * NOT the Metal, IOKit or Turnip ABI and it does not describe an ioctl. The
+ * IOKit service will copy exactly these fixed-size records across its external
+ * methods. All fields are little endian; both participants are ARM64. Every
+ * array is inside one fixed record so a caller cannot pass a length that
+ * disagrees with the storage. Unknown versions, methods and flags are refused
+ * rather than ignored. */
+enum {
+    NativeAdrenoAbiVersion = 1,
+    NativeAdrenoAbiMaxBuffers = 16,
+    NativeAdrenoAbiMaxBoBytesShift = 28, /* 256MiB per object */
+    NativeAdrenoMethodQuery = 1,
+    NativeAdrenoMethodBoAlloc = 2,
+    NativeAdrenoMethodBoMap = 3,
+    NativeAdrenoMethodBoFree = 4,
+    NativeAdrenoMethodSubmit = 5,
+    NativeAdrenoMethodWaitFence = 6,
+    NativeAdrenoMethodGetTimestamp = 7,
+    NativeAdrenoMethodGetStatus = 8,
+    NativeAdrenoMethodSetMetadata = 9,
+    NativeAdrenoMethodGetMetadata = 10,
+    NativeAdrenoMethodCreateQueue = 11,
+    NativeAdrenoMethodCloseQueue = 12,
+    NativeAdrenoMethodBoCpuMap = 13,
+    NativeAdrenoMethodBoCpuUnmap = 14,
+    NativeAdrenoMethodGetDeviceInfo = 15,
+    NativeAdrenoMethodBoImport = 16,
+    NativeAdrenoMethodSubmitResources = 17,
+    NativeAdrenoAbiMaxResources = 1024,
+    NativeAdrenoAbiMetadataBytes = 64,
+    NativeAdrenoAbiMaxQueues = 8
+};
+struct NativeAdrenoAbiParams {
+    uint32_t abi_version;
+    uint32_t input_bits;          /* GPU VA bits below 2^input_bits */
+    uint32_t output_bits;         /* physical address bits */
+    uint32_t flags;               /* NativeAdrenoParamsHostImport or zero */
+    uint64_t max_bo_bytes;
+};
+enum {
+    NativeAdrenoParamsCompositor4096 = 4, /* 4096 client BOs; residency set stays 1024 */
+    NativeAdrenoParamsSubmitResources = 2, /* complete per-submit BO read/write set */
+    NativeAdrenoParamsHostImport = 1  /* BoImport pins the caller's own pages (an IOSurface's) as a BO */
+};
+struct NativeAdrenoAbiBoAlloc {
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+    uint32_t align_log2;          /* 12..24 */
+    uint32_t contiguous;          /* 1 requires one raw physical span */
+};
+struct NativeAdrenoAbiBoAllocReply {
+    uint64_t handle;              /* opaque to userspace, nonzero */
+};
+/* Pins [address, address + bytes) of the CALLING task and makes it a BO (reply: NativeAdrenoAbiBoAllocReply). The pages stay wired
+ * until BoFree; they keep the caller's own CPU mapping and cache mode, so the caller cleans its caches before GPU use and invalidates
+ * them after GPU writes (the GPU maps them non-cacheable). An imported BO has no CPU-map token. */
+struct NativeAdrenoAbiBoImport {
+    uint64_t address;             /* 4KiB aligned */
+    uint64_t bytes;               /* 4KiB multiple, <= max_bo_bytes */
+};
+struct NativeAdrenoAbiBoMap {
+    uint64_t handle;
+    uint64_t iova;                /* 4KiB aligned, inside the mounted aperture */
+    uint32_t permissions;         /* bit0 read, bit1 write; read required */
+    uint32_t writeback;           /* 0 normal non-coherent, 1 WB/WA */
+    uint32_t shareability;        /* 2 outer, 3 inner */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiBoMapReply {
+    uint64_t iova;
+};
+struct NativeAdrenoAbiBoFree {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    uint64_t bytes;               /* 4-byte multiple, dword count = bytes/4 */
+};
+struct NativeAdrenoAbiSubmit {
+    uint32_t buffer_count;        /* 1..NativeAdrenoAbiMaxBuffers */
+    uint32_t reserved;            /* zero */
+    uint64_t queue;               /* open queue; 0 is created by open() */
+    uint64_t wait_fence;          /* zero or an earlier fence of this client */
+    uint64_t wait_timeout_ns;     /* used only when wait_fence is nonzero */
+    NativeAdrenoAbiSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
+};
+/* A complete residency/access set, including nested IBs and all GPU data.
+ * Extension of ABI1: clients must check NativeAdrenoParamsSubmitResources.
+ * Fixed size; IOKit transports this larger-than-inline request out of line. */
+struct NativeAdrenoAbiResource {
+    uint64_t handle;
+    uint32_t access;             /* bit0 GPU read, bit1 GPU write; nonzero */
+    uint32_t reserved;
+};
+struct NativeAdrenoAbiSubmitResources {
+    NativeAdrenoAbiSubmit commands;
+    uint32_t resource_count;
+    uint32_t reserved;
+    NativeAdrenoAbiResource resources[NativeAdrenoAbiMaxResources];
+};
+struct NativeAdrenoAbiMetadata {
+    uint64_t handle;              /* object identity */
+    uint32_t bytes;               /* set: length; get: requested capacity */
+    uint32_t reserved;            /* zero */
+    char text[NativeAdrenoAbiMetadataBytes]; /* raw bytes, not NUL terminated */
+};
+struct NativeAdrenoAbiSubmitReply {
+    uint64_t fence;               /* nonzero CP timestamp value */
+};
+struct NativeAdrenoAbiWaitFence {
+    uint64_t fence;
+    uint64_t timeout_ns;          /* 0 polls once */
+};
+struct NativeAdrenoAbiTimestamp {
+    uint64_t ticks;               /* GPU always-on counter value */
+};
+struct NativeAdrenoAbiBoCpuMap {
+    uint64_t handle;
+};
+struct NativeAdrenoAbiBoCpuMapReply {
+    uint32_t token;               /* clientMemoryForType selector */
+    uint32_t reserved;            /* zero */
+    uint64_t bytes;               /* bytes the mapping covers */
+};
+struct NativeAdrenoAbiBoCpuUnmap {
+    uint64_t handle;
+    uint32_t token;               /* exactly the token returned by map */
+    uint32_t reserved;            /* zero */
+};
+struct NativeAdrenoAbiQueue {
+    uint64_t queue;               /* zero for create, an open id for close */
+};
+struct NativeAdrenoAbiQueueReply {
+    uint64_t queue;               /* nonzero id of the created queue */
+};
+struct NativeAdrenoAbiStatus {
+    uint64_t faults;              /* monotonic; change means context lost */
+    uint64_t suspends;            /* monotonic suspend/reset count */
+};
+/* Fixed facts of the mounted GPU that the Vulkan driver needs and cannot derive: all come from the board code, which takes
+ * them from the pinned sources (a6xx catalog, UBWC config, the programmed UCHE ranges), never from a guess. */
+enum {
+    NativeAdrenoDeviceClientIova = 1,     /* flags: the client chooses BO addresses (BoMap iova) */
+    NativeAdrenoDeviceCachedCoherent = 2  /* flags: unused until IO-coherent BO memory exists */
+};
+struct NativeAdrenoAbiDeviceInfo {
+    uint32_t chip_id;             /* ADRENO_CHIPID, e.g. 0x43050a01 */
+    uint32_t gmem_bytes;
+    uint64_t gmem_base;           /* UCHE GMEM window start (GPU address) */
+    uint64_t uche_trap_base;
+    uint64_t va_start;            /* first GPU address the client may map */
+    uint64_t va_size;
+    uint32_t highest_bank_bit;
+    uint32_t ubwc_swizzle;        /* bit0 level 1, bit1 level 2, bit2 level 3 */
+    uint32_t macrotile_mode;      /* 0 four channel, 1 eight channel */
+    uint32_t ubwc_version;        /* encoder version, 4 for UBWC 4.0 */
+    uint32_t flags;
+    uint32_t reserved;            /* zero */
+};
+#if defined(__cplusplus)
+static_assert(sizeof(NativeAdrenoAbiSubmitResources) == 16808, "ABI scoped submit layout");
+static_assert(sizeof(NativeAdrenoAbiDeviceInfo) == 64, "ABI device info layout");
+static_assert(sizeof(NativeAdrenoAbiParams) == 24, "ABI params layout");
+static_assert(sizeof(NativeAdrenoAbiBoAlloc) == 16, "ABI alloc layout");
+static_assert(sizeof(NativeAdrenoAbiBoMap) == 32, "ABI map layout");
+static_assert(sizeof(NativeAdrenoAbiBoImport) == 16, "ABI import layout");
+static_assert(sizeof(NativeAdrenoAbiSubmitBuffer) == 24, "ABI buffer layout");
+static_assert(sizeof(NativeAdrenoAbiSubmit) == 416, "ABI submit layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMap) == 8, "ABI cpu map layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuMapReply) == 16, "ABI cpu map reply layout");
+static_assert(sizeof(NativeAdrenoAbiBoCpuUnmap) == 16, "ABI cpu unmap layout");
+static_assert(sizeof(NativeAdrenoAbiQueue) == 8, "ABI queue layout");
+static_assert(sizeof(NativeAdrenoAbiQueueReply) == 8, "ABI queue reply layout");
+static_assert(sizeof(NativeAdrenoAbiMetadata) == 80, "ABI metadata layout");
+static_assert(sizeof(NativeAdrenoAbiWaitFence) == 16, "ABI wait layout");
+static_assert(sizeof(NativeAdrenoAbiTimestamp) == 8, "ABI timestamp layout");
+static_assert(sizeof(NativeAdrenoAbiStatus) == 16, "ABI status layout");
+#endif
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoCpu.cpp b/iokit/Kernel/arm/unixnu/NativeAdrenoCpu.cpp
new file mode 100644
index 000000000..1cd36f557
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoCpu.cpp
@@ -0,0 +1,149 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoMemory.h"
+#include <kern/cpu_data.h>
+#include <vm/vm_map.h>
+#include <mach/vm_param.h>
+#include <kern/clock.h>
+#include <vm/memory_types.h>
+extern "C" vm_offset_t phystokv(uint64_t pa);
+extern "C" uint64_t gPhysBase,gPhysSize;   /* the physical range phystokv covers (the kernel's own DRAM); anything else panics in phystokv */
+extern "C" void pmap_set_cache_attributes(ppnum_t pn,unsigned int cacheattr);
+extern "C" unsigned int pmap_cache_attributes(ppnum_t pn);
+/* Time and bytes of every CPU cache maintenance pass (the board page shows them per submission), and the pages user BOs made
+ * write-combined: [0] ticks, [1] bytes, [2] longest pass in ticks, [3] passes, [4] write-combined pages now. */
+extern "C" {volatile uint64_t native_adreno_cache_stats[5];}
+/* Time spent checking and re-asserting write-combined page attributes (NativeAdrenoReassertWriteCombined), for the board page. */
+extern "C" {volatile uint64_t native_adreno_reassert_ticks;}
+static void noteMaintenance(uint64_t began,size_t bytes)
+{
+    const uint64_t ticks=mach_absolute_time()-began;
+    __atomic_fetch_add(&native_adreno_cache_stats[0],ticks,__ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_adreno_cache_stats[1],bytes,__ATOMIC_RELAXED);
+    __atomic_fetch_add(&native_adreno_cache_stats[3],1,__ATOMIC_RELAXED);
+    uint64_t longest=__atomic_load_n(&native_adreno_cache_stats[2],__ATOMIC_RELAXED);
+    while(ticks>longest && !__atomic_compare_exchange_n(&native_adreno_cache_stats[2],&longest,ticks,true,__ATOMIC_RELAXED,__ATOMIC_RELAXED)) {}
+}
+
+IOReturn NativeAdrenoQueryCpuGranule(NativeAdrenoCpuState *out)
+{
+    if(!out)return kIOReturnBadArgument;
+    *out={};
+    disable_preemption();
+    __asm__ volatile("mrs %0, tcr_el1" : "=r"(out->tcr));
+    __asm__ volatile("mrs %0, ttbr0_el1" : "=r"(out->ttbr0));
+    __asm__ volatile("mrs %0, ttbr1_el1" : "=r"(out->ttbr1));
+    __asm__ volatile("mrs %0, sctlr_el1" : "=r"(out->sctlr));
+    out->kernel_page_bytes=page_size;
+    out->kernel_map_page_bytes=vm_map_page_size(kernel_map);
+    enable_preemption();
+    const uint64_t host=PAGE_SIZE;
+    const bool granule=(host==4096 && ((out->tcr>>14)&3)==0 && ((out->tcr>>30)&3)==2) ||
+        (host==16384 && ((out->tcr>>14)&3)==2 && ((out->tcr>>30)&3)==1);
+    const bool native=granule && out->kernel_page_bytes==host && out->kernel_map_page_bytes==host &&
+        (out->sctlr&1) && (out->ttbr1&(UINT64_C(0x0000ffffffffffff)&~(host-1)));
+    return native?kIOReturnSuccess:kIOReturnUnsupported;
+}
+static IOReturn maintainOwnedPages(void *mapping,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    /* Whole owned pages avoid IVAC corruption of a neighbour's dirty line.
+     * No Apple coherent-I/O shortcut is used for these noncoherent DMA paths.
+     * Pin this CPU while reading its CTR and issuing all cache operations. */
+    if(!mapping || !bytes || (((uintptr_t)mapping|bytes)&4095) ||
+        bytes>UINTPTR_MAX-(uintptr_t)mapping || op>NativeAdrenoInvalidate || op<NativeAdrenoClean)
+        return kIOReturnBadArgument;
+    disable_preemption();
+    uint64_t ctr;__asm__ volatile("mrs %0, ctr_el0":"=r"(ctr));
+    size_t line=(size_t)4<<((ctr>>16)&15);
+    if(line>4096) {enable_preemption();return kIOReturnUnsupported;}
+    uintptr_t address=(uintptr_t)mapping,end=address+bytes;
+    __asm__ volatile("dsb sy":::"memory");
+    for(;address<end;address+=line) {
+        if(op==NativeAdrenoClean)__asm__ volatile("dc cvac, %0"::"r"(address):"memory");
+        else if(op==NativeAdrenoCleanInvalidate)__asm__ volatile("dc civac, %0"::"r"(address):"memory");
+        else __asm__ volatile("dc ivac, %0"::"r"(address):"memory");
+    }
+    __asm__ volatile("dsb sy":::"memory");
+    enable_preemption();return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMaintainOwnedPages(void *mapping,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    const uint64_t began=mach_absolute_time();
+    const IOReturn status=maintainOwnedPages(mapping,bytes,op);
+    if(!status)noteMaintenance(began,bytes);
+    return status;
+}
+IOReturn NativeAdrenoMaintainPhysicalPages(uint64_t physical,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    if(!physical || !bytes || ((physical|bytes)&4095) || physical>UINT64_MAX-bytes || op>NativeAdrenoInvalidate || op<NativeAdrenoClean)
+        return kIOReturnBadArgument;
+    const uint64_t began=mach_absolute_time();
+    /* One barrier pair per run of up to 64 pages instead of per page (an imported 3048x2032 surface is 5952 pages): preemption stays off
+     * for a bounded run, and the closing DSB on the issuing core completes every operation of that run. */
+    for(size_t offset=0;offset<bytes;) {
+        disable_preemption();
+        uint64_t ctr;__asm__ volatile("mrs %0, ctr_el0":"=r"(ctr));
+        const size_t line=(size_t)4<<((ctr>>16)&15);
+        if(line>4096) {enable_preemption();return kIOReturnUnsupported;}
+        __asm__ volatile("dsb sy":::"memory");
+        for(unsigned run=0;run<64 && offset<bytes;++run,offset+=4096) {
+            /* Reject physical ranges outside the kernel DRAM aperture before phystokv.
+             * An absent alias does not establish that an imported mapping is uncached. */
+            const uint64_t page=physical+offset;
+            if(page<gPhysBase || page-gPhysBase>=gPhysSize || 4096>gPhysSize-(page-gPhysBase)) {
+                __asm__ volatile("dsb sy":::"memory");enable_preemption();return kIOReturnUnsupported;
+            }
+            const vm_offset_t alias=phystokv(page);
+            if(!alias) {__asm__ volatile("dsb sy":::"memory");enable_preemption();return kIOReturnUnsupported;}
+            for(uintptr_t address=alias,end=alias+4096;address<end;address+=line) {
+                if(op==NativeAdrenoClean)__asm__ volatile("dc cvac, %0"::"r"(address):"memory");
+                else if(op==NativeAdrenoCleanInvalidate)__asm__ volatile("dc civac, %0"::"r"(address):"memory");
+                else __asm__ volatile("dc ivac, %0"::"r"(address):"memory");
+            }
+        }
+        __asm__ volatile("dsb sy":::"memory");
+        enable_preemption();
+    }
+    noteMaintenance(began,bytes);
+    return kIOReturnSuccess;
+}
+/* A user BO's pages become Normal non-cacheable (write-combined) for every CPU mapping the pmap tracks: the kernel's own mapping and each
+ * client view. The views did not get the cache mode their mapping asked for (int-070: Turnip's write-combine view left IB words in a CPU
+ * cache line), but they do take the page's own attribute. That is the Linux msm model for its WC BOs: CPU writes reach DRAM, the GPU's
+ * non-cacheable reads see them and CPU reads see GPU writes without per-submission maintenance. The physical aperture keeps its cacheable
+ * block mapping on this kernel (no __ARM_PTE_PHYSMAP__); nothing writes through it, and the caller cleans and invalidates the pages first.
+ * Before the pages go back to the VM they get the default attribute again. */
+IOReturn NativeAdrenoSetPagesCacheMode(const NativeAdrenoPhysicalSpan *spans,size_t count,bool write_combined)
+{
+    if(!spans || !count)return kIOReturnBadArgument;
+    uint64_t pages=0;
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans[i];
+        if(!span.bytes || ((span.physical|span.bytes)&(PAGE_SIZE-1)) || span.physical>UINT64_MAX-span.bytes ||
+            span.physical<gPhysBase || span.physical+span.bytes-gPhysBase>gPhysSize)return kIOReturnBadArgument;
+        pages+=span.bytes/PAGE_SIZE;
+    }
+    for(size_t i=0;i<count;++i)
+        for(uint64_t offset=0;offset<spans[i].bytes;offset+=PAGE_SIZE)
+            pmap_set_cache_attributes((ppnum_t)((spans[i].physical+offset)>>PAGE_SHIFT),write_combined?VM_WIMG_WCOMB:VM_WIMG_USE_DEFAULT);
+    if(write_combined)__atomic_fetch_add(&native_adreno_cache_stats[4],pages,__ATOMIC_RELAXED);
+    else __atomic_fetch_sub(&native_adreno_cache_stats[4],pages,__ATOMIC_RELAXED);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoReassertWriteCombined(const NativeAdrenoPhysicalSpan *spans,size_t count,uint32_t *reset)
+{
+    if(!spans || !count || !reset)return kIOReturnBadArgument;
+    const uint64_t began=mach_absolute_time();
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans[i];
+        if(!span.bytes || ((span.physical|span.bytes)&(PAGE_SIZE-1)) || span.physical>UINT64_MAX-span.bytes ||
+            span.physical<gPhysBase || span.physical+span.bytes-gPhysBase>gPhysSize)return kIOReturnBadArgument;
+        for(uint64_t offset=0;offset<span.bytes;offset+=PAGE_SIZE) {
+            const ppnum_t pn=(ppnum_t)((span.physical+offset)>>PAGE_SHIFT);
+            /* From the default attribute the pmap also cleans and invalidates the page (pmap_sync_wimg), so lines a cacheable view
+             * dirtied reach DRAM before the GPU reads it. */
+            if((pmap_cache_attributes(pn)&VM_WIMG_MASK)!=VM_WIMG_WCOMB) {pmap_set_cache_attributes(pn,VM_WIMG_WCOMB);++*reset;}
+        }
+    }
+    __atomic_fetch_add(&native_adreno_reassert_ticks,mach_absolute_time()-began,__ATOMIC_RELAXED);
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoMemory.cpp b/iokit/Kernel/arm/unixnu/NativeAdrenoMemory.cpp
new file mode 100644
index 000000000..90a14716b
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoMemory.cpp
@@ -0,0 +1,390 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoMemory.h"
+/* Where a call that never returns is stuck: the free/unmap/release path stores a stage number here, the board page shows it. */
+extern "C" {volatile uint32_t native_adreno_trace_stage;}
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSubMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <kern/task.h>
+#include <mach/vm_param.h>
+
+static bool roundHost(size_t bytes,size_t *rounded)
+{
+    const size_t mask=PAGE_SIZE-1;
+    if(!bytes || bytes>SIZE_MAX-mask)return false;
+    *rounded=(bytes+mask)&~mask;return true;
+}
+static void zeroOwned(void *base,size_t bytes,bool noncacheable)
+{
+    /* bzero may use DC ZVA; it is not valid for every NC/device alias. */
+    if(noncacheable) {
+        volatile uint32_t *words=static_cast<volatile uint32_t *>(base);
+        for(size_t i=0;i<bytes/4;++i)words[i]=0;
+        __asm__ volatile("dsb sy":::"memory");
+    } else bzero(base,bytes);
+}
+static bool outputWidth(unsigned bits)
+{return bits==32 || bits==36 || bits==40 || bits==42 || bits==44 || bits==48;}
+/* Where the last import stopped (10..19, 19 = done), and for a refused page the physical address and offset: the board log shows them. */
+enum : IOReturn {kNativeAdrenoProtectionFailure=2};   /* KERN_PROTECTION_FAILURE, as prepare() reports a range that cannot be wired for writing */
+extern "C" {volatile uint32_t native_adreno_pool_mib=0,native_adreno_pool_status=0;volatile uint32_t native_adreno_import_stage;volatile uint64_t native_adreno_import_fail_pa,native_adreno_import_fail_offset;}
+/* The pool (see reservePool): a free list of page extents over one contiguous block; best fit, neighbours merged on release. */
+extern "C" {volatile uint32_t native_adreno_pool_stats[8];}
+/* The pool's write-combine (writeCombinePool): bit 31 once tried, the low bits its status. */
+extern "C" {volatile uint32_t native_adreno_pool_wc;}   /* [0] pool MiB, [1] BOs from the pool, [2] fell back, [3] MiB in use, [4] peak MiB, [5] scattered BOs, [6] their spans, [7] import spans */
+namespace {
+struct PoolExtent {size_t offset,bytes;};
+struct Pool {
+    IOBufferMemoryDescriptor *descriptor=nullptr;
+    unsigned char *virt=nullptr;uint64_t physical=0;size_t bytes=0,used=0,peak=0;
+    PoolExtent free[512];unsigned count=0;
+    bool write_combined=false;
+};
+/* 0148: several blocks. On sweet XNU hands out at most ~48 MiB physically contiguous even early in bsd init (0137), so the pool is
+ * up to PoolBlocks of them; a BO never straddles two blocks and remembers its own (pool_block_). */
+enum : unsigned {PoolBlocks=16};
+Pool pools[PoolBlocks];unsigned pool_blocks=0;
+void poolStats() {
+    size_t used=0;
+    for(unsigned b=0;b<pool_blocks;++b)used+=pools[b].used;
+    native_adreno_pool_stats[3]=(uint32_t)(used>>20);
+    if((uint32_t)(used>>20)>native_adreno_pool_stats[4])native_adreno_pool_stats[4]=(uint32_t)(used>>20);
+}
+bool poolTake(Pool &pool,size_t bytes,size_t *offset) {
+    int best=-1;
+    for(unsigned i=0;i<pool.count;++i)if(pool.free[i].bytes>=bytes && (best<0 || pool.free[i].bytes<pool.free[best].bytes))best=(int)i;
+    if(best<0)return false;
+    *offset=pool.free[best].offset;
+    pool.free[best].offset+=bytes;pool.free[best].bytes-=bytes;
+    if(!pool.free[best].bytes) {for(unsigned i=(unsigned)best;i+1<pool.count;++i)pool.free[i]=pool.free[i+1];--pool.count;}
+    pool.used+=bytes;if(pool.used>pool.peak)pool.peak=pool.used;
+    poolStats();
+    return true;
+}
+void poolGive(Pool &pool,size_t offset,size_t bytes) {
+    unsigned at=0;while(at<pool.count && pool.free[at].offset<offset)++at;
+    if(pool.count>=512) {pool.used-=bytes;return;}   /* cannot happen with bounded fragmentation; the extent is lost, not reused */
+    for(unsigned i=pool.count;i>at;--i)pool.free[i]=pool.free[i-1];
+    pool.free[at]={offset,bytes};++pool.count;
+    if(at+1<pool.count && pool.free[at].offset+pool.free[at].bytes==pool.free[at+1].offset) {
+        pool.free[at].bytes+=pool.free[at+1].bytes;
+        for(unsigned i=at+1;i+1<pool.count;++i)pool.free[i]=pool.free[i+1];
+        --pool.count;
+    }
+    if(at && pool.free[at-1].offset+pool.free[at-1].bytes==pool.free[at].offset) {
+        pool.free[at-1].bytes+=pool.free[at].bytes;
+        for(unsigned i=at;i+1<pool.count;++i)pool.free[i]=pool.free[i+1];
+        --pool.count;
+    }
+    pool.used-=bytes;poolStats();
+}
+}
+size_t NativeAdrenoMemory::poolBytes()
+{
+    size_t bytes=0;
+    for(unsigned b=0;b<pool_blocks;++b)bytes+=pools[b].bytes;
+    return bytes;
+}
+IOMemoryDescriptor *NativeAdrenoMemory::userDescriptor() const
+{return descriptor_?static_cast<IOMemoryDescriptor *>(descriptor_):pool_view_;}
+/* int-152: a user BO's pages changed attribute one pmap_set_cache_attributes call at a time (each walks the page's mappings, flushes the
+ * TLB and cleans the page), on allocation and again on release, under the connection lock: 3 ms a BO on average and 90-130 ms for a
+ * surface-sized one, while every other GPU call of every client waited. The pool is the BOs' own block and nothing else maps it, so
+ * its pages take the attribute once here and keep it while the pool lives. */
+IOReturn NativeAdrenoMemory::writeCombinePool()
+{
+    if(!pool_blocks)return kIOReturnNotReady;
+    for(unsigned b=0;b<pool_blocks;++b) {
+        Pool &pool=pools[b];
+        if(!pool.descriptor || !pool.virt || !pool.bytes)return kIOReturnNotReady;
+        if(pool.write_combined)continue;
+        IOReturn status=NativeAdrenoMaintainOwnedPages(pool.virt,pool.bytes,NativeAdrenoCleanInvalidate);
+        if(status)return status;
+        const NativeAdrenoPhysicalSpan span={0,pool.physical,pool.bytes};
+        status=NativeAdrenoSetPagesCacheMode(&span,1,true);
+        if(status)return status;
+        pool.write_combined=true;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::reservePool(unsigned bits,size_t bytes)
+{
+    if(pool_blocks>=PoolBlocks)return kIOReturnNoResources;
+    if(!bytes || (bytes&(PAGE_SIZE-1)) || !outputWidth(bits))return kIOReturnBadArgument;
+    NativeAdrenoCpuState cpu{};
+    IOReturn status=NativeAdrenoQueryCpuGranule(&cpu);if(status!=kIOReturnSuccess)return status;
+    const uint64_t limit=UINT64_C(1)<<bits;
+    IOBufferMemoryDescriptor *descriptor=IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+        static_cast<IOOptionBits>(kIODirectionInOut)|static_cast<IOOptionBits>(kIOMemoryMapperNone)|kIOMemoryPhysicallyContiguous,
+        bytes,(limit-1)&~uint64_t(PAGE_SIZE-1));
+    if(!descriptor)return kIOReturnNoMemory;
+    status=descriptor->prepare();
+    if(status!=kIOReturnSuccess) {descriptor->release();return status;}
+    IOByteCount length=0,tail=0;
+    const addr64_t first=descriptor->getPhysicalSegment(0,&length,kIOMemoryMapperNone);
+    const addr64_t last=descriptor->getPhysicalSegment(bytes-4096,&tail,kIOMemoryMapperNone);
+    unsigned char *virt=static_cast<unsigned char *>(descriptor->getBytesNoCopy());
+    if(!first || (first&(PAGE_SIZE-1)) || length<bytes || tail<4096 || !virt || ((uintptr_t)virt&(PAGE_SIZE-1)) || last!=first+bytes-4096 || first>=limit || bytes>limit-first ||
+        descriptor->getLength()!=bytes) {
+        (void)descriptor->complete();descriptor->release();return kIOReturnUnsupported;
+    }
+    Pool &pool=pools[pool_blocks];
+    pool.descriptor=descriptor;pool.virt=virt;pool.physical=first;pool.bytes=bytes;pool.used=pool.peak=0;
+    pool.free[0]={0,bytes};pool.count=1;
+    ++pool_blocks;
+    native_adreno_pool_stats[0]=(uint32_t)(poolBytes()>>20);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::allocate(size_t bytes,unsigned bits,bool contiguous,size_t budget,bool pooled)
+{
+    if(backed() || spans_ || owned_spans_ || quarantined_)return kIOReturnBusy;
+    if(!bytes || (bytes&4095) || !outputWidth(bits) || !budget || budget>256u*1024u*1024u)
+        return kIOReturnBadArgument;
+    size_t capacity=0;
+    if(!roundHost(bytes,&capacity) || capacity>budget)return kIOReturnNoResources;
+    NativeAdrenoCpuState cpu{};
+    IOReturn status=NativeAdrenoQueryCpuGranule(&cpu);if(status!=kIOReturnSuccess)return status;
+    uint64_t limit=UINT64_C(1)<<bits;
+    for(unsigned b=0;pooled && b<pool_blocks;++b) {
+        Pool &pool=pools[b];
+        size_t offset=0;
+        if(capacity<=pool.bytes && poolTake(pool,capacity,&offset)) {
+            const uint64_t physical=pool.physical+offset;
+            if(physical>=limit || capacity>limit-physical) {poolGive(pool,offset,capacity);}
+            else {
+                spans_=IONew(NativeAdrenoPhysicalSpan,1);
+                if(!spans_) {poolGive(pool,offset,capacity);return kIOReturnNoMemory;}
+                owned_spans_=IONew(NativeAdrenoPhysicalSpan,1);
+                if(!owned_spans_) {IODelete(spans_,NativeAdrenoPhysicalSpan,1);spans_=nullptr;poolGive(pool,offset,capacity);return kIOReturnNoMemory;}
+                owned_capacity_=owned_count_=1;owned_spans_[0]={0,physical,capacity};
+                span_capacity_=1;span_count_=1;spans_[0]={0,physical,bytes};
+                mapping_=pool.virt+offset;bytes_=bytes;allocated_bytes_=capacity;pooled_=true;pool_offset_=offset;pool_block_=b;prepared_=true;write_combined_=pool.write_combined;
+                /* Turnip CPU-maps every BO through clientMemoryForType; a pooled one has no descriptor of its own. */
+                pool_view_=IOSubMemoryDescriptor::withSubRange(pool.descriptor,offset,capacity,kIODirectionInOut);
+                if(!pool_view_) {(void)release();return kIOReturnNoMemory;}
+                zeroOwned(mapping_,capacity,pool.write_combined);
+                /* Through a write-combined pool's own mapping the zeros go to DRAM; the barrier completes them. */
+                if(pool.write_combined)__asm__ volatile("dsb sy":::"memory");
+                else status=NativeAdrenoMaintainOwnedPages(mapping_,capacity,NativeAdrenoClean);
+                if(status!=kIOReturnSuccess) {(void)release();return status;}
+                native_adreno_pool_stats[1]=native_adreno_pool_stats[1]+1;
+                return kIOReturnSuccess;
+            }
+        }
+    }
+    if(pooled && pool_blocks)native_adreno_pool_stats[2]=native_adreno_pool_stats[2]+1;
+    IOOptionBits options=static_cast<IOOptionBits>(kIODirectionInOut)|static_cast<IOOptionBits>(kIOMemoryMapperNone);
+    if(contiguous)options|=kIOMemoryPhysicallyContiguous;
+    descriptor_=IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,options,capacity,(limit-1)&~uint64_t(PAGE_SIZE-1));
+    if(!descriptor_)return kIOReturnNoMemory;
+    status=descriptor_->prepare();
+    if(status!=kIOReturnSuccess) {descriptor_->release();descriptor_=nullptr;return status;}
+    prepared_=true;bytes_=bytes;allocated_bytes_=capacity;mapping_=descriptor_->getBytesNoCopy();
+    status=kIOReturnUnsupported;
+    if(!mapping_ || ((uintptr_t)mapping_&(PAGE_SIZE-1)) || capacity>UINTPTR_MAX-(uintptr_t)mapping_ ||
+        descriptor_->getLength()!=capacity)goto failed;
+    owned_capacity_=capacity/PAGE_SIZE;
+    owned_spans_=IONew(NativeAdrenoPhysicalSpan,owned_capacity_);
+    if(!owned_spans_) {status=kIOReturnNoMemory;goto failed;}
+    for(size_t offset=0;offset<capacity;offset+=PAGE_SIZE) {
+        IOByteCount length=0;
+        const addr64_t physical=descriptor_->getPhysicalSegment(offset,&length,kIOMemoryMapperNone);
+        if(!physical || (physical&(PAGE_SIZE-1)) || length<PAGE_SIZE || physical>=limit || PAGE_SIZE>limit-physical ||
+            (contiguous && offset && physical!=owned_spans_[0].physical+offset)) {status=kIOReturnUnsupported;goto failed;}
+        if(owned_count_ && physical==owned_spans_[owned_count_-1].physical+owned_spans_[owned_count_-1].bytes)
+            owned_spans_[owned_count_-1].bytes+=PAGE_SIZE;
+        else owned_spans_[owned_count_++]={offset,physical,PAGE_SIZE};
+    }
+    span_capacity_=bytes/4096;
+    spans_=IONew(NativeAdrenoPhysicalSpan,span_capacity_);
+    if(!spans_) {status=kIOReturnNoMemory;goto failed;}
+    for(size_t offset=0;offset<bytes;offset+=4096) {
+        IOByteCount length=0;
+        addr64_t physical=descriptor_->getPhysicalSegment(offset,&length,kIOMemoryMapperNone);
+        if(!physical || (physical&4095) || length<4096 || physical>=limit || 4096>limit-physical)
+            {status=kIOReturnUnsupported;goto failed;}
+        if(contiguous && offset && physical!=spans_[0].physical+offset)
+            {status=kIOReturnUnsupported;goto failed;}
+        if(span_count_ && physical==spans_[span_count_-1].physical+spans_[span_count_-1].bytes)
+            spans_[span_count_-1].bytes+=4096;
+        else spans_[span_count_++]={offset,physical,4096};
+    }
+    zeroOwned(mapping_,capacity,false);
+    status=NativeAdrenoMaintainOwnedPages(mapping_,capacity,NativeAdrenoClean);
+    if(status!=kIOReturnSuccess)goto failed;
+    native_adreno_pool_stats[5]=native_adreno_pool_stats[5]+1;native_adreno_pool_stats[6]=native_adreno_pool_stats[6]+(uint32_t)span_count_;
+    return kIOReturnSuccess;
+failed:
+    /* release() deliberately retains descriptor/metadata if complete fails.
+     * Preserve the allocation's original failure instead of reporting cleanup
+     * as success. No object has been exposed to a GPU or userspace yet. */
+    (void)release();return status;
+}
+IOReturn NativeAdrenoMemory::importTask(void *task,uint64_t address,size_t bytes,unsigned bits,size_t budget)
+{
+    native_adreno_import_stage=10;
+    if(descriptor_ || imported_ || spans_ || quarantined_)return kIOReturnBusy;
+    native_adreno_import_stage=11;
+    if(!task || !address || (address&4095) || !bytes || (bytes&4095) || address>UINT64_MAX-bytes || !outputWidth(bits) ||
+        !budget || budget>256u*1024u*1024u)return kIOReturnBadArgument;
+    native_adreno_import_stage=12;
+    if(bytes>budget)return kIOReturnNoResources;
+    NativeAdrenoCpuState cpu{};
+    native_adreno_import_stage=13;
+    IOReturn status=NativeAdrenoQueryCpuGranule(&cpu);if(status!=kIOReturnSuccess)return status;
+    const uint64_t limit=UINT64_C(1)<<bits;
+    imported_=IOMemoryDescriptor::withAddressRange(address,bytes,
+        static_cast<IOOptionBits>(kIODirectionInOut)|static_cast<IOOptionBits>(kIOMemoryMapperNone),static_cast<task_t>(task));
+    native_adreno_import_stage=14;
+    if(!imported_)return kIOReturnNoMemory;
+    native_adreno_import_stage=15;
+    status=imported_->prepare();
+    if(status==kNativeAdrenoProtectionFailure) {
+        /* Read-only memory of the owner (a mapped file, constant data): cannot be pinned for writing. Pin it for reading only; the GPU then maps it
+         * read-only. Metal's no-copy buffers over such memory are only ever read by shaders. */
+        imported_->release();imported_=nullptr;
+        imported_=IOMemoryDescriptor::withAddressRange(address,bytes,
+            static_cast<IOOptionBits>(kIODirectionOut)|static_cast<IOOptionBits>(kIOMemoryMapperNone),static_cast<task_t>(task));
+        if(!imported_)return kIOReturnNoMemory;
+        status=imported_->prepare();
+        if(status==kIOReturnSuccess)read_only_=true;
+    }
+    if(status!=kIOReturnSuccess) {imported_->release();imported_=nullptr;return status;}
+    prepared_=true;bytes_=bytes;
+    status=kIOReturnUnsupported;
+    native_adreno_import_stage=16;
+    if(imported_->getLength()!=bytes)goto failed;
+    native_adreno_import_stage=17;
+    span_capacity_=bytes/4096;
+    spans_=IONew(NativeAdrenoPhysicalSpan,span_capacity_);
+    if(!spans_) {status=kIOReturnNoMemory;goto failed;}
+    for(size_t offset=0;offset<bytes;offset+=4096) {
+        IOByteCount length=0;
+        addr64_t physical=imported_->getPhysicalSegment(offset,&length,kIOMemoryMapperNone);
+        if(!physical || (physical&4095) || length<4096 || physical>=limit || 4096>limit-physical)
+            {native_adreno_import_stage=18;native_adreno_import_fail_pa=physical;native_adreno_import_fail_offset=offset;
+             status=kIOReturnUnsupported;goto failed;}
+        if(span_count_ && physical==spans_[span_count_-1].physical+spans_[span_count_-1].bytes)
+            spans_[span_count_-1].bytes+=4096;
+        else spans_[span_count_++]={offset,physical,4096};
+    }
+    native_adreno_import_stage=19;
+    native_adreno_pool_stats[7]=native_adreno_pool_stats[7]+(uint32_t)span_count_;
+    return kIOReturnSuccess;
+failed:
+    (void)release();return status;
+}
+IOReturn NativeAdrenoMemory::borrowBootStorage(void *mapping,uint64_t physical,size_t bytes,unsigned bits)
+{
+    if(backed() || spans_ || owned_spans_ || quarantined_)return kIOReturnBusy;
+    if(!mapping || !physical || !bytes || (bytes&4095) || (physical&4095) ||
+        ((uintptr_t)mapping&4095) || !outputWidth(bits) || bytes>UINTPTR_MAX-(uintptr_t)mapping ||
+        physical>=(UINT64_C(1)<<bits) || bytes>(UINT64_C(1)<<bits)-physical)return kIOReturnBadArgument;
+    spans_=IONew(NativeAdrenoPhysicalSpan,1);
+    if(!spans_)return kIOReturnNoMemory;
+    spans_[0]={0,physical,bytes};span_count_=span_capacity_=1;
+    mapping_=mapping;bytes_=allocated_bytes_=bytes;borrowed_nc_=prepared_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::makeWriteCombined()
+{
+    if(write_combined_ && prepared_ && !quarantined_ && !device_references_)return kIOReturnSuccess;
+    if(!(descriptor_ || pooled_) || imported_ || !prepared_ || quarantined_ || device_references_ || write_combined_ || !mapping_ || !span_count_)
+        return kIOReturnNotReady;
+    if(pooled_ && pools[pool_block_].write_combined) {write_combined_=true;return kIOReturnSuccess;}
+    IOReturn status=NativeAdrenoMaintainOwnedPages(mapping_,allocated_bytes_,NativeAdrenoCleanInvalidate);
+    if(status)return status;
+    status=NativeAdrenoSetPagesCacheMode(owned_spans_,owned_count_,true);
+    if(status)return status;
+    write_combined_=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::release()
+{
+    native_adreno_trace_stage=30;
+    if(device_references_ || quarantined_)return kIOReturnBusy;
+    if(pool_view_) {
+        /* A live user mapping retains the view: its range must not go back to the pool for reuse. */
+        if(pool_view_->getRetainCount()>1) {quarantined_=true;return kIOReturnBusy;}
+        pool_view_->release();pool_view_=nullptr;
+    }
+    if(write_combined_ && pooled_ && pools[pool_block_].write_combined)write_combined_=false;   /* the pool's pages keep the attribute */
+    if(write_combined_) {
+        /* The pages go back to the VM cacheable, as they came. */
+        const IOReturn status=NativeAdrenoSetPagesCacheMode(owned_spans_,owned_count_,false);
+        if(status) {quarantined_=true;return status;}
+        write_combined_=false;
+    }
+    if(imported_) {
+        if(prepared_) {
+            IOReturn status=imported_->complete();
+            if(status!=kIOReturnSuccess) {quarantined_=true;return status;}
+            prepared_=false;
+        }
+        imported_->release();imported_=nullptr;
+    }
+    if(descriptor_) {
+        if(prepared_) {
+            native_adreno_trace_stage=31;
+            IOReturn status=descriptor_->complete();
+            native_adreno_trace_stage=32;
+            if(status!=kIOReturnSuccess) {quarantined_=true;return status;}
+            prepared_=false;
+        }
+        native_adreno_trace_stage=33;
+        descriptor_->release();descriptor_=nullptr;
+        native_adreno_trace_stage=34;
+    }
+    if(pooled_) {poolGive(pools[pool_block_],pool_offset_,allocated_bytes_);pooled_=false;prepared_=false;pool_offset_=0;pool_block_=0;}
+    if(spans_)IODelete(spans_,NativeAdrenoPhysicalSpan,span_capacity_);
+    if(owned_spans_)IODelete(owned_spans_,NativeAdrenoPhysicalSpan,owned_capacity_);
+    owned_spans_=nullptr;owned_count_=owned_capacity_=0;
+    prepared_=false;borrowed_nc_=false;mapping_=nullptr;spans_=nullptr;bytes_=allocated_bytes_=span_count_=span_capacity_=0;read_only_=false;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::holdForDevice()
+{
+    if(!backed() || !prepared_ || !span_count_ || quarantined_)return kIOReturnNotReady;
+    if(device_references_==UINT32_MAX)return kIOReturnNoResources;
+    ++device_references_;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::retireAfterQuiescence()
+{
+    if(!device_references_)return kIOReturnBadArgument;
+    if(quarantined_)return kIOReturnNotReady;
+    --device_references_;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoMemory::publishForDevice(size_t offset,size_t bytes,bool writes,bool include_write_combined)
+{
+    if(!backed() || !prepared_ || quarantined_)return kIOReturnNotReady;
+    if(!bytes || ((offset|bytes)&4095) || offset>bytes_ || bytes>bytes_-offset)return kIOReturnBadArgument;
+    if(borrowed_nc_) {__asm__ volatile("dsb sy":::"memory");return kIOReturnSuccess;}
+    if(imported_)return maintainImported(offset,bytes,writes?NativeAdrenoCleanInvalidate:NativeAdrenoClean);
+    if(write_combined_)   /* no CPU mapping should cache these pages; if one does, reach its lines through the physical pages */
+        return include_write_combined?maintainImported(offset,bytes,writes?NativeAdrenoCleanInvalidate:NativeAdrenoClean):kIOReturnSuccess;
+    return NativeAdrenoMaintainOwnedPages(static_cast<unsigned char *>(mapping_)+offset,bytes,
+        writes?NativeAdrenoCleanInvalidate:NativeAdrenoClean);
+}
+IOReturn NativeAdrenoMemory::acquireDeviceWrites(size_t offset,size_t bytes)
+{
+    if(!backed() || !prepared_ || quarantined_)return kIOReturnNotReady;
+    if(!bytes || ((offset|bytes)&4095) || offset>bytes_ || bytes>bytes_-offset)return kIOReturnBadArgument;
+    /* Imported pages may hold the owner's unrelated dirty lines next to the GPU's writes: clean as well as invalidate. */
+    if(borrowed_nc_) {__asm__ volatile("dsb sy":::"memory");return kIOReturnSuccess;}
+    if(imported_)return maintainImported(offset,bytes,NativeAdrenoCleanInvalidate);
+    if(write_combined_)return kIOReturnSuccess;
+    return NativeAdrenoMaintainOwnedPages(static_cast<unsigned char *>(mapping_)+offset,bytes,NativeAdrenoInvalidate);
+}
+/* Imported pages have no kernel mapping here (and write-combined ones only a non-cacheable one); maintain each span's part of
+ * [offset, offset+bytes) by physical address. */
+IOReturn NativeAdrenoMemory::maintainImported(size_t offset,size_t bytes,NativeAdrenoCacheOperation op)
+{
+    for(size_t i=0;i<span_count_;++i) {
+        const NativeAdrenoPhysicalSpan &span=spans_[i];
+        const size_t begin=offset>span.offset?offset:span.offset;
+        const size_t end=offset+bytes<span.offset+span.bytes?offset+bytes:span.offset+span.bytes;
+        if(begin>=end)continue;
+        const IOReturn status=NativeAdrenoMaintainPhysicalPages(span.physical+(begin-span.offset),end-begin,op);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoMemory.h b/iokit/Kernel/arm/unixnu/NativeAdrenoMemory.h
new file mode 100644
index 000000000..cec88d49c
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoMemory.h
@@ -0,0 +1,121 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_MEMORY_H
+#define NATIVE_ADRENO_MEMORY_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+class IOBufferMemoryDescriptor;
+class IOMemoryDescriptor;
+struct NativeAdrenoPhysicalSpan {uint64_t offset,physical,bytes;};
+struct NativeAdrenoCpuState {
+    uint64_t tcr,ttbr0,ttbr1,sctlr;
+    uint64_t kernel_page_bytes,kernel_map_page_bytes;
+};
+IOReturn NativeAdrenoQueryCpuGranule(NativeAdrenoCpuState *);
+enum NativeAdrenoCacheOperation {NativeAdrenoClean,NativeAdrenoCleanInvalidate,NativeAdrenoInvalidate};
+IOReturn NativeAdrenoMaintainOwnedPages(void *,size_t,NativeAdrenoCacheOperation);
+/* The same over whole physical pages of DRAM, through the kernel's physical aperture: data cache lines are physically tagged, so this
+ * reaches lines another task's mapping left (an imported IOSurface). Apple's sys_dcache_flush is only a DSB, so user space cannot. */
+IOReturn NativeAdrenoMaintainPhysicalPages(uint64_t physical,size_t bytes,NativeAdrenoCacheOperation);
+/* Every CPU mapping of the spans' pages becomes write-combined (true) or takes the default cacheable attribute again (false). */
+IOReturn NativeAdrenoSetPagesCacheMode(const NativeAdrenoPhysicalSpan *,size_t count,bool write_combined);
+/* int-100 found a write-combined BO's page back at the default (cacheable) attribute with dirty IB lines: XNU's view machinery sets a page's
+ * attribute when it populates or tears down a device-pager view. Every page of the spans no longer write-combined is made so again (the pmap
+ * then rewrites every mapping it tracks and writes the page's cache lines back); *reset counts them. */
+IOReturn NativeAdrenoReassertWriteCombined(const NativeAdrenoPhysicalSpan *,size_t count,uint32_t *reset);
+
+/* Native XNU backing store, not a Metal device or user ABI. No IOMMU mapper,
+ * Linux fd/ioctl, hardware address, guessed PA or implicit destructor cleanup.
+ * Driver owns this object until release() succeeds; do not destroy/copy it
+ * with outstanding memory. Serialize every call under the queue/resource gate.
+ * Every published mapping/job must hold a device reference BEFORE publication,
+ * and retire it only after actual DMA quiescence and completed native TLB unmap.
+ * References are lifetime accounting, never fences or proof of quiescence. */
+class NativeAdrenoMemory final {
+    IOBufferMemoryDescriptor *descriptor_=nullptr;
+    IOMemoryDescriptor *imported_=nullptr;
+    bool read_only_=false;
+    void *mapping_=nullptr;
+    NativeAdrenoPhysicalSpan *spans_=nullptr;
+    size_t bytes_=0,allocated_bytes_=0,span_count_=0,span_capacity_=0;
+    /* CPU attributes belong to complete host pages, including private padding.
+     * GPU-visible spans deliberately exclude that padding. */
+    NativeAdrenoPhysicalSpan *owned_spans_=nullptr;
+    size_t owned_count_=0,owned_capacity_=0;
+    uint32_t device_references_=0;
+    bool prepared_=false,quarantined_=false,write_combined_=false,pooled_=false,borrowed_nc_=false;
+    size_t pool_offset_=0;
+    unsigned pool_block_=0;   /* which pool block a pooled BO came from */
+    IOMemoryDescriptor *pool_view_=nullptr;   /* a pooled BO's own range of the pool, for user mappings */
+    IOReturn maintainImported(size_t offset,size_t bytes,NativeAdrenoCacheOperation);
+public:
+    NativeAdrenoMemory()=default;
+    ~NativeAdrenoMemory()=default;
+    NativeAdrenoMemory(const NativeAdrenoMemory &)=delete;
+    NativeAdrenoMemory &operator=(const NativeAdrenoMemory &)=delete;
+    /* Explicit driver budget; bounded to 256MiB per backing object for now.
+     * Error may retain quarantined allocation state if complete() fails.
+     * Caller always keeps this object and checks quarantined(), even on error.
+     * CPU granule and kernel page ABI are checked before allocation.
+     * prepare(), raw unmapped physical segments, span/PA bounds and optional
+     * physical contiguity are verified before zeroing/PoC publication. */
+    /* `pooled`: take the bytes from the BO pool when one is reserved and has room. Only user BOs do: the pool is write-combined for
+     * the CPU (writeCombinePool), and the kernel's own objects (SMMU tables, ring, fence and firmware pages) are walked or read by the
+     * CPU through their cacheable mapping (int-153: page tables from the write-combined pool made each map's table update 2.6x slower). */
+    IOReturn allocate(size_t bytes,unsigned output_bits,bool contiguous,size_t byte_budget,bool pooled=false);
+    /* One physically contiguous block taken from the VM early (while memory is not yet fragmented) and cut into BOs afterwards: a BO from it is
+     * one span of the GPU's table instead of one per scattered page (int-137: 59474 spans for 332 MiB, the 65536 span capacity ran out,
+     * BoMap failed, the translator answered out of device memory and the compositor fell back to the CPU; each map also walked every span, 167 ms).
+     * allocate(..., pooled=true) uses the pool when one is reserved and has room, else the scattered path. Only the board calls this. */
+    static IOReturn reservePool(unsigned output_bits,size_t bytes);
+    static size_t poolBytes();
+    /* The whole pool write-combined once, for good: a pooled BO then takes no page-attribute change on allocation or release.
+     * Board only, after reservePool, when user BOs are write-combined. */
+    static IOReturn writeCombinePool();
+    /* Pins bytes at address in task (a user task's own pages) instead of allocating; prepare() wires them until release().
+     * There is no kernel mapping: the owner keeps its CPU mapping and does its own cache maintenance around GPU use, so
+     * publishForDevice/acquireDeviceWrites have nothing to do for this object. Spans and PA bounds are checked as for allocate. */
+    IOReturn importTask(void *task,uint64_t address,size_t bytes,unsigned output_bits,size_t byte_budget);
+    bool imported() const {return imported_!=nullptr;}
+    /* An import of memory the owner maps read-only (the kernel could pin it for reading only): the GPU may read it, never write it. */
+    bool readOnly() const {return read_only_;}
+    /* After allocate(), before any device or client mapping: cleans and invalidates the pages and makes every CPU mapping of them
+     * write-combined, so publishForDevice/acquireDeviceWrites have nothing left to do. release() restores the default attribute. */
+    IOReturn makeWriteCombined();
+    bool writeCombined() const {return write_combined_;}
+    /* NativeAdrenoReassertWriteCombined over this object's pages; nothing for an object that is not write-combined, nor for one from the
+     * BO pool: XNU set scattered BOs' pages back to the default attribute (int-160: 123847 pages), never a pool page (int-161: none in
+     * 1280 submissions, while walking the pool's pages took 0.65 ms of each). The submissions' line audit still covers every object. */
+    IOReturn reassertWriteCombined(uint32_t *reset) const
+    {return write_combined_ && span_count_ && !pooled_?NativeAdrenoReassertWriteCombined(owned_spans_,owned_count_,reset):kIOReturnSuccess;}
+    /* Kernel board only: the boot owner permanently retains this exact NC
+     * mapping and raw physical allocation. Never changes attributes/frees it. */
+    IOReturn borrowBootStorage(void *mapping,uint64_t physical,size_t bytes,unsigned output_bits);
+    bool backed() const {return descriptor_ || imported_ || pooled_ || borrowed_nc_;}
+    /* Refuses device references/quarantine; only clears ownership after real
+     * descriptor complete() succeeds. No automatic reset or resource recycling. */
+    IOReturn release();
+    IOReturn holdForDevice();
+    IOReturn retireAfterQuiescence();
+    void quarantine() {quarantined_=true;}
+    /* Requires real CPU/device exclusion and retained ownership. Before GPU
+     * writes, clean+invalidate; after genuine completion, invalidate only.
+     * CPU must not dirty these pages while the device owns access. */
+    /* A write-combined object is skipped unless include_write_combined: then its pages are maintained through the physical aperture,
+     * for a client whose view turned out to be cacheable after all (NativeAdrenoVm::distrustWriteCombined). */
+    IOReturn publishForDevice(size_t offset,size_t bytes,bool device_writes,bool include_write_combined=false);
+    IOReturn acquireDeviceWrites(size_t offset,size_t bytes);
+    bool quarantined() const {return quarantined_;}
+    uint32_t deviceReferences() const {return device_references_;}
+    size_t bytes() const {return bytes_;}
+    size_t allocatedBytes() const {return allocated_bytes_;}
+    size_t spanCount() const {return span_count_;}
+    const NativeAdrenoPhysicalSpan *spans() const {return spans_;}
+    void *mapping() const {return mapping_;}
+    /* Borrowed descriptor, never release independently or expose table pools
+     * through clientMemoryForType. Sharing requires a separate owner/task ABI. */
+    IOBufferMemoryDescriptor *descriptor() const {return descriptor_;}
+    /* What clientMemoryForType hands out: the BO's own descriptor, or its view of the pool. */
+    IOMemoryDescriptor *userDescriptor() const;
+};
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoRing.cpp b/iokit/Kernel/arm/unixnu/NativeAdrenoRing.cpp
new file mode 100644
index 000000000..9bd17ad6d
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoRing.cpp
@@ -0,0 +1,379 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoRing.h"
+#include "AdrenoPM4.h"
+#include <IOKit/IOLib.h>
+
+/* Values are taken from the pinned Linux source, not guessed:
+ * drivers/gpu/drm/msm/registers/adreno/a6xx.xml (register offsets), and
+ * registers/adreno/adreno_pm4.xml (opcode 0x46 CP_EVENT_WRITE7, event 0x31
+ * CACHE_CLEAN, WRITE_SRC bits 20..22, WRITE_DST bit 24, WRITE_ENABLED bit 27,
+ * IRQ bit 31). CP_RB_CNTL BUFSZ bits 0..5 and BLKSZ bits 8..13 are the same
+ * fields MSM_GPU_RB_CNTL_DEFAULT programs. All are dword register indices. */
+enum : uint32_t {
+    RingBase = 0x0800,        /* 64-bit CP_RB_BASE */
+    RingControl = 0x0802,     /* CP_RB_CNTL */
+    RingRptrAddress = 0x0804, /* 64-bit CP_RB_RPTR_ADDR */
+    RingRptr = 0x0806,
+    RingWptr = 0x0807,
+    RingScratch = 0x0885,     /* CP_SCRATCH(2) for A6XX..A7XX */
+    RingFenceOpcode = 0x46,   /* CP_EVENT_WRITE7 on A7XX */
+    RingFenceEvent = 0x31,    /* CACHE_CLEAN */
+    RingFenceEnable = 1u << 27,
+    RingFenceIrq = 1u << 31,
+    RingBlockBytes = 32,
+    /* A7XX framing, as a7xx_submit() in the pinned a6xx_gpu.c emits it: CP_THREAD_CONTROL (0x17; THREAD bits 0..1,
+     * BR 1, BV 2, BOTH 3; SYNC_THREADS bit 31), CP_SET_MARKER (0x65; 0x101 IFPC disable, 0x100 enable), CCU_INVALIDATE_DEPTH
+     * 0x18 / CCU_INVALIDATE_COLOR 0x19 and CP_WAIT_TIMESTAMP (0x14) from adreno_pm4.xml. User command streams synchronize
+     * the BR and BV threads themselves (Turnip waits on BV timestamps), so the IBs must run with both threads enabled. */
+    RingThreadControl = 0x17,
+    RingThreadBr = 1,
+    RingThreadBv = 2,
+    RingThreadBoth = 3,
+    RingSyncThreads = 1u << 31,
+    RingSetMarker = 0x65,
+    RingWaitTimestamp = 0x14,
+    RingCcuInvalidateDepth = 0x18,
+    RingCcuInvalidateColor = 0x19,
+    /* What the SQE's CP_SMMU_TABLE_UPDATE handler does before it switches tables (a740_sqe.fw, qrisc-disasm): CACHE_FLUSH7 (0x32)
+     * and CACHE_INVALIDATE7 (0x33) with a wait for idle (CP_WAIT_FOR_IDLE 0x26). Linux gets these from that packet on every context
+     * switch; this ring never sends it, and event 0x31 is only CACHE_CLEAN on A7XX, so nothing else ever invalidated UCHE. */
+    RingCacheFlush7 = 0x32,
+    RingCacheInvalidate7 = 0x33,
+    RingWaitForIdle = 0x26,
+    RingPrologueWords = 11,
+    /* a6xx_set_pagetable()'s A7XX context entry: CP_RESET_CONTEXT_STATE (0x1f; CLEAR_ON_CHIP_TS, CLEAR_RESOURCE_TABLE,
+     * CLEAR_BV_BR_COUNTER, RESET_GLOBAL_LOCAL_TS = bits 0..3) between thread syncs, LRZ_FLUSH_INVALIDATE (0x26), the
+     * RBBM_PERFCTR_SRAM_INIT_CMD (0x050e) write and CACHE_INVALIDATE (0x31), after a CP_WAIT_TIMESTAMP on the last fence, then the
+     * CP_WAIT_REG_MEM (0x3c, WRITE_EQ) on RBBM_PERFCTR_SRAM_INIT_STATUS (0x050f) bit 0 that Linux always emits after the SRAM init
+     * write. Without that wait the client's first IB started while the SRAM was still clearing; on sheng (int-064..067) the CP then
+     * stopped on the IB's first CP_THREAD_CONTROL, while the same IB retired under the Linux driver. */
+    RingResetContextState = 0x1f,
+    RingResetAll = 0xf,
+    RingLrzFlushInvalidate = 0x26,
+    RingCacheInvalidate = 0x31,
+    RingPerfctrSramInit = 0x050e,
+    RingPerfctrSramInitStatus = 0x050f,
+    RingWaitRegMem = 0x3c,
+    RingWaitWriteEq = 3,
+    RingResetWords = 26,
+    RingFenceWords = 7,       /* kernel bring-up submissions: TYPE4 scratch + TYPE7 event */
+    RingFramedFenceWords = 31,/* user submissions: scratch, BV timestamp, BR wait, ring timestamp */
+    RingBvFenceOffset = 12    /* msm_rbmemptrs.bv_fence; +8 is bv_rptr, the BV RPTR shadow hw init programs */
+};
+static uint32_t ilog2(size_t value)
+{
+    uint32_t result=0;while(value>1) {value>>=1;++result;}return result;
+}
+/* The last submissions as the CP will read them: [slot] fence, start index, end index, word count, then up to 112 ring words from the start. The board log
+ * prints them, so a fence the GPU never wrote can be compared with the packets that should have written it. */
+extern "C" {volatile uint32_t native_adreno_ring_log[4][4+112];volatile uint32_t native_adreno_ring_log_count;}
+IOReturn NativeAdrenoRing::poison()
+{
+    poisoned_=true;return kIOReturnIOError;
+}
+IOReturn NativeAdrenoRing::readRptr(uint32_t *value)
+{
+    uint32_t rptr=0;
+    if(a6xx_) {
+        if(cache_.acquire(cache_.cookie,a6xx_shadow_,sizeof(*a6xx_shadow_)))return poison();
+        rptr=*a6xx_shadow_;
+    } else if(io_.read32(io_.cookie,RingRptr,&rptr))return poison();
+    if(rptr>=ring_bytes_/4)return poison(); /* unusable read pointer */
+    *value=rptr;rptr_shadow_=rptr;return kIOReturnSuccess;
+}
+/* Packs one TYPE7 packet into words; returns the next free index or 0 when the header cannot be built. */
+static size_t packet(uint32_t *words,size_t at,uint32_t opcode,const uint32_t *payload,uint32_t count)
+{
+    if(AdrenoPM4Type7(opcode,count,&words[at])!=AdrenoPM4Success)return 0;
+    for(uint32_t i=0;i<count;++i)words[at+1+i]=payload[i];
+    return at+1+count;
+}
+/* Thread selection and IFPC disable before the user buffers, as a7xx_submit() does; the first submission after
+ * requestContextReset() also carries the context entry a6xx_set_pagetable() emits when a new context first submits.
+ * Every prologue ends its BR-only part with the GPU cache flush and invalidate described at RingCacheFlush7. */
+IOReturn NativeAdrenoRing::emitPrologue(uint32_t at,bool reset,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    if(a6xx_) {
+        /* Linux a6xx_set_pagetable/a6xx_submit at the pinned SM7150 revision.
+         * One already-owned context: no TTBR switch and no A7xx thread state.
+         * A requested context entry initializes performance SRAM under protected
+         * mode, waits for its real status, then restores protected mode. */
+        uint32_t words[19]={};
+        size_t n=0;
+        if(reset) {
+            const uint32_t off=0;
+            n=packet(words,n,0x5f,&off,1);
+            if(!n || AdrenoPM4Type4(RingPerfctrSramInit,1,&words[n])!=AdrenoPM4Success)return poison();
+            words[n+1]=1;n+=2;
+        }
+        const uint32_t invalidate=RingCacheInvalidate;
+        n=packet(words,n,RingFenceOpcode,&invalidate,1);
+        if(reset && n) {
+            const uint32_t wait[6]={RingWaitWriteEq,RingPerfctrSramInitStatus,0,1,1,0},on=1;
+            n=packet(words,n,RingWaitRegMem,wait,6);
+            if(n)n=packet(words,n,0x5f,&on,1);
+        }
+        const uint32_t depth=RingCcuInvalidateDepth,color=RingCcuInvalidateColor;
+        if(n)n=packet(words,n,RingFenceOpcode,&depth,1);
+        if(n)n=packet(words,n,RingFenceOpcode,&color,1);
+        const size_t count=6+(reset?13:0);
+        if(n!=count)return poison();
+        for(size_t i=0;i<count;++i)ring_[(at+(uint32_t)i)&mask]=words[i];
+        *end=(at+(uint32_t)count)&mask;return kIOReturnSuccess;
+    }
+    uint32_t words[RingPrologueWords+RingResetWords]={0};
+    const uint32_t br=RingSyncThreads|RingThreadBr,syncBoth=RingSyncThreads|RingThreadBoth,both=RingThreadBoth,marker=0x101;
+    const uint32_t count=RingPrologueWords+(reset?uint32_t(RingResetWords):0u);
+    size_t n=packet(words,0,RingThreadControl,&br,1);
+    if(reset) {
+        const uint64_t at4=fence_iova_+4;
+        const uint32_t wait[4]={0,(uint32_t)at4,(uint32_t)(at4>>32),seqno_},all=RingResetAll,lrz=RingLrzFlushInvalidate,
+            invalidate=RingCacheInvalidate;
+        if(n)n=packet(words,n,RingWaitTimestamp,wait,4);
+        if(n)n=packet(words,n,RingThreadControl,&syncBoth,1);
+        if(n)n=packet(words,n,RingResetContextState,&all,1);
+        if(n)n=packet(words,n,RingThreadControl,&syncBoth,1);
+        if(n)n=packet(words,n,RingFenceOpcode,&lrz,1);
+        if(n)n=packet(words,n,RingThreadControl,&br,1);
+        if(n && AdrenoPM4Type4(RingPerfctrSramInit,1,&words[n])==AdrenoPM4Success) {words[n+1]=1;n+=2;} else n=0;
+        if(n)n=packet(words,n,RingFenceOpcode,&invalidate,1);
+        const uint32_t sram[6]={RingWaitWriteEq,RingPerfctrSramInitStatus,0,1,1,0};
+        if(n)n=packet(words,n,RingWaitRegMem,sram,6);
+    }
+    const uint32_t flush=RingCacheFlush7,invalidate7=RingCacheInvalidate7;
+    if(n)n=packet(words,n,RingFenceOpcode,&flush,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&invalidate7,1);
+    if(n)n=packet(words,n,RingWaitForIdle,nullptr,0);
+    if(n)n=packet(words,n,RingThreadControl,&both,1);
+    if(n)n=packet(words,n,RingSetMarker,&marker,1);
+    if(n!=count)return poison();
+    for(uint32_t i=0;i<count;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+count)&mask;return kIOReturnSuccess;
+}
+/* Writes the timestamp fence that makes a submission observable. */
+IOReturn NativeAdrenoRing::emitFence(uint32_t at,uint32_t seqno,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    if(a6xx_) {
+        /* A6xx CACHE_FLUSH_TS=4, IRQ bit31, then WHERE_AM_I (0x62)
+         * updates the separate RPTR shadow. Never emit A7xx EVENT_WRITE7. */
+        uint32_t words[8]={};
+        if(AdrenoPM4Type7(0x46,4,&words[0])!=AdrenoPM4Success ||
+           AdrenoPM4Type7(0x62,2,&words[5])!=AdrenoPM4Success)return poison();
+        words[1]=4u|(1u<<31);
+        words[2]=(uint32_t)fence_iova_;words[3]=(uint32_t)(fence_iova_>>32);words[4]=seqno;
+        words[6]=(uint32_t)a6xx_shadow_iova_;words[7]=(uint32_t)(a6xx_shadow_iova_>>32);
+        for(unsigned i=0;i<8;++i)ring_[(at+i)&mask]=words[i];
+        *end=(at+8)&mask;return kIOReturnSuccess;
+    }
+    uint32_t words[RingFenceWords]={0};
+    if(AdrenoPM4Type4(RingScratch,1,&words[0])!=AdrenoPM4Success ||
+        AdrenoPM4Type7(RingFenceOpcode,4,&words[2])!=AdrenoPM4Success)return poison();
+    words[1]=seqno;
+    words[3]=RingFenceEvent|RingFenceEnable|RingFenceIrq;
+    /* The timestamp goes to +4 (msm_rbmemptrs.fence), where wait() reads it; +0 is the CP's RPTR shadow. */
+    const uint64_t at4=fence_iova_+4;
+    words[4]=(uint32_t)at4;words[5]=(uint32_t)(at4>>32);words[6]=seqno;
+    for(uint32_t i=0;i<RingFenceWords;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+RingFenceWords)&mask;return kIOReturnSuccess;
+}
+/* The fence of a framed submission: CP_SCRATCH(2), the BV thread's timestamp, a BR wait for it (so BR cannot report the
+ * submission while BV still works on it), then the ring timestamp with an interrupt, both threads and IFPC back on. */
+IOReturn NativeAdrenoRing::emitFramedFence(uint32_t at,uint32_t seqno,uint32_t *end)
+{
+    const uint32_t mask=(uint32_t)(ring_bytes_/4-1);
+    uint32_t words[RingFramedFenceWords]={0};
+    if(AdrenoPM4Type4(RingScratch,1,&words[0])!=AdrenoPM4Success)return poison();
+    words[1]=seqno;
+    /* The timestamp goes to +4 (msm_rbmemptrs.fence), where wait() reads it; +0 is the CP's RPTR shadow. */
+    const uint64_t at4=fence_iova_+4,bv=fence_iova_+RingBvFenceOffset;
+    const uint32_t br=RingThreadBr,bvThread=RingThreadBv,both=RingThreadBoth,depth=RingCcuInvalidateDepth,
+        color=RingCcuInvalidateColor,marker=0x100;
+    const uint32_t bvWrite[4]={RingFenceEvent|RingFenceEnable,(uint32_t)bv,(uint32_t)(bv>>32),seqno};
+    const uint32_t bvWait[4]={0,(uint32_t)bv,(uint32_t)(bv>>32),seqno};
+    const uint32_t fence[4]={RingFenceEvent|RingFenceEnable|RingFenceIrq,(uint32_t)at4,(uint32_t)(at4>>32),seqno};
+    size_t n=packet(words,2,RingThreadControl,&br,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&depth,1);
+    if(n)n=packet(words,n,RingFenceOpcode,&color,1);
+    if(n)n=packet(words,n,RingThreadControl,&bvThread,1);
+    if(n)n=packet(words,n,RingFenceOpcode,bvWrite,4);
+    if(n)n=packet(words,n,RingThreadControl,&br,1);
+    if(n)n=packet(words,n,RingWaitTimestamp,bvWait,4);
+    if(n)n=packet(words,n,RingFenceOpcode,fence,4);
+    if(n)n=packet(words,n,RingThreadControl,&both,1);
+    if(n)n=packet(words,n,RingSetMarker,&marker,1);
+    if(n!=RingFramedFenceWords)return poison();
+    for(uint32_t i=0;i<RingFramedFenceWords;++i)ring_[(at+i)&mask]=words[i];
+    *end=(at+RingFramedFenceWords)&mask;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::attach(const NativeAdrenoRingIo *io,const NativeAdrenoRingCache *cache,
+    void *ring,size_t ring_bytes,uint64_t ring_iova,void *fence,size_t fence_bytes,uint64_t fence_iova)
+{
+    if(attached_ || poisoned_ || ring_ || fence_)return kIOReturnBusy;
+    if(!io || !io->write32 || !io->read32 || !io->barrier || !cache ||
+        !cache->publish || !cache->acquire || !ring || !fence ||
+        ring_bytes<8192 || ring_bytes>(1u<<20) || (ring_bytes&(ring_bytes-1)) ||
+        ((ring_iova|ring_bytes)&(ring_bytes-1)) || (ring_iova&4095) ||
+        fence_bytes<64 || (fence_iova&7) || fence_bytes>=(1u<<24))return kIOReturnBadArgument;
+    /* No register may be touched before every argument is acceptable. */
+    io_=*io;cache_=*cache;ring_=static_cast<volatile uint32_t *>(ring);
+    ring_bytes_=ring_bytes;ring_iova_=ring_iova;
+    fence_=static_cast<volatile uint32_t *>(fence);fence_bytes_=fence_bytes;fence_iova_=fence_iova;
+    for(size_t i=0;i<fence_bytes_/4;++i)fence_[i]=0;
+    const uint32_t control=(uint32_t)(ilog2(ring_bytes/8)&0x3f)|(ilog2(RingBlockBytes/8)<<8);
+    const uint32_t base_lo=(uint32_t)ring_iova_,base_hi=(uint32_t)(ring_iova_>>32);
+    const uint32_t rptr_lo=(uint32_t)fence_iova_,rptr_hi=(uint32_t)(fence_iova_>>32);
+    const uint32_t writes[]={RingBase,base_lo,RingBase+1,base_hi,RingControl,control,
+        RingRptrAddress,rptr_lo,RingRptrAddress+1,rptr_hi,RingWptr,0,RingScratch,0};
+    for(size_t i=0;i<sizeof(writes)/sizeof(writes[0]);i+=2)
+        if(io_.write32(io_.cookie,writes[i],writes[i+1]))return poison();
+    uint32_t rptr=0;IOReturn status=readRptr(&rptr);
+    if(status)return status;
+    next_=rptr;seqno_=0;completed_=0;submissions_=0;
+    attached_=true;return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::adoptA6xx(const NativeAdrenoRingIo *io,const NativeAdrenoRingCache *cache,
+    void *ring,size_t ring_bytes,uint64_t ring_iova,void *fence,size_t fence_bytes,uint64_t fence_iova,
+    volatile uint32_t *shadow,uint64_t shadow_iova,uint32_t seed)
+{
+    if(attached_ || poisoned_ || ring_ || fence_)return kIOReturnBusy;
+    if(!io || !io->read32 || !io->write32 || !io->barrier || !cache || !cache->publish || !cache->acquire ||
+       !ring || !fence || !shadow || !seed || seed==UINT32_MAX || ring_bytes<8192 || ring_bytes>(1u<<20) ||
+       (ring_bytes&(ring_bytes-1)) || (ring_iova&(ring_bytes-1)) || fence_bytes<4 ||
+       (((uintptr_t)ring|(uintptr_t)fence|(uintptr_t)shadow|fence_iova|shadow_iova)&3) ||
+       ring_iova>=UINT64_C(0x100000000) || ring_bytes>UINT64_C(0x100000000)-ring_iova ||
+       fence_iova>=UINT64_C(0x100000000) || shadow_iova>=UINT64_C(0x100000000))return kIOReturnBadArgument;
+    if(cache->acquire(cache->cookie,static_cast<volatile uint32_t *>(fence),fence_bytes) ||
+       cache->acquire(cache->cookie,shadow,sizeof(*shadow)))return kIOReturnIOError;
+    uint32_t wptr=0,lo=0,hi=0,control=0,slo=0,shi=0,sqe=0;
+    if(io->read32(io->cookie,RingBase,&lo) || io->read32(io->cookie,RingBase+1,&hi) ||
+       io->read32(io->cookie,RingControl,&control) || io->read32(io->cookie,RingRptrAddress,&slo) ||
+       io->read32(io->cookie,RingRptrAddress+1,&shi) || io->read32(io->cookie,RingWptr,&wptr) ||
+       io->read32(io->cookie,0x808,&sqe))return kIOReturnIOError;
+    const uint32_t expected=(1u<<27)|(2u<<8)|ilog2(ring_bytes/8);
+    if(lo!=(uint32_t)ring_iova || hi || slo!=(uint32_t)shadow_iova || shi || control!=expected || sqe!=1 ||
+       wptr>=ring_bytes/4 || *shadow!=wptr || *static_cast<volatile uint32_t *>(fence)!=seed)return kIOReturnNotReady;
+    io_=*io;cache_=*cache;ring_=static_cast<volatile uint32_t *>(ring);ring_bytes_=ring_bytes;ring_iova_=ring_iova;
+    fence_=static_cast<volatile uint32_t *>(fence);fence_bytes_=fence_bytes;fence_iova_=fence_iova;fence_word_=0;
+    a6xx_=true;a6xx_shadow_=shadow;a6xx_shadow_iova_=shadow_iova;
+    next_=rptr_shadow_=wptr;seqno_=completed_=seed;submissions_=0;attached_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::detach()
+{
+    if(poisoned_)return kIOReturnBusy;
+    if(!attached_)return kIOReturnNotReady;
+    if(outstanding())return kIOReturnBusy;
+    attached_=false;ring_=nullptr;fence_=nullptr;ring_bytes_=fence_bytes_=0;
+    a6xx_=false;a6xx_shadow_=nullptr;a6xx_shadow_iova_=0;fence_word_=1;
+    ring_iova_=fence_iova_=0;next_=rptr_shadow_=seqno_=completed_=submissions_=0;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoRing::submit(const uint32_t *words,size_t word_count,uint32_t *fence)
+{
+    return submitWords(words,word_count,fence,false);
+}
+IOReturn NativeAdrenoRing::submitFramed(const uint32_t *words,size_t word_count,uint32_t *fence)
+{
+    return submitWords(words,word_count,fence,true);
+}
+IOReturn NativeAdrenoRing::submitWords(const uint32_t *words,size_t word_count,uint32_t *fence,bool framed)
+{
+    if(!fence)return kIOReturnBadArgument;*fence=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!words || !word_count || word_count>SIZE_MAX/sizeof(uint32_t))return kIOReturnBadArgument;
+    if(seqno_==UINT32_MAX)return kIOReturnNoResources;
+    const uint32_t size_words=(uint32_t)(ring_bytes_/4),mask=size_words-1;
+    const bool reset=framed && reset_pending_;
+    const uint32_t extra=a6xx_?(framed?(6u+(reset?13u:0u)+8u):8u):
+        (framed?RingPrologueWords+(reset?uint32_t(RingResetWords):0u)+RingFramedFenceWords:uint32_t(RingFenceWords));
+    if(word_count>size_words-extra-8)return kIOReturnNoResources;
+    uint32_t rptr=0;IOReturn status=readRptr(&rptr);
+    if(status)return status;
+    const uint32_t used=(next_-rptr)&mask;
+    if(word_count+extra+8>size_words-used)return kIOReturnNoResources;
+    uint32_t at=next_;
+    if(framed) {
+        status=emitPrologue(at,reset,&at);
+        if(status)return status;
+    }
+    for(size_t i=0;i<word_count;++i)ring_[(at+i)&mask]=words[i];
+    at=(at+(uint32_t)word_count)&mask;
+    uint32_t end=0;
+    status=framed && !a6xx_?emitFramedFence(at,seqno_+1,&end):emitFence(at,seqno_+1,&end);
+    if(status)return status;
+    /* Whole-ring publication is deliberate: a submission may wrap, and one
+     * clean of the owned pool is cheaper than a split range proof. */
+    {
+        const uint32_t slot=native_adreno_ring_log_count&3;
+        const uint32_t total=(end-next_)&mask;
+        volatile uint32_t *record=native_adreno_ring_log[slot];
+        record[0]=seqno_+1;record[1]=next_;record[2]=end;record[3]=total;
+        for(uint32_t i=0;i<112;++i)record[4+i]=i<total?ring_[(next_+i)&mask]:0;
+        native_adreno_ring_log_count=native_adreno_ring_log_count+1;
+    }
+    if(cache_.publish(cache_.cookie,ring_,ring_bytes_))return poison();
+    if(io_.barrier(io_.cookie))return poison();
+    if(io_.write32(io_.cookie,RingWptr,end))return poison();
+    next_=end;*fence=++seqno_;++submissions_;
+    if(reset)reset_pending_=false;
+    return kIOReturnSuccess;
+}
+NativeAdrenoRingFence NativeAdrenoRing::observeFence(uint32_t fence,
+    const NativeAdrenoRingClock *clock,uint32_t timeout_us,uint32_t *observed)
+{
+    if(observed)*observed=0;
+    if(!attached_ || poisoned_)return NativeAdrenoRingFencePoisoned;
+    if(!fence || fence>seqno_)return NativeAdrenoRingFenceArgument;
+    uint64_t start=clock && clock->now_us?clock->now_us(clock->cookie):0;
+    for(;;) {
+        if(cache_.acquire(cache_.cookie,fence_,fence_bytes_)) {poison();return NativeAdrenoRingFencePoisoned;}
+        const uint32_t value=fence_[fence_word_];
+        if(observed)*observed=value;
+        if(value>seqno_) {poison();return NativeAdrenoRingFencePoisoned;}
+        if(value>=fence)return NativeAdrenoRingFenceComplete;
+        if(!clock || !clock->now_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->now_us(clock->cookie)-start>=timeout_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->idle && clock->idle(clock->cookie))return NativeAdrenoRingFenceTimeout;
+    }
+}
+NativeAdrenoRingFence NativeAdrenoRing::wait(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us,uint32_t *observed)
+{
+    if(observed)*observed=0;
+    if(!attached_ || poisoned_)return NativeAdrenoRingFencePoisoned;
+    if(!fence || fence>seqno_)return NativeAdrenoRingFenceArgument;
+    uint64_t start=clock && clock->now_us?clock->now_us(clock->cookie):0;
+    for(;;) {
+        if(cache_.acquire(cache_.cookie,fence_,fence_bytes_)) {poison();return NativeAdrenoRingFencePoisoned;}
+        const uint32_t value=fence_[fence_word_];
+        if(observed)*observed=value;
+        if(value>=fence) {if(value>seqno_) {poison();return NativeAdrenoRingFencePoisoned;}completed_=value;
+            return NativeAdrenoRingFenceComplete;}
+        if(!clock || !clock->now_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->now_us(clock->cookie)-start>=timeout_us)return NativeAdrenoRingFenceTimeout;
+        if(clock->idle && clock->idle(clock->cookie))return NativeAdrenoRingFenceTimeout;
+    }
+}
+
+IOReturn NativeAdrenoRing::drainA6xx(const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!a6xx_ || !clock || !clock->now_us)return kIOReturnUnsupported;
+    const uint64_t began=clock->now_us(clock->cookie);
+    if(outstanding()) {
+        const NativeAdrenoRingFence fence=wait(seqno_,clock,timeout_us,nullptr);
+        if(fence!=NativeAdrenoRingFenceComplete)return fence==NativeAdrenoRingFenceTimeout?kIOReturnTimeout:kIOReturnIOError;
+    }
+    for(;;) {
+        uint32_t rptr=0,status=0;
+        IOReturn error=readRptr(&rptr);if(error)return error;
+        if(io_.read32(io_.cookie,0x210,&status))return poison();
+        /* Pinned Linux _a6xx_check_idle: CP_AHB_BUSY_CX_MASTER bit0 is
+         * expected while polling over AHB; all other busy bits must clear. */
+        if(rptr==next_ && !(status&~1u))return kIOReturnSuccess;
+        if(clock->now_us(clock->cookie)-began>=timeout_us)return kIOReturnTimeout;
+        if(clock->idle && clock->idle(clock->cookie))return kIOReturnTimeout;
+    }
+}
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoRing.h b/iokit/Kernel/arm/unixnu/NativeAdrenoRing.h
new file mode 100644
index 000000000..80e8b0067
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoRing.h
@@ -0,0 +1,117 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_RING_H
+#define NATIVE_ADRENO_RING_H
+#include <IOKit/IOTypes.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/* A7XX command processor ring and timestamp fence, not a scheduler.
+ * Register indices are dword offsets; the platform adds the MMIO base and
+ * multiplies by four. Caller must already own an exclusive, powered GPU with
+ * SQE microcode loaded (CP_SQE_INSTR_BASE), global reset released and all
+ * masters quiesced while attach programs the ring. Ring and fence CPU
+ * addresses must be actual writable mappings of the same IOVAs that were
+ * mapped into the active native-4K GPU context. No MMIO base, IRQ, power,
+ * GMU, context switching or per-client validation is implemented here.
+ * Every submit publishes ring memory before advancing WPTR and completes
+ * only when the CP timestamp value is observed at the fence address.
+ * A failed WPTR write or cache publication is uncertain: the ring is poisoned
+ * and every resource must be retained until an independently verified reset. */
+struct NativeAdrenoRingIo {
+    void *cookie;
+    /* Return zero only on a completed access. */
+    int (*write32)(void *,uint32_t reg,uint32_t value);
+    int (*read32)(void *,uint32_t reg,uint32_t *value);
+    int (*barrier)(void *);
+};
+struct NativeAdrenoRingCache {
+    void *cookie;
+    /* Clean owned ring bytes to PoC before the device reads them. */
+    int (*publish)(void *,const volatile uint32_t *words,size_t bytes);
+    /* Invalidate the fence page before the CPU reads CP-written values. */
+    int (*acquire)(void *,volatile uint32_t *words,size_t bytes);
+};
+struct NativeAdrenoRingClock {
+    void *cookie;
+    uint64_t (*now_us)(void *);
+    /* Optional; may sleep. Never used before a successful submit. */
+    int (*idle)(void *);
+};
+enum NativeAdrenoRingFence {
+    NativeAdrenoRingFenceComplete = 0,
+    NativeAdrenoRingFenceTimeout,
+    NativeAdrenoRingFencePoisoned,
+    NativeAdrenoRingFenceArgument
+};
+class NativeAdrenoRing final {
+    NativeAdrenoRingIo io_{};
+    NativeAdrenoRingCache cache_{};
+    volatile uint32_t *ring_=nullptr,*fence_=nullptr;
+    size_t ring_bytes_=0,fence_bytes_=0;
+    uint64_t ring_iova_=0,fence_iova_=0;
+    uint32_t next_=0,rptr_shadow_=0,seqno_=0,completed_=0,submissions_=0;
+    bool attached_=false,poisoned_=false,reset_pending_=false;
+    bool a6xx_=false;
+    volatile uint32_t *a6xx_shadow_=nullptr;
+    uint64_t a6xx_shadow_iova_=0;
+    unsigned fence_word_=1;
+    IOReturn poison();
+    IOReturn readRptr(uint32_t *);
+    IOReturn emitPrologue(uint32_t at,bool reset,uint32_t *end);
+    IOReturn emitFence(uint32_t at,uint32_t seqno,uint32_t *end);
+    IOReturn emitFramedFence(uint32_t at,uint32_t seqno,uint32_t *end);
+    IOReturn submitWords(const uint32_t *words,size_t word_count,uint32_t *fence,bool framed);
+public:
+    NativeAdrenoRing()=default;
+    ~NativeAdrenoRing()=default;
+    NativeAdrenoRing(const NativeAdrenoRing &)=delete;
+    NativeAdrenoRing &operator=(const NativeAdrenoRing &)=delete;
+    /* ring_bytes is a power of two in [8KiB,1MiB]; ring_iova must be aligned
+     * to ring_bytes. fence_bytes >=64 and fence_iova 8-aligned. The fence page
+     * layout is: +0 CP read-pointer shadow, +4 completed timestamp, +8 spare.
+     * All outputs are prevalidated before any register write. */
+    IOReturn attach(const NativeAdrenoRingIo *,const NativeAdrenoRingCache *,
+        void *ring,size_t ring_bytes,uint64_t ring_iova,
+        void *fence,size_t fence_bytes,uint64_t fence_iova);
+    /* Sweet A618 handoff: adopt an already initialized, idle kernel ring.
+     * No base/control/SQE/WPTR writes and no memory clearing. The board owns
+     * all mappings for the boot lifetime. Seed is the observed completed
+     * CACHE_FLUSH_TS value, with shadow and fence in separate storage.
+     * Trusted kernel submissions only; framed submissions use the A6xx sequence. */
+    IOReturn adoptA6xx(const NativeAdrenoRingIo *,const NativeAdrenoRingCache *,
+        void *ring,size_t ring_bytes,uint64_t ring_iova,
+        void *fence,size_t fence_bytes,uint64_t fence_iova,
+        volatile uint32_t *shadow,uint64_t shadow_iova,uint32_t seed);
+    /* Programs nothing. Refuses while submissions are unobserved or poisoned,
+     * because only the caller can establish real GPU quiescence and unmap. */
+    IOReturn detach();
+    /* Emit an entire command stream followed by the timestamp fence and commit
+     * it with one WPTR update. Returns a nonzero fence value on success. The
+     * words are copied; the caller's buffer is never retained. */
+    IOReturn submit(const uint32_t *words,size_t word_count,uint32_t *fence);
+    /* Validated command buffers: A6xx cache invalidation plus legacy timestamp
+     * fence, or A7xx BR/BV framing. No VM switch or client isolation is implied. */
+    IOReturn submitFramed(const uint32_t *words,size_t word_count,uint32_t *fence);
+    /* The next framed submission starts with the A7XX context entry of a6xx_set_pagetable() (BR/BV counters, on-chip
+     * timestamps and resource table cleared between thread syncs); a new user client requests it, as Linux does per context. */
+    void requestContextReset() {reset_pending_=true;}
+    /* Polls the CP-written timestamp after invalidating the fence page. Never
+     * writes registers and never advances the ring. Timeout is not poison. */
+    NativeAdrenoRingFence wait(uint32_t fence,const NativeAdrenoRingClock *,
+        uint32_t timeout_us,uint32_t *observed);
+    /* Observe a previously issued fence without retiring or accounting for it.
+     * Used before a new submission waits on an earlier batch; only fence values
+     * this ring issued are accepted. Never writes a register. */
+    NativeAdrenoRingFence observeFence(uint32_t fence,const NativeAdrenoRingClock *,
+        uint32_t timeout_us,uint32_t *observed);
+    /* A618 VM-update barrier: actual memory RPTR must reach WPTR and the
+     * render engine must be idle after its timestamp fence. Caller holds gate. */
+    IOReturn drainA6xx(const NativeAdrenoRingClock *,uint32_t timeout_us);
+    bool poisoned() const {return poisoned_;}
+    uint32_t outstanding() const {return seqno_-completed_;}
+    uint32_t lastSubmitted() const {return seqno_;}      /* the newest fence number handed out */
+    uint32_t completedFence() const {return completed_;}
+    uint32_t submissions() const {return submissions_;}
+    uint32_t readPointer() const {return rptr_shadow_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoSmmuMemory.cpp b/iokit/Kernel/arm/unixnu/NativeAdrenoSmmuMemory.cpp
new file mode 100644
index 000000000..9aa7d0b69
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoSmmuMemory.cpp
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSmmuMemory.h"
+static int publishTable(void *cookie,volatile uint64_t *page,size_t bytes)
+{
+    auto *memory=static_cast<NativeAdrenoMemory *>(cookie);
+    if(!memory || !page || bytes!=4096 || ((uintptr_t)page&4095) ||
+        (uintptr_t)page<(uintptr_t)memory->mapping())return 1;
+    uintptr_t offset=(uintptr_t)page-(uintptr_t)memory->mapping();
+    if(offset>memory->bytes() || bytes>memory->bytes()-offset)return 1;
+    return memory->publishForDevice(offset,bytes,false)==kIOReturnSuccess?0:1;
+}
+IOReturn NativeAdrenoBindSmmuVisibility(NativeAdrenoMemory *memory,ArmSmmu4KLiveVisibility *visibility)
+{
+    if(!visibility)return kIOReturnBadArgument;*visibility={};
+    if(!memory || memory->quarantined() || !memory->deviceReferences() || !memory->mapping() ||
+        memory->spanCount()!=1 || memory->spans()[0].offset ||
+        memory->spans()[0].bytes!=memory->bytes())return kIOReturnBadArgument;
+    *visibility={memory,publishTable};return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoPrepareSmmuMemory(NativeAdrenoMemory *memory,unsigned input_bits,
+    unsigned output_bits,uint64_t iova,uint64_t bytes,unsigned upper,size_t budget,
+    ArmSmmu4KLiveArena *arena,ArmSmmu4KLiveState *state,ArmSmmu4KLiveVisibility *visibility)
+{
+    if(!memory || !arena || !state || !visibility)return kIOReturnBadArgument;
+    *visibility={};
+    if(state->prepared || state->poisoned || memory->quarantined() || memory->deviceReferences())
+        return kIOReturnBusy;
+    if(!memory->mapping() || memory->spanCount()!=1 ||
+        memory->spans()[0].offset || memory->spans()[0].bytes!=memory->bytes() ||
+        !memory->bytes() || (memory->bytes()&4095))return kIOReturnUnsupported;
+    *arena={{input_bits,output_bits,memory->spans()[0].physical,budget},iova,bytes,upper,
+        static_cast<volatile uint64_t *>(memory->mapping()),memory->bytes()/4096,nullptr,0};
+    ArmSmmu4KStatus status=ArmSmmu4KLivePrepare(arena,state);
+    if(status!=ArmSmmu4KSuccess)return status==ArmSmmu4KCapacity?kIOReturnNoResources:kIOReturnBadArgument;
+    ArmSmmu4KLiveResult audit;
+    status=ArmSmmu4KLiveAudit(arena,state,nullptr,0,&audit);
+    if(status!=ArmSmmu4KSuccess) {state->poisoned=1;return kIOReturnIOError;}
+    IOReturn result=memory->publishForDevice(0,state->tables.table_pages*4096,false);
+    if(result==kIOReturnSuccess)result=memory->holdForDevice();
+    if(result!=kIOReturnSuccess) {state->poisoned=1;return result;}
+    return NativeAdrenoBindSmmuVisibility(memory,visibility);
+}
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoSmmuMemory.h b/iokit/Kernel/arm/unixnu/NativeAdrenoSmmuMemory.h
new file mode 100644
index 000000000..6fb40d367
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoSmmuMemory.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SMMU_MEMORY_H
+#define NATIVE_ADRENO_SMMU_MEMORY_H
+#include "NativeAdrenoMemory.h"
+#include "ArmSmmu4KLive.h"
+/* Bind the actual contiguous raw-PA backing allocation to an INACTIVE native
+ * arena, publish its used table pages and take a device-lifetime reference.
+ * Caller retains memory/arena/state/visibility under an exclusive resource
+ * gate; all outputs and the backing pool are disjoint. State starts zeroed.
+ * Never invoke on an active or foreign table pool. This does not program a
+ * context, route streams, allocate MMIO/IRQs or establish power/security.
+ * On success the memory reference remains held until real masters are stopped,
+ * streams faulted, context disabled and native TLB synchronization completes.
+ * On prepare/publication failure no context has been exposed; caller retains
+ * allocation and poisoned state and handles cleanup. No automatic replay. */
+IOReturn NativeAdrenoPrepareSmmuMemory(NativeAdrenoMemory *,unsigned input_bits,
+    unsigned output_bits,uint64_t iova,uint64_t bytes,unsigned upper_region,
+    size_t leaf_budget,ArmSmmu4KLiveArena *,ArmSmmu4KLiveState *,ArmSmmu4KLiveVisibility *);
+/* Bind only the native PoC publisher to an already retained contiguous table
+ * allocation. No caller-supplied success callback or page-table copy. */
+IOReturn NativeAdrenoBindSmmuVisibility(NativeAdrenoMemory *,ArmSmmu4KLiveVisibility *);
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoStatus.h b/iokit/Kernel/arm/unixnu/NativeAdrenoStatus.h
new file mode 100644
index 000000000..fa69ac8ec
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoStatus.h
@@ -0,0 +1,26 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_STATUS_H
+#define NATIVE_ADRENO_STATUS_H
+#include <IOKit/IOTypes.h>
+#include <stdint.h>
+/* Monotonic fault and suspend counters for Turnip's device_check_status and
+ * device_get_suspend_count. Turnip compares the fault count against the value
+ * it saw last; a change means the context is lost. This object only counts
+ * what the driver tells it: the IRQ path records a fatal decode, the reset or
+ * power path records a suspend, and submission poisoning must be recorded by
+ * the caller that observed it. It performs no detection, reset or recovery and
+ * never clears a count, so a client cannot hide a fault by re-reading. */
+struct NativeAdrenoStatusCounts {
+    uint64_t faults;
+    uint64_t suspends;
+};
+class NativeAdrenoStatus final {
+    uint64_t faults_=0,suspends_=0;
+public:
+    void noteFault() {if(faults_!=UINT64_MAX)++faults_;}
+    void noteSuspend() {if(suspends_!=UINT64_MAX)++suspends_;}
+    uint64_t faults() const {return faults_;}
+    uint64_t suspends() const {return suspends_;}
+    NativeAdrenoStatusCounts counts() const {return {faults_,suspends_};}
+};
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoSubmit.cpp b/iokit/Kernel/arm/unixnu/NativeAdrenoSubmit.cpp
new file mode 100644
index 000000000..1cfe0bfce
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoSubmit.cpp
@@ -0,0 +1,346 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoSubmit.h"
+#include "AdrenoPM4.h"
+#include <IOKit/IOLib.h>
+#include <mach/mach_time.h>
+
+/* CP_INDIRECT_BUFFER is opcode 0x3f with a 3-word payload: 64-bit GPU address
+ * and IB_SIZE in dwords (bits 0..19), exactly as the pinned adreno_pm4.xml
+ * domain states and Linux msm_gem_submit.c converts the userspace byte size. */
+enum : uint32_t {SubmitIndirectBuffer=0x3f,SubmitIbWords=3,SubmitMaxJobs=8,
+    SubmitMaxBuffers=16,SubmitMaxIbBytes=0xfffffu*4u,
+    SubmitAuditBytes=256u*1024u};   /* IB bytes the write-combine audit compares per submission */
+extern "C" {volatile uint32_t native_adreno_coherence[8];}
+/* Legacy full-VM publication: [0] mach ticks, [1] bytes maintained, [2] objects maintained (NativeAdrenoVm::publishMapped). */
+extern "C" {uint64_t native_adreno_publish_stats[3];}
+/* The submission (1-based count) at which the write-combine audit found a dirty IB line or failed; 0 = never. */
+extern "C" {volatile uint32_t native_adreno_wc_distrusted;}
+/* The write-combine audit before each submission while trusted: [0] submissions audited, [1] IB lines compared, [2] dirty lines,
+ * [3] stale clean lines, [4] the last audit failure (any failure also ends the trust), [5] pages found back at the default attribute
+ * and write-combined again. */
+extern "C" {volatile uint32_t native_adreno_wc_audit[6];}
+/* Fence waits: [0] calls, [1] timeouts, [2] the fence of the last timed-out wait, [3] the fence value the GPU had written then, [4] the newest fence handed out,
+ * [5] the newest completed, [6] waits for a fence no job holds (observeFence path), [7] the last fence refused as never submitted. */
+extern "C" {volatile uint32_t native_adreno_fence_wait[8];}
+/* The IBs of the last submissions: [slot] fence, iova low/high, bytes, then the first 28 dwords of the first IB (read as the kernel maps it). */
+extern "C" {volatile uint32_t native_adreno_ib_log[4][4+28];volatile uint32_t native_adreno_ib_log_count;}
+IOReturn NativeAdrenoSubmit::poison()
+{
+    poisoned_=true;return kIOReturnIOError;
+}
+NativeAdrenoSubmit::Job *NativeAdrenoSubmit::find(uint32_t fence)
+{
+    if(fence)for(auto &job:jobs_)if(job.active && job.fence==fence)return &job;
+    return nullptr;
+}
+NativeAdrenoSubmit::Job *NativeAdrenoSubmit::free()
+{
+    for(auto &job:jobs_)if(!job.active)return &job;
+    return nullptr;
+}
+IOReturn NativeAdrenoSubmit::attach(NativeAdrenoVm *vm,NativeAdrenoRing *ring)
+{
+    if(attached_ || poisoned_ || vm_ || ring_)return kIOReturnBusy;
+    if(!vm || !ring || vm->poisoned() || ring->poisoned())return kIOReturnBadArgument;
+    vm_=vm;ring_=ring;attached_=true;stats_={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::release(Job &job)
+{
+    IOReturn status=kIOReturnSuccess;
+    if(job.resources) {
+        // Invalidate after completion BEFORE dropping any device references.
+        for(size_t i=0;i<job.count;++i)
+            if((job.resources[i].access&2) && vm_->acquireHandle(job.resources[i].handle))return poison();
+        for(size_t i=0;i<job.count;++i) {
+            if(vm_->retireJobAfterCompletion(job.resources[i].handle))return poison();
+            ++stats_.references_retired;
+        }
+        IODelete(job.resources,NativeAdrenoSubmitResource,job.count);
+    } else {
+        for(size_t i=0;i<job.count;++i) {
+            IOReturn retired=vm_->retireJobAfterCompletion(job.handles[i]);
+            if(retired)status=retired;else ++stats_.references_retired;
+        }
+        if(status)return poison();
+        if(vm_->acquireImported())return poison();
+    }
+    job={};return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::detach()
+{
+    if(poisoned_ || outstanding())return kIOReturnBusy;
+    if(!attached_)return kIOReturnNotReady;
+    attached_=false;vm_=nullptr;ring_=nullptr;return kIOReturnSuccess;
+}
+bool NativeAdrenoSubmit::queueOutstanding(uint32_t queue) const
+{
+    return rangeOutstanding(queue,1);
+}
+bool NativeAdrenoSubmit::rangeOutstanding(uint32_t first,uint32_t count) const
+{
+    for(const auto &job:jobs_)if(job.active && job.queue-first<count)return true;
+    return false;
+}
+size_t NativeAdrenoSubmit::outstanding() const
+{
+    size_t count=0;for(const auto &job:jobs_)if(job.active)++count;return count;
+}
+IOReturn NativeAdrenoSubmit::submit(const NativeAdrenoSubmitBuffer *buffers,size_t count,
+    uint32_t queue,uint32_t *fence)
+{
+    return submitResources(buffers,count,queue,nullptr,0,fence);
+}
+IOReturn NativeAdrenoSubmit::submitResources(const NativeAdrenoSubmitBuffer *buffers,size_t count,
+    uint32_t queue,const NativeAdrenoSubmitResource *resources,size_t resource_count,uint32_t *fence)
+{
+    if(!fence)return kIOReturnBadArgument;*fence=0;
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!buffers || !count || count>SubmitMaxBuffers || resource_count>NativeAdrenoVmMaxObjects ||
+       (resource_count && !resources) || (resources && !resource_count))return kIOReturnBadArgument;
+    for(size_t i=0;i<resource_count;++i) {
+        uint64_t va=0;size_t bytes=0;unsigned permissions=0;
+        const IOReturn described=vm_->describe(resources[i].handle,&va,&bytes,&permissions);
+        if(!resources[i].access || (resources[i].access&~3u) || described ||
+           (resources[i].access&permissions)!=resources[i].access) {
+            IOLog("SWEET RENDER: reject residency index=%lu handle=%llu access=%u permissions=%u describe=%#x\n",
+                (unsigned long)i,resources[i].handle,resources[i].access,permissions,described);
+            return kIOReturnBadArgument;
+        }
+        for(size_t j=0;j<i;++j)if(resources[j].handle==resources[i].handle)return kIOReturnBadArgument;
+    }
+    for(size_t i=0;resource_count && i<count;++i) {
+        bool found=false;
+        for(size_t j=0;j<resource_count;++j)
+            if(resources[j].handle==buffers[i].handle && (resources[j].access&1)) {found=true;break;}
+        if(!found)return kIOReturnBadArgument;
+    }
+    /* Every buffer is validated against the live VM before any reference. */
+    uint64_t handles[SubmitMaxBuffers];size_t handle_count=0;
+    uint32_t words[SubmitMaxBuffers*(1+SubmitIbWords)];size_t word_count=0;
+    for(size_t i=0;i<count;++i) {
+        const NativeAdrenoSubmitBuffer &buffer=buffers[i];
+        if(!buffer.handle || (buffer.iova&3) || !buffer.bytes || (buffer.bytes&3) || buffer.bytes>SubmitMaxIbBytes)
+            return kIOReturnBadArgument;
+        uint64_t iova=0;size_t bytes=0;unsigned permissions=0;
+        IOReturn status=vm_->describe(buffer.handle,&iova,&bytes,&permissions);
+        if(status)return status;
+        if(!(permissions&ArmSmmu4KRead) || buffer.iova<iova ||
+            buffer.iova-iova>bytes || buffer.bytes>bytes-(buffer.iova-iova))return kIOReturnBadArgument;
+        uint32_t header=0;
+        if(AdrenoPM4Type7(SubmitIndirectBuffer,SubmitIbWords,&header)!=AdrenoPM4Success)
+            return poison();
+        words[word_count++]=header;
+        words[word_count++]=(uint32_t)buffer.iova;
+        words[word_count++]=(uint32_t)(buffer.iova>>32);
+        words[word_count++]=(uint32_t)(buffer.bytes/4);
+        bool known=false;
+        for(size_t j=0;j<handle_count;++j)if(handles[j]==buffer.handle) {known=true;break;}
+        if(!known)handles[handle_count++]=buffer.handle;
+    }
+    IOReturn swept=retireCompleted();
+    if(swept)return swept;
+    Job *job=free();
+    if(!job)return kIOReturnBusy;
+    const size_t held_count=resources?resource_count:handle_count;
+    NativeAdrenoSubmitResource *held=resources?IONew(NativeAdrenoSubmitResource,resource_count):nullptr;
+    if(resources && !held)return kIOReturnNoMemory;
+    for(size_t i=0;i<held_count;++i) {
+        const uint64_t handle=resources?resources[i].handle:handles[i];
+        IOReturn status=vm_->holdJob(handle);
+        if(status) {
+            while(i) {--i;vm_->retireJobAfterCompletion(resources?resources[i].handle:handles[i]);++stats_.references_retired;}
+            if(held)IODelete(held,NativeAdrenoSubmitResource,resource_count);
+            return status;
+        }
+        if(held)held[i]=resources[i];
+        ++stats_.references_held;
+    }
+    auto rollback=[&]() {
+        for(size_t i=0;i<held_count;++i) {vm_->retireJobAfterCompletion(resources?resources[i].handle:handles[i]);++stats_.references_retired;}
+        if(held)IODelete(held,NativeAdrenoSubmitResource,resource_count);
+    };
+    uint32_t value=0;
+    /* int-070: the first IB word as the kernel's cacheable alias and DRAM see it before any maintenance, then DRAM after the CPU
+     * caches over every mapped BO are cleaned and invalidated. The board shows the last submission's record on a stall. */
+    uint32_t cached=~0u,before=~0u,ignored=0,after=~0u;
+    /* Write-combined stores this CPU made before the call (the client's command words) complete before anything below. */
+    __asm__ volatile("dsb sy":::"memory");
+    /* int-098/099: with write-combined user BOs and no maintenance the CP stopped at the end of the first IB, as in int-065..069 when an
+     * IB sat in a CPU cache. While write-combined BOs are trusted, every line of this submission's IBs is compared as a CPU cache and
+     * DRAM hold it (bounded). A dirty line means a client view still caches its BOs: maintain every BO from now on, this submission
+     * included (the audit already wrote the IB lines back; the rest of the BOs may hold more). */
+    if(vm_->writeCombinedTrusted()) {
+        /* int-100: the dirty IB page was back at XNU's default (cacheable) attribute. Write-combine every such page again first; the
+         * pmap writes its lines back on the way, so the audit below should then find none. */
+        uint32_t reset=0;
+        IOReturn audited=vm_->reassertWriteCombined(&reset);
+        native_adreno_wc_audit[5]=native_adreno_wc_audit[5]+reset;
+        uint32_t lines=0,dirty=0,stale=0;size_t budget=SubmitAuditBytes;
+        /* The re-assertion above is the correction and runs every time; the audit only detects, and found no dirty line in int-141's
+         * 133798, so after the first 16 submissions it compares every eighth one's IBs (it cost about 2 ms each). */
+        ++audit_tick_;
+        const bool audit_now=audit_tick_<=16 || (audit_tick_&7)==1;
+        if(!audit_now)budget=0;
+        for(size_t i=0;i<count && budget && !audited;++i) {   /* a failed re-assertion skips the audit and ends the trust */
+            const size_t bytes=buffers[i].bytes<budget?(size_t)buffers[i].bytes:budget;
+            audited=vm_->auditRange(buffers[i].iova,bytes,&lines,&dirty,&stale);budget-=bytes;
+        }
+        if(audit_now && audited!=kIOReturnUnsupported) {   /* no board hook (host): nothing to compare */
+            native_adreno_wc_audit[0]=native_adreno_wc_audit[0]+1;
+            native_adreno_wc_audit[1]=native_adreno_wc_audit[1]+lines;
+            native_adreno_wc_audit[2]=native_adreno_wc_audit[2]+dirty;
+            native_adreno_wc_audit[3]=native_adreno_wc_audit[3]+stale;
+            if(audited)native_adreno_wc_audit[4]=audited;
+        }
+        if(dirty || (audited && audited!=kIOReturnUnsupported)) {
+            vm_->distrustWriteCombined();
+            native_adreno_wc_distrusted=native_adreno_coherence[0]+1;
+        }
+    }
+    (void)vm_->sampleWord(buffers[0].iova,&cached,&before);
+    IOReturn status=kIOReturnSuccess;
+    if(resources) {
+        for(size_t i=0;i<resource_count && !status;++i)
+            status=vm_->publishHandle(resources[i].handle,(resources[i].access&2)!=0);
+    } else {
+        const uint64_t published=mach_absolute_time();
+        status=vm_->publishMapped();
+        __atomic_add_fetch(&native_adreno_publish_stats[0],mach_absolute_time()-published,__ATOMIC_RELAXED);
+    }
+    if(!status) {
+        (void)vm_->sampleWord(buffers[0].iova,&ignored,&after);
+        native_adreno_coherence[0]=native_adreno_coherence[0]+1;
+        native_adreno_coherence[1]=cached;native_adreno_coherence[2]=before;native_adreno_coherence[3]=after;
+        if(cached!=before || before!=after) {
+            if(!native_adreno_coherence[4]) {
+                native_adreno_coherence[5]=cached;native_adreno_coherence[6]=before;native_adreno_coherence[7]=after;
+            }
+            native_adreno_coherence[4]=native_adreno_coherence[4]+1;
+        }
+        status=vm_->invalidateTlb();
+    }
+    if(status) {
+        rollback();
+        return status;
+    }
+    {
+        const uint32_t slot=native_adreno_ib_log_count&3;uint32_t head[28];
+        (void)vm_->peekWords(buffers[0].iova,head,28);
+        native_adreno_ib_log[slot][0]=ring_->lastSubmitted()+1;native_adreno_ib_log[slot][1]=(uint32_t)buffers[0].iova;
+        native_adreno_ib_log[slot][2]=(uint32_t)(buffers[0].iova>>32);native_adreno_ib_log[slot][3]=(uint32_t)buffers[0].bytes;
+        for(unsigned i=0;i<28;++i)native_adreno_ib_log[slot][4+i]=head[i];
+        native_adreno_ib_log_count=native_adreno_ib_log_count+1;
+    }
+    status=ring_->submitFramed(words,word_count,&value);
+    if(status) {
+        /* A poisoned ring may already have consumed the WPTR write, so the
+         * referenced buffers cannot be retired here. */
+        if(ring_->poisoned()) {
+            *job=Job{};++stats_.poisoned_jobs;
+            if(held)job->resources=held;
+            else for(size_t i=0;i<handle_count;++i)job->handles[i]=handles[i];
+            job->count=held_count;job->queue=queue;job->active=true;
+            return poison();
+        }
+        rollback();
+        return status;
+    }
+    if(held)job->resources=held;
+    else for(size_t i=0;i<handle_count;++i)job->handles[i]=handles[i];
+    job->count=held_count;job->fence=value;job->queue=queue;job->active=true;
+    ++stats_.submissions;
+    if(outstanding()>stats_.peak_jobs)stats_.peak_jobs=outstanding();
+    *fence=value;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::observeFence(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    if(!fence)return kIOReturnBadArgument;
+    const NativeAdrenoRingFence result=ring_->observeFence(fence,clock,timeout_us,nullptr);
+    if(result==NativeAdrenoRingFencePoisoned)return poison();
+    if(result==NativeAdrenoRingFenceArgument)return kIOReturnBadArgument;
+    if(result==NativeAdrenoRingFenceTimeout)return kIOReturnTimeout;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::wait(uint32_t fence,const NativeAdrenoRingClock *clock,
+    uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    Job *job=find(fence);
+    uint32_t observed=0;
+    native_adreno_fence_wait[0]=native_adreno_fence_wait[0]+1;
+    if(!job) {
+        native_adreno_fence_wait[6]=native_adreno_fence_wait[6]+1;
+        const NativeAdrenoRingFence passed=ring_->observeFence(fence,clock,timeout_us,&observed);
+        if(passed==NativeAdrenoRingFencePoisoned)return poison();
+        if(passed==NativeAdrenoRingFenceArgument) {native_adreno_fence_wait[7]=fence;return kIOReturnBadArgument;}
+        if(passed==NativeAdrenoRingFenceTimeout) {
+            ++stats_.timeouts;
+            native_adreno_fence_wait[1]=native_adreno_fence_wait[1]+1;native_adreno_fence_wait[2]=fence;native_adreno_fence_wait[3]=observed;
+            native_adreno_fence_wait[4]=ring_->lastSubmitted();native_adreno_fence_wait[5]=ring_->completedFence();
+            return kIOReturnTimeout;
+        }
+        return kIOReturnSuccess;
+    }
+    const uint64_t wait_began=clock && clock->now_us?clock->now_us(clock->cookie):0;
+    const NativeAdrenoRingFence result=ring_->wait(fence,clock,timeout_us,&observed);
+    const uint64_t wait_done=clock && clock->now_us?clock->now_us(clock->cookie):wait_began;
+    if(result==NativeAdrenoRingFencePoisoned)return poison();
+    if(result==NativeAdrenoRingFenceArgument) {native_adreno_fence_wait[7]=fence;return kIOReturnBadArgument;}
+    if(result==NativeAdrenoRingFenceTimeout) {
+        ++stats_.timeouts;
+        native_adreno_fence_wait[1]=native_adreno_fence_wait[1]+1;native_adreno_fence_wait[2]=fence;native_adreno_fence_wait[3]=observed;
+        native_adreno_fence_wait[4]=ring_->lastSubmitted();native_adreno_fence_wait[5]=ring_->completedFence();
+        return kIOReturnTimeout;
+    }
+    const size_t resource_count=job->count;
+    IOReturn status=release(*job);
+    const uint64_t retired=clock && clock->now_us?clock->now_us(clock->cookie):wait_done;
+    static unsigned retirements=0;
+    if(++retirements<=8 || retirements%120==0 || status)
+        IOLog("SWEET RENDER: fence retire %u resources=%lu gpu_wait_us=%llu cache_retire_us=%llu result=%#x\n",
+            retirements,(unsigned long)resource_count,(unsigned long long)(wait_done-wait_began),
+            (unsigned long long)(retired-wait_done),status);
+    if(status)return status;
+    ++stats_.completed;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::waitAll(const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    while(outstanding()) {
+        Job *oldest=nullptr;
+        for(auto &job:jobs_)if(job.active && (!oldest || job.fence-oldest->fence>0x80000000u))oldest=&job;
+        const IOReturn status=wait(oldest->fence,clock,timeout_us);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::waitRange(uint32_t first,uint32_t count,const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    while(rangeOutstanding(first,count)) {
+        Job *oldest=nullptr;
+        for(auto &job:jobs_)if(job.active && job.queue-first<count && (!oldest || job.fence-oldest->fence>0x80000000u))oldest=&job;
+        const IOReturn status=wait(oldest->fence,clock,timeout_us);
+        if(status)return status;
+    }
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoSubmit::retireCompleted()
+{
+    if(!attached_ || poisoned_)return kIOReturnNotReady;
+    for(auto &job:jobs_) {
+        if(!job.active)continue;
+        const NativeAdrenoRingFence state=ring_->observeFence(job.fence,nullptr,0,nullptr);
+        if(state==NativeAdrenoRingFencePoisoned)return poison();
+        if(state!=NativeAdrenoRingFenceComplete)continue;
+        const IOReturn status=release(job);
+        if(status)return status;
+        ++stats_.completed;
+    }
+    return kIOReturnSuccess;
+}
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoSubmit.h b/iokit/Kernel/arm/unixnu/NativeAdrenoSubmit.h
new file mode 100644
index 000000000..6cc87eaa8
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoSubmit.h
@@ -0,0 +1,91 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_SUBMIT_H
+#define NATIVE_ADRENO_SUBMIT_H
+#include "NativeAdrenoRing.h"
+#include "NativeAdrenoVm.h"
+
+struct NativeAdrenoSubmitBuffer {
+    uint64_t handle;
+    uint64_t iova;
+    size_t bytes;      /* Complete indirect-buffer range in bytes. */
+};
+struct NativeAdrenoSubmitResource {
+    uint64_t handle;
+    uint32_t access;
+};
+/* Coherence samples (int-070): [0] submissions sampled; [1..3] the last one's first IB word through the kernel's cacheable alias,
+ * through DRAM before and through DRAM after the CPU cache maintenance of every mapped BO (~0 when unreadable); [4] samples whose
+ * three values differ and [5..7] the first such sample. */
+extern "C" volatile uint32_t native_adreno_coherence[8];
+/* The write-combine audit (int-100), see NativeAdrenoSubmit.cpp, and the submission (1-based) that ended the trust; 0 = never. */
+extern "C" volatile uint32_t native_adreno_wc_audit[6];
+extern "C" volatile uint32_t native_adreno_wc_distrusted;
+struct NativeAdrenoSubmitStats {
+    uint32_t submissions,completed,timeouts,poisoned_jobs;
+    size_t references_held,references_retired,peak_jobs;
+};
+/* Kernel-side execbuf: turns validated indirect buffers into one ring
+ * submission and owns a device reference per distinct buffer until the
+ * timestamp fence is actually observed. This is not a userspace ABI and not a
+ * scheduler: at most eight jobs are outstanding, callers serialize every
+ * method, and the ring/VM must already be attached to the same live context.
+ * Buffers may be sub-ranges of a live VM mapping but never a different IOVA,
+ * unmapped handle, table pool or a range that includes unreadable bytes.
+ * A failed ring commit that poisons the ring keeps every reference and the
+ * submit object unusable; only an independent reset may reclaim them. */
+class NativeAdrenoSubmit final {
+    struct Job {
+        uint32_t fence=0;
+        size_t count=0;
+        uint64_t handles[16]{};
+        NativeAdrenoSubmitResource *resources=nullptr;
+        uint32_t queue=0;
+        bool active=false;
+    } jobs_[8];
+    NativeAdrenoVm *vm_=nullptr;
+    NativeAdrenoRing *ring_=nullptr;
+    NativeAdrenoSubmitStats stats_{};
+    bool attached_=false,poisoned_=false;
+    uint32_t audit_tick_=0;   /* submissions since attach; every eighth one audits its IB lines */
+    Job *find(uint32_t fence);
+    Job *free();
+    IOReturn release(Job &);
+    IOReturn poison();
+public:
+    NativeAdrenoSubmit()=default;
+    ~NativeAdrenoSubmit()=default;
+    NativeAdrenoSubmit(const NativeAdrenoSubmit &)=delete;
+    NativeAdrenoSubmit &operator=(const NativeAdrenoSubmit &)=delete;
+    IOReturn attach(NativeAdrenoVm *,NativeAdrenoRing *);
+    /* Refuses while jobs are outstanding or poisoned; the caller must have
+     * stopped the GPU and observed every fence before calling this. */
+    IOReturn detach();
+    /* queue is bookkeeping for one shared ring; it never reorders or isolates
+     * submissions and is validated by the caller's open queue set. */
+    IOReturn submit(const NativeAdrenoSubmitBuffer *,size_t,uint32_t queue,
+        uint32_t *fence);
+    /* Holds every residency object until the real fence, cleans just this set,
+     * and acquires only GPU-written objects. Legacy submit keeps full-VM sync. */
+    IOReturn submitResources(const NativeAdrenoSubmitBuffer *,size_t,uint32_t,
+        const NativeAdrenoSubmitResource *,size_t,uint32_t *);
+    bool queueOutstanding(uint32_t queue) const;
+    /* Queues [first, first+count): whether any of their jobs is outstanding, and a wait for every one of them (oldest first) that
+     * leaves other queues' jobs alone. Each client of the shared ring owns one such range. */
+    bool rangeOutstanding(uint32_t first,uint32_t count) const;
+    IOReturn waitRange(uint32_t first,uint32_t count,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Retires (without waiting) every job whose fence the CP has already passed, so completed work never pins buffers or
+     * job slots just because nobody called wait(). */
+    IOReturn retireCompleted();
+    /* Waits for every outstanding job in submission order and retires its references. */
+    IOReturn waitAll(const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Polls the CP timestamp; on completion retires every buffer reference. A fence whose job was already retired (by
+     * wait or retireCompleted) is checked against the ring and succeeds once the CP has passed it. */
+    IOReturn wait(uint32_t fence,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    /* Wait for an earlier fence without touching job references; a timeout
+     * leaves every job and reference exactly as they were. */
+    IOReturn observeFence(uint32_t fence,const NativeAdrenoRingClock *,uint32_t timeout_us);
+    bool poisoned() const {return poisoned_;}
+    size_t outstanding() const;
+    NativeAdrenoSubmitStats stats() const {return stats_;}
+};
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoTimer.cpp b/iokit/Kernel/arm/unixnu/NativeAdrenoTimer.cpp
new file mode 100644
index 000000000..022241556
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoTimer.cpp
@@ -0,0 +1,55 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoTimer.h"
+#include <IOKit/IOLib.h>
+
+/* Derivation, not a guess:
+ *   pinned a6xx_gmu.xml  GMU_ALWAYS_ON_COUNTER_L 0x1f888, _H 0x1f889
+ *                        (dword offsets, variants A6XX-A7XX)
+ *   pinned sm8550.dtsi   gpu@3d00000, gmu@3d6a000
+ *   byte offset = (offset << 2) - (gmu_base - gpu_base)
+ *               = (0x1f888 << 2) - 0x6a000 = 0x14220
+ *   pinned a6xx.xml      CP_ALWAYS_ON_COUNTER 0x0980 (64-bit, A6XX-A7XX)
+ *     read as low at 0x0980 and high at 0x0981, as Linux gpu_read64 does. */
+enum : uint32_t {
+    TimerGmuLow = 0x14220,
+    TimerGmuHigh = 0x14224,
+    TimerCpLow = 0x0980,
+    TimerCpHigh = 0x0981,
+    TimerRetries = 8
+};
+uint32_t NativeAdrenoTimer::gmuLowOffset(){return TimerGmuLow;}
+uint32_t NativeAdrenoTimer::gmuHighOffset(){return TimerGmuHigh;}
+uint32_t NativeAdrenoTimer::cpLowRegister(){return TimerCpLow;}
+uint32_t NativeAdrenoTimer::cpHighRegister(){return TimerCpHigh;}
+IOReturn NativeAdrenoTimer::attach(const NativeAdrenoTimeIo *io,uint32_t source)
+{
+    if(attached_)return kIOReturnBusy;
+    if(!io || !io->read32)return kIOReturnBadArgument;
+    if(source!=NativeAdrenoTimeGmu && source!=NativeAdrenoTimeCp)return kIOReturnBadArgument;
+    io_=*io;source_=source;attached_=true;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoTimer::detach()
+{
+    if(!attached_)return kIOReturnNotReady;
+    attached_=false;io_={};
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoTimer::read(uint64_t *ticks) const
+{
+    if(!ticks)return kIOReturnBadArgument;*ticks=0;
+    if(!attached_)return kIOReturnNotReady;
+    const uint32_t low=source_==NativeAdrenoTimeGmu?TimerGmuLow:TimerCpLow;
+    const uint32_t high=source_==NativeAdrenoTimeGmu?TimerGmuHigh:TimerCpHigh;
+    for(unsigned attempt=0;attempt<TimerRetries;++attempt) {
+        uint32_t first=0,low_word=0,second=0;
+        if(io_.read32(io_.cookie,high,&first) ||
+            io_.read32(io_.cookie,low,&low_word) ||
+            io_.read32(io_.cookie,high,&second))return kIOReturnIOError;
+        if(first==second) {
+            *ticks=(uint64_t(first)<<32)|low_word;
+            return kIOReturnSuccess;
+        }
+    }
+    return kIOReturnTimeout;
+}
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoTimer.h b/iokit/Kernel/arm/unixnu/NativeAdrenoTimer.h
new file mode 100644
index 000000000..436610558
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoTimer.h
@@ -0,0 +1,42 @@
+/* SPDX-License-Identifier: MIT */
+#ifndef NATIVE_ADRENO_TIMER_H
+#define NATIVE_ADRENO_TIMER_H
+#include <IOKit/IOTypes.h>
+#include <stdint.h>
+
+/* GPU always-on counter reader for the user-visible timestamp. Two sources are
+ * distinguished because their address spaces differ:
+ *  - GMU window: byte offsets inside the already bound GMU window. The A740
+ *    offset is derived from the pinned a6xx_gmu.xml dword offset 0x1f888 and
+ *    the SM8550 DT layout: (0x1f888 << 2) - (gmu 0x03d6a000 - gpu 0x03d00000)
+ *    = 0x14220 for the low word and 0x14224 for the high word.
+ *  - CP window: dword register indices in the GPU register window, from
+ *    a6xx.xml CP_ALWAYS_ON_COUNTER at 0x0980 for A6XX..A7XX.
+ * The caller binds exactly one already powered window; this object performs no
+ * power, reset or window discovery. Reads retry while the high word changes,
+ * so a counter rollover cannot return a torn value; exceeding the retry bound
+ * is an error. A failed read reports an I/O error and never fabricates ticks. */
+enum NativeAdrenoTimeSource { NativeAdrenoTimeGmu = 0, NativeAdrenoTimeCp = 1 };
+struct NativeAdrenoTimeIo {
+    void *cookie;
+    int (*read32)(void *,uint32_t address,uint32_t *value);
+};
+class NativeAdrenoTimer final {
+    NativeAdrenoTimeIo io_{};
+    uint32_t source_=NativeAdrenoTimeGmu;
+    bool attached_=false;
+public:
+    NativeAdrenoTimer()=default;
+    ~NativeAdrenoTimer()=default;
+    NativeAdrenoTimer(const NativeAdrenoTimer &)=delete;
+    NativeAdrenoTimer &operator=(const NativeAdrenoTimer &)=delete;
+    /* Source is a numeric ABI boundary value and is range-checked. */
+    IOReturn attach(const NativeAdrenoTimeIo *,uint32_t source);
+    IOReturn detach();
+    IOReturn read(uint64_t *ticks) const;
+    static uint32_t gmuLowOffset();
+    static uint32_t gmuHighOffset();
+    static uint32_t cpLowRegister();
+    static uint32_t cpHighRegister();
+};
+#endif
diff --git a/iokit/Kernel/arm/unixnu/NativeAdrenoUserClient.cpp b/iokit/Kernel/arm/unixnu/NativeAdrenoUserClient.cpp
new file mode 100644
index 000000000..6bad78720
--- /dev/null
+++ b/iokit/Kernel/arm/unixnu/NativeAdrenoUserClient.cpp
@@ -0,0 +1,668 @@
+/* SPDX-License-Identifier: MIT */
+#include "NativeAdrenoUserClient.h"
+extern "C" volatile uint32_t native_adreno_trace_stage;
+/* 0 keeps user BOs cacheable and maintained before every submission (int-070..097); the board sets it from the sheng-gpu-wc boot argument. */
+extern "C" {volatile uint32_t native_adreno_wc_enabled=1;}
+/* BoImport record: [0] calls, [1] refused, [2..5] last refusal (status, stage, bytes, address), [6..9] first refusal. Stages 1..3 are this file's
+ * checks, 10..19 NativeAdrenoMemory::importTask's. */
+extern "C" {volatile uint64_t native_adreno_import_diag[10];}
+extern "C" volatile uint32_t native_adreno_import_stage;
+extern "C" volatile uint32_t native_adreno_io_coherent;
+/* Per kernel method: [method][0] calls, [1] calls that returned non-zero, [2] last status, [3] total time (us, 32-bit). Method numbers are the ABI's (1..16). */
+extern "C" {extern uint64_t (*native_adreno_vm_now_us)(void);volatile uint32_t native_adreno_method_stats[20][4];volatile uint32_t native_adreno_map_fail[7][2];}
+static void noteImport(IOReturn status,uint32_t stage,uint64_t bytes,uint64_t address)
+{
+    if(!status)return;
+    native_adreno_import_diag[1]=native_adreno_import_diag[1]+1;
+    native_adreno_import_diag[2]=(uint32_t)status;native_adreno_import_diag[3]=stage;native_adreno_import_diag[4]=bytes;native_adreno_import_diag[5]=address;
+    if(native_adreno_import_diag[1]==1) {
+        native_adreno_import_diag[6]=(uint32_t)status;native_adreno_import_diag[7]=stage;native_adreno_import_diag[8]=bytes;native_adreno_import_diag[9]=address;
+    }
+}
+#include <IOKit/IOLib.h>
+#include <kern/clock.h>
+#include <string.h>
+NativeAdrenoUserClient::Entry *NativeAdrenoUserClient::find(uint64_t handle)
+{
+    if(handle)for(size_t i=0;i<entry_count_;++i)if(entries_[i].used && entries_[i].handle==handle)return &entries_[i];
+    return nullptr;
+}
+void NativeAdrenoUserClient::clear(Entry &entry)
+{
+    entry.handle=0;entry.mapped=0;entry.iova=0;entry.used=false;
+    entry.mapped_state=false;entry.unreleasable=false;entry.metadata_bytes=0;
+    entry.token=0;entry.mapping_leases=0;
+}
+NativeAdrenoUserClient::Entry *NativeAdrenoUserClient::free()
+{
+    for(size_t i=0;i<entry_count_;++i)if(!entries_[i].used)return &entries_[i];
+    return nullptr;
+}
+size_t NativeAdrenoUserClient::liveObjects() const
+{
+    size_t count=0;for(size_t i=0;i<entry_count_;++i)if(entries_[i].used)++count;return count;
+}
+bool NativeAdrenoUserClient::mapped(uint64_t handle)
+{
+    Entry *entry=find(handle);return entry && entry->mapped_state;
+}
+NativeAdrenoMemory *NativeAdrenoUserClient::memoryOf(uint64_t handle)
+{
+    Entry *entry=find(handle);return entry && !entry->unreleasable?&entry->memory:nullptr;
+}
+IOReturn NativeAdrenoUserClient::open(uint32_t abi_version,NativeAdrenoVm *vm,
+    NativeAdrenoSubmit *submit,NativeAdrenoRing *ring,uint32_t input_bits,uint32_t output_bits)
+{
+    if(open_ || vm_ || submit_)return kIOReturnBusy;
+    if(abi_version!=NativeAdrenoAbiVersion)return kIOReturnUnsupported;
+    if(!vm || !submit || !ring || input_bits<31 || input_bits>48 ||
+        output_bits<32 || output_bits>48 || vm->poisoned() || submit->poisoned() ||
+        ring->poisoned())return kIOReturnBadArgument;
+    entries_=IONew(Entry,NativeAdrenoClientMaxObjects);
+    if(!entries_)return kIOReturnNoMemory;
+    memset(entries_,0,sizeof(Entry)*NativeAdrenoClientMaxObjects);
+    entry_count_=NativeAdrenoClientMaxObjects;
+    vm_=vm;submit_=submit;ring_=ring;input_bits_=input_bits;output_bits_=output_bits;
+    next_handle_=1;open_=true;
+    queues_[0]={0,true};
+    /* Each client is a new GPU context for the CP: its first submission clears the BR/BV synchronization state. */
+    ring_->requestContextReset();
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::setScope(uint32_t queue_base,uint64_t window_start,uint64_t window_bytes)
+{
+    if(!open_)return kIOReturnNotReady;
+    if(queue_base%NativeAdrenoAbiMaxQueues || queue_base>UINT32_MAX-NativeAdrenoAbiMaxQueues || (window_start&4095) || (window_bytes&4095) ||
+        (window_bytes && (window_start+window_bytes<window_start || window_start+window_bytes>(UINT64_C(1)<<input_bits_))))
+        return kIOReturnBadArgument;
+    if(liveObjects() || submit_->rangeOutstanding(queue_base_,NativeAdrenoAbiMaxQueues) ||
+        submit_->rangeOutstanding(queue_base,NativeAdrenoAbiMaxQueues))return kIOReturnBusy;
+    queue_base_=queue_base;window_start_=window_start;window_bytes_=window_bytes;window_peak_=0;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::close()
+{
+    if(!open_)return kIOReturnNotReady;
+    if(liveObjects() || submit_->rangeOutstanding(queue_base_,NativeAdrenoAbiMaxQueues))return kIOReturnBusy;
+    for(size_t i=1;i<NativeAdrenoAbiMaxQueues;++i)if(queues_[i].active)return kIOReturnBusy;
+    IODelete(entries_,Entry,entry_count_);entry_count_=0;
+    queue_base_=0;window_start_=window_bytes_=window_peak_=0;
+    open_=false;for(auto &queue:queues_)queue=Queue{};vm_=nullptr;submit_=nullptr;ring_=nullptr;timer_=nullptr;status_=nullptr;info_=nullptr;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::releaseAll(const NativeAdrenoRingClock *clock,uint32_t timeout_us)
+{
+    if(!open_)return kIOReturnNotReady;
+    if(!clock)return kIOReturnBadArgument;
+    IOReturn status=submit_->waitRange(queue_base_,NativeAdrenoAbiMaxQueues,clock,timeout_us);
+    if(status)return status;
+    for(size_t index=0;index<entry_count_;++index) {
+        Entry &entry=entries_[index];
+        if(!entry.used)continue;
+        entry.mapping_leases=0;
+        NativeAdrenoAbiBoFree request{entry.handle};
+        status=freeBo(&request);
+        if(status)return status;
+    }
+    for(size_t i=1;i<NativeAdrenoAbiMaxQueues;++i)queues_[i]=Queue{};
+    return close();
+}
+NativeAdrenoMemory *NativeAdrenoUserClient::memoryForToken(uint32_t token)
+{
+    if(!open_ || !token || token>entry_count_)return nullptr;
+    Entry &entry=entries_[token-1];
+    return entry.used && !entry.unreleasable && entry.token==token && entry.mapping_leases?&entry.memory:nullptr;
+}
+IOReturn NativeAdrenoUserClient::query(NativeAdrenoAbiParams *params)
+{
+    if(!params)return kIOReturnBadArgument;
+    *params={};
+    if(!open_)return kIOReturnNotReady;
+    params->abi_version=NativeAdrenoAbiVersion;
+    params->input_bits=input_bits_;params->output_bits=output_bits_;
+    params->flags=NativeAdrenoParamsHostImport|NativeAdrenoParamsSubmitResources|NativeAdrenoParamsCompositor4096;params->max_bo_bytes=UINT64_C(1)<<NativeAdrenoAbiMaxBoBytesShift;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::allocBo(const NativeAdrenoAbiBoAlloc *request,
+    NativeAdrenoAbiBoAllocReply *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;reply->handle=0;
+    if(!open_)return kIOReturnNotReady;
+    const uint64_t limit=UINT64_C(1)<<NativeAdrenoAbiMaxBoBytesShift;
+    if(!request->bytes || (request->bytes&4095) || request->bytes>limit ||
+        request->align_log2<12 || request->align_log2>24 || request->contiguous>1)
+        return kIOReturnBadArgument;
+    Entry *entry=free();
+    if(!entry)return kIOReturnNoResources;
+    /* A scattered allocation costs one VM span per physical page (int-030: 16 MiB came back as 4096 single-page spans, the
+     * whole span table), so larger objects try one contiguous run first and fall back to scattered pages unless the
+     * caller demanded contiguity. */
+    IOReturn status=kIOReturnUnsupported;
+    /* 0146: a failed contiguous try scans the whole free list (0135: ~20 ms of a 22 ms BoAlloc). After one fails, objects at least
+     * that large go straight to scattered pages for a second; the pool still serves first inside allocate(). */
+    static uint64_t contiguous_failed_bytes=UINT64_MAX,contiguous_failed_at=0;
+    uint64_t now=mach_absolute_time(),since_ns=0;
+    absolutetime_to_nanoseconds(now-contiguous_failed_at,&since_ns);
+    if(since_ns>=NSEC_PER_SEC)contiguous_failed_bytes=UINT64_MAX;
+    const bool prefer_contiguous=request->contiguous==0 && request->bytes>=NativeAdrenoClientContiguousFirstBytes &&
+        request->bytes<contiguous_failed_bytes;
+    if(prefer_contiguous) {
+        status=entry->memory.allocate((size_t)request->bytes,output_bits_,true,(size_t(1)<<NativeAdrenoAbiMaxBoBytesShift),true);
+        if(status && !entry->memory.quarantined() && entry->memory.release()==kIOReturnSuccess)status=kIOReturnUnsupported;
+        if(status) {contiguous_failed_bytes=request->bytes;contiguous_failed_at=now;}
+    }
+    if(status)
+        status=entry->memory.allocate((size_t)request->bytes,output_bits_,request->contiguous!=0,(size_t(1)<<NativeAdrenoAbiMaxBoBytesShift),true);
+    /* User BOs are write-combined for the CPU, as the GPU maps them non-cacheable: no per-submission cache maintenance.
+     * int-147 kept them cacheable under IO coherence and mapped the GPU side write-back: the first Turnip IB executed zeros and the GPU hung
+     * (the kernel's cacheable alias read zeros past the first line too). Turnip maps every BO asking kIOMapWriteCombineCache, the user's
+     * cache bits replace the kernel's (IOUserClient::mapClientMemory64), and XNU's view machinery changes the page attribute to match, so
+     * the aliases disagreed. A coherent own BO needs a client that asks for a write-back view. */
+    if(!status && native_adreno_wc_enabled)status=entry->memory.makeWriteCombined();
+    if(status) {
+        /* A failed allocation can leave quarantine behind; never reuse it. */
+        clear(*entry);
+        if(entry->memory.release()!=kIOReturnSuccess) {
+            entry->used=true;entry->unreleasable=true;
+        }
+        return status==kIOReturnUnsupported?kIOReturnUnsupported:status;
+    }
+    entry->used=true;entry->handle=next_handle_++;entry->token=(uint32_t)(entry-entries_)+1;
+    entry->mapped=0;entry->iova=0;entry->mapped_state=false;
+    reply->handle=entry->handle;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::importBo(const NativeAdrenoAbiBoImport *request,void *task,
+    NativeAdrenoAbiBoAllocReply *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;reply->handle=0;
+    if(!open_)return kIOReturnNotReady;
+    native_adreno_import_diag[0]=native_adreno_import_diag[0]+1;
+    const uint64_t limit=UINT64_C(1)<<NativeAdrenoAbiMaxBoBytesShift;
+    if(!task || !request->address || ((request->address|request->bytes)&4095) || !request->bytes || request->bytes>limit) {
+        noteImport(kIOReturnBadArgument,1,request->bytes,request->address);
+        return kIOReturnBadArgument;
+    }
+    Entry *entry=free();
+    if(!entry) {noteImport(kIOReturnNoResources,2,request->bytes,request->address);return kIOReturnNoResources;}
+    const IOReturn status=entry->memory.importTask(task,request->address,(size_t)request->bytes,output_bits_,(size_t)request->bytes);
+    if(status) {
+        noteImport(status,native_adreno_import_stage,request->bytes,request->address);
+        clear(*entry);
+        if(entry->memory.release()!=kIOReturnSuccess) {entry->used=true;entry->unreleasable=true;}
+        return status;
+    }
+    entry->used=true;entry->handle=next_handle_++;entry->token=(uint32_t)(entry-entries_)+1;
+    entry->mapped=0;entry->iova=0;entry->mapped_state=false;
+    reply->handle=entry->handle;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::mapBo(const NativeAdrenoAbiBoMap *request,
+    NativeAdrenoAbiBoMapReply *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;reply->iova=0;
+    if(!open_)return kIOReturnNotReady;
+    if(!(request->permissions&1) || (request->permissions&~3u) || request->writeback>1 ||
+        (request->shareability!=2 && request->shareability!=3) || request->reserved ||
+        (request->iova&4095))return kIOReturnBadArgument;
+    Entry *entry=find(request->handle);
+    if(!entry || entry->unreleasable)return kIOReturnBadArgument;
+    if(entry->mapped_state)return kIOReturnBusy;
+    const uint64_t end=request->iova+entry->memory.bytes();
+    if(window_bytes_ && (request->iova<window_start_ || end<request->iova || end>window_start_+window_bytes_))return kIOReturnBadArgument;
+    uint64_t handle=0;
+    /* Memory the owner maps read-only could only be pinned for reading: the GPU gets the read half of what was asked. */
+    const unsigned permissions=entry->memory.readOnly()?(request->permissions&~2u):request->permissions;
+    /* Imported memory is the owner's cacheable memory (IOSurfaces, no-copy buffers): once the board proved IO coherence, the GPU maps it
+     * write-back inner-shareable (Linux's IOMMU_CACHE PTE) and the CPU caches over it need no maintenance. The GPU's own BOs stay
+     * non-cacheable: their CPU view is write-combined, and a snoop could find a stale line of the kernel's cacheable alias. */
+    const bool coherent=entry->memory.imported() && native_adreno_io_coherent;
+    const IOReturn status=vm_->map(&entry->memory,0,request->iova,permissions,
+        coherent?1u:request->writeback,coherent?3u:request->shareability,&handle);
+    if(status)return status;
+    entry->mapped=handle;entry->iova=request->iova;entry->mapped_state=true;
+    if(end>window_peak_)window_peak_=end;
+    reply->iova=request->iova;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::freeBo(const NativeAdrenoAbiBoFree *request)
+{
+    native_adreno_trace_stage=1;
+    if(!request)return kIOReturnBadArgument;
+    if(!open_)return kIOReturnNotReady;
+    Entry *entry=find(request->handle);
+    if(!entry)return kIOReturnBadArgument;
+    if(entry->unreleasable)return kIOReturnBusy;
+    if(entry->mapping_leases)return kIOReturnBusy;
+    native_adreno_trace_stage=2;
+    if(entry->mapped_state) {
+        /* Completed jobs must not pin the buffer: retire what the CP has passed before the unmap decides. */
+        submit_->retireCompleted(); /* a poisoned execbuf refuses and the unmap below stays refused too */
+        native_adreno_trace_stage=3;
+        const IOReturn unmap=vm_->unmap(entry->mapped);
+        native_adreno_trace_stage=4;
+        if(unmap)return unmap;
+        entry->mapped_state=false;entry->mapped=0;entry->iova=0;
+    }
+    const IOReturn release=entry->memory.release();
+    if(release)return release;
+    clear(*entry);
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::submit(const NativeAdrenoAbiSubmit *request,
+    NativeAdrenoAbiSubmitReply *reply,const NativeAdrenoRingClock *clock)
+{
+    if(!request || !reply)return kIOReturnBadArgument;reply->fence=0;
+    if(!open_)return kIOReturnNotReady;
+    if(!request->buffer_count || request->buffer_count>NativeAdrenoAbiMaxBuffers ||
+        request->reserved)return kIOReturnBadArgument;
+    if(request->queue>=NativeAdrenoAbiMaxQueues || !queues_[request->queue].active)
+        return kIOReturnBadArgument;
+    if(request->wait_fence) {
+        if(!clock)return kIOReturnBadArgument;
+        const uint32_t wait_us=request->wait_timeout_ns==0?0:
+            (request->wait_timeout_ns>UINT64_C(0xffffffff)*1000u?0xffffffffu:
+            (uint32_t)(request->wait_timeout_ns/1000));
+        const IOReturn waited=submit_->observeFence((uint32_t)request->wait_fence,clock,wait_us);
+        if(waited)return waited;
+    }
+    NativeAdrenoSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
+    for(uint32_t i=0;i<request->buffer_count;++i) {
+        const NativeAdrenoAbiSubmitBuffer &wire=request->buffers[i];
+        if(!wire.bytes || (wire.bytes&3))return kIOReturnBadArgument;
+        Entry *entry=find(wire.handle);
+        if(!entry || !entry->mapped_state)return kIOReturnBadArgument;
+        buffers[i]={entry->mapped,wire.iova,(size_t)wire.bytes};
+    }
+    uint32_t fence=0;
+    const IOReturn status=submit_->submit(buffers,request->buffer_count,
+        queue_base_+static_cast<uint32_t>(request->queue),&fence);
+    if(status)return status;
+    reply->fence=fence;
+    return kIOReturnSuccess;
+}
+IOReturn NativeAdrenoUserClient::submitResources(const NativeAdrenoAbiSubmitResources *request,
+    NativeAdrenoAbiSubmitReply *reply)
+{
+    if(!request || !reply)return kIOReturnBadArgument;
+    reply->fence=0;
+    if(!open_)return kIOReturnNotReady;
+    const auto &commands=request->commands;
+    if(request->reserved || !request->resource_count || request->resource_count>NativeAdrenoAbiMaxResources ||
+       !commands.buffer_count || commands.buffer_count>NativeAdrenoAbiMaxBuffers || commands.reserved ||
+       commands.wait_fence || commands.wait_timeout_ns || commands.queue>=NativeAdrenoAbiMaxQueues ||
+       !queues_[commands.queue].active)return kIOReturnBadArgument;
+    auto resources=IONew(NativeAdrenoSubmitResource,request->resource_count);
+    if(!resources)return kIOReturnNoMemory;
+    IOReturn status=kIOReturnSuccess;
+    for(uint32_t i=0;i<request->resource_count;++i) {
+        const auto &wire=request->resources[i];
+        Entry *entry=find(wire.handle);
+        if(!entry || !entry->mapped_state || entry->unreleasable || wire.reserved || !wire.access || (wire.access&~3u)) {
+            status=kIOReturnBadArgument;break;
+        }
+        /* Gallium's FD_RELOC_FLAGS_INIT is READ|WRITE even for sampled,
+         * immutable IOSurfaces. This list is conservative residency/cache
+         * ownership, not permission to upgrade an owner's read-only pages.
+         * Keep the SMMU mapping read-only and hand the submit core its actual
+         * permitted access. A GPU store still faults instead of writing it. */
+        uint32_t access=wire.access;
+        if(entry->memory.readOnly()) {
+            if(!(access&1)) {status=kIOReturnBadArgument;break;}
+            access=1;
+            if(wire.access&2) {
+                static unsigned reports=0;
+                if(reports++<8)IOLog("SWEET RENDER: immutable residency handle=%llu requested=%u effective=1 SMMU read-only\n",
+                    wire.handle,wire.access);
+            }
+        }
+        resources[i]={entry->mapped,access};
+    }
+    NativeAdrenoSubmitBuffer buffers[NativeAdrenoAbiMaxBuffers];
+    for(uint32_t i=0;!status && i<commands.buffer_count;++i) {
+        const auto &wire=commands.buffers[i];
+        Entry *entry=find(wire.handle);
+        if(!entry || !entry->mapped_state || entry->unreleasable || !wire.bytes || wire.bytes>SIZE_MAX || (wire.bytes&3)) {
+            status=kIOReturnBadArgument;break;
+        }
+        buffers[i]={entry->mapped,wire.iova,(size_t)wire.bytes};
+    }
+    uint32_t fence=0;
+    if(!status)status=submit_->submitResources(buffers,commands.buffer_count,
+        queue_base_+static_cast<uint32_t>(commands.queue),resources,request->resource_count,&fence);
+    IODelete(resources,NativeAdrenoSubmitResource,request->resource_count);
+    if(!status)reply->fence=fence;
+    return status;
+}
