+/*
+ * sweettouchsim=S: S seconds after the touch service starts, swipe right then
+ * left across the middle of the screen 20 times (16 ms steps, finger 9), so
+ * CoreAnimation load and frame rate can be measured without anyone at the
+ * phone. On the lock screen right/left is Today view and back.
+ */
+static void
+sweet_touchsim_swipe(int x0, int x1, int y)
+{
+	const int steps = 24;
+	for (int i = 0; i <= steps; i++) {
+		sweet_hid_touch(9, 1, x0 + (x1 - x0) * i / steps, y);
+		IOSleep(16);
+	}
+	sweet_hid_touch(9, 0, x1, y);
+}
+
+static void
+sweet_touchsim_thread(void *arg, wait_result_t wr)
+{
+	(void)wr;
+	IOSleep((uint32_t)(uintptr_t)arg * 1000);
+	IOLog("SWEET TOUCHSIM: start\n");
+	for (int n = 0; n < 20; n++) {
+		sweet_touchsim_swipe(120, 960, 1300);
+		IOSleep(1500);
+		sweet_touchsim_swipe(960, 120, 1300);
+		IOSleep(1500);
+	}
+	IOLog("SWEET TOUCHSIM: done (40 swipes)\n");
+}
+
+extern "C" void
+sweet_touchsim_start(void)
+{
+	uint32_t secs = 0;
+	if (!PE_parse_boot_argn("sweettouchsim", &secs, sizeof(secs)) || secs == 0) {
+		return;
+	}
+	thread_t t;
+	if (kernel_thread_start(sweet_touchsim_thread, (void *)(uintptr_t)secs, &t) == KERN_SUCCESS) {
+		thread_deallocate(t);
+	}
+}
