--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -473,6 +473,46 @@
  * of the tro_ucred field so that the uthread structure can be
  * used like any other.
  */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+static void
+sweet_pbfix(void)
+{
+	static const char path[] = "/System/Library/Caches/com.apple.dyld/dyld_shared_cache_arm64.19";
+	static const uint8_t orig[4] = { 0x28, 0x36, 0x00, 0xb5 };
+	static const uint8_t nop[4] = { 0x1f, 0x20, 0x03, 0xd5 };
+	const off_t off = 0x50cfab4;
+	unsigned int on = 1;
+	(void)PE_parse_boot_argn("sweetpbfix", &on, sizeof(on));
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int err = vnode_open(path, FREAD | FWRITE, 0, 0, &vp, ctx);
+	if (err) {
+		printf("SWEET PBFIX: open %s: %d\n", path, err);
+		return;
+	}
+	uint8_t cur[4] = { 0 };
+	int resid = 0;
+	err = vn_rdwr(UIO_READ, vp, (caddr_t)cur, sizeof(cur), off, UIO_SYSSPACE, 0,
+	    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+	const uint8_t *want = on ? nop : orig;
+	const uint8_t *from = on ? orig : nop;
+	if (err || resid) {
+		printf("SWEET PBFIX: read err %d resid %d\n", err, resid);
+	} else if (memcmp(cur, want, 4) == 0) {
+		printf("SWEET PBFIX: already %s\n", on ? "patched" : "original");
+	} else if (memcmp(cur, from, 4) != 0) {
+		printf("SWEET PBFIX: unexpected bytes %02x%02x%02x%02x, left alone\n",
+		    cur[0], cur[1], cur[2], cur[3]);
+	} else {
+		err = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)want, 4, off, UIO_SYSSPACE, IO_SYNC,
+		    vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		printf("SWEET PBFIX: %s PosterBoard assert: err %d resid %d\n",
+		    on ? "patched" : "restored", err, resid);
+	}
+	(void)vnode_close(vp, FWRITE, ctx);
+}
+#endif
+
 void
 bsd_init(void)
 {
@@ -941,6 +981,9 @@
 			}
 #endif
 		}
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+		sweet_pbfix();
+#endif
 	}
 
 
