--- /dev/null
+++ b/iokit/Kernel/arm/SweetBusy.cpp
@@ -0,0 +1,45 @@
+#include <pexpert/arm64/board_config.h>
+
+#if defined(SWEET)
+#include <IOKit/IOService.h>
+#include <IOKit/IORegistryEntry.h>
+#include <IOKit/IOLib.h>
+
+extern "C" void sweet_iokit_busy_dump(void);
+
+void
+sweet_iokit_busy_dump(void)
+{
+	IOService *root = IOService::getServiceRoot();
+	IOLog("SWEET BUSY: root busy %u\n", root ? root->getBusyState() : 0);
+	IORegistryIterator *it = IORegistryIterator::iterateOver(gIOServicePlane, kIORegistryIterateRecursively);
+	if (it == NULL) {
+		return;
+	}
+	unsigned shown = 0;
+	while (IORegistryEntry *e = it->getNextObject()) {
+		IOService *s = OSDynamicCast(IOService, e);
+		if (s == NULL || s->getBusyState() == 0) {
+			continue;
+		}
+		bool leaf = true;
+		OSIterator *kids = s->getChildIterator(gIOServicePlane);
+		if (kids != NULL) {
+			while (IORegistryEntry *k = (IORegistryEntry *)kids->getNextObject()) {
+				IOService *ks = OSDynamicCast(IOService, k);
+				if (ks != NULL && ks->getBusyState() != 0) {
+					leaf = false;
+					break;
+				}
+			}
+			kids->release();
+		}
+		if (shown++ < 40) {
+			IOLog("SWEET BUSY: %s%s busy %u class %s\n", leaf ? "LEAF " : "", s->getName(),
+			    s->getBusyState(), s->getMetaClass()->getClassName());
+		}
+	}
+	it->release();
+	IOLog("SWEET BUSY: %u busy services\n", shown);
+}
+#endif
