+/*
+ * sweetshot=S: S seconds after the log starts, copy the panel (every second
+ * pixel and row, BGRA) into reserved blocks just before the log ring, for
+ * `skyios shot-pull` from recovery. sweetshot_every=T takes up to
+ * SWEET_SHOT_SLOTS shots T seconds apart. Header block: "SWEETSHT", version,
+ * width, height, bytes per row of the data, slot, seconds after boot.
+ */
+#define SWEET_SHOT_SLOTS        4
+#define SWEET_SHOT_BLOCKS       1024u   /* per slot: header + up to 4 MiB */
+
+struct sweet_shot_header {
+	char magic[8];
+	uint32_t version, width, height, bpr, slot, secs;
+};
+
 static void
+sweet_shot_thread(void *arg, __unused wait_result_t wr)
+{
+	uint32_t first = (uint32_t)(uintptr_t)arg, every = 0;
+	PE_parse_boot_argn("sweetshot_every", &every, sizeof(every));
+	/* nothing touches the framebuffer before the first shot is due (0111y,
+	 * mapping it at thread start, died early; cause not confirmed) */
+	(void)tsleep(&sweet_shot_thread, PZERO, "sweetshot", hz * (int)first);
+	/* the panel as AppleCLCD maps it; 0111z, with its own ml_io_map of
+	 * the panel here, hung around the first shot (cause not confirmed) */
+	extern volatile uintptr_t sweet_fb_shot_pixels;
+	extern volatile uint64_t sweet_fb_shot_size;
+	extern volatile uint32_t sweet_fb_shot_rowbytes;
+	uintptr_t fb = sweet_fb_shot_pixels;
+	uint32_t w = (uint32_t)(sweet_fb_shot_size >> 32), h = (uint32_t)sweet_fb_shot_size, rb = sweet_fb_shot_rowbytes;
+	if (w == 0 || h == 0 || rb < w * 4) {
+		fb = 0;
+	}
+	uint32_t ow = w / 2, oh = h / 2, obpr = ow * 4;
+	if (fb == 0 || (uint64_t)obpr * oh > (SWEET_SHOT_BLOCKS - 1) * (uint64_t)UFS_BLOCK) {
+		printf("SWEET SHOT: no usable framebuffer (%ux%u rb %u)\n", w, h, rb);
+		return;
+	}
+	uint64_t area = su.first_block + su.nblocks - SWEET_LOG_BLOCKS - SWEET_SHOT_SLOTS * SWEET_SHOT_BLOCKS;
+	uint8_t *bounce = (uint8_t *)(su.dma + DMA_BOUNCE);
+	/* chunks start on block boundaries: rows_per * obpr is a multiple of UFS_BLOCK */
+	uint32_t g = obpr, b = UFS_BLOCK;
+	while (b) {
+		uint32_t t = g % b;
+		g = b;
+		b = t;
+	}
+	uint32_t step = UFS_BLOCK / g;
+	uint32_t rows_per = (BOUNCE_SIZE / obpr) / step * step, secs = first;
+	printf("SWEET SHOT: framebuffer %ux%u rb %u mapped at %p\n", w, h, rb, (void *)fb);
+	for (uint32_t slot = 0; slot < SWEET_SHOT_SLOTS; slot++) {
+		uint64_t base = area + (uint64_t)slot * SWEET_SHOT_BLOCKS;
+		int error = 0;
+		lck_mtx_lock(&sweet_ufs_lock);
+		for (uint32_t y0 = 0; y0 < oh && !error; y0 += rows_per) {
+			uint32_t n = MIN(rows_per, oh - y0);
+			for (uint32_t y = 0; y < n; y++) {
+				const uint32_t *src = (const uint32_t *)(fb + (uint64_t)(2 * (y0 + y)) * rb);
+				uint32_t *dst = (uint32_t *)(bounce + (uint64_t)y * obpr);
+				for (uint32_t x = 0; x < ow; x++) {
+					dst[x] = src[2 * x];
+				}
+			}
+			uint32_t bytes = n * obpr, blocks = (bytes + UFS_BLOCK - 1) / UFS_BLOCK;
+			bzero(bounce + bytes, blocks * UFS_BLOCK - bytes);
+			error = ufs_write_blocks(base + 1 + (uint64_t)y0 * obpr / UFS_BLOCK, blocks);
+		}
+		if (!error) {
+			struct sweet_shot_header hd = {
+				.magic = { 'S', 'W', 'E', 'E', 'T', 'S', 'H', 'T' },
+				.version = 1, .width = ow, .height = oh, .bpr = obpr, .slot = slot, .secs = secs,
+			};
+			bzero(bounce, UFS_BLOCK);
+			memcpy(bounce, &hd, sizeof(hd));
+			error = ufs_write_blocks(base, 1);
+		}
+		if (!error) {
+			error = ufs_sync_cache();
+		}
+		lck_mtx_unlock(&sweet_ufs_lock);
+		printf("SWEET SHOT: slot %u at %u s: %ux%u -> block 0x%llx: %d\n", slot, secs, ow, oh, base, error);
+		if (error || every == 0) {
+			return;
+		}
+		(void)tsleep(&sweet_shot_thread, PZERO, "sweetshot", hz * (int)every);
+		secs += every;
+	}
+}
+
+static void
 sweet_log_start(void)
 {
 	uint32_t on = 1;
@@ -748,6 +838,11 @@
 	if (kernel_thread_start(sweet_log_thread, NULL, &thread) == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	}
+	uint32_t shot = 0;
+	if (PE_parse_boot_argn("sweetshot", &shot, sizeof(shot)) && shot != 0 &&
+	    kernel_thread_start(sweet_shot_thread, (void *)(uintptr_t)shot, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
 }
 
