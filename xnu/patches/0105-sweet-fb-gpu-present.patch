+/*
+ * Copy one layer with the Adreno 2D engine (skyios-kernel cp.rs). The surface
+ * is cleaned from the CPU caches, its physical runs are handed to the GPU page
+ * tables and the copy is queued; the surface stays retained until the next
+ * GPU present (which waits for this one) or gpuSettle(). The first frames and
+ * every 600th are waited for and checked against the source; any failure or
+ * mismatch turns the GPU path off for this boot and the caller copies with
+ * the CPU (also with sweetfb_gpu=0). sweetfb_gpu=2 waits for every copy.
+ */
+bool
+AppleCLCD::gpuPresent(SweetSurface *s, uintptr_t src, int32_t sx, int32_t sy, int32_t dx,
+    int32_t dy, int32_t w, int32_t h)
+{
+	if (sweet_fb_gpu_mode < 0) {
+		int on = 1;
+		PE_parse_boot_argn("sweetfb_gpu", &on, sizeof(on));
+		sweet_fb_gpu_mode = on;
+	}
+	if (sweet_fb_gpu_mode == 0 || sweet_rs_gpu_state() != 1) {
+		/* not up yet (the GPU thread starts sweetgpu_delay s after boot) */
+		return false;
+	}
+	uint64_t start = (uint64_t)s->offset + (uint64_t)sy * s->bytesPerRow;
+	uint64_t end = (uint64_t)s->offset + (uint64_t)(sy + h) * s->bytesPerRow;
+	if (end > s->memory->getLength()) {
+		end = s->memory->getLength();
+	}
+	uint32_t nseg = 0;
+	if (!gpuCollect(s, end, &nseg)) {
+		return false;
+	}
+	uint32_t frame = sweet_fb_gpu_frames + 1;
+	bool check = frame <= 8 || (frame % 600) == 0;
+	uint64_t t0 = mach_absolute_time();
+	sweet_rs_cache_clean(src + start, end - start);
+	uint64_t t1 = mach_absolute_time();
+	if (!sweet_rs_gpu_blit(sweet_fb_gpu_segs, nseg, s->offset, s->bytesPerRow, (uint32_t)sx,
+	    (uint32_t)sy, (uint32_t)w, (uint32_t)h, fPhys, (uint64_t)fRowBytes * fHeight, fRowBytes,
+	    (uint32_t)dx, (uint32_t)dy, check || sweet_fb_gpu_mode == 2)) {
+		IOLog("SWEET FB: GPU present failed after %u frames (%u segs), CPU copy from now on\n",
+		    sweet_fb_gpu_frames, nseg);
+		sweet_fb_gpu_mode = 0;
+		OSSafeReleaseNULL(sweet_fb_gpu_inflight);
+		return false;
+	}
+	uint64_t t2 = mach_absolute_time();
+	/* the call waited for the previous copy, so its source can go */
+	OSSafeReleaseNULL(sweet_fb_gpu_inflight);
+	s->retain();
+	sweet_fb_gpu_inflight = s;
+	sweet_fb_gpu_frames = frame;
+	if (!check && sweet_fb_gpu_frames <= 12) {
+		uint64_t c = 0, g = 0;
+		absolutetime_to_nanoseconds(t1 - t0, &c);
+		absolutetime_to_nanoseconds(t2 - t1, &g);
+		IOLog("SWEET FB: GPU present %u: queued, clean %llu us, submit %llu us%s\n",
+		    sweet_fb_gpu_frames, c / 1000, g / 1000, sweet_fb_gpu_mode == 2 ? " (sync)" : "");
+	}
+	if (check) {
+		uint32_t bad = 0, first_x = 0, first_y = 0, got = 0, want = 0;
+		for (uint32_t i = 0; i < 64; i++) {
+			uint32_t x = (uint32_t)(((uint64_t)i * 977 + 13) % (uint32_t)w);
+			uint32_t y = (uint32_t)(((uint64_t)i * 7919 + 5) % (uint32_t)h);
+			if (i == 63) {
+				x = (uint32_t)w - 1;
+				y = (uint32_t)h - 1;
+			}
+			uint32_t a = *(volatile uint32_t *)(src + s->offset + (uint64_t)(sy + y) * s->bytesPerRow + (uint64_t)(sx + x) * 4);
+			uint32_t b = *(volatile uint32_t *)(fPixels + (uint64_t)(dy + y) * fRowBytes + (uint64_t)(dx + x) * 4);
+			if (a != b && bad++ == 0) {
+				first_x = x;
+				first_y = y;
+				want = a;
+				got = b;
+			}
+		}
+		uint64_t c = 0, g = 0;
+		absolutetime_to_nanoseconds(t1 - t0, &c);
+		absolutetime_to_nanoseconds(t2 - t1, &g);
+		IOLog("SWEET FB: GPU present %u: %dx%d, %u segs, clean %llu us, gpu %llu us, check %u/64 bad%s\n",
+		    sweet_fb_gpu_frames, w, h, nseg, c / 1000, g / 1000, bad, bad ? " -> CPU copy from now on" : "");
+		if (bad != 0) {
+			IOLog("SWEET FB: first mismatch at %u,%u: panel 0x%08x want 0x%08x\n", first_x, first_y, got, want);
+			sweet_fb_gpu_mode = 0;
+			return false;
+		}
+		sweet_fb_gpu_checked++;
+	}
+	return true;
+}
+
+/* physical runs of [0, end) of the surface into sweet_fb_gpu_segs */
+bool
+AppleCLCD::gpuCollect(SweetSurface *s, uint64_t end, uint32_t *nseg)
+{
+	uint32_t n = 0;
+	IOByteCount off = 0;
+	while (off < end && n < SWEET_FB_GPU_SEGS) {
+		IOByteCount len = 0;
+		addr64_t pa = s->memory->getPhysicalSegment(off, &len, kIOMemoryMapperNone);
+		if (pa == 0 || len == 0) {
+			return false;
+		}
+		sweet_fb_gpu_segs[n][0] = pa;
+		sweet_fb_gpu_segs[n][1] = len;
+		n++;
+		off += len;
 	}
+	*nseg = n;
+	return off >= end;
 }
 
+/*
+ * Scale the whole logical-size layer onto the panel with the 3D engine
+ * (skyios-kernel cp3d::compose) instead of cropping it. Boot-arg
+ * sweetfb_scale=1. Queued like gpuPresent; the first frames and every 600th
+ * are waited for and checked loosely (bilinear filtering mixes neighbours):
+ * a failure or a mostly wrong sample set returns to the crop path for this
+ * boot.
+ */
 bool
+AppleCLCD::gpuCompose(SweetSurface *s, uintptr_t src)
+{
+	if (sweet_fb_scale_mode < 0) {
+		int on = 0;
+		PE_parse_boot_argn("sweetfb_scale", &on, sizeof(on));
+		sweet_fb_scale_mode = on != 0;
+	}
+	if (sweet_fb_gpu_mode < 0) {
+		int on = 1;
+		PE_parse_boot_argn("sweetfb_gpu", &on, sizeof(on));
+		sweet_fb_gpu_mode = on;
+	}
+	if (!sweet_fb_scale_mode || sweet_fb_gpu_mode == 0 || sweet_rs_gpu_state() != 1 ||
+	    (s->offset & 63) != 0 || (s->bytesPerRow & 63) != 0) {
+		return false;
+	}
+	uint64_t end = (uint64_t)s->offset + (uint64_t)s->height * s->bytesPerRow;
+	if (end > s->memory->getLength()) {
+		return false;
+	}
+	uint32_t nseg = 0;
+	if (!gpuCollect(s, end, &nseg)) {
+		return false;
+	}
+	uint32_t frame = sweet_fb_compose_frames + 1;
+	bool check = frame <= 8 || (frame % 600) == 0;
+	uint64_t t0 = mach_absolute_time();
+	sweet_rs_cache_clean(src + s->offset, end - s->offset);
+	uint64_t t1 = mach_absolute_time();
+	if (!sweet_rs_gpu_compose(sweet_fb_gpu_segs, nseg, s->offset, s->bytesPerRow, s->width,
+	    s->height, fPhys, (uint64_t)fRowBytes * fHeight, fRowBytes, fWidth, fHeight,
+	    check || sweet_fb_gpu_mode == 2)) {
+		IOLog("SWEET FB: GPU compose failed after %u frames (%u segs), crop path from now on\n",
+		    sweet_fb_compose_frames, nseg);
+		sweet_fb_scale_mode = 0;
+		sweet_fb_scaled = 0;
+		OSSafeReleaseNULL(sweet_fb_gpu_inflight);
+		return false;
+	}
+	uint64_t t2 = mach_absolute_time();
+	OSSafeReleaseNULL(sweet_fb_gpu_inflight);
+	s->retain();
+	sweet_fb_gpu_inflight = s;
+	sweet_fb_compose_frames = frame;
+	sweet_fb_scaled = 1;
+	uint64_t c = 0, g = 0;
+	absolutetime_to_nanoseconds(t1 - t0, &c);
+	absolutetime_to_nanoseconds(t2 - t1, &g);
+	if (!check) {
+		if (frame <= 12) {
+			IOLog("SWEET FB: GPU compose %u: queued, clean %llu us, submit %llu us\n", frame, c / 1000, g / 1000);
+		}
+		return true;
+	}
+	/* panel (x, y) samples the surface near ((x + 0.5) * sw / dw, (y + 0.5) * sh / dh) */
+	uint32_t ok = 0, first = 64, got = 0, want = 0, fx = 0, fy = 0;
+	for (uint32_t i = 0; i < 64; i++) {
+		uint32_t x = (uint32_t)(((uint64_t)i * 977 + 13) % fWidth);
+		uint32_t y = (uint32_t)(((uint64_t)i * 7919 + 5) % fHeight);
+		uint32_t px = (uint32_t)(((uint64_t)(2 * x + 1) * s->width) / (2 * fWidth));
+		uint32_t py = (uint32_t)(((uint64_t)(2 * y + 1) * s->height) / (2 * fHeight));
+		uint32_t a = *(volatile uint32_t *)(src + s->offset + (uint64_t)py * s->bytesPerRow + (uint64_t)px * 4);
+		uint32_t b = *(volatile uint32_t *)(fPixels + (uint64_t)y * fRowBytes + (uint64_t)x * 4);
+		bool close = true;
+		for (int k = 0; k < 4; k++) {
+			int d = (int)((a >> (8 * k)) & 0xff) - (int)((b >> (8 * k)) & 0xff);
+			if (d > 48 || d < -48) {
+				close = false;
+			}
+		}
+		if (close) {
+			ok++;
+		} else if (first == 64) {
+			first = i;
+			fx = x;
+			fy = y;
+			got = b;
+			want = a;
+		}
+	}
+	IOLog("SWEET FB: GPU compose %u: %ux%u -> %ux%u, %u segs, clean %llu us, gpu %llu us, check %u/64 close%s\n",
+	    frame, s->width, s->height, fWidth, fHeight, nseg, c / 1000, g / 1000, ok,
+	    ok < 48 ? " -> crop path from now on" : "");
+	if (first != 64) {
+		IOLog("SWEET FB: compose first far sample at %u,%u: panel 0x%08x src 0x%08x\n", fx, fy, got, want);
+	}
+	if (ok < 48) {
+		sweet_fb_scale_mode = 0;
+		sweet_fb_scaled = 0;
+		return false;
+	}
+	return true;
+}
+
+/* wait for a queued GPU copy before the CPU writes panel memory itself */
+void
+AppleCLCD::gpuSettle(void)
+{
+	if (sweet_fb_gpu_inflight == NULL) {
+		return;
+	}
+	if (!sweet_rs_gpu_wait()) {
+		IOLog("SWEET FB: queued GPU present did not finish, CPU copy from now on\n");
+		sweet_fb_gpu_mode = 0;
+	}
+	OSSafeReleaseNULL(sweet_fb_gpu_inflight);
+}
