+extern int tsleep(void *, int, const char *, int);
+extern int hz;
+
+void
+sweet_bsd_sleep_ms(unsigned int ms)
+{
+	static int chan;
+	int ticks = (int)((unsigned long long)ms * hz / 1000);
+	if (ticks < 1) ticks = 1;
+	(void)tsleep(&chan, 22, "sweetrs", ticks);
+}
