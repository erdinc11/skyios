 void
 sweet_rs_log(const char *msg)
 {
+	int len = 0;
+	const char *p = msg;
+	while (*p++) len++;
+	sweet_log_append(msg, len);
 	printf("%s", msg);
 }
 
+static void
+note_append(const char *s)
+{
+	char *p = sweet_boot_note;
+	while (*p) p++;
+	while (*s && (p - sweet_boot_note) < 250) *p++ = *s++;
+	*p = 0;
+}
+
+/* C-side auto-reboot: does not depend on Rust dispatch */
+extern uint64_t mach_absolute_time(void);
+extern void absolutetime_to_nanoseconds(uint64_t abstime, uint64_t *result);
+
+static void
+sweet_c_reboot_thread(void *p, __unused wait_result_t wr)
+{
+	uintptr_t secs = (uintptr_t)p;
+	/* busy-wait — both tsleep and delay block forever from sweet_rs_init threads */
+	uint64_t start = mach_absolute_time();
+	uint64_t ns_target = (uint64_t)secs * 1000000000ULL;
+	for (;;) {
+		/* yield to other threads */
+		__asm__ volatile("yield" ::: "memory");
+		uint64_t now = mach_absolute_time();
+		uint64_t elapsed_abs = now - start;
+		uint64_t elapsed_ns;
+		absolutetime_to_nanoseconds(elapsed_abs, &elapsed_ns);
+		if (elapsed_ns >= ns_target)
+			break;
+	}
+	printf("SWEET C REBOOT: %lu s up, resetting to fastboot\n", secs);
+	/* write restart-reason = bootloader to IMEM */
+	vm_offset_t imem = ml_io_map(0x146aa000, 0x1000);
+	if (imem) {
+		*(volatile uint32_t *)(imem + 0x65c) = 0x77665500;
+	}
+	__asm__ volatile("dsb sy" ::: "memory");
+	/* PSCI SYSTEM_RESET via SMC (fn id 0x84000009) */
+	__asm__ volatile(
+		"movz x0, #0x0009\n"
+		"movk x0, #0x8400, lsl #16\n"
+		"mov x1, xzr\n"
+		"mov x2, xzr\n"
+		"mov x3, xzr\n"
+		"smc #0\n"
+		::: "x0","x1","x2","x3","memory"
+	);
+	/* fallback: PS_HOLD */
+	vm_offset_t ps = ml_io_map(0x0c264000, 0x1000);
+	if (ps) *(volatile uint32_t *)ps = 0;
+}
+
+void
+sweet_rs_init(void)
+{
+	note_append("A; ");
+	sweet_log_append("SWEET RS WRAP A\n", 16);
+
+	/* spawn C-side reboot first (always works) */
+	uint32_t reboot_secs = 0;
+	if (PE_parse_boot_argn("sweetreboot", &reboot_secs, sizeof(reboot_secs))
+	    && reboot_secs != 0) {
+		thread_t rt;
+		if (kernel_thread_start(sweet_c_reboot_thread,
+		    (void *)(uintptr_t)reboot_secs, &rt) == KERN_SUCCESS)
+			thread_deallocate(rt);
+		note_append("CR; ");
+	}
+
+	sweet_rs_start();
+	note_append("Z; ");
+	sweet_log_append("SWEET RS WRAP Z\n", 16);
+}
