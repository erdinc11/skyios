+extern void sweet_rs_thread_dispatch(uintptr_t id, uintptr_t arg);
+
+/*
+ * Threads spawned during sweet_rs_init cannot use tsleep or delay
+ * until boot progresses past sweet_log_start / sweet_sample_start.
+ * Busy-wait 3 s via mach_absolute_time before entering Rust.
+ */
 static void
 sweet_rs_thread(void *p, __unused wait_result_t wr)
 {
 	struct sweet_rs_job job = *(struct sweet_rs_job *)p;
 	kfree_data(p, sizeof(job));
-	job.fn(job.arg);
+	{
+		uint64_t s = mach_absolute_time();
+		uint64_t ns;
+		for (;;) {
+			__asm__ volatile("yield" ::: "memory");
+			uint64_t e = mach_absolute_time() - s;
+			absolutetime_to_nanoseconds(e, &ns);
+			if (ns >= 3000000000ULL) break;
+		}
+	}
+	note_append("T; ");
+	sweet_rs_thread_dispatch(job.id, job.arg);
+	note_append("TX; ");
 	(void)thread_terminate(current_thread());
 	thread_block(THREAD_CONTINUE_NULL);
 }
 
